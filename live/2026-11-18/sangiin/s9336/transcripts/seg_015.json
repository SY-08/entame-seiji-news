[
{
"file": "seg_015.ts",
"start": 0.0,
"end": 12.0,
"clock": "12:00:00",
"text": "逆転減少、つまり年金がたらなくてパートや何かで働いてギリギリのところでやっている方は対象にならないけれども"
},
{
"file": "seg_015.ts",
"start": 12.0,
"end": 23.68,
"clock": "12:00:12",
"text": "年金が出るけど会社の役員とかですね、色々あって周囲の多い人には支援金の対象になるという逆転減少といいますか"
},
{
"file": "seg_015.ts",
"start": 23.68,
"end": 35.68,
"clock": "12:00:23",
"text": "おかしなことが起こるわけでございます。そういう点からもこの大慶のこの範囲ではですね、色んな矛盾がおかしいことが起こるのではないでしょうか、大臣かがでしょうか"
},
{
"file": "seg_015.ts",
"start": 35.68,
"end": 40.28,
"clock": "12:00:35",
"text": "片山国務大臣"
},
{
"file": "seg_015.ts",
"start": 40.28,
"end": 50.48,
"clock": "12:00:40",
"text": "今申し上げたとおり支援金制度自体の目的がですね、この純負担実の改善、いわゆる沖縄株等を中心として見られるような"
},
{
"file": "seg_015.ts",
"start": 50.48,
"end": 61.2,
"clock": "12:00:50",
"text": "純負担実の改善が必要ということが明らかになった中低所得の現役金動士のぜえ社会保険領による負担の軽減を通じた手取りの増加という"
},
{
"file": "seg_015.ts",
"start": 61.2,
"end": 71.64,
"clock": "12:01:01",
"text": "基金の課題に対応する目的で導入するものでございまして、現役世代とは重役と負担の構造が大きく異なる高齢者については"
},
{
"file": "seg_015.ts",
"start": 71.64,
"end": 82.84,
"clock": "12:01:11",
"text": "純負担が現役なみである方は支給対象とするということにしたわけでございます。所得加減学以下の方は支給対象とはならないわけですが"
},
{
"file": "seg_015.ts",
"start": 82.84,
"end": 91.96,
"clock": "12:01:22",
"text": "支援金は一定の就労の実態を有する方を対象とする制度でございまして、就労者でございますから、現役世代であっても高齢者だっても"
},
{
"file": "seg_015.ts",
"start": 91.96,
"end": 101.16,
"clock": "12:01:31",
"text": "それは同じ対応にはなりますが、加えまして所得加減学を超える所得がある方について、特に高齢者の場合、単に所得の対象で"
},
{
"file": "seg_015.ts",
"start": 101.16,
"end": 110.4,
"clock": "12:01:41",
"text": "支給対象となるかが決まるわけではなくて、税者解剖権量負担から年金時空学を差し切った順負担で判断することになるので"
},
{
"file": "seg_015.ts",
"start": 110.4,
"end": 118.6,
"clock": "12:01:50",
"text": "具体的にはおっしゃったように、現役なみの順負担がある方が支給対象をどうなるということが資産上もそれは出てくると思います。"
},
{
"file": "seg_015.ts",
"start": 118.6,
"end": 130.48,
"clock": "12:01:58",
"text": "ですから、所得上減学を超える所得がある方につきましては、現役世代であっても高齢者であっても高平差の観点から、これは支給対象となって、つまり高所得者はなっていないところは同じでございますが、"
},
{
"file": "seg_015.ts",
"start": 130.48,
"end": 142.36,
"clock": "12:02:10",
"text": "その上で申し上げますと、支援金制度だけで社会保障を取りまく全ての政策課題が解決できるものではないということは、国民会議でもそれは議論の前提であったはずでございまして、"
},
{
"file": "seg_015.ts",
"start": 142.36,
"end": 154.44,
"clock": "12:02:22",
"text": "支援金制度と基礎の社会保障制度の相方から取り残される方が生じないように、全体として必要な支援が適切に行き届くようにしてまいりたいと考えております。"
},
{
"file": "seg_015.ts",
"start": 154.44,
"end": 169.84,
"clock": "12:02:34",
"text": "具体的には法案の検討規定について、規定において、修行していない高齢者等の方について、年金制度及び生活補正度を掃除たの、既存の社会保障制度との関係を整理しす必要な措置のあり方について検討し、"
},
{
"file": "seg_015.ts",
"start": 169.84,
"end": 180.24,
"clock": "12:02:49",
"text": "令和12年までに結論を得ることとしておりますので、この国会でのこの御審議も踏まえまして、こういった対応についても、真摯に検討してまいるわけでございます。"
},
{
"file": "seg_015.ts",
"start": 181.24,
"end": 183.04,
"clock": "12:03:01",
"text": "大盟美貴君"
},
{
"file": "seg_015.ts",
"start": 183.04,
"end": 193.04,
"clock": "12:03:03",
"text": "今、大臣におっしゃったの1枚目の資料の赤線を聞きましたけれど、そういう方々はいろいろ考えますとなっているのは、コメディーション1位ですよね。"
},
{
"file": "seg_015.ts",
"start": 193.04,
"end": 197.64,
"clock": "12:03:13",
"text": "これただよく読みますと何言っているのかなということなんですよね。"
},
{
"file": "seg_015.ts",
"start": 197.64,
"end": 205.84,
"clock": "12:03:17",
"text": "給付の対象外で支援が必要な方を丁寧に把握した上でと、全部出すとは限らないのと反してですよね。"
},
{
"file": "seg_015.ts",
"start": 205.84,
"end": 222.24,
"clock": "12:03:25",
"text": "しかも給付と相談修行支援と、財源検討して可能なものと、さらに国民連携、国保の原面、軽減制度なども含めてと、"
},
{
"file": "seg_015.ts",
"start": 222.24,
"end": 232.44,
"clock": "12:03:42",
"text": "要するにですね、やっぱりこの大型となり給付税が向上、そういう発想から来てますので、順負担とかあるんでしょうけれども、"
},
{
"file": "seg_015.ts",
"start": 232.44,
"end": 237.24,
"clock": "12:03:52",
"text": "この注意書き赤線引いたところは要するにですね、これ働いてくれということなんですね。"
},
{
"file": "seg_015.ts",
"start": 237.24,
"end": 242.94,
"clock": "12:03:57",
"text": "少ない所得の人はもっと働いてもらいたいと、そのための修行支援とか相談乗りますよと、"
},
{
"file": "seg_015.ts",
"start": 242.94,
"end": 251.24,
"clock": "12:04:02",
"text": "そうすればこの大型の中に入りますよと、それが無理ならですね、生活保護とか、自治体の支援を受けてくださいと、"
},
{
"file": "seg_015.ts",
"start": 251.24,
"end": 254.54,
"clock": "12:04:11",
"text": "そういう話なんですね、赤線書いてあるのですね。"
},
{
"file": "seg_015.ts",
"start": 254.54,
"end": 258.64,
"clock": "12:04:14",
"text": "で、さらに申し上げますと、順負担ということを言われましたけれど、"
},
{
"file": "seg_015.ts",
"start": 258.64,
"end": 265.54,
"clock": "12:04:18",
"text": "私はこの、ずっとこの議論がですね、おかしなことになってつじつまわないのは、"
},
{
"file": "seg_015.ts",
"start": 265.54,
"end": 270.24,
"clock": "12:04:25",
"text": "消費税が2年後にみんなが増税されるときの手当てとして、"
},
{
"file": "seg_015.ts",
"start": 270.24,
"end": 274.24,
"clock": "12:04:30",
"text": "全く違う話、給付金税外工場という、"
},
{
"file": "seg_015.ts",
"start": 274.24,
"end": 278.84,
"clock": "12:04:34",
"text": "全くこれ別の政策、別の目的の提案のものを、"
},
{
"file": "seg_015.ts",
"start": 278.84,
"end": 281.04,
"clock": "12:04:38",
"text": "つなぎで持ってきているところから、"
},
{
"file": "seg_015.ts",
"start": 281.04,
"end": 286.34,
"clock": "12:04:41",
"text": "何度も何度も対象がになるじゃないかとか、どうするんだと指摘はされていると。"
},
{
"file": "seg_015.ts",
"start": 286.34,
"end": 290.74,
"clock": "12:04:46",
"text": "で、順負担ということは、もちろんこの大権のときにはね、"
},
{
"file": "seg_015.ts",
"start": 290.74,
"end": 295.94,
"clock": "12:04:50",
"text": "給付が受益上回るかとかですね、いろいろあるのがわかりますけれど、"
},
{
"file": "seg_015.ts",
"start": 295.94,
"end": 300.84,
"clock": "12:04:55",
"text": "とはらっているのは消費税増税のときの国民の負担、"
},
{
"file": "seg_015.ts",
"start": 300.84,
"end": 304.64,
"clock": "12:05:00",
"text": "家計の苦しさに対してどう対応するかというふうだと思うんですよね。"
},
{
"file": "seg_015.ts",
"start": 304.64,
"end": 307.54,
"clock": "12:05:04",
"text": "したがって、あの順負担とかいう考えは、"
},
{
"file": "seg_015.ts",
"start": 307.54,
"end": 311.24,
"clock": "12:05:07",
"text": "この順負担っていったとですね、高齢者の方々だって、"
},
{
"file": "seg_015.ts",
"start": 311.24,
"end": 313.64,
"clock": "12:05:11",
"text": "勝手は負担していたわけですよね。"
},
{
"file": "seg_015.ts",
"start": 313.64,
"end": 315.44,
"clock": "12:05:13",
"text": "で、今生活しているわけです。"
},
{
"file": "seg_015.ts",
"start": 315.44,
"end": 317.64,
"clock": "12:05:15",
"text": "順負担率なんとか関係ありません。"
},
{
"file": "seg_015.ts",
"start": 317.64,
"end": 320.14,
"clock": "12:05:17",
"text": "日々の生活それにかかるのが消費税と、"
},
{
"file": "seg_015.ts",
"start": 320.14,
"end": 323.24,
"clock": "12:05:20",
"text": "それが上手されるということでありますので、"
},
{
"file": "seg_015.ts",
"start": 323.24,
"end": 325.44,
"clock": "12:05:23",
"text": "この枠組みではなくてですね、"
},
{
"file": "seg_015.ts",
"start": 325.44,
"end": 332.54,
"clock": "12:05:25",
"text": "きちっとした上税に対する支援をきちっとやるべきではないかと思いますが、"
},
{
"file": "seg_015.ts",
"start": 332.54,
"end": 333.44,
"clock": "12:05:32",
"text": "いかがですか。"
},
{
"file": "seg_015.ts",
"start": 333.44,
"end": 335.74,
"clock": "12:05:33",
"text": "この枠組みでは解決できない話を、"
},
{
"file": "seg_015.ts",
"start": 335.74,
"end": 337.44,
"clock": "12:05:35",
"text": "最初は申し上げています。"
},
{
"file": "seg_015.ts",
"start": 337.44,
"end": 340.24,
"clock": "12:05:37",
"text": "方山国務大臣。"
},
{
"file": "seg_015.ts",
"start": 340.24,
"end": 343.04,
"clock": "12:05:40",
"text": "社会保障国民会議において、"
},
{
"file": "seg_015.ts",
"start": 343.04,
"end": 348.24,
"clock": "12:05:43",
"text": "この弱年の勤労者世帯にとって収入から税党権利をなど差し入った手取りが、"
},
{
"file": "seg_015.ts",
"start": 348.24,
"end": 350.84,
"clock": "12:05:48",
"text": "どのぐらい残るか生活の上で、"
},
{
"file": "seg_015.ts",
"start": 350.84,
"end": 353.24,
"clock": "12:05:50",
"text": "説実なものであるといったご意見があり、"
},
{
"file": "seg_015.ts",
"start": 353.24,
"end": 355.44,
"clock": "12:05:53",
"text": "税や社会保険料のご負担と、"
},
{
"file": "seg_015.ts",
"start": 355.44,
"end": 358.14,
"clock": "12:05:55",
"text": "現金給付を総合的に捉えるものとして、"
},
{
"file": "seg_015.ts",
"start": 358.14,
"end": 362.24,
"clock": "12:05:58",
"text": "先ほどから申し上げている順負担率の分析を基に議論をしてきて、"
},
{
"file": "seg_015.ts",
"start": 362.24,
"end": 364.34,
"clock": "12:06:02",
"text": "こういう取りまとめが出たわけですが、"
},
{
"file": "seg_015.ts",
"start": 364.34,
"end": 365.94,
"clock": "12:06:04",
"text": "それでこの支援金は、"
},
{
"file": "seg_015.ts",
"start": 365.94,
"end": 367.84,
"clock": "12:06:05",
"text": "諸海国等の比較を通じて、"
},
{
"file": "seg_015.ts",
"start": 367.84,
"end": 370.94,
"clock": "12:06:07",
"text": "順負担率の改善が必要と明らかになった"
},
{
"file": "seg_015.ts",
"start": 370.94,
"end": 373.74,
"clock": "12:06:10",
"text": "中定所得の現金金動車に着目して、"
},
{
"file": "seg_015.ts",
"start": 373.74,
"end": 378.04,
"clock": "12:06:13",
"text": "こうした方の税、社会保険料による負担の軽減を行うとともに、"
},
{
"file": "seg_015.ts",
"start": 378.04,
"end": 380.04,
"clock": "12:06:18",
"text": "いわゆる年収の壁などによる"
},
{
"file": "seg_015.ts",
"start": 380.04,
"end": 382.34,
"clock": "12:06:20",
"text": "働き控えを緩和することを通じた、"
},
{
"file": "seg_015.ts",
"start": 382.34,
"end": 385.54,
"clock": "12:06:22",
"text": "就労促進を図ることを目的として導入するということと、"
},
{
"file": "seg_015.ts",
"start": 385.54,
"end": 386.94,
"clock": "12:06:25",
"text": "なったわけでございます。"
},
{
"file": "seg_015.ts",
"start": 386.94,
"end": 391.34,
"clock": "12:06:26",
"text": "この上で、消費税率の飲食料費に係る引き下げは、"
},
{
"file": "seg_015.ts",
"start": 391.34,
"end": 396.64,
"clock": "12:06:31",
"text": "新金指定度の本格導入までのつなぎとして検討してきたものでございまして、"
},
{
"file": "seg_015.ts",
"start": 396.64,
"end": 400.54,
"clock": "12:06:36",
"text": "この負担率を表す順負担率のカーブで見ますと、"
},
{
"file": "seg_015.ts",
"start": 400.54,
"end": 404.94,
"clock": "12:06:40",
"text": "飲食料費の食用基金税率を1%に引き下げまして、"
},
{
"file": "seg_015.ts",
"start": 404.94,
"end": 408.14,
"clock": "12:06:44",
"text": "支援金を先行的に導入する段階では、"
},
{
"file": "seg_015.ts",
"start": 408.14,
"end": 412.14,
"clock": "12:06:48",
"text": "主に中定所得の方の順負担率が、"
},
{
"file": "seg_015.ts",
"start": 412.14,
"end": 416.24,
"clock": "12:06:52",
"text": "こう、さっと、明らかに低下するとともに、"
},
{
"file": "seg_015.ts",
"start": 416.24,
"end": 419.24,
"clock": "12:06:56",
"text": "飲食料費の消費税率を8%に戻して、"
},
{
"file": "seg_015.ts",
"start": 419.24,
"end": 422.04,
"clock": "12:06:59",
"text": "支援金を本格導入する段階では、"
},
{
"file": "seg_015.ts",
"start": 422.04,
"end": 424.74,
"clock": "12:07:02",
"text": "高所得の方の順負担率の上昇は、"
},
{
"file": "seg_015.ts",
"start": 424.74,
"end": 427.24,
"clock": "12:07:04",
"text": "総体的に小さいものにとどまる一方、"
},
{
"file": "seg_015.ts",
"start": 427.24,
"end": 431.74,
"clock": "12:07:07",
"text": "支援金の対象となる中定所得の現金の下の奥の方の順負担率は、"
},
{
"file": "seg_015.ts",
"start": 431.74,
"end": 434.04,
"clock": "12:07:11",
"text": "さらに下がるということになります。"
},
{
"file": "seg_015.ts",
"start": 434.04,
"end": 438.24,
"clock": "12:07:14",
"text": "今、ご指摘に出た方々というのは、"
},
{
"file": "seg_015.ts",
"start": 438.24,
"end": 443.04,
"clock": "12:07:18",
"text": "その所得の加減にも対応されない方とか、"
},
{
"file": "seg_015.ts",
"start": 443.04,
"end": 445.14,
"clock": "12:07:23",
"text": "さまざまなことがあると思いますので、"
},
{
"file": "seg_015.ts",
"start": 445.14,
"end": 446.54,
"clock": "12:07:25",
"text": "それにつきましては、"
},
{
"file": "seg_015.ts",
"start": 446.54,
"end": 448.84,
"clock": "12:07:26",
"text": "先ほどから申し上げましたような、"
},
{
"file": "seg_015.ts",
"start": 448.84,
"end": 453.04,
"clock": "12:07:28",
"text": "しっかりとして配慮をするということにつきるのではないかというふうに思っております。"
},
{
"file": "seg_015.ts",
"start": 453.04,
"end": 455.74,
"clock": "12:07:33",
"text": "すみません、時間が過ぎてしまって。"
},
{
"file": "seg_015.ts",
"start": 455.74,
"end": 457.84,
"clock": "12:07:35",
"text": "大盟美希君、続きは次回あります。"
},
{
"file": "seg_015.ts",
"start": 457.84,
"end": 478.36,
"clock": "12:07:37",
"text": "ありがとうございました。"
},
{
"file": "seg_015.ts",
"start": 478.36,
"end": 481.06,
"clock": "12:07:58",
"text": "大島区相君。"
},
{
"file": "seg_015.ts",
"start": 481.06,
"end": 483.36,
"clock": "12:08:01",
"text": "大島区相でございます。"
},
{
"file": "seg_015.ts",
"start": 483.36,
"end": 485.56,
"clock": "12:08:03",
"text": "財務大臣、さっき、"
},
{
"file": "seg_015.ts",
"start": 485.56,
"end": 488.36,
"clock": "12:08:05",
"text": "賛成党のまずだ院のところで、"
},
{
"file": "seg_015.ts",
"start": 488.36,
"end": 490.36,
"clock": "12:08:08",
"text": "その70、170という、"
},
{
"file": "seg_015.ts",
"start": 490.36,
"end": 495.36,
"clock": "12:08:10",
"text": "あるいはこの間の私の答弁の関係のやつだったんですね。"
},
{
"file": "seg_015.ts",
"start": 495.36,
"end": 498.86,
"clock": "12:08:15",
"text": "今日はちょっと通告をしてませんので、"
},
{
"file": "seg_015.ts",
"start": 498.86,
"end": 500.36,
"clock": "12:08:18",
"text": "質問をしませんが、"
},
{
"file": "seg_015.ts",
"start": 500.36,
"end": 505.66,
"clock": "12:08:20",
"text": "結局、輸出補助金と言われるこの、"
},
{
"file": "seg_015.ts",
"start": 505.66,
"end": 508.56,
"clock": "12:08:25",
"text": "勘補金という認識は、"
},
{
"file": "seg_015.ts",
"start": 508.56,
"end": 510.36,
"clock": "12:08:28",
"text": "まずは院と一緒なんですよね。"
},
{
"file": "seg_015.ts",
"start": 510.36,
"end": 513.36,
"clock": "12:08:30",
"text": "で、その諸外国の、"
},
{
"file": "seg_015.ts",
"start": 513.36,
"end": 516.36,
"clock": "12:08:33",
"text": "もうやってるからというふうにおっしゃいましたけど、"
},
{
"file": "seg_015.ts",
"start": 516.36,
"end": 520.36,
"clock": "12:08:36",
"text": "その諸外国のその負荷値税と、"
},
{
"file": "seg_015.ts",
"start": 520.36,
"end": 522.36,
"clock": "12:08:40",
"text": "日本の消費税の、"
},
{
"file": "seg_015.ts",
"start": 522.36,
"end": 525.36,
"clock": "12:08:42",
"text": "その聴取の仕方だったりとかね、"
},
{
"file": "seg_015.ts",
"start": 525.36,
"end": 526.36,
"clock": "12:08:45",
"text": "何が言いたいかというと、"
},
{
"file": "seg_015.ts",
"start": 526.36,
"end": 528.36,
"clock": "12:08:46",
"text": "一つ例を挙げれば、"
},
{
"file": "seg_015.ts",
"start": 528.36,
"end": 531.36,
"clock": "12:08:48",
"text": "レジを打って、"
},
{
"file": "seg_015.ts",
"start": 531.36,
"end": 534.36,
"clock": "12:08:51",
"text": "そこに確実に消費税分、"
},
{
"file": "seg_015.ts",
"start": 534.36,
"end": 539.36,
"clock": "12:08:54",
"text": "負荷値税分がポンと出てくるようなレジが、"
},
{
"file": "seg_015.ts",
"start": 539.36,
"end": 541.36,
"clock": "12:08:59",
"text": "国とつながってればね、"
},
{
"file": "seg_015.ts",
"start": 541.36,
"end": 545.36,
"clock": "12:09:01",
"text": "そういった税金なんと価格なんていうのは、"
},
{
"file": "seg_015.ts",
"start": 545.36,
"end": 548.36,
"clock": "12:09:05",
"text": "必ず明快に把握できるわけですよね。"
},
{
"file": "seg_015.ts",
"start": 548.36,
"end": 553.36,
"clock": "12:09:08",
"text": "ところが、本当は内税であったりとか、"
},
{
"file": "seg_015.ts",
"start": 553.36,
"end": 556.36,
"clock": "12:09:13",
"text": "その税の位置付けというか、"
},
{
"file": "seg_015.ts",
"start": 556.36,
"end": 559.36,
"clock": "12:09:16",
"text": "その数字とかが合前で、"
},
{
"file": "seg_015.ts",
"start": 559.36,
"end": 562.36,
"clock": "12:09:19",
"text": "後で深刻するみたいなような制度だと、"
},
{
"file": "seg_015.ts",
"start": 562.36,
"end": 564.36,
"clock": "12:09:22",
"text": "その消費税として本当に、"
},
{
"file": "seg_015.ts",
"start": 564.36,
"end": 566.36,
"clock": "12:09:24",
"text": "払っているのかとか、"
},
{
"file": "seg_015.ts",
"start": 566.36,
"end": 568.36,
"clock": "12:09:26",
"text": "預かっているのかとか、"
},
{
"file": "seg_015.ts",
"start": 568.36,
"end": 572.36,
"clock": "12:09:28",
"text": "色々みんなが混乱するようなこともない。"
},
{
"file": "seg_015.ts",
"start": 572.36,
"end": 575.36,
"clock": "12:09:32",
"text": "このちょうど財務省とレクをしているときに、"
},
{
"file": "seg_015.ts",
"start": 575.36,
"end": 580.36,
"clock": "12:09:35",
"text": "台湾なんかはそういうレジがあって、"
},
{
"file": "seg_015.ts",
"start": 580.36,
"end": 583.36,
"clock": "12:09:40",
"text": "レジを必ず通せば、"
},
{
"file": "seg_015.ts",
"start": 583.36,
"end": 586.36,
"clock": "12:09:43",
"text": "それが政府必ず繋がると。"
},
{
"file": "seg_015.ts",
"start": 586.36,
"end": 588.36,
"clock": "12:09:46",
"text": "それをやらないって、"
},
{
"file": "seg_015.ts",
"start": 588.36,
"end": 590.36,
"clock": "12:09:48",
"text": "レジを打たないということは、"
},
{
"file": "seg_015.ts",
"start": 590.36,
"end": 593.36,
"clock": "12:09:50",
"text": "これはもう脱税なんだというのが明快だと。"
},
{
"file": "seg_015.ts",
"start": 593.36,
"end": 595.36,
"clock": "12:09:53",
"text": "そのレシートには宝くじがついてて、"
},
{
"file": "seg_015.ts",
"start": 595.36,
"end": 598.36,
"clock": "12:09:55",
"text": "必ず消費者はレシートくれ、"
},
{
"file": "seg_015.ts",
"start": 598.36,
"end": 601.36,
"clock": "12:09:58",
"text": "という風に言うから非常に…"
}
]