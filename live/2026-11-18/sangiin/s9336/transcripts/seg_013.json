[
{
"file": "seg_013.ts",
"start": 0.0,
"end": 5.28,
"clock": "11:40:00",
"text": "消化できておりませんけれども、 引き続き産生党は経済成長のための"
},
{
"file": "seg_013.ts",
"start": 5.28,
"end": 12.38,
"clock": "11:40:05",
"text": "厳税ということで消費税一日率厳税を お呼び廃止をお願いして、"
},
{
"file": "seg_013.ts",
"start": 12.38,
"end": 37.4,
"clock": "11:40:12",
"text": "この質問を終わらせていただきます。 ありがとうございました。"
},
{
"file": "seg_013.ts",
"start": 37.4,
"end": 41.4,
"clock": "11:40:37",
"text": "大盟御司君"
},
{
"file": "seg_013.ts",
"start": 41.4,
"end": 47.5,
"clock": "11:40:41",
"text": "日本共産党の大盟御司です。 本題に入る前にお時間をいただきまして、"
},
{
"file": "seg_013.ts",
"start": 47.5,
"end": 54.5,
"clock": "11:40:47",
"text": "世紀文化大臣の政治資金パーティー問題について、 資料提出がこの本委員会の"
},
{
"file": "seg_013.ts",
"start": 54.5,
"end": 61.14,
"clock": "11:40:54",
"text": "理事会協議にもなっておりますし、 また新しい事実が判明いたしましたので、"
},
{
"file": "seg_013.ts",
"start": 61.14,
"end": 67.02,
"clock": "11:41:01",
"text": "事実確認だけさせていただきたいと思います。 計算省に聞きます。"
},
{
"file": "seg_013.ts",
"start": 67.02,
"end": 77.46,
"clock": "11:41:07",
"text": "2024年3月10日午後6時半からホテルルポール工事町3回アクアマリンにおいて"
},
{
"file": "seg_013.ts",
"start": 77.46,
"end": 87.46,
"clock": "11:41:17",
"text": "開催された石山の政治資金パーティーに、 当時の計算省の売用関係担当ですかね、"
},
{
"file": "seg_013.ts",
"start": 87.46,
"end": 95.06,
"clock": "11:41:27",
"text": "生物化学産業課長さん出席していたと思いますが、 どうですか。"
},
{
"file": "seg_013.ts",
"start": 95.06,
"end": 100.26,
"clock": "11:41:35",
"text": "片岡公一郎経済産業省大臣官房長"
},
{
"file": "seg_013.ts",
"start": 100.26,
"end": 106.58,
"clock": "11:41:40",
"text": "お答え申し上げます。当時、石義議員事務所から 当初の省務情報政策局、"
},
{
"file": "seg_013.ts",
"start": 106.58,
"end": 113.58,
"clock": "11:41:46",
"text": "生物化学産業課長宛に依頼があったことを受けまして、 当該課長は政治資金パーティーとの認識はなく、"
},
{
"file": "seg_013.ts",
"start": 113.58,
"end": 119.14,
"clock": "11:41:53",
"text": "一般的な政策の説明として、 徒所省事務である売用産業の信仰にかかる"
},
{
"file": "seg_013.ts",
"start": 119.14,
"end": 125.02,
"clock": "11:41:59",
"text": "政策等について説明をいたしまして、 出議事の後に退席したと承知してございます。"
},
{
"file": "seg_013.ts",
"start": 125.62,
"end": 127.02,
"clock": "11:42:05",
"text": "大門美希君"
},
{
"file": "seg_013.ts",
"start": 127.02,
"end": 132.02,
"clock": "11:42:07",
"text": "今あった取执職されたと、 厚労省だけじゃなく、"
},
{
"file": "seg_013.ts",
"start": 132.02,
"end": 139.02,
"clock": "11:42:12",
"text": "計算省の課長も、 積算の政治資金パーティーに呼ばれていたということでございます。"
},
{
"file": "seg_013.ts",
"start": 139.02,
"end": 146.02,
"clock": "11:42:19",
"text": "政治資金パーティーとは知らなかった、 政策の説明だった、大臣にお聞きいたしますけれども、"
},
{
"file": "seg_013.ts",
"start": 146.02,
"end": 152.22,
"clock": "11:42:26",
"text": "これから大事な小説の質問がありますので、 完結にお願いしたいと思いますが、"
},
{
"file": "seg_013.ts",
"start": 152.22,
"end": 161.22,
"clock": "11:42:32",
"text": "なぜ厚労省課長も、計算省の課長も、 御本人に政治資金パーティーということを知らせないで、"
},
{
"file": "seg_013.ts",
"start": 161.22,
"end": 165.22,
"clock": "11:42:41",
"text": "大臣は呼ばれたんですか? なぜ呼ばれたんですか?"
},
{
"file": "seg_013.ts",
"start": 165.22,
"end": 169.22,
"clock": "11:42:45",
"text": "世紀吉平門部科学大臣"
},
{
"file": "seg_013.ts",
"start": 169.22,
"end": 177.22,
"clock": "11:42:49",
"text": "はい、経済産業所の担当者から、 庁小事務であるバイオ産業の信仰にかかります、"
},
{
"file": "seg_013.ts",
"start": 177.22,
"end": 182.22,
"clock": "11:42:57",
"text": "政策の説明をしていただくために 来ていただいたわけでございますが、"
},
{
"file": "seg_013.ts",
"start": 182.22,
"end": 187.22,
"clock": "11:43:02",
"text": "当時経済産業所に対しまして、 介護の趣旨についての伝え方が"
},
{
"file": "seg_013.ts",
"start": 187.22,
"end": 192.22,
"clock": "11:43:07",
"text": "十分でなかった可能性がございました。 その点は大変申し訳なく思っております。"
},
{
"file": "seg_013.ts",
"start": 192.22,
"end": 194.22,
"clock": "11:43:12",
"text": "大門美希君"
},
{
"file": "seg_013.ts",
"start": 194.22,
"end": 201.22,
"clock": "11:43:14",
"text": "まず事実確認をさせてもらいますが、 その3月11日の参加者は何人で、"
},
{
"file": "seg_013.ts",
"start": 201.22,
"end": 205.22,
"clock": "11:43:21",
"text": "どういう人たちが参加されましたか?"
},
{
"file": "seg_013.ts",
"start": 205.22,
"end": 210.56,
"clock": "11:43:25",
"text": "世紀門部科学大臣"
},
{
"file": "seg_013.ts",
"start": 210.56,
"end": 218.56,
"clock": "11:43:30",
"text": "はい、この3月の会でございます。 私が経済産業所に、"
},
{
"file": "seg_013.ts",
"start": 218.56,
"end": 227.56,
"clock": "11:43:38",
"text": "政策説明を依頼した2024年3月の会合でございますが、 委員からの議念付職をいたしますために、"
},
{
"file": "seg_013.ts",
"start": 227.56,
"end": 236.56,
"clock": "11:43:47",
"text": "豪志寺議員の皆様のどういう意図で 販売したパーティー券の金額購入人数とか、"
},
{
"file": "seg_013.ts",
"start": 236.56,
"end": 246.56,
"clock": "11:43:56",
"text": "当時の参加人数の件でございますが、 金額は九万円で当日のおよび当日の"
},
{
"file": "seg_013.ts",
"start": 246.56,
"end": 249.56,
"clock": "11:44:06",
"text": "参加人数は11人でございました。"
},
{
"file": "seg_013.ts",
"start": 249.56,
"end": 251.56,
"clock": "11:44:09",
"text": "大門美希君"
},
{
"file": "seg_013.ts",
"start": 251.56,
"end": 257.56,
"clock": "11:44:11",
"text": "まず事実確認させていただきます。 私たちの入職者差し寄りを得るのに、"
},
{
"file": "seg_013.ts",
"start": 257.56,
"end": 264.56,
"clock": "11:44:17",
"text": "3月11日のパーティーには7人。 工労者は呼ばれた6月13日の"
},
{
"file": "seg_013.ts",
"start": 264.56,
"end": 268.56,
"clock": "11:44:24",
"text": "銀会館のパーティーに参加したのは9人ということですよね。"
},
{
"file": "seg_013.ts",
"start": 268.56,
"end": 276.56,
"clock": "11:44:28",
"text": "一部て日本バイオテク協会の幹部の企業の代表の方々だったと思いますが、"
},
{
"file": "seg_013.ts",
"start": 276.56,
"end": 278.56,
"clock": "11:44:36",
"text": "いかがですか。"
},
{
"file": "seg_013.ts",
"start": 278.56,
"end": 283.16,
"clock": "11:44:38",
"text": "石木門部科学大臣"
},
{
"file": "seg_013.ts",
"start": 283.16,
"end": 286.16,
"clock": "11:44:43",
"text": "バイオ関係者の企業でございました。"
},
{
"file": "seg_013.ts",
"start": 286.16,
"end": 288.16,
"clock": "11:44:46",
"text": "大門美希君"
},
{
"file": "seg_013.ts",
"start": 288.16,
"end": 291.16,
"clock": "11:44:48",
"text": "先ほどのニューグするのは、"
},
{
"file": "seg_013.ts",
"start": 291.16,
"end": 297.16,
"clock": "11:44:51",
"text": "さっきの話で戻りますが、なぜ工労者の課長にも、 計算者の課長にも、"
},
{
"file": "seg_013.ts",
"start": 297.16,
"end": 300.16,
"clock": "11:44:57",
"text": "そういう集まりであって、 政治金パーティーということを"
},
{
"file": "seg_013.ts",
"start": 300.16,
"end": 305.16,
"clock": "11:45:00",
"text": "伝えなかったのはまずかったじゃなくて、 意図的に伝えないで隠されて、"
},
{
"file": "seg_013.ts",
"start": 305.16,
"end": 309.16,
"clock": "11:45:05",
"text": "そうしないと呼べなかったんじゃないですか。 いかがですか。"
},
{
"file": "seg_013.ts",
"start": 309.16,
"end": 312.16,
"clock": "11:45:09",
"text": "石木門部科学大臣"
},
{
"file": "seg_013.ts",
"start": 313.16,
"end": 319.16,
"clock": "11:45:13",
"text": "介護の趣旨について、 施され方が十分でなかった点は、"
},
{
"file": "seg_013.ts",
"start": 319.16,
"end": 324.16,
"clock": "11:45:19",
"text": "その点は私も今、大変申し訳なく思っておりますが、"
},
{
"file": "seg_013.ts",
"start": 324.16,
"end": 329.16,
"clock": "11:45:24",
"text": "いわゆる政策等についての説明ということでございまして、"
},
{
"file": "seg_013.ts",
"start": 329.16,
"end": 332.16,
"clock": "11:45:29",
"text": "それに関します失業等でございまして、"
},
{
"file": "seg_013.ts",
"start": 332.16,
"end": 336.16,
"clock": "11:45:32",
"text": "それが終わりましたら再生されたという形を持っております。"
},
{
"file": "seg_013.ts",
"start": 336.16,
"end": 338.16,
"clock": "11:45:36",
"text": "大門美希君"
},
{
"file": "seg_013.ts",
"start": 338.16,
"end": 342.16,
"clock": "11:45:38",
"text": "この問題はやるわけが事実確認をさせていただきますが、"
},
{
"file": "seg_013.ts",
"start": 342.16,
"end": 348.16,
"clock": "11:45:42",
"text": "この時のルポールの時の収入は、 政治式報告書によりますと、"
},
{
"file": "seg_013.ts",
"start": 348.16,
"end": 351.16,
"clock": "11:45:48",
"text": "九十六万円になっております。"
},
{
"file": "seg_013.ts",
"start": 351.16,
"end": 353.16,
"clock": "11:45:51",
"text": "と記載されていますよね。"
},
{
"file": "seg_013.ts",
"start": 353.16,
"end": 357.16,
"clock": "11:45:53",
"text": "私たちが入手した参加者名前は、 七人です。"
},
{
"file": "seg_013.ts",
"start": 357.16,
"end": 361.16,
"clock": "11:45:57",
"text": "九十六万円、七人で割り切れません。"
},
{
"file": "seg_013.ts",
"start": 361.16,
"end": 366.16,
"clock": "11:46:01",
"text": "十三万、七千百四十二円ということで、"
},
{
"file": "seg_013.ts",
"start": 366.16,
"end": 370.16,
"clock": "11:46:06",
"text": "これは本当にパーティーの一人当たりの 回避だったんですか。"
},
{
"file": "seg_013.ts",
"start": 370.16,
"end": 374.16,
"clock": "11:46:10",
"text": "責任、文部科学大臣"
},
{
"file": "seg_013.ts",
"start": 374.16,
"end": 377.16,
"clock": "11:46:14",
"text": "参加された方につきましては、"
},
{
"file": "seg_013.ts",
"start": 377.16,
"end": 381.16,
"clock": "11:46:17",
"text": "同じ会社の中の社員さんとかを連れてこられる方とかいらっしゃいますから、"
},
{
"file": "seg_013.ts",
"start": 381.16,
"end": 384.16,
"clock": "11:46:21",
"text": "代表者以外の方も連れてこられる方もいらっしゃいますから、"
},
{
"file": "seg_013.ts",
"start": 384.16,
"end": 387.16,
"clock": "11:46:24",
"text": "人数にしましてはその人数ではございません。"
},
{
"file": "seg_013.ts",
"start": 387.16,
"end": 389.16,
"clock": "11:46:27",
"text": "大門美希君"
},
{
"file": "seg_013.ts",
"start": 389.16,
"end": 392.16,
"clock": "11:46:29",
"text": "ルポールの時の回避は一人いくらだったんですか。"
},
{
"file": "seg_013.ts",
"start": 392.16,
"end": 395.16,
"clock": "11:46:32",
"text": "責任、文部科学大臣"
},
{
"file": "seg_013.ts",
"start": 396.16,
"end": 399.16,
"clock": "11:46:36",
"text": "基本的には急になんですが、途中で体積されたり、"
},
{
"file": "seg_013.ts",
"start": 399.16,
"end": 403.16,
"clock": "11:46:39",
"text": "聞きたい項目を終わったら仕事のために 帰ったりする方がいらっしゃいますから、"
},
{
"file": "seg_013.ts",
"start": 403.16,
"end": 406.16,
"clock": "11:46:43",
"text": "基本的には一人九万円なんですけれども、"
},
{
"file": "seg_013.ts",
"start": 406.16,
"end": 409.16,
"clock": "11:46:46",
"text": "そういうふうな数字が上がっていると思います。"
},
{
"file": "seg_013.ts",
"start": 409.16,
"end": 411.16,
"clock": "11:46:49",
"text": "大門美希君"
},
{
"file": "seg_013.ts",
"start": 411.16,
"end": 414.16,
"clock": "11:46:51",
"text": "私、ここがポイントだと思うんですけれども、"
},
{
"file": "seg_013.ts",
"start": 414.16,
"end": 421.16,
"clock": "11:46:54",
"text": "実はもう一回この政権バイオホーラムの 政治式にパートをやっていらっしゃいますが、"
},
{
"file": "seg_013.ts",
"start": 421.16,
"end": 427.16,
"clock": "11:47:01",
"text": "その時はですね、収入が七十二万で、 参加者七人、"
},
{
"file": "seg_013.ts",
"start": 427.16,
"end": 431.16,
"clock": "11:47:07",
"text": "これも一人当たりにすると、 発数が出て割り切れません。"
},
{
"file": "seg_013.ts",
"start": 431.16,
"end": 436.16,
"clock": "11:47:11",
"text": "それで私たち赤畑の取材によりますと、 出席企業に聞きますと、"
},
{
"file": "seg_013.ts",
"start": 436.16,
"end": 440.16,
"clock": "11:47:16",
"text": "一回一回のパーティーの会ではなくて、 年回避的なもので、"
},
{
"file": "seg_013.ts",
"start": 440.16,
"end": 443.16,
"clock": "11:47:20",
"text": "収めていたということあるわけですね。"
},
{
"file": "seg_013.ts",
"start": 443.16,
"end": 446.16,
"clock": "11:47:23",
"text": "これが実は正しいんじゃないですか。"
},
{
"file": "seg_013.ts",
"start": 446.16,
"end": 450.16,
"clock": "11:47:26",
"text": "その時に一人いくらという、 割り切った数字を集めていることにならないんじゃないですか。"
},
{
"file": "seg_013.ts",
"start": 453.05,
"end": 455.05,
"clock": "11:47:33",
"text": "関門部科学大臣"
},
{
"file": "seg_013.ts",
"start": 455.05,
"end": 459.05,
"clock": "11:47:35",
"text": "先ほどの答弁の分を補足したおきますが、"
},
{
"file": "seg_013.ts",
"start": 459.05,
"end": 464.05,
"clock": "11:47:39",
"text": "3月の介護の月ましては参加費は九万円ですが、 実際に途中3回、"
},
{
"file": "seg_013.ts",
"start": 464.05,
"end": 466.05,
"clock": "11:47:44",
"text": "中指された方がいらっしゃいます。"
},
{
"file": "seg_013.ts",
"start": 466.05,
"end": 473.05,
"clock": "11:47:46",
"text": "これを勘案して、厳格者参加者が3名いて、 全体としては九十六万という形にはなっております。"
},
{
"file": "seg_013.ts",
"start": 473.05,
"end": 478.05,
"clock": "11:47:53",
"text": "また、その寄付というふうなお話がい ばございました。"
},
{
"file": "seg_013.ts",
"start": 478.05,
"end": 481.05,
"clock": "11:47:58",
"text": "いわゆる、これはですね、"
},
{
"file": "seg_013.ts",
"start": 481.05,
"end": 484.05,
"clock": "11:48:01",
"text": "2024年の3月の介護では、"
},
{
"file": "seg_013.ts",
"start": 484.05,
"end": 487.05,
"clock": "11:48:04",
"text": "バイオテクノロジーに関する意見効果を 行うものでございまして、"
},
{
"file": "seg_013.ts",
"start": 487.05,
"end": 492.05,
"clock": "11:48:07",
"text": "政策の説明をしていただいたと 対策されたことでございますけれども、"
},
{
"file": "seg_013.ts",
"start": 492.05,
"end": 496.05,
"clock": "11:48:12",
"text": "この寄付には当たらないと思っております。"
},
{
"file": "seg_013.ts",
"start": 496.05,
"end": 498.05,
"clock": "11:48:16",
"text": "それはその理由としましては、"
},
{
"file": "seg_013.ts",
"start": 498.05,
"end": 502.05,
"clock": "11:48:18",
"text": "いわゆる、一回一回の開催にさして、"
},
{
"file": "seg_013.ts",
"start": 502.05,
"end": 506.05,
"clock": "11:48:22",
"text": "ご連絡をさせていただいて、 回避はそのような金額だということで、"
},
{
"file": "seg_013.ts",
"start": 506.05,
"end": 510.05,
"clock": "11:48:26",
"text": "通知を一回一回させていただいて、 年間費という形ではございません。"
},
{
"file": "seg_013.ts",
"start": 510.05,
"end": 514.05,
"clock": "11:48:30",
"text": "また、政治資金規制法によりますと、"
},
{
"file": "seg_013.ts",
"start": 514.05,
"end": 520.05,
"clock": "11:48:34",
"text": "寄付とミナスと期待されております内容の つきましては、当費、または回避とは、"
},
{
"file": "seg_013.ts",
"start": 520.05,
"end": 523.05,
"clock": "11:48:40",
"text": "その定義は政治団体の当速企約、"
},
{
"file": "seg_013.ts",
"start": 523.05,
"end": 528.05,
"clock": "11:48:43",
"text": "そのたこりらの相当するものに基づく 金銭上の財務の利口としての当該政治団体の"
},
{
"file": "seg_013.ts",
"start": 528.05,
"end": 532.05,
"clock": "11:48:48",
"text": "厚生員が負担するものとされている ところでございます。"
},
{
"file": "seg_013.ts",
"start": 532.05,
"end": 537.05,
"clock": "11:48:52",
"text": "一方で、当該会議会議員のおよそ3か社が 支払った3か日というのは、"
},
{
"file": "seg_013.ts",
"start": 537.05,
"end": 540.05,
"clock": "11:48:57",
"text": "政治機制法上の局には当らないと認識して、"
},
{
"file": "seg_013.ts",
"start": 540.05,
"end": 544.05,
"clock": "11:49:00",
"text": "一回一回通知をして、金額を迷宮して 通知をさせていただいているところでございます。"
},
{
"file": "seg_013.ts",
"start": 544.05,
"end": 546.05,
"clock": "11:49:04",
"text": "大門美希君。"
},
{
"file": "seg_013.ts",
"start": 546.05,
"end": 552.05,
"clock": "11:49:06",
"text": "だったら、活命委員も理事会で 協議ということになりますが、"
},
{
"file": "seg_013.ts",
"start": 552.05,
"end": 558.05,
"clock": "11:49:12",
"text": "もっと詳しい事ですね、参加人数と、 正式な参加人数と出していただかないと、"
},
{
"file": "seg_013.ts",
"start": 558.05,
"end": 561.05,
"clock": "11:49:18",
"text": "もう一回全部発数が出るんですよ。"
},
{
"file": "seg_013.ts",
"start": 561.05,
"end": 564.05,
"clock": "11:49:21",
"text": "正式の参加者名簿をこちらもっているんですよ。"
},
{
"file": "seg_013.ts",
"start": 564.05,
"end": 569.05,
"clock": "11:49:24",
"text": "その後から人数で合わせて、一人回比9万円とか つうのは、"
},
{
"file": "seg_013.ts",
"start": 569.05,
"end": 573.05,
"clock": "11:49:29",
"text": "後から作ったような疑いが非常に濃いわけでありますので、"
},
{
"file": "seg_013.ts",
"start": 573.05,
"end": 576.05,
"clock": "11:49:33",
"text": "資料を出してもらいたいと思います。"
},
{
"file": "seg_013.ts",
"start": 576.05,
"end": 580.05,
"clock": "11:49:36",
"text": "申し上げたように、このオーパーティー 3回やられているんですけど、"
},
{
"file": "seg_013.ts",
"start": 580.05,
"end": 588.05,
"clock": "11:49:40",
"text": "日本バイオ的協会の幹部企業の中心になる企業の"
},
{
"file": "seg_013.ts",
"start": 588.05,
"end": 590.05,
"clock": "11:49:48",
"text": "大正座の方ばかりです。"
},
{
"file": "seg_013.ts",
"start": 590.05,
"end": 594.05,
"clock": "11:49:50",
"text": "大臣はこの日本バイオ的協会とは どういう関係ですか。"
},
{
"file": "seg_013.ts",
"start": 595.05,
"end": 598.05,
"clock": "11:49:55",
"text": "責任、文部科学大臣。"
}
]