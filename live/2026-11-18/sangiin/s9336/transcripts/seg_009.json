[
{
"file": "seg_009.ts",
"start": 0.34,
"end": 8.3,
"clock": "11:00:00",
"text": "振動金福庫財務副大臣お答えいたします"
},
{
"file": "seg_009.ts",
"start": 8.3,
"end": 11.28,
"clock": "11:00:08",
"text": "先ほど片山大臣からも答弁があったとおり"
},
{
"file": "seg_009.ts",
"start": 11.28,
"end": 14.04,
"clock": "11:00:11",
"text": "WT保存金協定におきましても"
},
{
"file": "seg_009.ts",
"start": 14.04,
"end": 15.64,
"clock": "11:00:14",
"text": "御指摘の消費税の幹部は"
},
{
"file": "seg_009.ts",
"start": 15.64,
"end": 19.48,
"clock": "11:00:15",
"text": "輸出補助金にわたらないこととされているところであります"
},
{
"file": "seg_009.ts",
"start": 19.48,
"end": 21.8,
"clock": "11:00:19",
"text": "なお御指摘の中国の増地税"
},
{
"file": "seg_009.ts",
"start": 21.8,
"end": 24.78,
"clock": "11:00:21",
"text": "これは我が国の消費税にあたるわけでございますが"
},
{
"file": "seg_009.ts",
"start": 24.78,
"end": 28.28,
"clock": "11:00:24",
"text": "この増地税は輸出には課税されず"
},
{
"file": "seg_009.ts",
"start": 28.28,
"end": 31.4,
"clock": "11:00:28",
"text": "輸出事業者が深刻に寄りし入れ時に"
},
{
"file": "seg_009.ts",
"start": 31.4,
"end": 34.24,
"clock": "11:00:31",
"text": "支払った増地税の幹部を置けることが"
},
{
"file": "seg_009.ts",
"start": 34.24,
"end": 36.24,
"clock": "11:00:34",
"text": "制度上可能となっておりまして"
},
{
"file": "seg_009.ts",
"start": 36.24,
"end": 39.18,
"clock": "11:00:36",
"text": "その際幹部率が産業政策の一環として"
},
{
"file": "seg_009.ts",
"start": 39.18,
"end": 42.4,
"clock": "11:00:39",
"text": "調整されているものと承知しているところであります"
},
{
"file": "seg_009.ts",
"start": 42.4,
"end": 44.8,
"clock": "11:00:42",
"text": "その上で我が国において"
},
{
"file": "seg_009.ts",
"start": 44.8,
"end": 47.8,
"clock": "11:00:44",
"text": "御指摘のような措置を思けるとした場合"
},
{
"file": "seg_009.ts",
"start": 47.8,
"end": 51.0,
"clock": "11:00:47",
"text": "新たに輸出免税にかかる幹部金額を"
},
{
"file": "seg_009.ts",
"start": 51.0,
"end": 52.9,
"clock": "11:00:51",
"text": "切り分けて深刻いただくことが"
},
{
"file": "seg_009.ts",
"start": 52.9,
"end": 54.2,
"clock": "11:00:52",
"text": "必要になりますが"
},
{
"file": "seg_009.ts",
"start": 54.2,
"end": 59.3,
"clock": "11:00:54",
"text": "例えば輸出取引と国内取引とに共通して用した"
},
{
"file": "seg_009.ts",
"start": 59.3,
"end": 61.0,
"clock": "11:00:59",
"text": "費用につきまして"
},
{
"file": "seg_009.ts",
"start": 61.0,
"end": 64.2,
"clock": "11:01:01",
"text": "どこまでが輸出分に対応する資入れなのか"
},
{
"file": "seg_009.ts",
"start": 64.2,
"end": 66.6,
"clock": "11:01:04",
"text": "実態に即して合理的かつ明確に"
},
{
"file": "seg_009.ts",
"start": 66.6,
"end": 69.0,
"clock": "11:01:06",
"text": "切り分けることは困難であるといった"
},
{
"file": "seg_009.ts",
"start": 69.0,
"end": 71.2,
"clock": "11:01:09",
"text": "課題があると考えているところであります"
},
{
"file": "seg_009.ts",
"start": 71.2,
"end": 74.6,
"clock": "11:01:11",
"text": "また仮に輸出事業者への幹部を原学者買い"
},
{
"file": "seg_009.ts",
"start": 74.6,
"end": 77.1,
"clock": "11:01:14",
"text": "輸出事業者は資入れ時にしあらった"
},
{
"file": "seg_009.ts",
"start": 77.1,
"end": 80.1,
"clock": "11:01:17",
"text": "消費税額を一部回収することができなくなり"
},
{
"file": "seg_009.ts",
"start": 80.1,
"end": 82.6,
"clock": "11:01:20",
"text": "国内取引のみを行う事業者や"
},
{
"file": "seg_009.ts",
"start": 82.6,
"end": 85.1,
"clock": "11:01:22",
"text": "原学されない仕組みを持つ多国の"
},
{
"file": "seg_009.ts",
"start": 85.1,
"end": 88.7,
"clock": "11:01:25",
"text": "事業者に比べて競争上不利になってしまいます"
},
{
"file": "seg_009.ts",
"start": 88.7,
"end": 90.8,
"clock": "11:01:28",
"text": "このような輸出事業者への幹部は"
},
{
"file": "seg_009.ts",
"start": 90.8,
"end": 92.8,
"clock": "11:01:30",
"text": "公平な競争環境を維持するために"
},
{
"file": "seg_009.ts",
"start": 92.8,
"end": 94.3,
"clock": "11:01:32",
"text": "必要な仕組みであり"
},
{
"file": "seg_009.ts",
"start": 94.3,
"end": 96.2,
"clock": "11:01:34",
"text": "税制つびき対象ではないというふうに"
},
{
"file": "seg_009.ts",
"start": 96.2,
"end": 97.2,
"clock": "11:01:36",
"text": "考えております"
},
{
"file": "seg_009.ts",
"start": 97.2,
"end": 100.5,
"clock": "11:01:37",
"text": "その上で消費税は社会保障の財源として"
},
{
"file": "seg_009.ts",
"start": 100.5,
"end": 103.7,
"clock": "11:01:40",
"text": "活用され社会保障給付という形で"
},
{
"file": "seg_009.ts",
"start": 103.7,
"end": 105.9,
"clock": "11:01:43",
"text": "家計に還元されていますので"
},
{
"file": "seg_009.ts",
"start": 105.9,
"end": 107.9,
"clock": "11:01:45",
"text": "仮に一律に厳税した場合"
},
{
"file": "seg_009.ts",
"start": 107.9,
"end": 110.2,
"clock": "11:01:47",
"text": "年金医療介護消止方釈という"
},
{
"file": "seg_009.ts",
"start": 110.2,
"end": 112.0,
"clock": "11:01:50",
"text": "国民の皆様の暮らしに"
},
{
"file": "seg_009.ts",
"start": 112.0,
"end": 113.8,
"clock": "11:01:52",
"text": "不可欠かかる行政サービスにも"
},
{
"file": "seg_009.ts",
"start": 113.8,
"end": 117.0,
"clock": "11:01:53",
"text": "影響がでかないわけであります"
},
{
"file": "seg_009.ts",
"start": 117.0,
"end": 119.4,
"clock": "11:01:57",
"text": "このため消費税の一律厳税は"
},
{
"file": "seg_009.ts",
"start": 119.4,
"end": 122.6,
"clock": "11:01:59",
"text": "適正ではないと考えているところであります"
},
{
"file": "seg_009.ts",
"start": 122.6,
"end": 124.4,
"clock": "11:02:02",
"text": "松田真奈部君"
},
{
"file": "seg_009.ts",
"start": 124.4,
"end": 126.9,
"clock": "11:02:04",
"text": "予想されたところです"
},
{
"file": "seg_009.ts",
"start": 126.9,
"end": 131.1,
"clock": "11:02:06",
"text": "次に消費税"
},
{
"file": "seg_009.ts",
"start": 131.1,
"end": 132.6,
"clock": "11:02:11",
"text": "消費減税で"
},
{
"file": "seg_009.ts",
"start": 132.6,
"end": 134.4,
"clock": "11:02:12",
"text": "食品科学はどの程度下がるのか"
},
{
"file": "seg_009.ts",
"start": 134.4,
"end": 137.1,
"clock": "11:02:14",
"text": "という議論がなされていますが"
},
{
"file": "seg_009.ts",
"start": 137.1,
"end": 139.0,
"clock": "11:02:17",
"text": "価格決定はそもそも先ほど申したように"
},
{
"file": "seg_009.ts",
"start": 139.0,
"end": 142.0,
"clock": "11:02:19",
"text": "事業者の経営判断ですので"
},
{
"file": "seg_009.ts",
"start": 142.0,
"end": 143.7,
"clock": "11:02:22",
"text": "特に全般的に物価上昇で"
},
{
"file": "seg_009.ts",
"start": 143.7,
"end": 145.3,
"clock": "11:02:23",
"text": "コストが上がっている時に"
},
{
"file": "seg_009.ts",
"start": 145.3,
"end": 147.2,
"clock": "11:02:25",
"text": "実際にどのような価格設定行動が"
},
{
"file": "seg_009.ts",
"start": 147.2,
"end": 150.7,
"clock": "11:02:27",
"text": "なされるか不当面が多いと思います"
},
{
"file": "seg_009.ts",
"start": 150.7,
"end": 153.2,
"clock": "11:02:30",
"text": "高知総理は食料品のみの消費税減税を"
},
{
"file": "seg_009.ts",
"start": 153.2,
"end": 154.1,
"clock": "11:02:33",
"text": "行われた場合"
},
{
"file": "seg_009.ts",
"start": 154.1,
"end": 157.0,
"clock": "11:02:34",
"text": "店の風評にかかるということを"
},
{
"file": "seg_009.ts",
"start": 157.0,
"end": 158.6,
"clock": "11:02:37",
"text": "発言されていますが"
},
{
"file": "seg_009.ts",
"start": 158.6,
"end": 161.3,
"clock": "11:02:38",
"text": "そもそも食品の価格弾力性"
},
{
"file": "seg_009.ts",
"start": 161.3,
"end": 162.8,
"clock": "11:02:41",
"text": "これは他の品目に比べると"
},
{
"file": "seg_009.ts",
"start": 162.8,
"end": 164.6,
"clock": "11:02:42",
"text": "決して高くないわけで"
},
{
"file": "seg_009.ts",
"start": 164.6,
"end": 167.0,
"clock": "11:02:44",
"text": "例えば価格が1%上がった時の"
},
{
"file": "seg_009.ts",
"start": 167.0,
"end": 168.4,
"clock": "11:02:47",
"text": "売上減少幅については"
},
{
"file": "seg_009.ts",
"start": 168.4,
"end": 170.3,
"clock": "11:02:48",
"text": "食品はマイナス2%から"
},
{
"file": "seg_009.ts",
"start": 170.3,
"end": 172.1,
"clock": "11:02:50",
"text": "マイナス3.5%"
},
{
"file": "seg_009.ts",
"start": 172.1,
"end": 174.1,
"clock": "11:02:52",
"text": "それ以外の品目はマイナス4%から"
},
{
"file": "seg_009.ts",
"start": 174.1,
"end": 175.5,
"clock": "11:02:54",
"text": "マイナス7%程度と"
},
{
"file": "seg_009.ts",
"start": 175.5,
"end": 177.1,
"clock": "11:02:55",
"text": "一産もありまして"
},
{
"file": "seg_009.ts",
"start": 177.1,
"end": 178.5,
"clock": "11:02:57",
"text": "これまでのコストを価格"
},
{
"file": "seg_009.ts",
"start": 178.5,
"end": 180.5,
"clock": "11:02:58",
"text": "転換することをためらっていた"
},
{
"file": "seg_009.ts",
"start": 180.5,
"end": 183.7,
"clock": "11:03:00",
"text": "食品販売業者は利益確保のために"
},
{
"file": "seg_009.ts",
"start": 183.7,
"end": 185.4,
"clock": "11:03:03",
"text": "あまり値段を下げない可能性が"
},
{
"file": "seg_009.ts",
"start": 185.4,
"end": 186.6,
"clock": "11:03:05",
"text": "考えられないかという"
},
{
"file": "seg_009.ts",
"start": 186.6,
"end": 188.3,
"clock": "11:03:06",
"text": "指摘もあります"
},
{
"file": "seg_009.ts",
"start": 188.3,
"end": 189.5,
"clock": "11:03:08",
"text": "実際の足元では消費が"
},
{
"file": "seg_009.ts",
"start": 189.5,
"end": 190.5,
"clock": "11:03:09",
"text": "定面しておりまして"
},
{
"file": "seg_009.ts",
"start": 190.5,
"end": 194.1,
"clock": "11:03:10",
"text": "この9月の消費指摘は"
},
{
"file": "seg_009.ts",
"start": 194.1,
"end": 197.0,
"clock": "11:03:14",
"text": "実質で前年同月比6.8%"
},
{
"file": "seg_009.ts",
"start": 197.0,
"end": 199.3,
"clock": "11:03:17",
"text": "当減10か月連続でマイナス"
},
{
"file": "seg_009.ts",
"start": 199.3,
"end": 200.8,
"clock": "11:03:19",
"text": "という数字もありますし"
},
{
"file": "seg_009.ts",
"start": 200.8,
"end": 203.5,
"clock": "11:03:20",
"text": "先般のGDP統計でも"
},
{
"file": "seg_009.ts",
"start": 203.5,
"end": 205.2,
"clock": "11:03:23",
"text": "コロナ前の低水準だと"
},
{
"file": "seg_009.ts",
"start": 205.2,
"end": 207.5,
"clock": "11:03:25",
"text": "消費はという結果が出ています"
},
{
"file": "seg_009.ts",
"start": 207.5,
"end": 209.8,
"clock": "11:03:27",
"text": "経済政策として考えますと"
},
{
"file": "seg_009.ts",
"start": 209.8,
"end": 212.5,
"clock": "11:03:29",
"text": "むしろ価格弾力性がより高い"
},
{
"file": "seg_009.ts",
"start": 212.5,
"end": 214.4,
"clock": "11:03:32",
"text": "他の品目を含めて"
},
{
"file": "seg_009.ts",
"start": 214.4,
"end": 216.9,
"clock": "11:03:34",
"text": "一率の消費減少を行う方法が"
},
{
"file": "seg_009.ts",
"start": 216.9,
"end": 220.8,
"clock": "11:03:36",
"text": "内需拡大という点からも"
},
{
"file": "seg_009.ts",
"start": 220.8,
"end": 223.7,
"clock": "11:03:40",
"text": "またそれをやるべき局面ではないかと思いますが"
},
{
"file": "seg_009.ts",
"start": 223.7,
"end": 225.1,
"clock": "11:03:43",
"text": "いかがでしょうか"
},
{
"file": "seg_009.ts",
"start": 225.1,
"end": 229.16,
"clock": "11:03:45",
"text": "片山国務大臣"
},
{
"file": "seg_009.ts",
"start": 229.16,
"end": 231.56,
"clock": "11:03:49",
"text": "今般お願いしております"
},
{
"file": "seg_009.ts",
"start": 231.56,
"end": 234.46,
"clock": "11:03:51",
"text": "飲食料金に係る消費税金の引き上げを"
},
{
"file": "seg_009.ts",
"start": 234.46,
"end": 236.16,
"clock": "11:03:54",
"text": "含み出す等法案は"
},
{
"file": "seg_009.ts",
"start": 236.16,
"end": 239.42,
"clock": "11:03:56",
"text": "これまで仏下高屋税社会保険料による"
},
{
"file": "seg_009.ts",
"start": 239.42,
"end": 241.46,
"clock": "11:03:59",
"text": "負担に苦しんでこられた"
},
{
"file": "seg_009.ts",
"start": 241.46,
"end": 245.96,
"clock": "11:04:01",
"text": "中定所得の現役勤労者の"
},
{
"file": "seg_009.ts",
"start": 245.96,
"end": 247.56,
"clock": "11:04:05",
"text": "負担の軽減が"
},
{
"file": "seg_009.ts",
"start": 247.56,
"end": 249.36,
"clock": "11:04:07",
"text": "現化の最重要課題であるという"
},
{
"file": "seg_009.ts",
"start": 249.36,
"end": 250.66,
"clock": "11:04:09",
"text": "認識のもとで"
},
{
"file": "seg_009.ts",
"start": 250.66,
"end": 253.86,
"clock": "11:04:10",
"text": "支援金の令和11年度の本格導入までの"
},
{
"file": "seg_009.ts",
"start": 253.86,
"end": 254.96,
"clock": "11:04:13",
"text": "つなぎとして"
},
{
"file": "seg_009.ts",
"start": 254.96,
"end": 256.56,
"clock": "11:04:14",
"text": "現化の仏下の上昇に"
},
{
"file": "seg_009.ts",
"start": 256.56,
"end": 258.66,
"clock": "11:04:16",
"text": "勘納みを行うものでありまして"
},
{
"file": "seg_009.ts",
"start": 258.66,
"end": 259.76,
"clock": "11:04:18",
"text": "御指摘のように"
},
{
"file": "seg_009.ts",
"start": 259.76,
"end": 261.86,
"clock": "11:04:19",
"text": "内需拡大を直接の狙いとした"
},
{
"file": "seg_009.ts",
"start": 261.86,
"end": 263.56,
"clock": "11:04:21",
"text": "というものではございません"
},
{
"file": "seg_009.ts",
"start": 263.56,
"end": 265.36,
"clock": "11:04:23",
"text": "また足元では消費が"
},
{
"file": "seg_009.ts",
"start": 265.36,
"end": 267.36,
"clock": "11:04:25",
"text": "定名をしていると見られるかどうか"
},
{
"file": "seg_009.ts",
"start": 267.36,
"end": 270.76,
"clock": "11:04:27",
"text": "確かに今回の数字はありましたが"
},
{
"file": "seg_009.ts",
"start": 270.76,
"end": 273.76,
"clock": "11:04:30",
"text": "先般公表された家計調査で"
},
{
"file": "seg_009.ts",
"start": 273.76,
"end": 274.96,
"clock": "11:04:33",
"text": "おっしゃっているとしたら"
},
{
"file": "seg_009.ts",
"start": 274.96,
"end": 276.86,
"clock": "11:04:34",
"text": "それはそういう部分がございますが"
},
{
"file": "seg_009.ts",
"start": 276.86,
"end": 278.86,
"clock": "11:04:36",
"text": "この御家計調査につきましては"
},
{
"file": "seg_009.ts",
"start": 278.86,
"end": 282.06,
"clock": "11:04:38",
"text": "1世帯あたりの消費を示す等系でございまして"
},
{
"file": "seg_009.ts",
"start": 282.06,
"end": 284.26,
"clock": "11:04:42",
"text": "世帯人員の減少などによって"
},
{
"file": "seg_009.ts",
"start": 284.26,
"end": 286.16,
"clock": "11:04:44",
"text": "消費全体と比べると"
},
{
"file": "seg_009.ts",
"start": 286.16,
"end": 288.16,
"clock": "11:04:46",
"text": "4名の動きとなる傾向はあるものと"
},
{
"file": "seg_009.ts",
"start": 288.16,
"end": 289.36,
"clock": "11:04:48",
"text": "認識しております"
},
{
"file": "seg_009.ts",
"start": 289.36,
"end": 291.46,
"clock": "11:04:49",
"text": "その上で個人消費につきましては"
},
{
"file": "seg_009.ts",
"start": 291.46,
"end": 293.66,
"clock": "11:04:51",
"text": "中等情勢の近迫化に伴い"
},
{
"file": "seg_009.ts",
"start": 293.66,
"end": 295.26,
"clock": "11:04:53",
"text": "予想物価の上昇が"
},
{
"file": "seg_009.ts",
"start": 295.26,
"end": 297.16,
"clock": "11:04:55",
"text": "消費者の傾向感を抑えていると"
},
{
"file": "seg_009.ts",
"start": 297.16,
"end": 298.9,
"clock": "11:04:57",
"text": "いうふうには考えられるということに"
},
{
"file": "seg_009.ts",
"start": 298.9,
"end": 299.86,
"clock": "11:04:58",
"text": "加えまして"
},
{
"file": "seg_009.ts",
"start": 299.86,
"end": 302.26,
"clock": "11:04:59",
"text": "自然災害や天候不純などの"
},
{
"file": "seg_009.ts",
"start": 302.26,
"end": 303.66,
"clock": "11:05:02",
"text": "一時的な要因も"
},
{
"file": "seg_009.ts",
"start": 303.66,
"end": 305.76,
"clock": "11:05:03",
"text": "多少なりとも影響を応募していると"
},
{
"file": "seg_009.ts",
"start": 305.76,
"end": 307.06,
"clock": "11:05:05",
"text": "いうことがありますが"
},
{
"file": "seg_009.ts",
"start": 307.06,
"end": 308.46,
"clock": "11:05:07",
"text": "雇用者報酬の"
},
{
"file": "seg_009.ts",
"start": 308.46,
"end": 310.46,
"clock": "11:05:08",
"text": "雇用者報酬の検調さは"
},
{
"file": "seg_009.ts",
"start": 310.46,
"end": 312.66,
"clock": "11:05:10",
"text": "数字的にも維持されているものと"
},
{
"file": "seg_009.ts",
"start": 312.66,
"end": 313.66,
"clock": "11:05:12",
"text": "考えております"
},
{
"file": "seg_009.ts",
"start": 313.66,
"end": 315.26,
"clock": "11:05:13",
"text": "その上で申し上げますと"
},
{
"file": "seg_009.ts",
"start": 315.26,
"end": 316.66,
"clock": "11:05:15",
"text": "政府といたしましては"
},
{
"file": "seg_009.ts",
"start": 316.66,
"end": 318.86,
"clock": "11:05:16",
"text": "社会保障財源となっております"
},
{
"file": "seg_009.ts",
"start": 318.86,
"end": 321.26,
"clock": "11:05:18",
"text": "消費税を一日前税数ということに"
},
{
"file": "seg_009.ts",
"start": 321.26,
"end": 323.86,
"clock": "11:05:21",
"text": "ついては年金医療介護消費者改革"
},
{
"file": "seg_009.ts",
"start": 323.86,
"end": 325.86,
"clock": "11:05:23",
"text": "という国民の皆様の暮らしに"
},
{
"file": "seg_009.ts",
"start": 325.86,
"end": 327.86,
"clock": "11:05:25",
"text": "不確か変わる行政サービスにも"
},
{
"file": "seg_009.ts",
"start": 327.86,
"end": 330.06,
"clock": "11:05:27",
"text": "影響が出かないということがありますので"
},
{
"file": "seg_009.ts",
"start": 330.06,
"end": 331.86,
"clock": "11:05:30",
"text": "適切ではないというふうに"
},
{
"file": "seg_009.ts",
"start": 331.86,
"end": 333.06,
"clock": "11:05:31",
"text": "おまこの委員会でも"
},
{
"file": "seg_009.ts",
"start": 333.06,
"end": 335.86,
"clock": "11:05:33",
"text": "ずっとお答えをしているところでございます"
},
{
"file": "seg_009.ts",
"start": 335.86,
"end": 338.86,
"clock": "11:05:35",
"text": "松田真奈部君"
},
{
"file": "seg_009.ts",
"start": 338.86,
"end": 340.26,
"clock": "11:05:38",
"text": "多くの企業が"
},
{
"file": "seg_009.ts",
"start": 340.26,
"end": 341.26,
"clock": "11:05:40",
"text": "コストだけで"
},
{
"file": "seg_009.ts",
"start": 341.26,
"end": 344.46,
"clock": "11:05:41",
"text": "根上げを従っているという状況で"
},
{
"file": "seg_009.ts",
"start": 344.46,
"end": 346.66,
"clock": "11:05:44",
"text": "来年4月に食品化学が"
},
{
"file": "seg_009.ts",
"start": 346.66,
"end": 348.46,
"clock": "11:05:46",
"text": "その分下がらないと"
},
{
"file": "seg_009.ts",
"start": 348.46,
"end": 349.96,
"clock": "11:05:48",
"text": "風評の問題がある"
},
{
"file": "seg_009.ts",
"start": 349.96,
"end": 351.76,
"clock": "11:05:49",
"text": "あるいは消費者の批判がある"
},
{
"file": "seg_009.ts",
"start": 351.76,
"end": 352.96,
"clock": "11:05:51",
"text": "ということになりますの"
},
{
"file": "seg_009.ts",
"start": 352.96,
"end": 354.56,
"clock": "11:05:52",
"text": "ならばということで"
},
{
"file": "seg_009.ts",
"start": 354.56,
"end": 355.96,
"clock": "11:05:54",
"text": "来年4月よりも前に"
},
{
"file": "seg_009.ts",
"start": 355.96,
"end": 357.56,
"clock": "11:05:55",
"text": "根上げをしておいて"
},
{
"file": "seg_009.ts",
"start": 357.56,
"end": 359.46,
"clock": "11:05:57",
"text": "そこから4月には"
},
{
"file": "seg_009.ts",
"start": 359.46,
"end": 361.46,
"clock": "11:05:59",
"text": "税率分化学を引き下げるという"
},
{
"file": "seg_009.ts",
"start": 361.46,
"end": 363.56,
"clock": "11:06:01",
"text": "行動を取る可能性があるということは"
},
{
"file": "seg_009.ts",
"start": 363.56,
"end": 365.16,
"clock": "11:06:03",
"text": "関係者からも指摘をされている"
},
{
"file": "seg_009.ts",
"start": 365.16,
"end": 366.46,
"clock": "11:06:05",
"text": "ところであります"
},
{
"file": "seg_009.ts",
"start": 366.46,
"end": 367.76,
"clock": "11:06:06",
"text": "この場合実際には"
},
{
"file": "seg_009.ts",
"start": 367.76,
"end": 369.56,
"clock": "11:06:07",
"text": "店頭科学は現時点に比べて"
},
{
"file": "seg_009.ts",
"start": 369.56,
"end": 372.16,
"clock": "11:06:09",
"text": "下がらないということになりまして"
},
{
"file": "seg_009.ts",
"start": 372.16,
"end": 373.36,
"clock": "11:06:12",
"text": "消費者の恩恵は"
},
{
"file": "seg_009.ts",
"start": 373.36,
"end": 376.96,
"clock": "11:06:13",
"text": "実質は的にはゼロということになりますが"
},
{
"file": "seg_009.ts",
"start": 376.96,
"end": 379.66,
"clock": "11:06:16",
"text": "税率引き下げ前の"
},
{
"file": "seg_009.ts",
"start": 379.66,
"end": 381.06,
"clock": "11:06:19",
"text": "臨場根上げをやめるようにと"
},
{
"file": "seg_009.ts",
"start": 381.06,
"end": 381.86,
"clock": "11:06:21",
"text": "政府として"
},
{
"file": "seg_009.ts",
"start": 381.86,
"end": 382.46,
"clock": "11:06:21",
"text": "失踪するわけにも"
},
{
"file": "seg_009.ts",
"start": 382.46,
"end": 384.46,
"clock": "11:06:22",
"text": "いかないというふうに思いますが"
},
{
"file": "seg_009.ts",
"start": 384.46,
"end": 386.46,
"clock": "11:06:24",
"text": "さらにちょっと続けますと"
},
{
"file": "seg_009.ts",
"start": 386.46,
"end": 387.56,
"clock": "11:06:26",
"text": "この場合"
},
{
"file": "seg_009.ts",
"start": 387.56,
"end": 389.76,
"clock": "11:06:27",
"text": "2年後の税率8%への"
},
{
"file": "seg_009.ts",
"start": 389.76,
"end": 392.16,
"clock": "11:06:29",
"text": "引き上げのときは"
},
{
"file": "seg_009.ts",
"start": 392.16,
"end": 393.66,
"clock": "11:06:32",
"text": "今回の消費税率引き下げが"
},
{
"file": "seg_009.ts",
"start": 393.66,
"end": 395.76,
"clock": "11:06:33",
"text": "なかった場合に比べて"
},
{
"file": "seg_009.ts",
"start": 395.76,
"end": 398.16,
"clock": "11:06:35",
"text": "その分科学が上昇する"
},
{
"file": "seg_009.ts",
"start": 398.16,
"end": 399.46,
"clock": "11:06:38",
"text": "そういうことに"
},
{
"file": "seg_009.ts",
"start": 399.46,
"end": 402.06,
"clock": "11:06:39",
"text": "結局それで終わってしまう"
},
{
"file": "seg_009.ts",
"start": 402.06,
"end": 403.06,
"clock": "11:06:42",
"text": "ということになります"
},
{
"file": "seg_009.ts",
"start": 403.06,
"end": 403.86,
"clock": "11:06:43",
"text": "現在のような"
},
{
"file": "seg_009.ts",
"start": 403.86,
"end": 405.26,
"clock": "11:06:43",
"text": "物価上昇局面では"
},
{
"file": "seg_009.ts",
"start": 405.26,
"end": 407.86,
"clock": "11:06:45",
"text": "今般の事件的な消費税率引き下げを"
},
{
"file": "seg_009.ts",
"start": 407.86,
"end": 409.06,
"clock": "11:06:47",
"text": "物価高対策として"
},
{
"file": "seg_009.ts",
"start": 409.06,
"end": 409.76,
"clock": "11:06:49",
"text": "位置づけることには"
},
{
"file": "seg_009.ts",
"start": 409.76,
"end": 411.86,
"clock": "11:06:49",
"text": "そもそも無理があるのではないかと思いますか"
},
{
"file": "seg_009.ts",
"start": 411.86,
"end": 413.86,
"clock": "11:06:51",
"text": "いかがでしょう"
},
{
"file": "seg_009.ts",
"start": 413.86,
"end": 420.11,
"clock": "11:06:53",
"text": "振動金井福幸財務副大臣"
},
{
"file": "seg_009.ts",
"start": 420.11,
"end": 421.11,
"clock": "11:07:00",
"text": "消費者の恩恵は"
},
{
"file": "seg_009.ts",
"start": 421.11,
"end": 422.51,
"clock": "11:07:01",
"text": "実質的にゼロではないかという"
},
{
"file": "seg_009.ts",
"start": 422.51,
"end": 423.51,
"clock": "11:07:02",
"text": "従子的と"
},
{
"file": "seg_009.ts",
"start": 423.51,
"end": 424.71,
"clock": "11:07:03",
"text": "税率引き下げ前の"
},
{
"file": "seg_009.ts",
"start": 424.71,
"end": 426.61,
"clock": "11:07:04",
"text": "臨場的な根上げに関して"
},
{
"file": "seg_009.ts",
"start": 426.61,
"end": 428.01,
"clock": "11:07:06",
"text": "お答えしたいと思います"
},
{
"file": "seg_009.ts",
"start": 428.01,
"end": 430.61,
"clock": "11:07:08",
"text": "まず食料品を中心とする"
},
{
"file": "seg_009.ts",
"start": 430.61,
"end": 432.31,
"clock": "11:07:10",
"text": "近年の物価上昇は"
},
{
"file": "seg_009.ts",
"start": 432.31,
"end": 434.61,
"clock": "11:07:12",
"text": "低価格品への切り替えなど"
},
{
"file": "seg_009.ts",
"start": 434.61,
"end": 436.51,
"clock": "11:07:14",
"text": "節約余地の小さい"
},
{
"file": "seg_009.ts",
"start": 436.51,
"end": 437.81,
"clock": "11:07:16",
"text": "低所得"
},
{
"file": "seg_009.ts",
"start": 437.81,
"end": 440.01,
"clock": "11:07:17",
"text": "低所得世帯にとって"
},
{
"file": "seg_009.ts",
"start": 440.01,
"end": 441.91,
"clock": "11:07:20",
"text": "より大きな負担となっており"
},
{
"file": "seg_009.ts",
"start": 441.91,
"end": 443.71,
"clock": "11:07:21",
"text": "生活必需品に対する支援が"
},
{
"file": "seg_009.ts",
"start": 443.71,
"end": 445.41,
"clock": "11:07:23",
"text": "重要となっております"
},
{
"file": "seg_009.ts",
"start": 445.41,
"end": 447.81,
"clock": "11:07:25",
"text": "仮に適正な科学展開によって"
},
{
"file": "seg_009.ts",
"start": 447.81,
"end": 450.21,
"clock": "11:07:27",
"text": "本体科学が上昇するとしても"
},
{
"file": "seg_009.ts",
"start": 450.21,
"end": 452.91,
"clock": "11:07:30",
"text": "消費税の税率引き下げ分については"
},
{
"file": "seg_009.ts",
"start": 452.91,
"end": 455.11,
"clock": "11:07:32",
"text": "科学に反映されることを踏まえれば"
},
{
"file": "seg_009.ts",
"start": 455.11,
"end": 457.51,
"clock": "11:07:35",
"text": "十分に意義があるものと考えております"
},
{
"file": "seg_009.ts",
"start": 457.51,
"end": 458.51,
"clock": "11:07:37",
"text": "その上で"
},
{
"file": "seg_009.ts",
"start": 458.51,
"end": 459.81,
"clock": "11:07:38",
"text": "企業との関係では"
},
{
"file": "seg_009.ts",
"start": 459.81,
"end": 461.01,
"clock": "11:07:39",
"text": "経営判断に基づく"
},
{
"file": "seg_009.ts",
"start": 461.01,
"end": 462.31,
"clock": "11:07:41",
"text": "自由な科学決定を"
},
{
"file": "seg_009.ts",
"start": 462.31,
"end": 464.01,
"clock": "11:07:42",
"text": "妨げることは難しく"
},
{
"file": "seg_009.ts",
"start": 464.01,
"end": 466.41,
"clock": "11:07:44",
"text": "適正な科学展開が行わらなければ"
},
{
"file": "seg_009.ts",
"start": 466.41,
"end": 467.61,
"clock": "11:07:46",
"text": "血液に水をさすことにも"
},
{
"file": "seg_009.ts",
"start": 467.61,
"end": 468.71,
"clock": "11:07:47",
"text": "なりかにません"
},
{
"file": "seg_009.ts",
"start": 468.71,
"end": 469.61,
"clock": "11:07:48",
"text": "このため"
},
{
"file": "seg_009.ts",
"start": 469.61,
"end": 472.01,
"clock": "11:07:49",
"text": "適正な科学展開を図っていくことは"
},
{
"file": "seg_009.ts",
"start": 472.01,
"end": 473.41,
"clock": "11:07:52",
"text": "極めて重要であります"
},
{
"file": "seg_009.ts",
"start": 473.41,
"end": 474.51,
"clock": "11:07:53",
"text": "一方で"
},
{
"file": "seg_009.ts",
"start": 474.51,
"end": 475.91,
"clock": "11:07:54",
"text": "便条なやりにつきましては"
},
{
"file": "seg_009.ts",
"start": 475.91,
"end": 477.51,
"clock": "11:07:55",
"text": "しっかりと対応していく必要があると"
},
{
"file": "seg_009.ts",
"start": 477.51,
"end": 478.81,
"clock": "11:07:57",
"text": "考えておりまして"
},
{
"file": "seg_009.ts",
"start": 478.81,
"end": 480.81,
"clock": "11:07:58",
"text": "消費者庁も参画している"
},
{
"file": "seg_009.ts",
"start": 480.81,
"end": 483.11,
"clock": "11:08:00",
"text": "関係府省庁連絡会議において"
},
{
"file": "seg_009.ts",
"start": 483.11,
"end": 484.61,
"clock": "11:08:03",
"text": "具体的な対応について"
},
{
"file": "seg_009.ts",
"start": 484.61,
"end": 486.31,
"clock": "11:08:04",
"text": "検討深めてまいりたいというふうに"
},
{
"file": "seg_009.ts",
"start": 486.31,
"end": 488.41,
"clock": "11:08:06",
"text": "考えているところであります"
},
{
"file": "seg_009.ts",
"start": 488.41,
"end": 490.41,
"clock": "11:08:08",
"text": "松田真奈部君"
},
{
"file": "seg_009.ts",
"start": 490.41,
"end": 492.01,
"clock": "11:08:10",
"text": "次にですね"
},
{
"file": "seg_009.ts",
"start": 492.01,
"end": 493.91,
"clock": "11:08:12",
"text": "今年1月に"
},
{
"file": "seg_009.ts",
"start": 493.91,
"end": 495.81,
"clock": "11:08:13",
"text": "福山参議院福木町以下"
},
{
"file": "seg_009.ts",
"start": 495.81,
"end": 498.31,
"clock": "11:08:15",
"text": "各党の参議院議員で"
},
{
"file": "seg_009.ts",
"start": 498.31,
"end": 500.31,
"clock": "11:08:18",
"text": "イタリア法務にしまして"
},
{
"file": "seg_009.ts",
"start": 500.31,
"end": 502.31,
"clock": "11:08:20",
"text": "無礼会議福議長と"
},
{
"file": "seg_009.ts",
"start": 502.31,
"end": 503.01,
"clock": "11:08:22",
"text": "面談しまして"
},
{
"file": "seg_009.ts",
"start": 503.01,
"end": 503.91,
"clock": "11:08:23",
"text": "その無礼会議議長が"
},
{
"file": "seg_009.ts",
"start": 503.91,
"end": 505.71,
"clock": "11:08:23",
"text": "先輩を来にしまして"
},
{
"file": "seg_009.ts",
