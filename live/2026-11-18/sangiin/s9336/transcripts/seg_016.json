[
{
"file": "seg_016.ts",
"start": 0.0,
"end": 3.44,
"clock": "12:10:00",
"text": "その税収は明快になると"
},
{
"file": "seg_016.ts",
"start": 3.44,
"end": 9.98,
"clock": "12:10:03",
"text": "だからこの間も高知総理が今度そういうレジの回収をするとかね"
},
{
"file": "seg_016.ts",
"start": 9.98,
"end": 15.28,
"clock": "12:10:09",
"text": "そういったスマートレジを支給するみたいな補助するみたいなことを決めたって言ってましたが"
},
{
"file": "seg_016.ts",
"start": 15.28,
"end": 23.48,
"clock": "12:10:15",
"text": "実際そこまでねやるようなレジそういう仕組みシステムを作っていくことが必要なんだろうなという"
},
{
"file": "seg_016.ts",
"start": 23.48,
"end": 26.48,
"clock": "12:10:23",
"text": "これは毎回から私もそういうふうに思っていたので"
},
{
"file": "seg_016.ts",
"start": 26.48,
"end": 31.04,
"clock": "12:10:26",
"text": "次回ちょっとそういったところも含めて聞いてみたいというふうに思います"
},
{
"file": "seg_016.ts",
"start": 31.04,
"end": 32.84,
"clock": "12:10:31",
"text": "今日はですね"
},
{
"file": "seg_016.ts",
"start": 32.84,
"end": 35.82,
"clock": "12:10:32",
"text": "ノリ水産大臣もお越しをいただいております"
},
{
"file": "seg_016.ts",
"start": 35.82,
"end": 45.48,
"clock": "12:10:35",
"text": "特に農業者とかあと水産業者の霊災な人たち中小という"
},
{
"file": "seg_016.ts",
"start": 45.48,
"end": 50.16,
"clock": "12:10:45",
"text": "まさに中小事業までいかない個人事業の人みたいな人たち"
},
{
"file": "seg_016.ts",
"start": 50.16,
"end": 55.6,
"clock": "12:10:50",
"text": "そういう人たちのあとは外職もそうなんですけど"
},
{
"file": "seg_016.ts",
"start": 56.56,
"end": 63.12,
"clock": "12:10:56",
"text": "売上の少ない事業者そういう人たちに国はどういうような形で対応しているのかって"
},
{
"file": "seg_016.ts",
"start": 63.12,
"end": 67.6,
"clock": "12:11:03",
"text": "まあ色々な答弁聞いてますけど一応とりあえず聞いていますかどうぞ"
},
{
"file": "seg_016.ts",
"start": 67.6,
"end": 71.26,
"clock": "12:11:07",
"text": "武田茂也新田農林水産大臣"
},
{
"file": "seg_016.ts",
"start": 71.26,
"end": 75.24,
"clock": "12:11:11",
"text": "飲食料品かから消費税率の引き下げにつきましては"
},
{
"file": "seg_016.ts",
"start": 75.24,
"end": 82.12,
"clock": "12:11:15",
"text": "農林業業者のうち本速課税員への移行が困難な勧読家事事業者免税事業者からは"
},
{
"file": "seg_016.ts",
"start": 82.12,
"end": 86.36,
"clock": "12:11:22",
"text": "売上が回収できない進入税税額が大きくなるのではないか"
},
{
"file": "seg_016.ts",
"start": 86.36,
"end": 91.52,
"clock": "12:11:26",
"text": "また本速事業者からも勧読を受けるまでの資金繰りが悪化するのではないか"
},
{
"file": "seg_016.ts",
"start": 91.52,
"end": 98.96,
"clock": "12:11:31",
"text": "外職業界からは食料品に限る消費税率が8%から10%に引き下げられる一方"
},
{
"file": "seg_016.ts",
"start": 98.96,
"end": 103.0,
"clock": "12:11:38",
"text": "外職の消費税率は10%に制御かれますので"
},
{
"file": "seg_016.ts",
"start": 103.0,
"end": 108.32,
"clock": "12:11:43",
"text": "外職需要が減少するのではないかというご心配の声があると承知しております"
},
{
"file": "seg_016.ts",
"start": 108.32,
"end": 112.76,
"clock": "12:11:48",
"text": "これらの農林業業者外職事業者等への対応は"
},
{
"file": "seg_016.ts",
"start": 112.76,
"end": 118.04,
"clock": "12:11:52",
"text": "現場の実情を確認しつつ影響に応じて対応をしっかり行う必要があると認識しています"
},
{
"file": "seg_016.ts",
"start": 118.04,
"end": 123.48,
"clock": "12:11:58",
"text": "このため本速課税に移行することが困難な農林業業者については"
},
{
"file": "seg_016.ts",
"start": 123.48,
"end": 129.88,
"clock": "12:12:03",
"text": "売上から回収できない資入税額が大きくなることで経営傾向は困難とならないように"
},
{
"file": "seg_016.ts",
"start": 129.88,
"end": 136.24,
"clock": "12:12:09",
"text": "個別の売上高を踏まえた金額を給付する仕組みを導入することや"
},
{
"file": "seg_016.ts",
"start": 136.24,
"end": 144.04,
"clock": "12:12:16",
"text": "食品事業者外職事業者についても生産性向上の取組への支援など影響を見つけた上で"
},
{
"file": "seg_016.ts",
"start": 144.04,
"end": 145.68,
"clock": "12:12:24",
"text": "的確な支援を講ずること"
},
{
"file": "seg_016.ts",
"start": 145.68,
"end": 152.8,
"clock": "12:12:25",
"text": "それに資金繰りや本速事業への移行についても支援を行うこととの方針が対応に明記されたところであります"
},
{
"file": "seg_016.ts",
"start": 152.8,
"end": 158.6,
"clock": "12:12:32",
"text": "こうした考えのもと予算編成過程において支援内容を具体的に具体化を進めてまいりたいと考えております"
},
{
"file": "seg_016.ts",
"start": 158.6,
"end": 163.8,
"clock": "12:12:38",
"text": "大島区総君というお決まりのことをお便をいただいたわけですが"
},
{
"file": "seg_016.ts",
"start": 163.8,
"end": 168.56,
"clock": "12:12:43",
"text": "私が問題史をしているのはですね"
},
{
"file": "seg_016.ts",
"start": 168.56,
"end": 171.96,
"clock": "12:12:48",
"text": "具体的な例を挙げていくと"
},
{
"file": "seg_016.ts",
"start": 171.96,
"end": 176.32,
"clock": "12:12:51",
"text": "例えば農業を通じてものを売っているとか"
},
{
"file": "seg_016.ts",
"start": 176.32,
"end": 181.4,
"clock": "12:12:56",
"text": "漁業を通じてものを売っているというそういうところがシステムのラインに乗っているから"
},
{
"file": "seg_016.ts",
"start": 181.4,
"end": 184.28,
"clock": "12:13:01",
"text": "当然消費税がいくらとか"
},
{
"file": "seg_016.ts",
"start": 184.28,
"end": 188.28,
"clock": "12:13:04",
"text": "市価の割れがいくらとかいうのは明快に出てくるじゃないですか"
},
{
"file": "seg_016.ts",
"start": 188.28,
"end": 194.32,
"clock": "12:13:08",
"text": "だからそれを本速課税とか簡易課税でやっている規模の人たちは"
},
{
"file": "seg_016.ts",
"start": 194.32,
"end": 199.8,
"clock": "12:13:14",
"text": "ある程度それを把握するのはまあの用意だと思うんですけど"
},
{
"file": "seg_016.ts",
"start": 199.8,
"end": 206.72,
"clock": "12:13:19",
"text": "免税事業者ね特に今日免税事業者について徹底して議論していきたいんですけど"
},
{
"file": "seg_016.ts",
"start": 206.72,
"end": 211.28,
"clock": "12:13:26",
"text": "免税事業者なんですかもともと税金は免除されていると"
},
{
"file": "seg_016.ts",
"start": 211.28,
"end": 219.04,
"clock": "12:13:31",
"text": "じゃあ消費税がいくらなのかとかいう概念はあんまりないんじゃないかと"
},
{
"file": "seg_016.ts",
"start": 219.04,
"end": 226.08,
"clock": "12:13:39",
"text": "まあ言うなれば今日はなんかこう立派なタイが一匹網に入ってたと"
},
{
"file": "seg_016.ts",
"start": 226.08,
"end": 230.36,
"clock": "12:13:46",
"text": "じゃあこれはちょっと知り合いの飲食店に持っていって"
},
{
"file": "seg_016.ts",
"start": 230.36,
"end": 233.56,
"clock": "12:13:50",
"text": "もうこれ安く売ってあげるからって言ったらお店の人も"
},
{
"file": "seg_016.ts",
"start": 233.56,
"end": 236.52,
"clock": "12:13:53",
"text": "おわりをしてじゃあこれでねって言ってやりとりしているような"
},
{
"file": "seg_016.ts",
"start": 236.52,
"end": 239.76,
"clock": "12:13:56",
"text": "これ現場はね多分あると思うんですよ"
},
{
"file": "seg_016.ts",
"start": 239.76,
"end": 245.08,
"clock": "12:13:59",
"text": "じゃあそれがじゃあ売上なのかって言ったらいやいや売上じゃなくてもそれは"
},
{
"file": "seg_016.ts",
"start": 245.08,
"end": 251.08,
"clock": "12:14:05",
"text": "ねその中で丸まっちゃってるっていうまあそういったことをやっている"
},
{
"file": "seg_016.ts",
"start": 251.08,
"end": 256.0,
"clock": "12:14:11",
"text": "事業者免税事業者って結構多いと思うんですねそれ管理課税でも法則課税の中でも"
},
{
"file": "seg_016.ts",
"start": 256.0,
"end": 260.32,
"clock": "12:14:16",
"text": "そういうことを取引する人もいるかもしれないけどもそんな細かいこと"
},
{
"file": "seg_016.ts",
"start": 260.32,
"end": 267.2,
"clock": "12:14:20",
"text": "言う必要はないけれども今言う免税事業者の人たちの売上を把握して"
},
{
"file": "seg_016.ts",
"start": 267.2,
"end": 275.56,
"clock": "12:14:27",
"text": "その売上1%そしてシーレーのこちらでは10%もあったり色々ある中で"
},
{
"file": "seg_016.ts",
"start": 275.56,
"end": 279.56,
"clock": "12:14:35",
"text": "じゃあそれを整理して免税事業者に幹部しますよなんて"
},
{
"file": "seg_016.ts",
"start": 279.56,
"end": 283.72,
"clock": "12:14:39",
"text": "めんどくさいことをやる私は必要はないと"
},
{
"file": "seg_016.ts",
"start": 283.72,
"end": 291.2,
"clock": "12:14:43",
"text": "でまさにもうその免税事業者なんだから売上も1000万円かとか言う風にね"
},
{
"file": "seg_016.ts",
"start": 291.2,
"end": 296.4,
"clock": "12:14:51",
"text": "もう決まってないわけじゃないですかいくら売上てもう1000万以上行ってないとこなんだから"
},
{
"file": "seg_016.ts",
"start": 296.4,
"end": 306.4,
"clock": "12:14:56",
"text": "だからそこの1%分の消費税売上額をその徹底してねやらせるなんていうのはこれこそ税をね"
},
{
"file": "seg_016.ts",
"start": 306.4,
"end": 312.72,
"clock": "12:15:06",
"text": "あの監促化して申請してもらおうとかなんとか言ってる趣旨に反すると思うんですよ"
},
{
"file": "seg_016.ts",
"start": 312.72,
"end": 318.8,
"clock": "12:15:12",
"text": "だから免税事業者っていうふうにちゃんと本則課税関係課税免税事業者というとちゃんと"
},
{
"file": "seg_016.ts",
"start": 318.8,
"end": 327.44,
"clock": "12:15:18",
"text": "聞い分けて制度としてやってるわけだから今回のこの新しい消費税を厳税するというときに"
},
{
"file": "seg_016.ts",
"start": 327.44,
"end": 334.16,
"clock": "12:15:27",
"text": "免税事業者だけはもうまさに払った消費税分幹部しますでいいじゃないですか"
},
{
"file": "seg_016.ts",
"start": 334.16,
"end": 340.6,
"clock": "12:15:34",
"text": "これは文句言う人私はいないと思うだからこういう要望が上がってこないというのはおかしいぞと"
},
{
"file": "seg_016.ts",
"start": 340.6,
"end": 349.04,
"clock": "12:15:40",
"text": "いう話を昨日ちょっと利盗進行なかったら今日ですね実は町村会の会長さんたちの要望としては"
},
{
"file": "seg_016.ts",
"start": 349.04,
"end": 357.92,
"clock": "12:15:49",
"text": "そういうもっとね会議にしてほしいんだという要望が出てるというわけだから多分いろんな業界団体"
},
{
"file": "seg_016.ts",
"start": 357.92,
"end": 366.56,
"clock": "12:15:57",
"text": "ねそれは農業とか漁業の上の人たちから話すればそんなことは出てこないけど免税事業者だけを集めたね"
},
{
"file": "seg_016.ts",
"start": 366.56,
"end": 371.88,
"clock": "12:16:06",
"text": "ところで話聞いたらそういう話は当然出てくると思うんですけどそこらへんね"
},
{
"file": "seg_016.ts",
"start": 371.88,
"end": 379.32,
"clock": "12:16:11",
"text": "あだけ農水大臣北海道のそういった小さい人の声とかね農業者の声とか"
},
{
"file": "seg_016.ts",
"start": 379.32,
"end": 388.04,
"clock": "12:16:19",
"text": "水産事業者の声を聞いたらね絶対そういう方がもう明快にいいと思うんですよそこらへんどうですか大臣"
},
{
"file": "seg_016.ts",
"start": 388.04,
"end": 401.46,
"clock": "12:16:28",
"text": "たけべ農林水産大臣あの旧府の仕組みについてはですね社会保障国民会議のヒアリングにおいてもですね農林業業者から"
},
{
"file": "seg_016.ts",
"start": 401.46,
"end": 408.04,
"clock": "12:16:41",
"text": "事務負担が極力少ない形で措置することを検討してほしいという声をいただいております"
},
{
"file": "seg_016.ts",
"start": 408.04,
"end": 417.68,
"clock": "12:16:48",
"text": "であのこの旧府が本宿家人にこそが困難なあの免税事業者である農林業業者を対象としていることも踏まえまして"
},
{
"file": "seg_016.ts",
"start": 417.68,
"end": 428.16,
"clock": "12:16:57",
"text": "あの冷静な農林業業者に角な事務負担をかけることないように十分入り注意して支援内容を具体化してまいりたいと思っております"
},
{
"file": "seg_016.ts",
"start": 428.16,
"end": 434.52,
"clock": "12:17:08",
"text": "大島口沖いやだが年代人ねじゃあじゃあちょっとそれを私も完結に聞くけど"
},
{
"file": "seg_016.ts",
"start": 434.52,
"end": 447.6,
"clock": "12:17:14",
"text": "今言ったようなことも一つね考える法討論として検討のね一つに加える予知は私十分あると思ったけどそこらへんの答弁どうする"
},
{
"file": "seg_016.ts",
"start": 447.6,
"end": 458.56,
"clock": "12:17:27",
"text": "たけべ農林水産大臣あの委員のあのお話はですねおそらく免税事業者の方があの持ってくる領収書ですとかレシートとかで"
},
{
"file": "seg_016.ts",
"start": 458.56,
"end": 461.04,
"clock": "12:17:38",
"text": "それで"
},
{
"file": "seg_016.ts",
"start": 461.04,
"end": 468.64,
"clock": "12:17:41",
"text": "支払ったらどうかというようなことなんだろうというふうに理解していますこの c れ額に基づいて算定する場合ですね"
},
{
"file": "seg_016.ts",
"start": 468.64,
"end": 479.92,
"clock": "12:17:48",
"text": "あの免税事業者であってもですねこれがあの消費税の引き下げの対象となる飲食料品の販売に対応するもののかどうなのかということは確認する必要があります"
},
{
"file": "seg_016.ts",
"start": 479.92,
"end": 489.92,
"clock": "12:17:59",
"text": "なので事業者の方もこれは飲食料品かかわるものだそうでないものだと仕分けをしていただくなければなりません合わせて給付する事務側からにするとですね"
},
{
"file": "seg_016.ts",
"start": 489.92,
"end": 499.36,
"clock": "12:18:09",
"text": "この事務側の方もこれは飲食料品にかかわるものだそうでないものだという事務手続か発生しますそうすると給付する事務"
},
{
"file": "seg_016.ts",
"start": 499.36,
"end": 507.92,
"clock": "12:18:19",
"text": "負担のことも考えると c れ額でやるとなるとこれかなり負担が大きくなるので我々としてはあのこの"
},
{
"file": "seg_016.ts",
"start": 507.92,
"end": 515.84,
"clock": "12:18:27",
"text": "給付についた売り上げながらに基づいてそれに一定の割れをかける方向で検討しているということであります 星馬くそくん"
},
{
"file": "seg_016.ts",
"start": 515.84,
"end": 530.84,
"clock": "12:18:35",
"text": "それはねあの今言う至急する側の方の事務はねそんな変わらないはずですよね だら実際じゃあ売上げ額がその800万なのか100万なのかで出てくる"
},
{
"file": "seg_016.ts",
"start": 530.84,
"end": 537.84,
"clock": "12:18:50",
"text": "ここの消費税の 勘付金の割合をあのある程度"
},
{
"file": "seg_016.ts",
"start": 537.84,
"end": 546.08,
"clock": "12:18:57",
"text": "ね推定するがいいわけじゃないですか カイカゼ制度の時にはねみなしで見るわけだからそしたら面税需要者の"
},
{
"file": "seg_016.ts",
"start": 546.08,
"end": 555.76,
"clock": "12:19:06",
"text": "ね売上げが900万なのか300万なのか100万なのかというんである程度想定した 領収書ね"
},
{
"file": "seg_016.ts",
"start": 555.76,
"end": 563.48,
"clock": "12:19:15",
"text": "シーレの領収の推定はできるわけだからその範囲内だったそのままポンとやってあげるわけじゃないそれ"
},
{
"file": "seg_016.ts",
"start": 563.48,
"end": 572.76,
"clock": "12:19:23",
"text": "非常に簡易的で簡単だということなんですよだからそういうことはねもっとねちゃんと そういう事業者のね"
},
{
"file": "seg_016.ts",
"start": 572.76,
"end": 587.6,
"clock": "12:19:32",
"text": "小さい恋をね広い上げてやってもらいたいということを明快に言っておきますねこれ 飲食量飲食店の場合もね今例えばおじいちゃんおばあちゃん2人でやってる食堂がね"
