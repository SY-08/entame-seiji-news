[
{
"file": "seg_011.ts",
"start": 0.0,
"end": 3.88,
"clock": "11:20:00",
"text": "下げについて政府はぶっかだか対策 であると説明をされています"
},
{
"file": "seg_011.ts",
"start": 3.88,
"end": 8.28,
"clock": "11:20:03",
"text": "しかし欧州などの戦略を見ますと 消費税に相当する負荷値税を引き下げ"
},
{
"file": "seg_011.ts",
"start": 8.28,
"end": 14.84,
"clock": "11:20:08",
"text": "てもその現税分が全て価格に反映 されるとは限らず一部しか価格"
},
{
"file": "seg_011.ts",
"start": 14.84,
"end": 20.12,
"clock": "11:20:14",
"text": "が下がらなかったという例がございます 今回8%から1%に引き下げるわけ"
},
{
"file": "seg_011.ts",
"start": 20.12,
"end": 25.44,
"clock": "11:20:20",
"text": "ですが税抜き価格が変わらない 場合税込み価格は計算上約6.5%"
},
{
"file": "seg_011.ts",
"start": 25.44,
"end": 31.0,
"clock": "11:20:25",
"text": "下がることになります政府は価格 引き下げ効果として食品の税込み"
},
{
"file": "seg_011.ts",
"start": 31.0,
"end": 36.16,
"clock": "11:20:31",
"text": "価格が平均何%下がることを想定 あるいは期待されているんでしょうか"
},
{
"file": "seg_011.ts",
"start": 36.16,
"end": 41.96,
"clock": "11:20:36",
"text": "お答えください 上松徳島財務省主税局長"
},
{
"file": "seg_011.ts",
"start": 41.96,
"end": 47.2,
"clock": "11:20:41",
"text": "お答えいたします委員御指摘のように いわゆる価格点価率が低かった"
},
{
"file": "seg_011.ts",
"start": 47.2,
"end": 52.2,
"clock": "11:20:47",
"text": "国ということもございますけれども 一方で時間をかけて価格点価率"
},
{
"file": "seg_011.ts",
"start": 52.2,
"end": 56.96,
"clock": "11:20:52",
"text": "が上がった国や税率変更の当初 から価格点価率が高かった国も"
},
{
"file": "seg_011.ts",
"start": 56.96,
"end": 61.72,
"clock": "11:20:56",
"text": "あるところでございます そして中で我が国をおきまして価格"
},
{
"file": "seg_011.ts",
"start": 61.72,
"end": 65.76,
"clock": "11:21:01",
"text": "は消費税率引き下げ以外の様々 な要因によって変動するもので"
},
{
"file": "seg_011.ts",
"start": 65.76,
"end": 70.2,
"clock": "11:21:05",
"text": "ございまして税込み価格がどの程度 引き下げるかについて拡大ルミ"
},
{
"file": "seg_011.ts",
"start": 70.2,
"end": 74.6,
"clock": "11:21:10",
"text": "投資を回し上げることは困難であり 想定を置くことは難しいところ"
},
{
"file": "seg_011.ts",
"start": 74.6,
"end": 79.04,
"clock": "11:21:14",
"text": "でございますけれども社会補償国民会議 の実務社会議においてヒアリング"
},
{
"file": "seg_011.ts",
"start": 79.04,
"end": 83.64,
"clock": "11:21:19",
"text": "を行いまして行理事業者の各団体 からは価格はある程度は引き下がる"
},
{
"file": "seg_011.ts",
"start": 83.64,
"end": 88.24,
"clock": "11:21:23",
"text": "だろうとの意見を多く示されている とことでございます消費税の税率"
},
{
"file": "seg_011.ts",
"start": 88.24,
"end": 92.88,
"clock": "11:21:28",
"text": "引き下げ分については価格に反映 されるものと考えてございます"
},
{
"file": "seg_011.ts",
"start": 92.88,
"end": 97.76,
"clock": "11:21:32",
"text": "小入里さやか君 ありがとうございます時間をかけて引き下がる例が"
},
{
"file": "seg_011.ts",
"start": 97.76,
"end": 101.76,
"clock": "11:21:37",
"text": "あるということですが二年限定 ですのでその上税率を戻す"
},
{
"file": "seg_011.ts",
"start": 101.76,
"end": 107.04,
"clock": "11:21:41",
"text": "ということでございますのでその 効果というのは本当に検証する"
},
{
"file": "seg_011.ts",
"start": 107.04,
"end": 111.84,
"clock": "11:21:47",
"text": "ことすらもできないのではないか という疑問がございます"
},
{
"file": "seg_011.ts",
"start": 111.84,
"end": 117.32,
"clock": "11:21:51",
"text": "後ほど伺う日本版同時の件につき ましても資質に対する非応対効果"
},
{
"file": "seg_011.ts",
"start": 117.32,
"end": 121.4,
"clock": "11:21:57",
"text": "という部分でEBPMをきちっと 検証していきましょうということで"
},
{
"file": "seg_011.ts",
"start": 121.4,
"end": 126.04,
"clock": "11:22:01",
"text": "設置されたものだと認識しております ので今回の食料品の消費税現在"
},
{
"file": "seg_011.ts",
"start": 126.04,
"end": 131.6,
"clock": "11:22:06",
"text": "であるならば税率引き下げで実際 にどの程度下がるのか国民の"
},
{
"file": "seg_011.ts",
"start": 131.6,
"end": 136.12,
"clock": "11:22:11",
"text": "購買力が実質的にどのくらい改善 するのかであと中小企業飲食"
},
{
"file": "seg_011.ts",
"start": 136.12,
"end": 140.12,
"clock": "11:22:16",
"text": "手の主役にどういう影響が出るのか そういったことを必ず検証して"
},
{
"file": "seg_011.ts",
"start": 140.12,
"end": 143.8,
"clock": "11:22:20",
"text": "いただきたいとお願いしますお願い申し上げ ます"
},
{
"file": "seg_011.ts",
"start": 143.8,
"end": 150.32,
"clock": "11:22:23",
"text": "そこで勝山大臣に伺います食品消費税 1%適用後に食品価格が"
},
{
"file": "seg_011.ts",
"start": 150.32,
"end": 156.6,
"clock": "11:22:30",
"text": "政府の想定する水準が下がるという 今水準は示されませんでしたけれども"
},
{
"file": "seg_011.ts",
"start": 156.6,
"end": 160.88,
"clock": "11:22:36",
"text": "下がることを前提にしているという お話はございましたので下がらなかった"
},
{
"file": "seg_011.ts",
"start": 160.88,
"end": 167.4,
"clock": "11:22:40",
"text": "場合ですねそういう下がるという 目標を達成するために何らかの追加"
},
{
"file": "seg_011.ts",
"start": 167.4,
"end": 174.6,
"clock": "11:22:47",
"text": "政策を予定されているんでしょうか 片山国務大臣まず下がらなかった"
},
{
"file": "seg_011.ts",
"start": 174.6,
"end": 178.44,
"clock": "11:22:54",
"text": "例もあるというお話もおっしゃって ましたがイギリスがコロナの時"
},
{
"file": "seg_011.ts",
"start": 178.44,
"end": 183.6,
"clock": "11:22:58",
"text": "に明確に雇用維持等目的として イギリスの不可可実実を一部引き"
},
{
"file": "seg_011.ts",
"start": 183.6,
"end": 188.96,
"clock": "11:23:03",
"text": "下げてこれ価格への範囲は一議 的な目的としないと増賞が表明"
},
{
"file": "seg_011.ts",
"start": 188.96,
"end": 196.04,
"clock": "11:23:08",
"text": "したというそういった例もございました が最近ウクライナ等の物価上昇の"
},
{
"file": "seg_011.ts",
"start": 196.04,
"end": 200.8,
"clock": "11:23:16",
"text": "次の山の2022年以降ですねポルト ガルスペインスウェーデンポーランド"
},
{
"file": "seg_011.ts",
"start": 200.8,
"end": 205.8,
"clock": "11:23:20",
"text": "等が主に食料品を中心とした不可可 事例率の次元的な汽下げをいずれ"
},
{
"file": "seg_011.ts",
"start": 205.8,
"end": 208.68,
"clock": "11:23:25",
"text": "もやっておりまだやっている ところもありますがこれは四か"
},
{
"file": "seg_011.ts",
"start": 208.68,
"end": 213.16,
"clock": "11:23:28",
"text": "国いずれにおいても非常に高い 100%と言っているところもあります"
},
{
"file": "seg_011.ts",
"start": 213.16,
"end": 216.88,
"clock": "11:23:33",
"text": "が価格典化率が認められている という分析である実際にある"
},
{
"file": "seg_011.ts",
"start": 216.88,
"end": 221.4,
"clock": "11:23:36",
"text": "ことは申し上げております スウェーデンでは国民の価格の小麦"
},
{
"file": "seg_011.ts",
"start": 221.4,
"end": 226.48,
"clock": "11:23:41",
"text": "の価格が下がったり通過度で 通過度で価格を抑制しやすい状況"
},
{
"file": "seg_011.ts",
"start": 226.48,
"end": 232.12,
"clock": "11:23:46",
"text": "ではあったもののほぼ完全転化という 分析が国会等にも出ているという"
},
{
"file": "seg_011.ts",
"start": 232.12,
"end": 237.4,
"clock": "11:23:52",
"text": "かそういう分析がされています その上で仮に様々な要因で飲食"
},
{
"file": "seg_011.ts",
"start": 237.4,
"end": 241.92,
"clock": "11:23:57",
"text": "料品の本体価格が上がったとして も総理も何度もお答えして"
},
{
"file": "seg_011.ts",
"start": 241.92,
"end": 246.52,
"clock": "11:24:01",
"text": "ますが消費税の税率引き下げ 分については価格に反映される"
},
{
"file": "seg_011.ts",
"start": 246.52,
"end": 250.2,
"clock": "11:24:06",
"text": "と認識をしております また関係府省連絡会議という"
},
{
"file": "seg_011.ts",
"start": 250.2,
"end": 255.32,
"clock": "11:24:10",
"text": "のも組成しておりますが国民の 皆様に向けた広報活動に加えて"
},
{
"file": "seg_011.ts",
"start": 255.32,
"end": 259.76,
"clock": "11:24:15",
"text": "価格同行の把握などをしっかり 行うことも通じて税率引き下げ"
},
{
"file": "seg_011.ts",
"start": 259.76,
"end": 263.92,
"clock": "11:24:19",
"text": "の効果が着実に発言するよう取り 組むこととしておりその効果"
},
{
"file": "seg_011.ts",
"start": 263.92,
"end": 269.6,
"clock": "11:24:23",
"text": "はしっかりと見極めてまいります お尋ねの食料品価格等が下がら"
},
{
"file": "seg_011.ts",
"start": 269.6,
"end": 273.44,
"clock": "11:24:29",
"text": "なかった場合でございますが これは家庭の非常に大きな家庭"
},
{
"file": "seg_011.ts",
"start": 273.44,
"end": 277.76,
"clock": "11:24:33",
"text": "の質問なのでお答えは控えます けれども一旦してもしっかりと"
},
{
"file": "seg_011.ts",
"start": 277.76,
"end": 282.76,
"clock": "11:24:37",
"text": "ご指摘があったような物価同行等 の影響等を適切に中止してこれに"
},
{
"file": "seg_011.ts",
"start": 282.76,
"end": 286.88,
"clock": "11:24:42",
"text": "対してはしっかりと対応してまいり たいと考えております"
},
{
"file": "seg_011.ts",
"start": 286.88,
"end": 290.16,
"clock": "11:24:46",
"text": "しょういりさえか君 ありがとうございます"
},
{
"file": "seg_011.ts",
"start": 290.16,
"end": 294.28,
"clock": "11:24:50",
"text": "目標の数値がないので目標の 成立もわからないという部分"
},
{
"file": "seg_011.ts",
"start": 294.28,
"end": 299.84,
"clock": "11:24:54",
"text": "で難しいお答えになったかとは 思いますただ物価だか対策と"
},
{
"file": "seg_011.ts",
"start": 299.84,
"end": 306.08,
"clock": "11:24:59",
"text": "目を打ったからには成立分引 下げを目標にするわけではなくて"
},
{
"file": "seg_011.ts",
"start": 306.08,
"end": 309.36,
"clock": "11:25:06",
"text": "全体の価格が引き下がらないと 国民にとっては何の意味もない"
},
{
"file": "seg_011.ts",
"start": 309.36,
"end": 314.96,
"clock": "11:25:09",
"text": "ということで全体の引下げ効果 というのを意識して次の政策"
},
{
"file": "seg_011.ts",
"start": 314.96,
"end": 319.92,
"clock": "11:25:14",
"text": "を打っていただきたいと思います その上で次の質問は飛ばさせて"
},
{
"file": "seg_011.ts",
"start": 319.92,
"end": 324.96,
"clock": "11:25:19",
"text": "いただきます時間の関係で 外食事業者への損失の部分に"
},
{
"file": "seg_011.ts",
"start": 324.96,
"end": 329.48,
"clock": "11:25:24",
"text": "ついて伺ってまいりたいと思います 今回農家さんや漁業者さんに"
},
{
"file": "seg_011.ts",
"start": 329.48,
"end": 334.0,
"clock": "11:25:29",
"text": "ついては消費税率の引下げによる 経営の影響に対応するため資金"
},
{
"file": "seg_011.ts",
"start": 334.0,
"end": 339.28,
"clock": "11:25:34",
"text": "グリ支援のほか一定の事業者に対して 売上げたかに応じた給付を行う"
},
{
"file": "seg_011.ts",
"start": 339.28,
"end": 343.6,
"clock": "11:25:39",
"text": "仕組みが検討されています しかしながら外食産業においては"
},
{
"file": "seg_011.ts",
"start": 343.6,
"end": 347.8,
"clock": "11:25:43",
"text": "貸付による資金グリ支援や テイクアウト等への高くかの"
},
{
"file": "seg_011.ts",
"start": 347.8,
"end": 351.52,
"clock": "11:25:47",
"text": "支援さらには消費化支援などが 中心となっております"
},
{
"file": "seg_011.ts",
"start": 351.52,
"end": 355.6,
"clock": "11:25:51",
"text": "これまでの答弁で飲食店が 購入る形状の不利益についても"
},
{
"file": "seg_011.ts",
"start": 355.6,
"end": 361.16,
"clock": "11:25:55",
"text": "業界団体からヒアリングを行いながら 支援内容検討されているとのことでした"
},
{
"file": "seg_011.ts",
"start": 361.16,
"end": 364.32,
"clock": "11:26:01",
"text": "ぜひとも実現していただきたい と思っておりますけれども"
},
{
"file": "seg_011.ts",
"start": 364.32,
"end": 375.57,
"clock": "11:26:04",
"text": "その意気込みを聞かせてください 川南県農林水産省大臣官房総括審議官"
},
{
"file": "seg_011.ts",
"start": 375.57,
"end": 379.69,
"clock": "11:26:15",
"text": "お答え申し上げます 外食事業者に対する支援につきましては"
},
{
"file": "seg_011.ts",
"start": 379.69,
"end": 384.33,
"clock": "11:26:19",
"text": "外食にもさまざまな規模業態があって 生じる影響もそれぞれに異なると"
},
{
"file": "seg_011.ts",
"start": 384.33,
"end": 389.01,
"clock": "11:26:24",
"text": "考えられますことから対応に当たり ましては事業者の皆さんの実情を"
},
{
"file": "seg_011.ts",
"start": 389.01,
"end": 393.73,
"clock": "11:26:29",
"text": "確認しつつ実際に影響を受ける 方々に向けた的確な支援を講じる"
},
{
"file": "seg_011.ts",
"start": 393.73,
"end": 398.85,
"clock": "11:26:33",
"text": "ことが重要と考えてございます このため対抗におきましては影響"
},
{
"file": "seg_011.ts",
"start": 398.85,
"end": 402.53,
"clock": "11:26:38",
"text": "の及ぶ業態などを見極めた上で 的確な支援を講ずるとの方針を"
},
{
"file": "seg_011.ts",
"start": 402.53,
"end": 406.19,
"clock": "11:26:42",
"text": "明記しているところでございまして 農林からも今お話いただきました"
},
{
"file": "seg_011.ts",
"start": 406.19,
"end": 410.45,
"clock": "11:26:46",
"text": "けれども現在さまざまな規模の あるいは業態への外食事業の"
},
{
"file": "seg_011.ts",
"start": 410.45,
"end": 415.01,
"clock": "11:26:50",
"text": "業界からどのような影響が懸念を されるかまたどのような支援が"
},
{
"file": "seg_011.ts",
"start": 415.01,
"end": 418.93,
"clock": "11:26:55",
"text": "必要かといったことをお伺いしている ところでございますこれを"
},
{
"file": "seg_011.ts",
"start": 418.93,
"end": 422.97,
"clock": "11:26:58",
"text": "競しながら決支援内容の検討を 進めているところでございまして"
},
{
"file": "seg_011.ts",
"start": 422.97,
"end": 427.49,
"clock": "11:27:02",
"text": "引き続きこういった皆様の声を 丁寧に伺いながら今後の予算編成"
},
{
"file": "seg_011.ts",
"start": 427.49,
"end": 431.69,
"clock": "11:27:07",
"text": "過程においてしっかりと具体化 をしていくとともに来年4月の"
},
{
"file": "seg_011.ts",
"start": 431.69,
"end": 435.29,
"clock": "11:27:11",
"text": "税率引き下げまでに具体的な 措置が講じられるよう取り"
},
{
"file": "seg_011.ts",
"start": 435.29,
"end": 438.21,
"clock": "11:27:15",
"text": "くんでもありたいと考えて ございます"
},
{
"file": "seg_011.ts",
"start": 438.21,
"end": 440.21,
"clock": "11:27:18",
"text": "塩入り茅彰君"
},
{
"file": "seg_011.ts",
"start": 440.21,
"end": 445.93,
"clock": "11:27:20",
"text": "はいありがとうございます是非ともしっかり とした保証をお願いしたいということで"
},
{
"file": "seg_011.ts",
"start": 445.93,
"end": 450.29,
"clock": "11:27:25",
"text": "まずこちらのパネルを見ていただき たいと思います"
},
{
"file": "seg_011.ts",
"start": 450.29,
"end": 455.09,
"clock": "11:27:30",
"text": "これは食品の消費税率が引き下げられて も飲食店の食材資入れ価格が"
},
{
"file": "seg_011.ts",
"start": 455.09,
"end": 460.97,
"clock": "11:27:35",
"text": "下がらなかった場合飲食店の 収益がどうなるかという"
},
{
"file": "seg_011.ts",
"start": 460.97,
"end": 466.57,
"clock": "11:27:40",
"text": "これは現行の理論通りに食材の 資入れ価格が値下がりしたときの"
},
{
"file": "seg_011.ts",
"start": 466.57,
"end": 471.41,
"clock": "11:27:46",
"text": "図柄計算書を見ていただいて おりますけれどもこの場合"
},
{
"file": "seg_011.ts",
"start": 471.41,
"end": 478.73,
"clock": "11:27:51",
"text": "6.5%正確には6.48%下がった場合 ということで計算をしております"
},
{
"file": "seg_011.ts",
"start": 478.73,
"end": 488.21,
"clock": "11:27:58",
"text": "このときには食材の資入れ価格 下がらなくても予定通り下がった"
},
{
"file": "seg_011.ts",
"start": 488.21,
"end": 497.47,
"clock": "11:28:08",
"text": "税率通り引き下がった場合において は農税額というのは"
},
{
"file": "seg_011.ts",
"start": 497.47,
"end": 500.11,
"clock": "11:28:17",
"text": "変わらないと"
},
{
"file": "seg_011.ts",
"start": 500.11,
"end": 505.15,
"clock": "11:28:20",
"text": "消費税農税後の利益というのは 変わらないということがわかると思います"
},
{
"file": "seg_011.ts",
"start": 505.15,
"end": 507.79,
"clock": "11:28:25",
"text": "次のパネルをお願いします"
},
{
"file": "seg_011.ts",
"start": 507.79,
"end": 512.51,
"clock": "11:28:27",
"text": "これ1億先ほどと同じくですね"
},
{
"file": "seg_011.ts",
"start": 512.51,
"end": 519.03,
"clock": "11:28:32",
"text": "1億1000万円の飲食店が税込み 3780万円で仕入れていた食材"
},
{
"file": "seg_011.ts",
"start": 519.03,
"end": 522.79,
"clock": "11:28:39",
"text": "ですねこれが"
},
{
"file": "seg_011.ts",
"start": 522.95,
"end": 527.75,
"clock": "11:28:42",
"text": "税率通り下がらなかった場合先ほど は6.48%で計算しましたが"
},
{
"file": "seg_011.ts",
"start": 527.75,
"end": 532.19,
"clock": "11:28:47",
"text": "その約半分として3.25%で計算を しております"
},
{
"file": "seg_011.ts",
"start": 532.19,
"end": 538.51,
"clock": "11:28:52",
"text": "同じく売上1億1000万円ですけれども 資入れ向上税額が1%に激減しますので"
},
{
"file": "seg_011.ts",
"start": 538.51,
"end": 543.43,
"clock": "11:28:58",
"text": "売上以上に消費税の農税額が増えて 消費税農税後の利益というのは"
},
{
"file": "seg_011.ts",
"start": 543.43,
"end": 546.79,
"clock": "11:29:03",
"text": "がじになります"
},
{
"file": "seg_011.ts",
"start": 546.79,
"end": 552.51,
"clock": "11:29:06",
"text": "つまり政府の制度変更によって 外食事業者には新たな損失が"
},
{
"file": "seg_011.ts",
"start": 552.51,
"end": 558.35,
"clock": "11:29:12",
"text": "生じうるということがこの計算書 でわかるわけです"
},
{
"file": "seg_011.ts",
"start": 558.35,
"end": 562.03,
"clock": "11:29:18",
"text": "資金繰りのための融資というのは 当然後で返済しなければならない"
},
{
"file": "seg_011.ts",
"start": 562.03,
"end": 566.99,
"clock": "11:29:22",
"text": "ですししかも利資がついてまいります またテイクアートへの業態転換"
},
{
"file": "seg_011.ts",
"start": 566.99,
"end": 571.27,
"clock": "11:29:26",
"text": "とか小緑化これも全ての飲食店 で可能なわけではありません"
},
{
"file": "seg_011.ts",
"start": 571.27,
"end": 575.95,
"clock": "11:29:31",
"text": "こうした形状の振り焼きについて は融資や業態転換の支援だけ"
},
{
"file": "seg_011.ts",
"start": 575.95,
"end": 581.79,
"clock": "11:29:35",
"text": "ではなく実際に発生した損失を 踏まえた直接的な給付保証"
},
{
"file": "seg_011.ts",
"start": 581.79,
"end": 586.31,
"clock": "11:29:41",
"text": "こういったものをしっかりと 講じていただきたいと心からお願い"
},
{
"file": "seg_011.ts",
"start": 586.31,
"end": 589.43,
"clock": "11:29:46",
"text": "申し上げます"
},
{
"file": "seg_011.ts",
"start": 589.43,
"end": 597.83,
"clock": "11:29:49",
"text": "そして支援じゃなくて保証という のをお願いしたいんですねという"
},
{
"file": "seg_011.ts",
"start": 597.83,
"end": 600.31,
