[
{
"file": "seg_006.ts",
"start": 0.0,
"end": 7.64,
"clock": "10:30:00",
"text": "佐々木理事長ありがとうございます 今回の補助金は来年の4月に間に合わせる"
},
{
"file": "seg_006.ts",
"start": 7.64,
"end": 11.84,
"clock": "10:30:07",
"text": "というのが最優先でその項の対応 は考慮されないということはちょっと"
},
{
"file": "seg_006.ts",
"start": 11.84,
"end": 17.7,
"clock": "10:30:11",
"text": "残念ではございますが今後も税率 が一定とは限りませんだからこそ"
},
{
"file": "seg_006.ts",
"start": 17.7,
"end": 22.66,
"clock": "10:30:17",
"text": "税率変更に要因対応できるシステム を国内の事業者に復旧させる"
},
{
"file": "seg_006.ts",
"start": 22.66,
"end": 26.82,
"clock": "10:30:22",
"text": "べきだと考えております 税率変更の度に補助金が必要と"
},
{
"file": "seg_006.ts",
"start": 26.82,
"end": 31.26,
"clock": "10:30:26",
"text": "なればやはり今回のような政策 判断にも影響してまいります"
},
{
"file": "seg_006.ts",
"start": 31.26,
"end": 37.02,
"clock": "10:30:31",
"text": "今回は難しくても是非2年後の改修 では将来の税率変更にも柔軟に対応"
},
{
"file": "seg_006.ts",
"start": 37.02,
"end": 41.02,
"clock": "10:30:37",
"text": "できること補助要件に盛り込む などまた前向きな検討をお願い"
},
{
"file": "seg_006.ts",
"start": 41.02,
"end": 46.34,
"clock": "10:30:41",
"text": "したいと思います 次に特に農業 漁業者の現場についてお伺い"
},
{
"file": "seg_006.ts",
"start": 46.34,
"end": 51.46,
"clock": "10:30:46",
"text": "をさせていただきたいと思います 農産物や水産物の直売上農業"
},
{
"file": "seg_006.ts",
"start": 51.46,
"end": 56.38,
"clock": "10:30:51",
"text": "漁業の販売システムでもレジ だけでなく生産や会計との"
},
{
"file": "seg_006.ts",
"start": 56.38,
"end": 60.18,
"clock": "10:30:56",
"text": "連携を含めて改修が必要となる 可能性があります"
},
{
"file": "seg_006.ts",
"start": 60.18,
"end": 64.82,
"clock": "10:31:00",
"text": "で来年4月までに準備をおいられる か費用負担はどうなっているか"
},
{
"file": "seg_006.ts",
"start": 64.82,
"end": 70.34,
"clock": "10:31:04",
"text": "現場には不安があります こうした直売上や農業漁業に対して"
},
{
"file": "seg_006.ts",
"start": 70.34,
"end": 74.5,
"clock": "10:31:10",
"text": "いつどのような経路で必要な 対応を周知するのでしょうか"
},
{
"file": "seg_006.ts",
"start": 74.5,
"end": 79.74,
"clock": "10:31:14",
"text": "また令和9年4月の開始までね 改修を完了できるようコスト面"
},
{
"file": "seg_006.ts",
"start": 79.74,
"end": 85.62,
"clock": "10:31:19",
"text": "も含めてどのような支援も行って いくのかお伺いいたします"
},
{
"file": "seg_006.ts",
"start": 85.62,
"end": 91.98,
"clock": "10:31:25",
"text": "小林大輝農林水産省経営局長 お答え申し上げます"
},
{
"file": "seg_006.ts",
"start": 91.98,
"end": 97.74,
"clock": "10:31:31",
"text": "令和9年4月からの消費税率の引き下げ につきまして直売上農業漁業"
},
{
"file": "seg_006.ts",
"start": 97.74,
"end": 101.58,
"clock": "10:31:37",
"text": "協を始めとするこの事業者におかれ ましてはレジ回収などのさまざま"
},
{
"file": "seg_006.ts",
"start": 101.58,
"end": 104.02,
"clock": "10:31:41",
"text": "な準備が必要になると見込まれて おります"
},
{
"file": "seg_006.ts",
"start": 104.02,
"end": 108.26,
"clock": "10:31:44",
"text": "政府としてはこうした準備を事業 者がしっかり行うことができます"
},
{
"file": "seg_006.ts",
"start": 108.26,
"end": 114.46,
"clock": "10:31:48",
"text": "よ先月立ち上げた関係省庁連絡 会議におきましても関係府省庁"
},
{
"file": "seg_006.ts",
"start": 114.46,
"end": 118.26,
"clock": "10:31:54",
"text": "庁が連携し周知等を行っていく こと等しております"
},
{
"file": "seg_006.ts",
"start": 118.26,
"end": 123.58,
"clock": "10:31:58",
"text": "またこのほか農林水産省といた しましても各業界団体向けの"
},
{
"file": "seg_006.ts",
"start": 123.58,
"end": 128.82,
"clock": "10:32:03",
"text": "全国説明会でありますとかブロック 別説明会の開催それから例えば"
},
{
"file": "seg_006.ts",
"start": 128.82,
"end": 135.02,
"clock": "10:32:08",
"text": "蓄産だとか漁業だといったような 業種別の団体を通じた厚生に"
},
{
"file": "seg_006.ts",
"start": 135.02,
"end": 139.3,
"clock": "10:32:15",
"text": "対する周知などを行うべく準備 検討しているところでございます"
},
{
"file": "seg_006.ts",
"start": 139.3,
"end": 142.2,
"clock": "10:32:19",
"text": "また支援でございますけれども 先ほど答弁がありましたとおり"
},
{
"file": "seg_006.ts",
"start": 142.2,
"end": 145.8,
"clock": "10:32:22",
"text": "でございますけれどもこうした 事業者が活用できる支援策も含め"
},
{
"file": "seg_006.ts",
"start": 145.8,
"end": 149.96,
"clock": "10:32:25",
"text": "ましてしっかり周知説明を行いまして 事業者に準備いただけるよう"
},
{
"file": "seg_006.ts",
"start": 149.96,
"end": 153.04,
"clock": "10:32:29",
"text": "対応してまいりたいと考えて ございます"
},
{
"file": "seg_006.ts",
"start": 153.04,
"end": 154.84,
"clock": "10:32:33",
"text": "佐々木理恵君"
},
{
"file": "seg_006.ts",
"start": 154.84,
"end": 159.86,
"clock": "10:32:34",
"text": "ありがとうございます現場で実際に 回収が進んでいるかしっかりと"
},
{
"file": "seg_006.ts",
"start": 159.86,
"end": 164.06,
"clock": "10:32:39",
"text": "進捗まで確認の方をお願いいた します"
},
{
"file": "seg_006.ts",
"start": 164.06,
"end": 168.56,
"clock": "10:32:44",
"text": "次に農業者漁業者の経営への 影響についてお伺いいたします"
},
{
"file": "seg_006.ts",
"start": 168.56,
"end": 173.84,
"clock": "10:32:48",
"text": "食料品の消費税率が8%から 1%になる一方で"
},
{
"file": "seg_006.ts",
"start": 173.84,
"end": 180.44,
"clock": "10:32:53",
"text": "批量や資料ガソリン農業機械など の資料では引き続き10%かかります"
},
{
"file": "seg_006.ts",
"start": 180.44,
"end": 186.44,
"clock": "10:33:00",
"text": "で音速課税では資料税額工場や カンプがありますがカンプまでの"
},
{
"file": "seg_006.ts",
"start": 186.44,
"end": 190.24,
"clock": "10:33:06",
"text": "資金繰りが大きな課題になって くると思います"
},
{
"file": "seg_006.ts",
"start": 190.24,
"end": 195.8,
"clock": "10:33:10",
"text": "また簡易課税や免税事業者では 仕組みが異なり生産者によって"
},
{
"file": "seg_006.ts",
"start": 195.8,
"end": 198.2,
"clock": "10:33:15",
"text": "影響に差が生じます"
},
{
"file": "seg_006.ts",
"start": 198.2,
"end": 204.2,
"clock": "10:33:18",
"text": "農水省は風へ方式ごとの経営への 影響をどう見込みそして給付等を"
},
{
"file": "seg_006.ts",
"start": 204.2,
"end": 208.96,
"clock": "10:33:24",
"text": "含めてどのように対応される 予定かお伺いいたします"
},
{
"file": "seg_006.ts",
"start": 208.96,
"end": 217.77,
"clock": "10:33:28",
"text": "小林大紀経営局長 お答え申し上げます"
},
{
"file": "seg_006.ts",
"start": 217.77,
"end": 221.85,
"clock": "10:33:37",
"text": "今般の飲食料品の消費税率の 引き下げによりまして一般に"
},
{
"file": "seg_006.ts",
"start": 221.85,
"end": 225.49,
"clock": "10:33:41",
"text": "農林水産物を販売する農林漁業者 におかれましては"
},
{
"file": "seg_006.ts",
"start": 225.49,
"end": 228.87,
"clock": "10:33:45",
"text": "売上から回収できないシリーズ 経営がこれが生じるものと考えて"
},
{
"file": "seg_006.ts",
"start": 229.85,
"end": 233.43,
"clock": "10:33:49",
"text": "この場合本則課税事業者につきましては"
},
{
"file": "seg_006.ts",
"start": 233.43,
"end": 239.73,
"clock": "10:33:53",
"text": "先ほどの御指摘の通り各事業年度の 市入れ税額が売上税額を余った場合に"
},
{
"file": "seg_006.ts",
"start": 239.73,
"end": 246.13,
"clock": "10:33:59",
"text": "その差額が事業終了時に5人 勘付されるという仕組みになっているわけで"
},
{
"file": "seg_006.ts",
"start": 246.13,
"end": 249.93,
"clock": "10:34:06",
"text": "ございますけれどもその勘付を 受けるまでの勘の資金繰り"
},
{
"file": "seg_006.ts",
"start": 249.93,
"end": 252.15,
"clock": "10:34:09",
"text": "これに影響が生じる懸念がございます"
},
{
"file": "seg_006.ts",
"start": 252.15,
"end": 257.13,
"clock": "10:34:12",
"text": "また簡易課税事業者でありますとか 免税事業者につきましては"
},
{
"file": "seg_006.ts",
"start": 257.13,
"end": 261.13,
"clock": "10:34:17",
"text": "本則課税事業者のようなこうした 勘付を受ける仕組みそのものがないために"
},
{
"file": "seg_006.ts",
"start": 261.13,
"end": 264.67,
"clock": "10:34:21",
"text": "売上から回収できないシリーズ 経営がこれが大きくなることで"
},
{
"file": "seg_006.ts",
"start": 264.67,
"end": 267.31,
"clock": "10:34:24",
"text": "経営に影響が生じる懸念がございます"
},
{
"file": "seg_006.ts",
"start": 267.31,
"end": 271.87,
"clock": "10:34:27",
"text": "このため本則課税に移行することが 困難な簡易課税事業者"
},
{
"file": "seg_006.ts",
"start": 271.87,
"end": 275.07,
"clock": "10:34:31",
"text": "免税事業者であります農林業業者 につきましては"
},
{
"file": "seg_006.ts",
"start": 275.07,
"end": 280.27,
"clock": "10:34:35",
"text": "個別の売上高を踏まえた金額 これを給付する仕組みこれを導入すること"
},
{
"file": "seg_006.ts",
"start": 280.27,
"end": 285.83,
"clock": "10:34:40",
"text": "また本則課税事業者も含めた 農林業業者につきましては"
},
{
"file": "seg_006.ts",
"start": 285.83,
"end": 291.53,
"clock": "10:34:45",
"text": "資金倫理についても支援を行う という方針が対抗に明記されたところでございまして"
},
{
"file": "seg_006.ts",
"start": 291.53,
"end": 295.67,
"clock": "10:34:51",
"text": "農林水産省といたしましては この対抗の考え方のもと"
},
{
"file": "seg_006.ts",
"start": 295.67,
"end": 301.67,
"clock": "10:34:55",
"text": "予算編成過程において支援の内容 の具体化を進めてまいりたいと考えてございます"
},
{
"file": "seg_006.ts",
"start": 301.67,
"end": 303.03,
"clock": "10:35:01",
"text": "佐々木入りへ君"
},
{
"file": "seg_006.ts",
"start": 303.03,
"end": 308.43,
"clock": "10:35:03",
"text": "はいありがとうございます同じものを生産 していっても風保針によって"
},
{
"file": "seg_006.ts",
"start": 308.43,
"end": 313.33,
"clock": "10:35:08",
"text": "影響が違うわけでございますので 特に小規模の他ほど制度を理解するのが"
},
{
"file": "seg_006.ts",
"start": 313.33,
"end": 317.33,
"clock": "10:35:13",
"text": "難しいと思いますのでフォロアップ の方をお願いしたいと思います"
},
{
"file": "seg_006.ts",
"start": 317.33,
"end": 324.09,
"clock": "10:35:17",
"text": "次に取引価格への影響です例えば 流通小売りの段階で消費税の"
},
{
"file": "seg_006.ts",
"start": 324.09,
"end": 329.09,
"clock": "10:35:24",
"text": "担保を受けるまで資金繰りに先ほど も申し取りますが負担が生じる場合"
},
{
"file": "seg_006.ts",
"start": 329.09,
"end": 335.57,
"clock": "10:35:29",
"text": "その負担がシーデ先に転化され農林水産物 の本体価格まで引き下がるような"
},
{
"file": "seg_006.ts",
"start": 335.57,
"end": 342.85,
"clock": "10:35:35",
"text": "生産者が求められることがそういう ことはないように懸念をしております"
},
{
"file": "seg_006.ts",
"start": 342.85,
"end": 349.05,
"clock": "10:35:42",
"text": "もちろんそうした値下げ発力が一 立に発生すると断定するものでは"
},
{
"file": "seg_006.ts",
"start": 349.05,
"end": 354.61,
"clock": "10:35:49",
"text": "ありませんが国民の負担を軽く するための厳税が生産者の所得"
},
{
"file": "seg_006.ts",
"start": 354.61,
"end": 358.73,
"clock": "10:35:54",
"text": "を圧迫するという結果となって は本末伝統でございます"
},
{
"file": "seg_006.ts",
"start": 358.73,
"end": 365.01,
"clock": "10:35:58",
"text": "厳税を理由とした農産物の本体 の価格を引き下げるのと不正"
},
{
"file": "seg_006.ts",
"start": 365.01,
"end": 370.85,
"clock": "10:36:05",
"text": "化農業者業業者の所得に不利益 が生じないようどのような対策を"
},
{
"file": "seg_006.ts",
"start": 370.85,
"end": 378.21,
"clock": "10:36:10",
"text": "講じるか大臣にお伺いいたします 竹部新田農林水産大臣"
},
{
"file": "seg_006.ts",
"start": 378.21,
"end": 383.53,
"clock": "10:36:18",
"text": "御指摘の税抜き取引価格に関し 食料システム法ではコストに"
},
{
"file": "seg_006.ts",
"start": 383.53,
"end": 388.17,
"clock": "10:36:23",
"text": "関する具体的な根拠を示して 取引条件の協議の申し出があった"
},
{
"file": "seg_006.ts",
"start": 388.17,
"end": 393.89,
"clock": "10:36:28",
"text": "場合には誠実に協議に応じる 胸の努力義務が措置されています"
},
{
"file": "seg_006.ts",
"start": 393.89,
"end": 398.89,
"clock": "10:36:33",
"text": "同方に基づき費用を考慮した取引 が行われる環境の整備を図ること"
},
{
"file": "seg_006.ts",
"start": 398.89,
"end": 404.33,
"clock": "10:36:38",
"text": "により食料の持続的な供給を通じ た農林水産業の発展と消費者"
},
{
"file": "seg_006.ts",
"start": 404.33,
"end": 407.61,
"clock": "10:36:44",
"text": "の利益の増進につなげてまいり たいと考えております"
},
{
"file": "seg_006.ts",
"start": 407.61,
"end": 411.77,
"clock": "10:36:47",
"text": "また農林業業者への給付について は先般閣議決定した対抗に"
},
{
"file": "seg_006.ts",
"start": 411.77,
"end": 416.69,
"clock": "10:36:51",
"text": "おきまして本則課税に合すること が困難な簡易課税事業者"
},
{
"file": "seg_006.ts",
"start": 416.69,
"end": 422.05,
"clock": "10:36:56",
"text": "免税事業者である農林業業者 に対する個別の売上に踏まえ"
},
{
"file": "seg_006.ts",
"start": 422.05,
"end": 427.97,
"clock": "10:37:02",
"text": "た金額を給付する仕組みを導入 するという方針が名記されたところ"
},
{
"file": "seg_006.ts",
"start": 427.97,
"end": 432.49,
"clock": "10:37:07",
"text": "でありましてこうした考えのもと 予算編成方法において支援内容"
},
{
"file": "seg_006.ts",
"start": 432.49,
"end": 437.2,
"clock": "10:37:12",
"text": "の具体化を進めてまいりたい と考えております"
},
{
"file": "seg_006.ts",
"start": 437.2,
"end": 438.52,
"clock": "10:37:17",
"text": "佐々木理恵君"
},
{
"file": "seg_006.ts",
"start": 438.52,
"end": 442.08,
"clock": "10:37:18",
"text": "はいありがとうございますしっかり とコスト資料を担保していただき"
},
{
"file": "seg_006.ts",
"start": 442.08,
"end": 446.38,
"clock": "10:37:22",
"text": "まして厳税を工事に不当な 書いたたきかないようにしっかり"
},
{
"file": "seg_006.ts",
"start": 446.38,
"end": 452.24,
"clock": "10:37:26",
"text": "重視していただきたいと思います 次に給付の仕組みについて"
},
{
"file": "seg_006.ts",
"start": 452.24,
"end": 457.76,
"clock": "10:37:32",
"text": "お伺いいたします今回80万人以上 の農業業業者が給付対象となり"
},
{
"file": "seg_006.ts",
"start": 457.76,
"end": 463.7,
"clock": "10:37:37",
"text": "えますがその多くは小規模事業者 や高齢者の皆さんです新生の"
},
{
"file": "seg_006.ts",
"start": 463.7,
"end": 467.88,
"clock": "10:37:43",
"text": "観測がかかせません 厳税は来年の4月から2年間"
},
{
"file": "seg_006.ts",
"start": 467.88,
"end": 474.12,
"clock": "10:37:47",
"text": "でございますが個人事業主の事業 年度は1月から12月です厳税機関"
},
{
"file": "seg_006.ts",
"start": 474.12,
"end": 479.56,
"clock": "10:37:54",
"text": "に合わせた売上田家の最終形 は大きな負担になります"
},
{
"file": "seg_006.ts",
"start": 479.56,
"end": 485.7,
"clock": "10:37:59",
"text": "で既存の確定申告を活用し追加 の計算や提出処理を最小限に"
},
{
"file": "seg_006.ts",
"start": 485.7,
"end": 490.2,
"clock": "10:38:05",
"text": "おさえ貫訴かつ迅速に給付すべき だと考えますが政府のご"
},
{
"file": "seg_006.ts",
"start": 490.2,
"end": 497.56,
"clock": "10:38:10",
"text": "見解をお伺いいたします 小林大輝経営局長"
},
{
"file": "seg_006.ts",
"start": 497.56,
"end": 502.16,
"clock": "10:38:17",
"text": "お答え申し上げます御指摘の個別 の売上田家を踏まえた金額を"
},
{
"file": "seg_006.ts",
"start": 502.16,
"end": 506.44,
"clock": "10:38:22",
"text": "給付する仕組みにつきましては 現在検討中ではありますけれども"
},
{
"file": "seg_006.ts",
"start": 506.44,
"end": 512.8,
"clock": "10:38:26",
"text": "この個別の売上田家の把握にあた っては確定申告書などの活用も含めて"
},
{
"file": "seg_006.ts",
"start": 512.8,
"end": 518.44,
"clock": "10:38:32",
"text": "検討を行っているところでございます 一方で例えば確定申告書を活用"
},
{
"file": "seg_006.ts",
"start": 518.44,
"end": 525.96,
"clock": "10:38:38",
"text": "する場合には御指摘のとおり4月 から開始される消費税率引上げ"
},
{
"file": "seg_006.ts",
"start": 525.96,
"end": 530.04,
"clock": "10:38:45",
"text": "機関と必ずしも一致しない場合 があるということになるわけ"
},
{
"file": "seg_006.ts",
"start": 530.04,
"end": 534.08,
"clock": "10:38:50",
"text": "でございますけれども私ども といたしましては今般の給付金"
},
{
"file": "seg_006.ts",
"start": 534.08,
"end": 539.08,
"clock": "10:38:54",
"text": "の申請については農林業業者の事務 負担を極力軽減するこういった"
},
{
"file": "seg_006.ts",
"start": 539.08,
"end": 544.24,
"clock": "10:38:59",
"text": "観点から既存の処理を最大限活用 するなどして必要な手続きを検討"
},
{
"file": "seg_006.ts",
"start": 544.24,
"end": 549.86,
"clock": "10:39:04",
"text": "してまいりたいと考えております 佐々木理恵君"
},
{
"file": "seg_006.ts",
"start": 549.86,
"end": 554.82,
"clock": "10:39:09",
"text": "ありがとうございます事務負担とのバランス もしっかりと考えていただいて"
},
{
"file": "seg_006.ts",
"start": 554.82,
"end": 561.22,
"clock": "10:39:14",
"text": "取り組んでいただきたいと思います 次に申請のデジタル化でございます"
},
{
"file": "seg_006.ts",
"start": 561.22,
"end": 567.38,
"clock": "10:39:21",
"text": "で国が整備してきたマイナンバー や高金受取講座で既存の税務"
},
{
"file": "seg_006.ts",
"start": 567.38,
"end": 574.62,
"clock": "10:39:27",
"text": "情報を活用し申請者の負担を減らす べきだと考えます個人情報の適切な"
},
{
"file": "seg_006.ts",
"start": 574.62,
"end": 581.28,
"clock": "10:39:34",
"text": "管理を前点でございますが申請 手続きを担速しデジタル申請"
},
{
"file": "seg_006.ts",
"start": 581.28,
"end": 586.78,
"clock": "10:39:41",
"text": "が難しい高齢者にもマイナンバー カードなどを使い確実に給付"
},
{
"file": "seg_006.ts",
"start": 586.78,
"end": 591.2,
"clock": "10:39:46",
"text": "を届けれるようにしたいという 提案をさせていただきたいのですが"
},
{
"file": "seg_006.ts",
"start": 591.2,
"end": 598.5,
"clock": "10:39:51",
"text": "いかがでしょうかお伺いいたします 小林大紀経営局長"
}
]