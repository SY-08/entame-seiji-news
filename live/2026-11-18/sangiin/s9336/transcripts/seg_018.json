[
{
"file": "seg_018.ts",
"start": 0.0,
"end": 4.44,
"clock": "12:30:00",
"text": "設備を導入してやりましょうとかいうような人はいないわけですから、"
},
{
"file": "seg_018.ts",
"start": 4.44,
"end": 10.28,
"clock": "12:30:04",
"text": "せめてそういう売上の小さい免税事業者についてはね、"
},
{
"file": "seg_018.ts",
"start": 10.28,
"end": 14.6,
"clock": "12:30:10",
"text": "そんな細かいこと言わずに安心してくださいと、"
},
{
"file": "seg_018.ts",
"start": 14.6,
"end": 17.8,
"clock": "12:30:14",
"text": "あんたちにはちゃんとこういう手当てをしました。"
},
{
"file": "seg_018.ts",
"start": 17.8,
"end": 21.84,
"clock": "12:30:17",
"text": "明快に言ってあげれば何の不安もないんだけれども、"
},
{
"file": "seg_018.ts",
"start": 21.84,
"end": 26.0,
"clock": "12:30:21",
"text": "どうなるかわからないというようなことが一番不安になろう。"
},
{
"file": "seg_018.ts",
"start": 26.0,
"end": 31.0,
"clock": "12:30:26",
"text": "じゃあもうやめようかみたいな話をね、している人たちもたくさんいるわけですから、"
},
{
"file": "seg_018.ts",
"start": 31.0,
"end": 37.76,
"clock": "12:30:31",
"text": "そういう意味においてはぜひね、そういった部分に配慮した。"
},
{
"file": "seg_018.ts",
"start": 37.76,
"end": 42.8,
"clock": "12:30:37",
"text": "大手とかはね、自分として勝手にいろんなことをやるわけだから。"
},
{
"file": "seg_018.ts",
"start": 42.8,
"end": 47.76,
"clock": "12:30:42",
"text": "支援しなくたって十分にその中で考えてやってるわけですよ。"
},
{
"file": "seg_018.ts",
"start": 47.76,
"end": 52.52,
"clock": "12:30:47",
"text": "だからそういうことのできない、そういった小さい事業者に、"
},
{
"file": "seg_018.ts",
"start": 52.52,
"end": 60.04,
"clock": "12:30:52",
"text": "どれだけ国がやっぱり配慮をして今回の制度を構築するかとすごく大事なことだと思うんですけど、"
},
{
"file": "seg_018.ts",
"start": 60.04,
"end": 65.84,
"clock": "12:31:00",
"text": "その件についてはね、また引き続きにやっていこうというふうに思っております。"
},
{
"file": "seg_018.ts",
"start": 65.84,
"end": 71.48,
"clock": "12:31:05",
"text": "最後にね、前回、高橋総理にも言ったんですけど、"
},
{
"file": "seg_018.ts",
"start": 71.48,
"end": 79.6,
"clock": "12:31:11",
"text": "この消費税現税の今回の部分で唯一評価できることは消費税を下げたというね、"
},
{
"file": "seg_018.ts",
"start": 79.72,
"end": 84.56,
"clock": "12:31:19",
"text": "ここは本当に評価をできることではあるんです。"
},
{
"file": "seg_018.ts",
"start": 84.56,
"end": 91.24,
"clock": "12:31:24",
"text": "じゃあそしたらそれを本当にもっとね、全ての国民にその恩恵がこう思う、"
},
{
"file": "seg_018.ts",
"start": 91.24,
"end": 95.2,
"clock": "12:31:31",
"text": "次亜に雨が降るようなものにしていかなきゃならないというのが、"
},
{
"file": "seg_018.ts",
"start": 95.2,
"end": 98.4,
"clock": "12:31:35",
"text": "やはり政府がやらなきゃいけないことだと思うんだけども、"
},
{
"file": "seg_018.ts",
"start": 98.4,
"end": 102.84,
"clock": "12:31:38",
"text": "支援金がね、先ほどの議論でもあるように一部の人だけで、"
},
{
"file": "seg_018.ts",
"start": 102.84,
"end": 107.28,
"clock": "12:31:42",
"text": "それで二年後にはね、増税するなんて言うようなことはね、"
},
{
"file": "seg_018.ts",
"start": 107.28,
"end": 113.36,
"clock": "12:31:47",
"text": "これはもう、まあ国民で納得する人はいないと思うんですよ。"
},
{
"file": "seg_018.ts",
"start": 113.36,
"end": 117.72,
"clock": "12:31:53",
"text": "今ずっとレクでね、来るお役人の人に一人一人聞くと、"
},
{
"file": "seg_018.ts",
"start": 117.72,
"end": 121.56,
"clock": "12:31:57",
"text": "もう個人的にどうですかって言ったら、それはもう消費税を下がらないと嬉しいと。"
},
{
"file": "seg_018.ts",
"start": 121.56,
"end": 124.16,
"clock": "12:32:01",
"text": "でもね、財源のことが心配なんですよねって、"
},
{
"file": "seg_018.ts",
"start": 124.16,
"end": 126.8,
"clock": "12:32:04",
"text": "役人は必ずそう言うんだよ、この下っちゃわらたけど、"
},
{
"file": "seg_018.ts",
"start": 126.8,
"end": 134.52,
"clock": "12:32:06",
"text": "国民の多くはそんな財源のことまでね、考えて今回のことをね、思ってる人はいないと思う。"
},
{
"file": "seg_018.ts",
"start": 134.52,
"end": 141.84,
"clock": "12:32:14",
"text": "だから、二年後のね、この増税というものがわかってる中で、"
},
{
"file": "seg_018.ts",
"start": 141.84,
"end": 146.04,
"clock": "12:32:21",
"text": "消費税が下がることをウェルカムっていうふうにね、"
},
{
"file": "seg_018.ts",
"start": 146.04,
"end": 150.8,
"clock": "12:32:26",
"text": "総合的に考えるっていうのは非常に難しいなというふうに思っていて、"
},
{
"file": "seg_018.ts",
"start": 150.8,
"end": 153.4,
"clock": "12:32:30",
"text": "まあある先生と話してたらね、"
},
{
"file": "seg_018.ts",
"start": 153.4,
"end": 160.08,
"clock": "12:32:33",
"text": "いや二年後にね、これをあげないというふうに言ってくれるんだったらね、"
},
{
"file": "seg_018.ts",
"start": 160.08,
"end": 163.04,
"clock": "12:32:40",
"text": "いやこれは良い制度だと思うけど、"
},
{
"file": "seg_018.ts",
"start": 163.04,
"end": 169.0,
"clock": "12:32:43",
"text": "二年後に上がることがわかっている、この制度を決していいと思わないなというようだね、"
},
{
"file": "seg_018.ts",
"start": 169.0,
"end": 170.16,
"clock": "12:32:49",
"text": "そういう声も聞きました。"
},
{
"file": "seg_018.ts",
"start": 170.16,
"end": 172.56,
"clock": "12:32:50",
"text": "まあ今私もいろんな人の声を聞いて、"
},
{
"file": "seg_018.ts",
"start": 172.56,
"end": 176.88,
"clock": "12:32:52",
"text": "やっぱり国民が本当にどう思っているかということを判断しながらね、"
},
{
"file": "seg_018.ts",
"start": 176.88,
"end": 179.92,
"clock": "12:32:56",
"text": "この議論を進めていきたいというふうに思っておりますので、"
},
{
"file": "seg_018.ts",
"start": 179.92,
"end": 183.28,
"clock": "12:32:59",
"text": "まあすぐまた委員会が開催されるようですから、"
},
{
"file": "seg_018.ts",
"start": 183.28,
"end": 187.52,
"clock": "12:33:03",
"text": "引き続き議論をさせていただくことで終わります。"
},
{
"file": "seg_018.ts",
"start": 187.52,
"end": 200.7,
"clock": "12:33:07",
"text": "以上です。"
},
{
"file": "seg_018.ts",
"start": 200.7,
"end": 205.26,
"clock": "12:33:20",
"text": "本日の質疑はこの程度にとどめ、これにて参加いたします。"
}
]