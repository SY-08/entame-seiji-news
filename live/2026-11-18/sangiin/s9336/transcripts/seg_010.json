[
{
"file": "seg_010.ts",
"start": 0.0,
"end": 3.0,
"clock": "11:10:00",
"text": "どうもですか いかがでしょうか"
},
{
"file": "seg_010.ts",
"start": 3.0,
"end": 8.32,
"clock": "11:10:03",
"text": "かさ山国務大臣 まずイタリアの制度は確かですね"
},
{
"file": "seg_010.ts",
"start": 8.32,
"end": 16.28,
"clock": "11:10:08",
"text": "包括任期定がかなり上位の法律 にあって税率の一定の特に食料品"
},
{
"file": "seg_010.ts",
"start": 16.28,
"end": 21.84,
"clock": "11:10:16",
"text": "や生活出身関係だったと思います が挙げ下げが法律事項でなくなって"
},
{
"file": "seg_010.ts",
"start": 21.84,
"end": 25.36,
"clock": "11:10:21",
"text": "る部分があるのでそのような 取扱をしている国が結構ある"
},
{
"file": "seg_010.ts",
"start": 25.36,
"end": 30.92,
"clock": "11:10:25",
"text": "のでそれは今のようなITシステム が非常に整うようになるよりも"
},
{
"file": "seg_010.ts",
"start": 30.92,
"end": 34.36,
"clock": "11:10:30",
"text": "前からやっていたようには承知 しておりますということがございます"
},
{
"file": "seg_010.ts",
"start": 34.36,
"end": 38.48,
"clock": "11:10:34",
"text": "がその上でお答えすると税率 変更のシステムが不十分との"
},
{
"file": "seg_010.ts",
"start": 38.48,
"end": 43.16,
"clock": "11:10:38",
"text": "御指摘につきましては高い数よりも 金手から消費税率を柔軟に変更"
},
{
"file": "seg_010.ts",
"start": 43.16,
"end": 46.76,
"clock": "11:10:43",
"text": "できるシステムなどを構築 する必要性というのはこれはまた"
},
{
"file": "seg_010.ts",
"start": 46.76,
"end": 50.52,
"clock": "11:10:46",
"text": "ベッドの理論で申し上げている ことでございますが今般の対抗"
},
{
"file": "seg_010.ts",
"start": 50.52,
"end": 55.24,
"clock": "11:10:50",
"text": "において緊急時における消費 税率の変更に柔軟に対応できる"
},
{
"file": "seg_010.ts",
"start": 55.24,
"end": 59.52,
"clock": "11:10:55",
"text": "システムの副優促進を図るとされて おりまして先ほど他の委員のご"
},
{
"file": "seg_010.ts",
"start": 59.52,
"end": 64.84,
"clock": "11:10:59",
"text": "質問もありますが充実変更に税率 変更に柔軟に対応できるスマートレース"
},
{
"file": "seg_010.ts",
"start": 64.84,
"end": 68.72,
"clock": "11:11:04",
"text": "システムの導入の支援等も政府 として行っているところでございます"
},
{
"file": "seg_010.ts",
"start": 68.72,
"end": 71.72,
"clock": "11:11:08",
"text": "これはさらにしっかりと対応して まりたいと考えております"
},
{
"file": "seg_010.ts",
"start": 71.72,
"end": 77.04,
"clock": "11:11:11",
"text": "その上で飲食料品の消費税率 1%のへんの引き下げを行っても"
},
{
"file": "seg_010.ts",
"start": 77.04,
"end": 81.16,
"clock": "11:11:17",
"text": "8%の税率が適用される新聞 というのは定期公独のものに"
},
{
"file": "seg_010.ts",
"start": 81.16,
"end": 87.16,
"clock": "11:11:21",
"text": "限られるので行理店で店頭を販売 される税率というのは10%でもと"
},
{
"file": "seg_010.ts",
"start": 87.16,
"end": 91.24,
"clock": "11:11:27",
"text": "もとございますので例えば飲食品 を販売するスーパーマーケット等の"
},
{
"file": "seg_010.ts",
"start": 91.24,
"end": 96.12,
"clock": "11:11:31",
"text": "売上げに適用する税率は引き続き 前と同じ2種類のままでございます"
},
{
"file": "seg_010.ts",
"start": 96.12,
"end": 100.32,
"clock": "11:11:36",
"text": "これも何回もお答えしております がまた新たに税率が3種類となる"
},
{
"file": "seg_010.ts",
"start": 100.32,
"end": 104.76,
"clock": "11:11:40",
"text": "局面は限定的と言うに考えられ ますので御指摘のように鼻から"
},
{
"file": "seg_010.ts",
"start": 104.76,
"end": 109.8,
"clock": "11:11:44",
"text": "四公面から観測原則に反するとは 考えておりません公営注立のこと"
},
{
"file": "seg_010.ts",
"start": 109.8,
"end": 115.64,
"clock": "11:11:49",
"text": "もございますがこれも前般から お答えしているようにうくらいな"
},
{
"file": "seg_010.ts",
"start": 115.64,
"end": 120.36,
"clock": "11:11:55",
"text": "危機が入ってきてぶっかが上がる ようになったと思われる近年数年"
},
{
"file": "seg_010.ts",
"start": 120.36,
"end": 124.58,
"clock": "11:12:00",
"text": "の事例を見ますとこれ全部 EUから 見ですがポルトガルスプレイン"
},
{
"file": "seg_010.ts",
"start": 124.58,
"end": 129.0,
"clock": "11:12:04",
"text": "スウェーデン・ポーランドこれは 全部食料品及びそれに関連する"
},
{
"file": "seg_010.ts",
"start": 129.0,
"end": 134.28,
"clock": "11:12:09",
"text": "つまり全部の税率ではない引き下げ なんですよねそれが公平注立"
},
{
"file": "seg_010.ts",
"start": 134.28,
"end": 139.68,
"clock": "11:12:14",
"text": "の原則とかそういうEUとしての 制度に関する考え方というのは"
},
{
"file": "seg_010.ts",
"start": 139.68,
"end": 144.24,
"clock": "11:12:19",
"text": "そちらの国にもあるわけですから これが本当に原則と愛入れるという"
},
{
"file": "seg_010.ts",
"start": 144.24,
"end": 146.92,
"clock": "11:12:24",
"text": "ふうにみんなが考えられること なのかなというとそうではない"
},
{
"file": "seg_010.ts",
"start": 146.92,
"end": 152.32,
"clock": "11:12:26",
"text": "じゃないかなと我々は思っております がその上で2年間に限って今回は"
},
{
"file": "seg_010.ts",
"start": 152.32,
"end": 155.84,
"clock": "11:12:32",
"text": "引き下げをお願いしているんです がこの臨時的な引き下げの影響を"
},
{
"file": "seg_010.ts",
"start": 155.84,
"end": 161.2,
"clock": "11:12:35",
"text": "受ける事業者様に対しては先ほど からお話が出ております本則風"
},
{
"file": "seg_010.ts",
"start": 161.2,
"end": 165.68,
"clock": "11:12:41",
"text": "以降が困難な農林休業者について 経営継続が困難とならないような"
},
{
"file": "seg_010.ts",
"start": 165.68,
"end": 169.6,
"clock": "11:12:45",
"text": "個別の売上だかを踏まえた金額を 給付する仕組みの導入とか"
},
{
"file": "seg_010.ts",
"start": 169.6,
"end": 173.68,
"clock": "11:12:49",
"text": "職員事業者や外職事業者について 実際に影響を受ける方々に向け"
},
{
"file": "seg_010.ts",
"start": 173.68,
"end": 178.28,
"clock": "11:12:53",
"text": "た的確な支援の丁寧な対応などの 対応を行うということをしております"
},
{
"file": "seg_010.ts",
"start": 178.28,
"end": 183.2,
"clock": "11:12:58",
"text": "のでこれらも踏まえますと御指摘 のような税制の基本原則運営"
},
{
"file": "seg_010.ts",
"start": 183.2,
"end": 186.96,
"clock": "11:13:03",
"text": "とかそれと返りしているということ はないのではないかとつまり税制"
},
{
"file": "seg_010.ts",
"start": 186.96,
"end": 191.6,
"clock": "11:13:06",
"text": "の基本原則と返りしていたら あの原則の許さえEUで各国が"
},
{
"file": "seg_010.ts",
"start": 191.6,
"end": 196.52,
"clock": "11:13:11",
"text": "堂々とやってしかもその結果 お互いに将来への参考として"
},
{
"file": "seg_010.ts",
"start": 196.52,
"end": 200.4,
"clock": "11:13:16",
"text": "持ち寄ってさらによくするということ をやろうとするはずがないのでは"
},
{
"file": "seg_010.ts",
"start": 200.4,
"end": 205.44,
"clock": "11:13:20",
"text": "ないかと思っております 松田真奈子君 もう時間が消しまって"
},
{
"file": "seg_010.ts",
"start": 205.44,
"end": 208.08,
"clock": "11:13:25",
"text": "用意した質問の半分で終わりって しまいましたけれどもこの追加"
},
{
"file": "seg_010.ts",
"start": 208.08,
"end": 212.2,
"clock": "11:13:28",
"text": "またやりたいと思います 以前にして多くの本にいらっしゃる"
},
{
"file": "seg_010.ts",
"start": 212.2,
"end": 217.72,
"clock": "11:13:32",
"text": "野党の皆さんが選挙の時は消費税 原税を言いながら今給付機の方"
},
{
"file": "seg_010.ts",
"start": 217.72,
"end": 222.04,
"clock": "11:13:37",
"text": "にチェンジしていくからいかに 今回の消費原税が無理があるか"
},
{
"file": "seg_010.ts",
"start": 222.04,
"end": 226.48,
"clock": "11:13:42",
"text": "ということを示すものである中で 私ども賛成等は公約通り"
},
{
"file": "seg_010.ts",
"start": 226.48,
"end": 231.2,
"clock": "11:13:46",
"text": "一立2%の引き避けという予定 課をしているという意味で国民の"
},
{
"file": "seg_010.ts",
"start": 231.2,
"end": 234.84,
"clock": "11:13:51",
"text": "二国に応えて頑張っている政党である ことを強調しまして私の質問を"
},
{
"file": "seg_010.ts",
"start": 234.84,
"end": 259.1,
"clock": "11:13:54",
"text": "応援させていただきます どうもありがとうございました"
},
{
"file": "seg_010.ts",
"start": 259.1,
"end": 264.47,
"clock": "11:14:19",
"text": "塩入れ最悪学分 参政党の塩入れ最悪課です"
},
{
"file": "seg_010.ts",
"start": 264.47,
"end": 269.79,
"clock": "11:14:24",
"text": "本日もよろしくお願いいたします まず日本経済の現状認識について"
},
{
"file": "seg_010.ts",
"start": 269.79,
"end": 274.75,
"clock": "11:14:29",
"text": "日本成長戦略担当九地大臣に 伺ってまいりたいと思います"
},
{
"file": "seg_010.ts",
"start": 274.75,
"end": 278.71,
"clock": "11:14:34",
"text": "高一総理が先般の特別委員会 に置かれましても設備投資が"
},
{
"file": "seg_010.ts",
"start": 278.71,
"end": 282.83,
"clock": "11:14:38",
"text": "過去最高の128兆円となり 実質賃金も上昇しており"
},
{
"file": "seg_010.ts",
"start": 282.83,
"end": 287.63,
"clock": "11:14:42",
"text": "日本経済が成長の高順化に踏み出せる かどうかの分岐点にあると発言"
},
{
"file": "seg_010.ts",
"start": 287.63,
"end": 291.59,
"clock": "11:14:47",
"text": "をされています 政府は現在の経済状況をどのように"
},
{
"file": "seg_010.ts",
"start": 291.59,
"end": 297.03,
"clock": "11:14:51",
"text": "認識されておられるでしょうか 九地みのる国務大臣"
},
{
"file": "seg_010.ts",
"start": 297.03,
"end": 301.39,
"clock": "11:14:57",
"text": "はいお答えします 日本経済現在確かな変化が"
},
{
"file": "seg_010.ts",
"start": 301.39,
"end": 304.63,
"clock": "11:15:01",
"text": "現れております GDPにつきましては"
},
{
"file": "seg_010.ts",
"start": 304.63,
"end": 307.99,
"clock": "11:15:04",
"text": "700兆円経済が視野に入ってきと ります"
},
{
"file": "seg_010.ts",
"start": 307.99,
"end": 313.47,
"clock": "11:15:07",
"text": "また瞬期労止交渉の賃上げ率は 3年連続で5%を超えております"
},
{
"file": "seg_010.ts",
"start": 313.47,
"end": 319.95,
"clock": "11:15:13",
"text": "また昨年度の民間設備投資これは 過去最高の128兆円を超えたということで"
},
{
"file": "seg_010.ts",
"start": 319.95,
"end": 323.63,
"clock": "11:15:19",
"text": "あります 実質賃金は昨年12月以降九か月"
},
{
"file": "seg_010.ts",
"start": 323.63,
"end": 328.35,
"clock": "11:15:23",
"text": "ではなくて十か月連続で全年 比プラスをつけております"
},
{
"file": "seg_010.ts",
"start": 328.35,
"end": 334.95,
"clock": "11:15:28",
"text": "日本経済は30年近く続きました デフレ的な経済構造のもと働いても"
},
{
"file": "seg_010.ts",
"start": 334.95,
"end": 339.83,
"clock": "11:15:34",
"text": "なかなか賃金が上がらないという 定帯から経済の高順間への道へ"
},
{
"file": "seg_010.ts",
"start": 339.83,
"end": 343.79,
"clock": "11:15:39",
"text": "踏み出せるかどうかのまさに 文記点にあると考えております"
},
{
"file": "seg_010.ts",
"start": 343.79,
"end": 348.47,
"clock": "11:15:43",
"text": "この変化の経済を一時的なものに 終わらせないことこれが極めて大事"
},
{
"file": "seg_010.ts",
"start": 348.47,
"end": 352.03,
"clock": "11:15:48",
"text": "であります 日本成長戦略と地域未来戦略"
},
{
"file": "seg_010.ts",
"start": 352.03,
"end": 359.51,
"clock": "11:15:52",
"text": "これこの二つを両輪に政府が一歩 前に出て国内投資の未密として"
},
{
"file": "seg_010.ts",
"start": 359.51,
"end": 366.19,
"clock": "11:15:59",
"text": "大規模かつ長期の予見可能性の高い 財政出走計画的に行い大胆な民間国内"
},
{
"file": "seg_010.ts",
"start": 366.19,
"end": 371.51,
"clock": "11:16:06",
"text": "投資を力強く引き出してまいります 同時に仏方に対する切れ目のない"
},
{
"file": "seg_010.ts",
"start": 371.51,
"end": 376.39,
"clock": "11:16:11",
"text": "支援を講じまして国民の暮らしを 守っていることも大事であります"
},
{
"file": "seg_010.ts",
"start": 376.39,
"end": 382.15,
"clock": "11:16:16",
"text": "今回の消費税支援金法案は切れ目のない 仏方が対策かつ中定所得者の"
},
{
"file": "seg_010.ts",
"start": 382.15,
"end": 386.87,
"clock": "11:16:22",
"text": "皆様の負担を直接軽減する 大変重要な法案というふうに"
},
{
"file": "seg_010.ts",
"start": 386.87,
"end": 388.87,
"clock": "11:16:26",
"text": "考えております"
},
{
"file": "seg_010.ts",
"start": 388.87,
"end": 393.19,
"clock": "11:16:28",
"text": "小井理裁和君 御提案にありがとうございます"
},
{
"file": "seg_010.ts",
"start": 393.19,
"end": 398.87,
"clock": "11:16:33",
"text": "確かに実質賃金の上昇これは 喜ばしいことだと思います"
},
{
"file": "seg_010.ts",
"start": 398.87,
"end": 405.07,
"clock": "11:16:38",
"text": "ただしここで改めて政府に認識 していただきたいのは実質賃金"
},
{
"file": "seg_010.ts",
"start": 405.07,
"end": 410.07,
"clock": "11:16:45",
"text": "が上昇しているという結果だけで 経済全体が公巡官に入ったと"
},
{
"file": "seg_010.ts",
"start": 410.07,
"end": 412.59,
"clock": "11:16:50",
"text": "判断してほしくないということ なんですね"
},
{
"file": "seg_010.ts",
"start": 412.59,
"end": 418.71,
"clock": "11:16:52",
"text": "というのは持続的な実質賃金の 上昇には大きく分けて労働生産"
},
{
"file": "seg_010.ts",
"start": 418.71,
"end": 422.67,
"clock": "11:16:58",
"text": "の向上と企業が生み出した負荷 価値をどれだけ労働者に分配する"
},
{
"file": "seg_010.ts",
"start": 422.67,
"end": 429.87,
"clock": "11:17:02",
"text": "かという労働分配の問題がございます 特に生産性の向上には設備投資技術"
},
{
"file": "seg_010.ts",
"start": 429.87,
"end": 434.31,
"clock": "11:17:09",
"text": "確信それから人材育成などを 負荷結となっておりますが政府は"
},
{
"file": "seg_010.ts",
"start": 434.31,
"end": 439.95,
"clock": "11:17:14",
"text": "これから370兆の成長戦略投資 ということでまだその投資は"
},
{
"file": "seg_010.ts",
"start": 439.95,
"end": 443.59,
"clock": "11:17:19",
"text": "スタートしていない段階でございます ということを考えますとその"
},
{
"file": "seg_010.ts",
"start": 443.59,
"end": 447.51,
"clock": "11:17:23",
"text": "効果が本格的に現れるのは一定 の時間がかかるわけですね"
},
{
"file": "seg_010.ts",
"start": 447.51,
"end": 451.75,
"clock": "11:17:27",
"text": "入部課を抑えられている生産性 向上はまた実現していないとなります"
},
{
"file": "seg_010.ts",
"start": 451.75,
"end": 455.71,
"clock": "11:17:31",
"text": "とあとは労働分配率の問題 になってくるんですけれどもこちら"
},
{
"file": "seg_010.ts",
"start": 455.71,
"end": 464.39,
"clock": "11:17:35",
"text": "のグラフをご覧いただければと思います これはいわゆる労働分配率一時的"
},
{
"file": "seg_010.ts",
"start": 464.39,
"end": 471.35,
"clock": "11:17:44",
"text": "に高くなる山が過去を見ても 全規模別労働分配率の推移"
},
{
"file": "seg_010.ts",
"start": 471.35,
"end": 475.15,
"clock": "11:17:51",
"text": "ということでご覧いただいています が過去に三つの山があると思うん"
