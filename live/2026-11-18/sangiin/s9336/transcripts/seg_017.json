[
{
"file": "seg_017.ts",
"start": 0.0,
"end": 8.0,
"clock": "12:20:00",
"text": "でも、うちは二人でやっているから、お前出前の人なんて雇えないよね、というようなそういう会話ですよ。"
},
{
"file": "seg_017.ts",
"start": 8.0,
"end": 15.0,
"clock": "12:20:08",
"text": "でも、おじいちゃんあれだよね、お弁当とか言っても二人でやるのも大変だよね、なんていう中で。"
},
{
"file": "seg_017.ts",
"start": 15.0,
"end": 17.0,
"clock": "12:20:15",
"text": "じゃあ、どうしようか、と言ったら。"
},
{
"file": "seg_017.ts",
"start": 17.0,
"end": 22.0,
"clock": "12:20:17",
"text": "例えば、じゃあ、Uber Eatsとかこういうのがあるよ、と。"
},
{
"file": "seg_017.ts",
"start": 22.0,
"end": 26.0,
"clock": "12:20:22",
"text": "おじいちゃんこういうのを使っていったら、出前の人を雇わなくていいよ、なんて言ったら。"
},
{
"file": "seg_017.ts",
"start": 27.0,
"end": 35.0,
"clock": "12:20:27",
"text": "じゃあ、そういうUber Eatsとかやるとか、言うのに、じゃあ、なんかこういうシステムがないとダメだとか言うと、"
},
{
"file": "seg_017.ts",
"start": 35.0,
"end": 39.0,
"clock": "12:20:35",
"text": "あ、そうな、って言うんで、悪いこと考える奴は、そういう飲食店行って、"
},
{
"file": "seg_017.ts",
"start": 39.0,
"end": 47.0,
"clock": "12:20:39",
"text": "いや、こういうのを導入すると、売り明けがありますよ、なんて言って、騙されるような人もいたりとかね。"
},
{
"file": "seg_017.ts",
"start": 47.0,
"end": 50.0,
"clock": "12:20:47",
"text": "私は今回すごく問題にしているのは、"
},
{
"file": "seg_017.ts",
"start": 51.0,
"end": 59.0,
"clock": "12:20:51",
"text": "あの、Take Outするのに決済を、正直言ってクレジットとかでやるわけですよね。"
},
{
"file": "seg_017.ts",
"start": 59.0,
"end": 65.0,
"clock": "12:20:59",
"text": "で、本当、恥ずかしいじゃないですけど、私自身もフィッシング先に一回やったことがあるんですけど、"
},
{
"file": "seg_017.ts",
"start": 65.0,
"end": 68.0,
"clock": "12:21:05",
"text": "非常に公明に誘導されちゃう。"
},
{
"file": "seg_017.ts",
"start": 68.0,
"end": 75.0,
"clock": "12:21:08",
"text": "だから、今回このTake Outをするっていうような状況になったときに、"
},
{
"file": "seg_017.ts",
"start": 76.0,
"end": 82.0,
"clock": "12:21:16",
"text": "やはり、お年寄りとかね、慣れない人もそういったネット決済とかに、"
},
{
"file": "seg_017.ts",
"start": 82.0,
"end": 87.0,
"clock": "12:21:22",
"text": "具人は、そのが広がるってことは被害に合う人たちもたくさん出てくるんだと。"
},
{
"file": "seg_017.ts",
"start": 87.0,
"end": 92.0,
"clock": "12:21:27",
"text": "俺より先があれだけね、みんな、あの、騙されないようにしなさいよなんて、"
},
{
"file": "seg_017.ts",
"start": 92.0,
"end": 96.0,
"clock": "12:21:32",
"text": "警察とか一生懸命こうしてるけど、やっぱ騙される人がいるわけですよ。"
},
{
"file": "seg_017.ts",
"start": 96.0,
"end": 102.0,
"clock": "12:21:36",
"text": "だから私は、その、やられる前に、そういう被害に合う前に、"
},
{
"file": "seg_017.ts",
"start": 103.0,
"end": 108.0,
"clock": "12:21:43",
"text": "それを防ぐためにどうするのかっていうことを、常に投げかけているんですけど、"
},
{
"file": "seg_017.ts",
"start": 108.0,
"end": 112.0,
"clock": "12:21:48",
"text": "今日は、国家公安委員長に知りたいと思います。"
},
{
"file": "seg_017.ts",
"start": 112.0,
"end": 115.0,
"clock": "12:21:52",
"text": "どういう取組をされているのかっていうのを、ちょっとそこを教えていただけます。"
},
{
"file": "seg_017.ts",
"start": 115.0,
"end": 126.0,
"clock": "12:21:55",
"text": "話、国家公安委員長、私も結構ネット決済で拓敗、時々頼んだり、もういたします。"
},
{
"file": "seg_017.ts",
"start": 126.0,
"end": 134.0,
"clock": "12:22:06",
"text": "それで、フィッシングはですね、やっぱり、IDパスワードやカード番号の接種、これを目的とするものです。"
},
{
"file": "seg_017.ts",
"start": 134.0,
"end": 140.0,
"clock": "12:22:14",
"text": "不正決済を含む各種サイバー犯罪に、これは、惡用されるということになると承知しています。"
},
{
"file": "seg_017.ts",
"start": 140.0,
"end": 148.0,
"clock": "12:22:20",
"text": "警察では、令和7年4月に決定された国民を詐欺から守るための総合対策2.0に基づいて、"
},
{
"file": "seg_017.ts",
"start": 148.0,
"end": 157.0,
"clock": "12:22:28",
"text": "関係省庁と連携して、事業者等に対し、フィッシング対策の強化を働きかけています。"
},
{
"file": "seg_017.ts",
"start": 157.0,
"end": 164.0,
"clock": "12:22:37",
"text": "また、消費者向けには、メールやSNSのリンク、安意にクリックしないこと、"
},
{
"file": "seg_017.ts",
"start": 164.0,
"end": 172.0,
"clock": "12:22:44",
"text": "私の携帯にもそういうのが、時々きます。安意にクリックしないように気をつけています。"
},
{
"file": "seg_017.ts",
"start": 172.0,
"end": 176.0,
"clock": "12:22:52",
"text": "安全なパスワードを設定するとともに、これを使い回せないこと、"
},
{
"file": "seg_017.ts",
"start": 176.0,
"end": 181.0,
"clock": "12:22:56",
"text": "などの基本的な対策について、広報憲発火活動を推進しています。"
},
{
"file": "seg_017.ts",
"start": 181.0,
"end": 186.0,
"clock": "12:23:01",
"text": "さらに、都道府県警察等が把握したフィッシングサイトなどの情報を、"
},
{
"file": "seg_017.ts",
"start": 186.0,
"end": 191.0,
"clock": "12:23:06",
"text": "警察庁が集約して、ウイルス対策のソフト事業者等に提供して、"
},
{
"file": "seg_017.ts",
"start": 191.0,
"end": 197.0,
"clock": "12:23:11",
"text": "警告表示などを行う取組を推進しています。"
},
{
"file": "seg_017.ts",
"start": 197.0,
"end": 203.0,
"clock": "12:23:17",
"text": "引き続き、関係省庁等と連携して、フィッシング対策を推進することによって、"
},
{
"file": "seg_017.ts",
"start": 203.0,
"end": 209.0,
"clock": "12:23:23",
"text": "安全安心なサイバー空間を確保するように、警察を指導してまいります。"
},
{
"file": "seg_017.ts",
"start": 209.0,
"end": 211.0,
"clock": "12:23:29",
"text": "大島区長くん。"
},
{
"file": "seg_017.ts",
"start": 211.0,
"end": 214.0,
"clock": "12:23:31",
"text": "ありがとうございます。是非、いろんなフォローに連携して、"
},
{
"file": "seg_017.ts",
"start": 214.0,
"end": 221.0,
"clock": "12:23:34",
"text": "そういう被害に合わないように、警察、さっき、昨今では警察官を名乗って、"
},
{
"file": "seg_017.ts",
"start": 221.0,
"end": 226.0,
"clock": "12:23:41",
"text": "いろいろ騙すやつも出てきている、この板地国公でしょうけども、"
},
{
"file": "seg_017.ts",
"start": 226.0,
"end": 231.0,
"clock": "12:23:46",
"text": "被害者を出さないように努力をしていただくことをお願いしておきます。"
},
{
"file": "seg_017.ts",
"start": 231.0,
"end": 237.0,
"clock": "12:23:51",
"text": "それで、今、フィッシング詐欺というと、クレジットカードとかなんですけど、"
},
{
"file": "seg_017.ts",
"start": 237.0,
"end": 245.0,
"clock": "12:23:57",
"text": "最近、銀行のカードとかなんかで、直接銀行の交差から決裁できるような、"
},
{
"file": "seg_017.ts",
"start": 245.0,
"end": 250.0,
"clock": "12:24:05",
"text": "これデビットカードというような決裁手段だというようなことらしいんですけど、"
},
{
"file": "seg_017.ts",
"start": 250.0,
"end": 254.0,
"clock": "12:24:10",
"text": "こういう部分、クレジットカードなんかというと、"
},
{
"file": "seg_017.ts",
"start": 254.0,
"end": 259.0,
"clock": "12:24:14",
"text": "何十日が気がついたときに、逆登って保証するとか言うような、"
},
{
"file": "seg_017.ts",
"start": 259.0,
"end": 263.0,
"clock": "12:24:19",
"text": "あれがあると思うんですけど、そういうデビットカードみたいなのも、"
},
{
"file": "seg_017.ts",
"start": 263.0,
"end": 267.0,
"clock": "12:24:23",
"text": "そういうふうな措置が取られているのかどうなのかというのは、"
},
{
"file": "seg_017.ts",
"start": 267.0,
"end": 269.0,
"clock": "12:24:27",
"text": "ちょっとお聞きしたいんです。"
},
{
"file": "seg_017.ts",
"start": 269.0,
"end": 272.0,
"clock": "12:24:29",
"text": "谷川智君、内閣副大臣。"
},
{
"file": "seg_017.ts",
"start": 272.0,
"end": 277.55,
"clock": "12:24:32",
"text": "お答えいたします。"
},
{
"file": "seg_017.ts",
"start": 277.55,
"end": 281.55,
"clock": "12:24:37",
"text": "社会全体で、ITEの活用が進む中、フィッシング詐欺や、"
},
{
"file": "seg_017.ts",
"start": 281.55,
"end": 283.55,
"clock": "12:24:41",
"text": "不正取引被害を防止するためには、"
},
{
"file": "seg_017.ts",
"start": 283.55,
"end": 286.55,
"clock": "12:24:43",
"text": "利用者の方々の注意のみに、ゆな電動ではなくて、"
},
{
"file": "seg_017.ts",
"start": 286.55,
"end": 291.55,
"clock": "12:24:46",
"text": "金融機関においても、実行的な対策を講じることが重要であると考えております。"
},
{
"file": "seg_017.ts",
"start": 291.55,
"end": 296.55,
"clock": "12:24:51",
"text": "このため、金融庁では、金融機関を語ったフィッシングなどによる、"
},
{
"file": "seg_017.ts",
"start": 296.55,
"end": 301.55,
"clock": "12:24:56",
"text": "不正取引被害の増加を踏まえ、令和7年7月に金融機関に対し、"
},
{
"file": "seg_017.ts",
"start": 301.55,
"end": 304.55,
"clock": "12:25:01",
"text": "フィッシング対策等の強化を要請しております。"
},
{
"file": "seg_017.ts",
"start": 304.55,
"end": 307.55,
"clock": "12:25:04",
"text": "また、監督資診を順次改正することにより、"
},
{
"file": "seg_017.ts",
"start": 307.55,
"end": 311.55,
"clock": "12:25:07",
"text": "金融機関に対し、インターネットバンキングやデビットカードなどの"
},
{
"file": "seg_017.ts",
"start": 311.55,
"end": 315.55,
"clock": "12:25:11",
"text": "決済サービスにおいて、ログイン時や出勤時において、"
},
{
"file": "seg_017.ts",
"start": 315.55,
"end": 319.55,
"clock": "12:25:15",
"text": "フィッシング体制のある多様素、認証の導入、必数化や、"
},
{
"file": "seg_017.ts",
"start": 319.55,
"end": 322.55,
"clock": "12:25:19",
"text": "メール内にパスワードの入力を促す、"
},
{
"file": "seg_017.ts",
"start": 322.55,
"end": 325.55,
"clock": "12:25:22",
"text": "リンクを原則として記載しないこと、また、"
},
{
"file": "seg_017.ts",
"start": 325.55,
"end": 328.55,
"clock": "12:25:25",
"text": "不正ログインや異常取引を検知した際の、"
},
{
"file": "seg_017.ts",
"start": 328.55,
"end": 332.55,
"clock": "12:25:28",
"text": "利用者への速やかな連絡体制の整備などの"
},
{
"file": "seg_017.ts",
"start": 332.55,
"end": 335.55,
"clock": "12:25:32",
"text": "セキュリティ対策の強化を求めております。"
},
{
"file": "seg_017.ts",
"start": 335.55,
"end": 338.55,
"clock": "12:25:35",
"text": "金融庁といたしましては、引き続き、"
},
{
"file": "seg_017.ts",
"start": 338.55,
"end": 341.55,
"clock": "12:25:38",
"text": "それとする関係省庁や、業館団体とも連携しながら、"
},
{
"file": "seg_017.ts",
"start": 341.55,
"end": 344.55,
"clock": "12:25:41",
"text": "金融機関における実行的な対策を促し、"
},
{
"file": "seg_017.ts",
"start": 344.55,
"end": 348.55,
"clock": "12:25:44",
"text": "フィッシング、先被害の防止に取り組んでもらいたいと考えております。"
},
{
"file": "seg_017.ts",
"start": 349.55,
"end": 351.55,
"clock": "12:25:49",
"text": "防止幕僧君。"
},
{
"file": "seg_017.ts",
"start": 351.55,
"end": 355.55,
"clock": "12:25:51",
"text": "そういう対策を講じたり、努力をされ、中でも、"
},
{
"file": "seg_017.ts",
"start": 355.55,
"end": 359.55,
"clock": "12:25:55",
"text": "やっぱり被害に合うと、在勤でね、"
},
{
"file": "seg_017.ts",
"start": 359.55,
"end": 363.55,
"clock": "12:25:59",
"text": "スルガ銀行の関係を徹底的に皆さんに言わせましたけど、"
},
{
"file": "seg_017.ts",
"start": 363.55,
"end": 367.55,
"clock": "12:26:03",
"text": "被害にあった人たちをどう救っていくかというようなことも、"
},
{
"file": "seg_017.ts",
"start": 367.55,
"end": 371.55,
"clock": "12:26:07",
"text": "並行してね、ぜひ議論しておいていただいて、"
},
{
"file": "seg_017.ts",
"start": 371.55,
"end": 376.55,
"clock": "12:26:11",
"text": "そういった被害にあったらすぐ救済できるような形を"
},
{
"file": "seg_017.ts",
"start": 376.55,
"end": 378.55,
"clock": "12:26:16",
"text": "とっていただくようなこと。"
},
{
"file": "seg_017.ts",
"start": 378.55,
"end": 381.55,
"clock": "12:26:18",
"text": "これも引き続き、議論していきたいと思いますので、"
},
{
"file": "seg_017.ts",
"start": 381.55,
"end": 385.55,
"clock": "12:26:21",
"text": "ちょっとそこら辺もぜひ検討ドアへを"
},
{
"file": "seg_017.ts",
"start": 385.55,
"end": 388.55,
"clock": "12:26:25",
"text": "次回ちょっとお聞きしたいと思いますから、よろしくお願いします。"
},
{
"file": "seg_017.ts",
"start": 388.55,
"end": 395.55,
"clock": "12:26:28",
"text": "納粋大臣、飲食店の関係もさっきちょっと途中になりましたけどもね、"
},
{
"file": "seg_017.ts",
"start": 396.55,
"end": 402.55,
"clock": "12:26:36",
"text": "そういう出前とかの仕組みとかを、"
},
{
"file": "seg_017.ts",
"start": 402.55,
"end": 405.55,
"clock": "12:26:42",
"text": "大手はね、自分たちでまくできてるし、"
},
{
"file": "seg_017.ts",
"start": 405.55,
"end": 409.55,
"clock": "12:26:45",
"text": "また10%と1%が混在するわけですよ。"
},
{
"file": "seg_017.ts",
"start": 409.55,
"end": 413.55,
"clock": "12:26:49",
"text": "そうするとやはり、免税事業者ね、売上のちっちゃい食堂。"
},
{
"file": "seg_017.ts",
"start": 413.55,
"end": 419.55,
"clock": "12:26:53",
"text": "そういうところにまた、今言うような形で売上を把握してね、"
},
{
"file": "seg_017.ts",
"start": 419.55,
"end": 424.55,
"clock": "12:26:59",
"text": "それで、じゃあ差額を補助しますよとかね、"
},
{
"file": "seg_017.ts",
"start": 424.55,
"end": 427.55,
"clock": "12:27:04",
"text": "なんか、あの、完璧しますよっていうのかどうかわからないけど、"
},
{
"file": "seg_017.ts",
"start": 427.55,
"end": 429.55,
"clock": "12:27:07",
"text": "そういうものがまだ見えない、何か検討してますよ、"
},
{
"file": "seg_017.ts",
"start": 429.55,
"end": 433.55,
"clock": "12:27:09",
"text": "そういう人たちに会うような仮立ちでやりますよって言うようなことを"
},
{
"file": "seg_017.ts",
"start": 433.55,
"end": 436.55,
"clock": "12:27:13",
"text": "言うよりも、今言うように、完結に、"
},
{
"file": "seg_017.ts",
"start": 436.55,
"end": 440.55,
"clock": "12:27:16",
"text": "もうあなたたちが、そうやって払った消費税は完璧しますよと。"
},
{
"file": "seg_017.ts",
"start": 440.55,
"end": 441.55,
"clock": "12:27:20",
"text": "今、名会じゃないですか。"
},
{
"file": "seg_017.ts",
"start": 441.55,
"end": 445.55,
"clock": "12:27:21",
"text": "大企業の輸出補助金なんていう完璧みたいなやつはね、"
},
{
"file": "seg_017.ts",
"start": 445.55,
"end": 448.55,
"clock": "12:27:25",
"text": "もう非常に単純名会にね、"
},
{
"file": "seg_017.ts",
"start": 448.55,
"end": 451.55,
"clock": "12:27:28",
"text": "コント何千億も出してるわけだから、"
},
{
"file": "seg_017.ts",
"start": 451.55,
"end": 455.55,
"clock": "12:27:31",
"text": "そんな免税事業者に出すような、本当ビビたる完璧にね、"
},
{
"file": "seg_017.ts",
"start": 455.55,
"end": 459.55,
"clock": "12:27:35",
"text": "そこまでね、厳密に言う必要はないところ、"
},
{
"file": "seg_017.ts",
"start": 459.55,
"end": 462.55,
"clock": "12:27:39",
"text": "国民の多くもそういうふうに思っていると思いますよ。"
},
{
"file": "seg_017.ts",
"start": 462.55,
"end": 467.55,
"clock": "12:27:42",
"text": "そういう意味において、飲食店の免税事業者についても、"
},
{
"file": "seg_017.ts",
"start": 467.55,
"end": 471.55,
"clock": "12:27:47",
"text": "まあいう売上把握、運動とか言わないで、"
},
{
"file": "seg_017.ts",
"start": 471.55,
"end": 474.55,
"clock": "12:27:51",
"text": "やるべきだと思いますけど、大臣どうですか。"
},
{
"file": "seg_017.ts",
"start": 474.55,
"end": 478.86,
"clock": "12:27:54",
"text": "高岩部農林水産大臣。"
},
{
"file": "seg_017.ts",
"start": 478.86,
"end": 481.86,
"clock": "12:27:58",
"text": "外食事業者に対して、免税事業者に対して"
},
{
"file": "seg_017.ts",
"start": 481.86,
"end": 485.86,
"clock": "12:28:01",
"text": "幹部をするということは予定、検討しておりません。"
},
{
"file": "seg_017.ts",
"start": 485.86,
"end": 489.86,
"clock": "12:28:05",
"text": "あくまでもこの外食事業者については、"
},
{
"file": "seg_017.ts",
"start": 489.86,
"end": 492.86,
"clock": "12:28:09",
"text": "弁当等との前立の差が拡大することで、"
},
{
"file": "seg_017.ts",
"start": 492.86,
"end": 495.86,
"clock": "12:28:12",
"text": "外食の需要が減少するのではないかという"
},
{
"file": "seg_017.ts",
"start": 495.86,
"end": 498.86,
"clock": "12:28:15",
"text": "懸念の声があることは承知しておりますので、"
},
{
"file": "seg_017.ts",
"start": 498.86,
"end": 501.86,
"clock": "12:28:18",
"text": "このためこの対抗においてですね、"
},
{
"file": "seg_017.ts",
"start": 501.86,
"end": 504.86,
"clock": "12:28:21",
"text": "外食事業者については資金売支援、"
},
{
"file": "seg_017.ts",
"start": 504.86,
"end": 507.86,
"clock": "12:28:24",
"text": "それから生産成功上に向けた小略化等への"
},
{
"file": "seg_017.ts",
"start": 507.86,
"end": 510.86,
"clock": "12:28:27",
"text": "取組みへの支援、それからテイクアウト等の"
},
{
"file": "seg_017.ts",
"start": 510.86,
"end": 513.86,
"clock": "12:28:30",
"text": "高く化をしようと考えていらっしゃる"
},
{
"file": "seg_017.ts",
"start": 513.86,
"end": 515.86,
"clock": "12:28:33",
"text": "外食事業者に対しての支援など、"
},
{
"file": "seg_017.ts",
"start": 515.86,
"end": 518.86,
"clock": "12:28:35",
"text": "影響を見極めた上で的確な支援を講ずる"
},
{
"file": "seg_017.ts",
"start": 518.86,
"end": 521.86,
"clock": "12:28:38",
"text": "方針を明記、対抗に明記しているところであります。"
},
{
"file": "seg_017.ts",
"start": 521.86,
"end": 525.86,
"clock": "12:28:41",
"text": "一言でテイクアウトといっても"
},
{
"file": "seg_017.ts",
"start": 525.86,
"end": 529.86,
"clock": "12:28:45",
"text": "いい話のとおり、大きな企業もあれば、"
},
{
"file": "seg_017.ts",
"start": 529.86,
"end": 532.86,
"clock": "12:28:49",
"text": "大きな飲食店もあれば小さな夫婦で"
},
{
"file": "seg_017.ts",
"start": 532.86,
"end": 534.86,
"clock": "12:28:52",
"text": "やっていらっしゃるというところもあると思います。"
},
{
"file": "seg_017.ts",
"start": 534.86,
"end": 537.86,
"clock": "12:28:54",
"text": "さまざまなそれぞれによって準備や"
},
{
"file": "seg_017.ts",
"start": 537.86,
"end": 540.86,
"clock": "12:28:57",
"text": "費用も必要という声も承知しておりますので、"
},
{
"file": "seg_017.ts",
"start": 540.86,
"end": 543.86,
"clock": "12:29:00",
"text": "現場の実情を伺いつつ、"
},
{
"file": "seg_017.ts",
"start": 543.86,
"end": 546.86,
"clock": "12:29:03",
"text": "一方で執行上の問題等についても"
},
{
"file": "seg_017.ts",
"start": 546.86,
"end": 550.86,
"clock": "12:29:06",
"text": "過去の実施した取組みもありますので、"
},
{
"file": "seg_017.ts",
"start": 550.86,
"end": 552.86,
"clock": "12:29:10",
"text": "それを蓄積なども生かしながら"
},
{
"file": "seg_017.ts",
"start": 552.86,
"end": 553.86,
"clock": "12:29:12",
"text": "検討を深めてまいりたいと思います。"
},
{
"file": "seg_017.ts",
"start": 553.86,
"end": 555.86,
"clock": "12:29:13",
"text": "大島区総理長"
},
{
"file": "seg_017.ts",
"start": 555.86,
"end": 558.86,
"clock": "12:29:15",
"text": "まあね、結局検討"
},
{
"file": "seg_017.ts",
"start": 558.86,
"end": 561.86,
"clock": "12:29:18",
"text": "もう考えていきますよという、"
},
{
"file": "seg_017.ts",
"start": 561.86,
"end": 563.86,
"clock": "12:29:21",
"text": "じゃあ国民は安心できないんですよ。"
},
{
"file": "seg_017.ts",
"start": 563.86,
"end": 565.86,
"clock": "12:29:23",
"text": "今言ったおじいちゃん、ばーちゃん"
},
{
"file": "seg_017.ts",
"start": 565.86,
"end": 567.86,
"clock": "12:29:25",
"text": "二人でやっているような食堂が"
},
{
"file": "seg_017.ts",
"start": 567.86,
"end": 571.86,
"clock": "12:29:27",
"text": "どうなのか、そういう不安もあるわけじゃないですか。"
},
{
"file": "seg_017.ts",
"start": 571.86,
"end": 573.86,
"clock": "12:29:31",
"text": "そういう意味をおいては"
},
{
"file": "seg_017.ts",
"start": 573.86,
"end": 575.86,
"clock": "12:29:33",
"text": "いやいやもう面前事業者"
},
{
"file": "seg_017.ts",
"start": 575.86,
"end": 577.86,
"clock": "12:29:35",
"text": "そんなのも気にしなくていいよと"
},
{
"file": "seg_017.ts",
"start": 577.86,
"end": 579.86,
"clock": "12:29:37",
"text": "あなたたちの分の"
},
{
"file": "seg_017.ts",
"start": 579.86,
"end": 581.86,
"clock": "12:29:39",
"text": "手厚くやりますよと。"
},
{
"file": "seg_017.ts",
"start": 581.86,
"end": 584.86,
"clock": "12:29:41",
"text": "だって支援しますって"
},
{
"file": "seg_017.ts",
"start": 584.86,
"end": 586.86,
"clock": "12:29:44",
"text": "お金を補助しますとか言ったって"
},
{
"file": "seg_017.ts",
"start": 586.86,
"end": 588.86,
"clock": "12:29:46",
"text": "くれるわけじゃないでしょう。"
},
{
"file": "seg_017.ts",
"start": 588.86,
"end": 590.86,
"clock": "12:29:48",
"text": "貸し付けたりするわけでしょ。"
},
{
"file": "seg_017.ts",
"start": 590.86,
"end": 592.86,
"clock": "12:29:50",
"text": "そしたらそういうところで"
},
{
"file": "seg_017.ts",
"start": 592.86,
"end": 594.86,
"clock": "12:29:52",
"text": "じゃあ事業をやめようかなって"
},
{
"file": "seg_017.ts",
"start": 594.86,
"end": 596.86,
"clock": "12:29:54",
"text": "これで事業を飲食店"
},
{
"file": "seg_017.ts",
"start": 596.86,
"end": 599.86,
"clock": "12:29:56",
"text": "どのしまってるような状況の中で"
},
{
"file": "seg_017.ts",
"start": 599.86,
"end": 600.86,
"clock": "12:29:59",
"text": "新たな"
}
]