[
{
"file": "seg_008.ts",
"start": 0.0,
"end": 5.68,
"clock": "10:50:00",
"text": "価格を実際どう決定するかは、事業者にとっては最高の経営判断だと思うんですね。"
},
{
"file": "seg_008.ts",
"start": 5.68,
"end": 16.24,
"clock": "10:50:05",
"text": "消費税は、事業者が負担することも想定される負荷値税であって、消費税って言葉自体が本当は正確でないように思います。"
},
{
"file": "seg_008.ts",
"start": 16.24,
"end": 24.6,
"clock": "10:50:16",
"text": "政府は答弁のために、経済産業所が実施している消費税の転課状況に関するアンケート調査では、"
},
{
"file": "seg_008.ts",
"start": 24.6,
"end": 30.76,
"clock": "10:50:24",
"text": "全て転課できているという回答が9割前後、それ以上あるというふうな答弁をされていますけれども、"
},
{
"file": "seg_008.ts",
"start": 30.76,
"end": 37.48,
"clock": "10:50:30",
"text": "この調査には、そもそも回答した企業の割合が小さいという問題のほか、いろいろな問題点が指摘されていまして、"
},
{
"file": "seg_008.ts",
"start": 37.48,
"end": 46.76,
"clock": "10:50:37",
"text": "例えば、納入先の企業、大企業なんかに延長して、100%転課できていないのに転課できていると回答しているということも指摘されますし、"
},
{
"file": "seg_008.ts",
"start": 46.76,
"end": 57.2,
"clock": "10:50:46",
"text": "何よりも、いろいろなコストの上昇を十分に科学転課できていない、ですから消費税を仮に100%科学転課した場合でも、"
},
{
"file": "seg_008.ts",
"start": 57.2,
"end": 65.92,
"clock": "10:50:57",
"text": "いろんなコストの上昇分の科学転課を犠牲にして消費税を科学転課しているというケースも多いではなかろうかと、"
},
{
"file": "seg_008.ts",
"start": 65.92,
"end": 72.72,
"clock": "10:51:05",
"text": "それが結局、埋めかれ維持利益をその分納入業者圧縮しているということになるわけで、"
},
{
"file": "seg_008.ts",
"start": 72.72,
"end": 82.26,
"clock": "10:51:12",
"text": "ちなみに、中小企業庁の別の庁舎で、価格交渉に関する調査では、コスト上昇分の価格点値は全体質として50%台、"
},
{
"file": "seg_008.ts",
"start": 82.26,
"end": 85.64,
"clock": "10:51:22",
"text": "これは現在領域とかエネルギーとかローム人がいろいろあるんですが、"
},
{
"file": "seg_008.ts",
"start": 85.64,
"end": 95.24,
"clock": "10:51:25",
"text": "こうした問題点の指摘について、どうお答えになるか、制度の建前とは異なって、実際は消費者が負担していない部分が大きい税制であるということを、"
},
{
"file": "seg_008.ts",
"start": 95.24,
"end": 99.24,
"clock": "10:51:35",
"text": "片山大臣はお認めになるかどうか、まずその点からお願いしたいと思います。"
},
{
"file": "seg_008.ts",
"start": 99.24,
"end": 101.64,
"clock": "10:51:39",
"text": "片山さつき、国務大臣。"
},
{
"file": "seg_008.ts",
"start": 101.64,
"end": 110.14,
"clock": "10:51:41",
"text": "はい、他期に分かるいろいろな例をお挙げになられたんですが、まず、消費税の添加状況に関するアンケート調査に関して、"
},
{
"file": "seg_008.ts",
"start": 110.14,
"end": 114.76,
"clock": "10:51:50",
"text": "回収率低いとか、納入先に延伸があって実態と違うんじゃないかとか、"
},
{
"file": "seg_008.ts",
"start": 114.76,
"end": 123.56,
"clock": "10:51:54",
"text": "そういった御指摘で時々ありますが、この調査は無作為抽出された1万件以上の回答に基づいておりますそうか、"
},
{
"file": "seg_008.ts",
"start": 123.56,
"end": 128.98,
"clock": "10:52:03",
"text": "この調査票には回答した企業事業者が特定されるような形で公表されることはないので、"
},
{
"file": "seg_008.ts",
"start": 128.98,
"end": 132.54,
"clock": "10:52:08",
"text": "当然ですが期待されているこういう条件であります。"
},
{
"file": "seg_008.ts",
"start": 132.54,
"end": 137.28,
"clock": "10:52:12",
"text": "これらを踏まえれば、この調査結果で消費税率の引き上げ分を、"
},
{
"file": "seg_008.ts",
"start": 137.28,
"end": 141.48,
"clock": "10:52:17",
"text": "価格に添加できた割合が9割を超えているということに基づいて、"
},
{
"file": "seg_008.ts",
"start": 141.48,
"end": 148.64,
"clock": "10:52:21",
"text": "消費者の添加が基本的にできていると、政府が答えても別に問題はないのであんないかと考えております。"
},
{
"file": "seg_008.ts",
"start": 148.64,
"end": 156.06,
"clock": "10:52:28",
"text": "また、消費税法や創設時の税制改革の基本理念とお示した税制改革法の規定を踏まえますと、"
},
{
"file": "seg_008.ts",
"start": 156.06,
"end": 161.76,
"clock": "10:52:36",
"text": "消費税は事業者が納税義務者である一方、価格への添加を通じまして、"
},
{
"file": "seg_008.ts",
"start": 161.76,
"end": 168.6,
"clock": "10:52:41",
"text": "最終的には消費者が負担することを予定しているものであるというふうに認識をしているわけでございまして、"
},
{
"file": "seg_008.ts",
"start": 168.6,
"end": 172.32,
"clock": "10:52:48",
"text": "先ほどのアンケートの調査結果と合わせてみましても、"
},
{
"file": "seg_008.ts",
"start": 172.32,
"end": 177.62,
"clock": "10:52:52",
"text": "ご指摘のように消費者が負担している部分が大きいんじゃないかという認識を、"
},
{
"file": "seg_008.ts",
"start": 177.62,
"end": 180.04,
"clock": "10:52:57",
"text": "政府としては持ってはおりません。"
},
{
"file": "seg_008.ts",
"start": 180.04,
"end": 184.0,
"clock": "10:53:00",
"text": "なお、ご指摘の価格交渉のいろんな部分がございます。"
},
{
"file": "seg_008.ts",
"start": 184.0,
"end": 186.24,
"clock": "10:53:04",
"text": "さまざまな調査ご意見がございます。"
},
{
"file": "seg_008.ts",
"start": 186.24,
"end": 190.44,
"clock": "10:53:06",
"text": "現在両費であったり人権披露を無非の話をさきなさいましたけど、"
},
{
"file": "seg_008.ts",
"start": 190.44,
"end": 192.68,
"clock": "10:53:10",
"text": "エネルギー価格も最近はあるでしょう。"
},
{
"file": "seg_008.ts",
"start": 192.68,
"end": 196.16,
"clock": "10:53:12",
"text": "こういった価格添加の状況を示したものが、"
},
{
"file": "seg_008.ts",
"start": 196.16,
"end": 201.48,
"clock": "10:53:16",
"text": "この間のご指摘の価格交渉の調査そのものでございますので、"
},
{
"file": "seg_008.ts",
"start": 201.48,
"end": 206.24,
"clock": "10:53:21",
"text": "消費税の添加状況とはまた別に考えていく必要がございます。"
},
{
"file": "seg_008.ts",
"start": 206.24,
"end": 208.36,
"clock": "10:53:26",
"text": "いずれにしても政府としては、"
},
{
"file": "seg_008.ts",
"start": 208.36,
"end": 212.96,
"clock": "10:53:28",
"text": "適正な価格添加や取引適正化の徹底というのは務めておりますし、"
},
{
"file": "seg_008.ts",
"start": 212.96,
"end": 216.48,
"clock": "10:53:32",
"text": "それから省力化とか生産性向上支援などは、"
},
{
"file": "seg_008.ts",
"start": 216.48,
"end": 221.2,
"clock": "10:53:36",
"text": "まさに高い政権としてもっとも中心的に取り組んでいるテーマの一つで、"
},
{
"file": "seg_008.ts",
"start": 221.2,
"end": 224.28,
"clock": "10:53:41",
"text": "中小企業の収益率が高まって、"
},
{
"file": "seg_008.ts",
"start": 224.28,
"end": 226.0,
"clock": "10:53:44",
"text": "収益力が高まって、"
},
{
"file": "seg_008.ts",
"start": 226.0,
"end": 228.64,
"clock": "10:53:46",
"text": "賃上げ環境が整備されるということが、"
},
{
"file": "seg_008.ts",
"start": 228.64,
"end": 232.0,
"clock": "10:53:48",
"text": "本質的なことだと思って取り組んでおりますし、"
},
{
"file": "seg_008.ts",
"start": 232.0,
"end": 233.84,
"clock": "10:53:52",
"text": "お答えになるかどうか分からないですけど、"
},
{
"file": "seg_008.ts",
"start": 233.84,
"end": 237.52,
"clock": "10:53:53",
"text": "そういうことが本水事の答えではないかと思っております。"
},
{
"file": "seg_008.ts",
"start": 237.52,
"end": 238.84,
"clock": "10:53:57",
"text": "松田真田君。"
},
{
"file": "seg_008.ts",
"start": 238.84,
"end": 242.84,
"clock": "10:53:58",
"text": "はい、そうお答えするしかないということはよくわかります。"
},
{
"file": "seg_008.ts",
"start": 242.84,
"end": 246.08,
"clock": "10:54:02",
"text": "ただ、実態をよく見た方がいいんじゃないかと、"
},
{
"file": "seg_008.ts",
"start": 246.08,
"end": 249.4,
"clock": "10:54:06",
"text": "それに対する避難にどう応えるかということが大事だと思います。"
},
{
"file": "seg_008.ts",
"start": 249.4,
"end": 253.44,
"clock": "10:54:09",
"text": "次に、消費税そのものに対する避難として、"
},
{
"file": "seg_008.ts",
"start": 253.44,
"end": 257.68,
"clock": "10:54:13",
"text": "輸出勧捕金の問題がよく言われています。"
},
{
"file": "seg_008.ts",
"start": 257.68,
"end": 261.44,
"clock": "10:54:17",
"text": "輸出、これ輸出企業に対する補助金のようなものではないかと、"
},
{
"file": "seg_008.ts",
"start": 261.44,
"end": 263.44,
"clock": "10:54:21",
"text": "その金額は膨大に登ると、"
},
{
"file": "seg_008.ts",
"start": 263.44,
"end": 266.44,
"clock": "10:54:23",
"text": "特に自動車メーカーなどの輸出大企業に、"
},
{
"file": "seg_008.ts",
"start": 266.44,
"end": 268.24,
"clock": "10:54:26",
"text": "かなり金額が勧捕されている。"
},
{
"file": "seg_008.ts",
"start": 268.24,
"end": 271.2,
"clock": "10:54:28",
"text": "これは大企業有効税制ではないかと、"
},
{
"file": "seg_008.ts",
"start": 271.2,
"end": 277.4,
"clock": "10:54:31",
"text": "だから大企業中心とする財界は消費税率の引上げに賛成するんだという話も聞かれますし、"
},
{
"file": "seg_008.ts",
"start": 277.4,
"end": 282.32,
"clock": "10:54:37",
"text": "また、トランプ大統領もこれ非完全消費としてやりために上げているではないかと、"
},
{
"file": "seg_008.ts",
"start": 282.32,
"end": 286.32,
"clock": "10:54:42",
"text": "この輸出勧捕金制度をやめると十分な財源が出てくるのではないかと。"
},
{
"file": "seg_008.ts",
"start": 286.32,
"end": 288.64,
"clock": "10:54:46",
"text": "もちろん一部誤解の部分もあるんですが、"
},
{
"file": "seg_008.ts",
"start": 288.64,
"end": 292.28,
"clock": "10:54:48",
"text": "ただ税制の基本は国民からの信頼でありまして、"
},
{
"file": "seg_008.ts",
"start": 292.28,
"end": 298.28,
"clock": "10:54:52",
"text": "こうした観点から消費税そのものが不公平税制として言われるという事態に対して、"
},
{
"file": "seg_008.ts",
"start": 298.28,
"end": 303.2,
"clock": "10:54:58",
"text": "制度の建前だけで反論しているだけでは不十分ではないかと思います。"
},
{
"file": "seg_008.ts",
"start": 303.2,
"end": 305.2,
"clock": "10:55:03",
"text": "輸出勧捕金の問題も、"
},
{
"file": "seg_008.ts",
"start": 305.2,
"end": 308.04,
"clock": "10:55:05",
"text": "結局は制度の建前と自体との返り、"
},
{
"file": "seg_008.ts",
"start": 308.04,
"end": 313.96,
"clock": "10:55:08",
"text": "実際の価格決定は事業者の経営判断であるというところから表示していると思います。"
},
{
"file": "seg_008.ts",
"start": 313.96,
"end": 317.2,
"clock": "10:55:13",
"text": "昨年日系新聞が報道していたんですけれども、"
},
{
"file": "seg_008.ts",
"start": 317.2,
"end": 321.92,
"clock": "10:55:17",
"text": "特に自動車業界では価格点値は6割弱にとどまっている、"
},
{
"file": "seg_008.ts",
"start": 321.92,
"end": 323.68,
"clock": "10:55:21",
"text": "完成者メーカーを頂点、"
},
{
"file": "seg_008.ts",
"start": 323.68,
"end": 326.68,
"clock": "10:55:23",
"text": "完成者メーカーを頂点とする産業ピラミッド構造では、"
},
{
"file": "seg_008.ts",
"start": 326.68,
"end": 331.28,
"clock": "10:55:26",
"text": "まったにこういう価格交渉をためらう部品メーカーが多いと、"
},
{
"file": "seg_008.ts",
"start": 331.28,
"end": 336.2,
"clock": "10:55:31",
"text": "つまり日本の自動車輸出企業に納入する下受機等の企業で、"
},
{
"file": "seg_008.ts",
"start": 336.2,
"end": 340.64,
"clock": "10:55:36",
"text": "コスト増分が十分に価格点下されていない傾向が指摘されているわけですね。"
},
{
"file": "seg_008.ts",
"start": 340.64,
"end": 344.04,
"clock": "10:55:40",
"text": "もし、輸出企業に納入する下受業者が、"
},
{
"file": "seg_008.ts",
"start": 344.04,
"end": 347.68,
"clock": "10:55:44",
"text": "事業にかかるいろんなコストを価格に十分点下して、"
},
{
"file": "seg_008.ts",
"start": 347.68,
"end": 352.88,
"clock": "10:55:47",
"text": "さらに消費税の負担分を100%を終わのせした価格で納品しているのであれば、"
},
{
"file": "seg_008.ts",
"start": 352.88,
"end": 355.92,
"clock": "10:55:52",
"text": "輸出企業側としてはその消費税分だけ、"
},
{
"file": "seg_008.ts",
"start": 355.92,
"end": 358.48,
"clock": "10:55:55",
"text": "資入れの価格が上がったことによって、"
},
{
"file": "seg_008.ts",
"start": 358.48,
"end": 360.84,
"clock": "10:55:58",
"text": "そのコストが上がっているわけですから、"
},
{
"file": "seg_008.ts",
"start": 360.84,
"end": 363.84,
"clock": "10:56:00",
"text": "その上昇分を幹部してもらうということになるので、"
},
{
"file": "seg_008.ts",
"start": 363.84,
"end": 366.08,
"clock": "10:56:03",
"text": "差し引きで得することにはならない、"
},
{
"file": "seg_008.ts",
"start": 366.08,
"end": 368.2,
"clock": "10:56:06",
"text": "輸出補助金には当たらないということになるんですが、"
},
{
"file": "seg_008.ts",
"start": 368.2,
"end": 370.24,
"clock": "10:56:08",
"text": "しかし実際にはそうでないと、"
},
{
"file": "seg_008.ts",
"start": 370.24,
"end": 373.64,
"clock": "10:56:10",
"text": "本当は上乗せしたいコストがあるけれども、"
},
{
"file": "seg_008.ts",
"start": 373.64,
"end": 375.64,
"clock": "10:56:13",
"text": "それを上乗せできていない、"
},
{
"file": "seg_008.ts",
"start": 375.64,
"end": 381.32,
"clock": "10:56:15",
"text": "うべかれし先ほど申し上げた利益を諦めて、"
},
{
"file": "seg_008.ts",
"start": 381.32,
"end": 385.64,
"clock": "10:56:21",
"text": "そしてそれがその分が大企業に幹部されている。"
},
{
"file": "seg_008.ts",
"start": 385.64,
"end": 389.68,
"clock": "10:56:25",
"text": "これいかにも、冷蔽企業から集達して、"
},
{
"file": "seg_008.ts",
"start": 389.68,
"end": 393.24,
"clock": "10:56:29",
"text": "輸出企業をもう勝手にじゃないかというふうな批判になってしまうんですが、"
},
{
"file": "seg_008.ts",
"start": 393.24,
"end": 394.84,
"clock": "10:56:33",
"text": "まずはこの点については、"
},
{
"file": "seg_008.ts",
"start": 394.84,
"end": 397.04,
"clock": "10:56:34",
"text": "どういうふうにお答えになるでしょうか。"
},
{
"file": "seg_008.ts",
"start": 397.04,
"end": 401.38,
"clock": "10:56:37",
"text": "片山国務大臣"
},
{
"file": "seg_008.ts",
"start": 401.38,
"end": 404.02,
"clock": "10:56:41",
"text": "有質感付近については、"
},
{
"file": "seg_008.ts",
"start": 404.02,
"end": 407.66,
"clock": "10:56:44",
"text": "長らくいろいろとずっとそういうご質問が、"
},
{
"file": "seg_008.ts",
"start": 407.66,
"end": 412.74,
"clock": "10:56:47",
"text": "いろいろな委員会で繰り返されてきているところですが、"
},
{
"file": "seg_008.ts",
"start": 412.74,
"end": 414.34,
"clock": "10:56:52",
"text": "先般もございました中で、"
},
{
"file": "seg_008.ts",
"start": 414.34,
"end": 416.54,
"clock": "10:56:54",
"text": "私ちょっと言い間違いがございまして、"
},
{
"file": "seg_008.ts",
"start": 416.54,
"end": 421.1,
"clock": "10:56:56",
"text": "消費税タイプの深下事税を使用している国が、"
},
{
"file": "seg_008.ts",
"start": 421.1,
"end": 423.98,
"clock": "10:57:01",
"text": "大体公的な認識で、"
},
{
"file": "seg_008.ts",
"start": 423.98,
"end": 425.62,
"clock": "10:57:03",
"text": "170カ国と言われているのは、"
},
{
"file": "seg_008.ts",
"start": 425.62,
"end": 427.46,
"clock": "10:57:05",
"text": "私100を飛ばして、"
},
{
"file": "seg_008.ts",
"start": 427.46,
"end": 431.26,
"clock": "10:57:07",
"text": "本当には170の1を飛ばしていってしまいまして、"
},
{
"file": "seg_008.ts",
"start": 431.26,
"end": 432.7,
"clock": "10:57:11",
"text": "70と申し上げたようなので、"
},
{
"file": "seg_008.ts",
"start": 432.7,
"end": 436.14,
"clock": "10:57:12",
"text": "今点出を定性を求めておりますが、"
},
{
"file": "seg_008.ts",
"start": 436.14,
"end": 439.22,
"clock": "10:57:16",
"text": "170カ国程度あるというのが、"
},
{
"file": "seg_008.ts",
"start": 439.22,
"end": 440.58,
"clock": "10:57:19",
"text": "一般的な認識で、"
},
{
"file": "seg_008.ts",
"start": 440.58,
"end": 443.18,
"clock": "10:57:20",
"text": "つまりとっても多いということなんですよね。"
},
{
"file": "seg_008.ts",
"start": 443.18,
"end": 446.38,
"clock": "10:57:23",
"text": "そのワークの消費税もそうですが、"
},
{
"file": "seg_008.ts",
"start": 446.38,
"end": 451.94,
"clock": "10:57:26",
"text": "カ国の深下事税が税や財やサービスの消費が行われる消費税国で、"
},
{
"file": "seg_008.ts",
"start": 451.94,
"end": 454.54,
"clock": "10:57:31",
"text": "負担を求めるという原則でできてまして、"
},
{
"file": "seg_008.ts",
"start": 454.54,
"end": 456.38,
"clock": "10:57:34",
"text": "そうしますという出国家では、"
},
{
"file": "seg_008.ts",
"start": 456.38,
"end": 459.02,
"clock": "10:57:36",
"text": "免税として有出企業が工場しきれない、"
},
{
"file": "seg_008.ts",
"start": 459.02,
"end": 462.22,
"clock": "10:57:39",
"text": "シーレジにしあらた税額の勘法を受けるという一方で、"
},
{
"file": "seg_008.ts",
"start": 462.22,
"end": 464.22,
"clock": "10:57:42",
"text": "輸入時には輸入国家において、"
},
{
"file": "seg_008.ts",
"start": 464.22,
"end": 466.98,
"clock": "10:57:44",
"text": "輸入時に課税をする仕組みになっていて、"
},
{
"file": "seg_008.ts",
"start": 466.98,
"end": 471.02,
"clock": "10:57:46",
"text": "これが全部その170カ国でやっているということは、"
},
{
"file": "seg_008.ts",
"start": 471.02,
"end": 473.26,
"clock": "10:57:51",
"text": "おそらくWTO加盟国の中でも、"
},
{
"file": "seg_008.ts",
"start": 473.26,
"end": 478.94,
"clock": "10:57:53",
"text": "相当な割合のプリスがこれで動いているという事実があります。"
},
{
"file": "seg_008.ts",
"start": 478.94,
"end": 480.94,
"clock": "10:57:58",
"text": "で、国際品という入品となり、"
},
{
"file": "seg_008.ts",
"start": 480.94,
"end": 483.94,
"clock": "10:58:00",
"text": "だって財富に差を設けないという観点をするとすると、"
},
{
"file": "seg_008.ts",
"start": 483.94,
"end": 486.74,
"clock": "10:58:03",
"text": "こういう調整というのが一つの仕切りでございまして、"
},
{
"file": "seg_008.ts",
"start": 486.74,
"end": 490.9,
"clock": "10:58:06",
"text": "この国際的な財を通す取扱いをやっているということで、"
},
{
"file": "seg_008.ts",
"start": 490.9,
"end": 493.86,
"clock": "10:58:10",
"text": "WTOの補助金協定におきましても、"
},
{
"file": "seg_008.ts",
"start": 493.86,
"end": 498.3,
"clock": "10:58:13",
"text": "その今御指摘のあらゆる国におけるこの消費税の幹部ですね、"
},
{
"file": "seg_008.ts",
"start": 498.3,
"end": 501.62,
"clock": "10:58:18",
"text": "これは有出補助金には当たらないという解釈が、"
},
{
"file": "seg_008.ts",
"start": 501.62,
"end": 503.5,
"clock": "10:58:21",
"text": "出ているわけでございます。"
},
{
"file": "seg_008.ts",
"start": 503.5,
"end": 507.3,
"clock": "10:58:23",
"text": "その上で、個別のケースでですね、"
},
{
"file": "seg_008.ts",
"start": 507.3,
"end": 511.02,
"clock": "10:58:27",
"text": "確かにそういう転価が十分じゃないんじゃないかということが、"
},
{
"file": "seg_008.ts",
"start": 511.02,
"end": 512.3,
"clock": "10:58:31",
"text": "指摘されることが、"
},
{
"file": "seg_008.ts",
"start": 512.3,
"end": 513.78,
"clock": "10:58:32",
"text": "それはあるかないかというのは、"
},
{
"file": "seg_008.ts",
"start": 513.78,
"end": 516.34,
"clock": "10:58:33",
"text": "この場で全部私たちも申し上げられないけれども、"
},
{
"file": "seg_008.ts",
"start": 516.34,
"end": 519.14,
"clock": "10:58:36",
"text": "消費税の適正な転価というのは重要である一方、"
},
{
"file": "seg_008.ts",
"start": 519.14,
"end": 523.26,
"clock": "10:58:39",
"text": "不当な根引きをシールなどの適正な転価をさらまたける行為は、"
},
{
"file": "seg_008.ts",
"start": 523.26,
"end": 526.46,
"clock": "10:58:43",
"text": "それが有出を伴うが国内だけであろうが、"
},
{
"file": "seg_008.ts",
"start": 526.46,
"end": 528.46,
"clock": "10:58:46",
"text": "これはあり得る問題であって、"
},
{
"file": "seg_008.ts",
"start": 528.46,
"end": 530.22,
"clock": "10:58:48",
"text": "それはもう有意識ことで、"
},
{
"file": "seg_008.ts",
"start": 530.22,
"end": 531.46,
"clock": "10:58:50",
"text": "公取等で、"
},
{
"file": "seg_008.ts",
"start": 531.46,
"end": 533.78,
"clock": "10:58:51",
"text": "その読金法の関係法令に基づいて、"
},
{
"file": "seg_008.ts",
"start": 533.78,
"end": 536.9,
"clock": "10:58:53",
"text": "厳正に対象していかなければいけないしまして、"
},
{
"file": "seg_008.ts",
"start": 536.9,
"end": 540.58,
"clock": "10:58:56",
"text": "下受け人命みたいな制度もこのところ政府ではやっておりますので、"
},
{
"file": "seg_008.ts",
"start": 540.58,
"end": 544.34,
"clock": "10:59:00",
"text": "しっかりと対応をしてまいりたいと思っております。"
},
{
"file": "seg_008.ts",
"start": 544.34,
"end": 546.22,
"clock": "10:59:04",
"text": "松田真奈部君。"
},
{
"file": "seg_008.ts",
"start": 546.22,
"end": 551.3,
"clock": "10:59:06",
"text": "はい、それをおっしゃる世界的な共通のリュールであるというのは、"
},
{
"file": "seg_008.ts",
"start": 551.3,
"end": 554.7,
"clock": "10:59:11",
"text": "そのとおりであることは十分承知しておりますが、"
},
{
"file": "seg_008.ts",
"start": 554.7,
"end": 560.66,
"clock": "10:59:14",
"text": "世界一百七十国という答えもございましたが、"
},
{
"file": "seg_008.ts",
"start": 560.66,
"end": 567.86,
"clock": "10:59:20",
"text": "中国では税率が13%という増地税という深か地税制が一回と名まれていますけれども、"
},
{
"file": "seg_008.ts",
"start": 567.86,
"end": 571.66,
"clock": "10:59:27",
"text": "今年10月に有出時の幹部が、"
},
{
"file": "seg_008.ts",
"start": 571.66,
"end": 575.06,
"clock": "10:59:31",
"text": "産業補助金として批判されることを回避するため、"
},
{
"file": "seg_008.ts",
"start": 575.06,
"end": 578.34,
"clock": "10:59:35",
"text": "新エネルギー社の有出にかかる幹部に関しては、"
},
{
"file": "seg_008.ts",
"start": 578.34,
"end": 582.22,
"clock": "10:59:38",
"text": "税率を9%に引き下げるということを決定していると報じられています。"
},
{
"file": "seg_008.ts",
"start": 582.22,
"end": 586.1,
"clock": "10:59:42",
"text": "有出補助金との批判を回避するためにも、"
},
{
"file": "seg_008.ts",
"start": 586.1,
"end": 589.18,
"clock": "10:59:46",
"text": "例えば有出補助金にあたって少し厳格をするとか、"
},
{
"file": "seg_008.ts",
"start": 589.18,
"end": 590.58,
"clock": "10:59:49",
"text": "それが無理であれば、"
},
{
"file": "seg_008.ts",
"start": 590.58,
"end": 594.02,
"clock": "10:59:50",
"text": "やはり有出切りをに爆弾な幹部がなされている現状を"
},
{
"file": "seg_008.ts",
"start": 594.02,
"end": 596.22,
"clock": "10:59:54",
"text": "絶成するべく消費税率そのものを"
},
{
"file": "seg_008.ts",
"start": 596.22,
"end": 599.3,
"clock": "10:59:56",
"text": "一律に引き下げるべきではないかということになると思いますけれども、"
},
{
"file": "seg_008.ts",
"start": 599.3,
"end": 600.5,
"clock": "10:59:59",
"text": "いかがでしょうか。"
}
]