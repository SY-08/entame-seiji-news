"file": "seg_012.ts",
"start": 467.17,
"end": 469.17,
"clock": "11:37:47",
"text": "しまうのではないかという御指摘は"
},
{
"file": "seg_012.ts",
"start": 469.17,
"end": 470.17,
"clock": "11:37:49",
"text": "もともとそういう法的な"
},
{
"file": "seg_012.ts",
"start": 470.17,
"end": 473.17,
"clock": "11:37:50",
"text": "位置づけのものではございません"
},
