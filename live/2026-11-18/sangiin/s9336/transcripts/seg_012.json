"file": "seg_012.ts",
"start": 416.17,
"end": 421.17,
"clock": "11:36:56",
"text": "まず御指摘の基金の見直しということも"
},
{
"file": "seg_012.ts",
"start": 421.17,
"end": 424.17,
"clock": "11:37:01",
"text": "日本版同時においては非常に"
},
{
"file": "seg_012.ts",
"start": 424.17,
"end": 427.17,
"clock": "11:37:04",
"text": "強調してやってきているわけでございますが"
},
{
"file": "seg_012.ts",
"start": 427.17,
"end": 431.17,
"clock": "11:37:07",
"text": "この基金は特定の事業の実施に際して"
},
{
"file": "seg_012.ts",
"start": 431.17,
"end": 434.17,
"clock": "11:37:11",
"text": "弾力的な資質が必要だとの"
},
{
"file": "seg_012.ts",
"start": 434.17,
"end": 437.17,
"clock": "11:37:14",
"text": "事情がある場合に設置を認めておりますが"
},
{
"file": "seg_012.ts",
"start": 437.17,
"end": 440.17,
"clock": "11:37:17",
"text": "その当該事業の実施仕事を取りに"
},
{
"file": "seg_012.ts",
"start": 440.17,
"end": 442.17,
"clock": "11:37:20",
"text": "照らして残高が課題であったり"
},
{
"file": "seg_012.ts",
"start": 442.17,
"end": 443.17,
"clock": "11:37:22",
"text": "あるいはその事業が実は"
},
{
"file": "seg_012.ts",
"start": 443.17,
"end": 446.17,
"clock": "11:37:23",
"text": "終わってしまったりしているという場合は"
},
{
"file": "seg_012.ts",
"start": 446.17,
"end": 448.17,
"clock": "11:37:26",
"text": "残高は国庫変脳をするということが"
},
{
"file": "seg_012.ts",
"start": 448.17,
"end": 450.17,
"clock": "11:37:28",
"text": "補助金的下方ですが"
},
{
"file": "seg_012.ts",
"start": 450.17,
"end": 452.17,
"clock": "11:37:30",
"text": "施行令できちっと位置づけられて"
