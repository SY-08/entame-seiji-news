{
"file": "seg_012.ts",
"start": 452.17,
"end": 454.17,
"clock": "11:37:32",
"text": "決まっておりますのでもともと"
},
{
"file": "seg_012.ts",
"start": 454.17,
"end": 456.17,
"clock": "11:37:34",
"text": "今申し上げたような事業になったら"
},
