[
{
"file": "seg_012.ts",
"start": 0.21,
"end": 4.71,
"clock": "11:30:00",
"text": "なんか応援しますよとかGo to It キャンペーンでサポートしますよって"
},
{
"file": "seg_012.ts",
"start": 4.71,
"end": 9.01,
"clock": "11:30:04",
"text": "コロナの時にも支援という形だったと思うんですけれども"
},
{
"file": "seg_012.ts",
"start": 9.01,
"end": 14.61,
"clock": "11:30:09",
"text": "政府の政策変更によって生じる損失がある限りにおいては"
},
{
"file": "seg_012.ts",
"start": 14.61,
"end": 19.81,
"clock": "11:30:14",
"text": "やっぱり補償という概念が正しいのではないかと思います"
},
{
"file": "seg_012.ts",
"start": 19.81,
"end": 24.01,
"clock": "11:30:19",
"text": "ぜひ今の業態のまま飲食店が経営を続けられるような"
},
{
"file": "seg_012.ts",
"start": 24.01,
"end": 28.21,
"clock": "11:30:24",
"text": "政策を講じていただきたいと心からお願い申し上げます"
},
{
"file": "seg_012.ts",
"start": 29.21,
"end": 34.21,
"clock": "11:30:29",
"text": "続いてその財源について伺ってまいりたいと思います"
},
{
"file": "seg_012.ts",
"start": 34.21,
"end": 38.21,
"clock": "11:30:34",
"text": "今回財源については特例交差に頼ることなく"
},
{
"file": "seg_012.ts",
"start": 38.21,
"end": 42.21,
"clock": "11:30:38",
"text": "前年度の指導が定められていない税外収入や"
},
{
"file": "seg_012.ts",
"start": 42.21,
"end": 44.71,
"clock": "11:30:42",
"text": "基金の不要資金などを活用するとともに"
},
{
"file": "seg_012.ts",
"start": 44.71,
"end": 47.71,
"clock": "11:30:44",
"text": "素材特別措置補助金基金の見直しなどによって"
},
{
"file": "seg_012.ts",
"start": 47.71,
"end": 50.71,
"clock": "11:30:47",
"text": "確保する方針が示されています"
},
{
"file": "seg_012.ts",
"start": 50.71,
"end": 54.21,
"clock": "11:30:50",
"text": "そこで確認するのですがこのように一つの法律に"
},
{
"file": "seg_012.ts",
"start": 54.21,
"end": 57.71,
"clock": "11:30:54",
"text": "財源確保の方針まで書き込むというのは"
},
{
"file": "seg_012.ts",
"start": 57.71,
"end": 60.71,
"clock": "11:30:57",
"text": "一般的によくあることなのでしょうか"
},
{
"file": "seg_012.ts",
"start": 60.71,
"end": 61.71,
"clock": "11:31:00",
"text": "答えください"
},
{
"file": "seg_012.ts",
"start": 61.71,
"end": 64.71,
"clock": "11:31:01",
"text": "振動金日工財務副大臣"
},
{
"file": "seg_012.ts",
"start": 64.71,
"end": 69.59,
"clock": "11:31:04",
"text": "お答えいたします"
},
{
"file": "seg_012.ts",
"start": 69.59,
"end": 73.59,
"clock": "11:31:09",
"text": "支援金や飲食料品の消費税率引き下げの財源につきましては"
},
{
"file": "seg_012.ts",
"start": 73.59,
"end": 77.59,
"clock": "11:31:13",
"text": "特例交差に頼らずに確保する旨を法律に明記しております"
},
{
"file": "seg_012.ts",
"start": 77.59,
"end": 82.59,
"clock": "11:31:17",
"text": "個子的の施策の財源を法律の中で定めている例としては"
},
{
"file": "seg_012.ts",
"start": 82.59,
"end": 86.59,
"clock": "11:31:22",
"text": "復興財源確保法において復興施策の財源として"
},
{
"file": "seg_012.ts",
"start": 86.59,
"end": 91.59,
"clock": "11:31:26",
"text": "復興独立税や税外収入を確保する旨を定めた例や"
},
{
"file": "seg_012.ts",
"start": 91.59,
"end": 97.59,
"clock": "11:31:31",
"text": "防衛財源確保法において防衛力整備計画対象経費に当てる財源として"
},
{
"file": "seg_012.ts",
"start": 97.59,
"end": 104.59,
"clock": "11:31:37",
"text": "防衛特別法人税や税外収入等を確保する旨を定めた例などがあります"
},
{
"file": "seg_012.ts",
"start": 104.59,
"end": 107.59,
"clock": "11:31:44",
"text": "なお臨時的な税制措置にもかわらず"
},
{
"file": "seg_012.ts",
"start": 107.59,
"end": 112.59,
"clock": "11:31:47",
"text": "政府として財源確保法案に明記したのは近年では例がなくて"
},
{
"file": "seg_012.ts",
"start": 112.59,
"end": 117.59,
"clock": "11:31:52",
"text": "本法案は政府の施政を明確に示したものとなっているところであります"
},
{
"file": "seg_012.ts",
"start": 117.59,
"end": 121.59,
"clock": "11:31:57",
"text": "その上で今後予算編成改革という大きな枠組みの中で"
},
{
"file": "seg_012.ts",
"start": 121.59,
"end": 127.59,
"clock": "11:32:01",
"text": "税収動向等を見極めつつ再出再入両面の見直しを進めることも合わせて"
},
{
"file": "seg_012.ts",
"start": 127.59,
"end": 131.59,
"clock": "11:32:07",
"text": "財務山だか対GDP費を安定的に引き下げていく中でも"
},
{
"file": "seg_012.ts",
"start": 131.59,
"end": 133.59,
"clock": "11:32:11",
"text": "可能となる財政規模を制裁し"
},
{
"file": "seg_012.ts",
"start": 133.59,
"end": 138.59,
"clock": "11:32:13",
"text": "当初予算と補正予算を通じた通年の国際発行額を"
},
{
"file": "seg_012.ts",
"start": 138.59,
"end": 141.59,
"clock": "11:32:18",
"text": "昨年同様適切にコントロールしながら支援金や"
},
{
"file": "seg_012.ts",
"start": 141.59,
"end": 144.59,
"clock": "11:32:21",
"text": "飲食料品の消費税率引き下げを含め"
},
{
"file": "seg_012.ts",
"start": 144.59,
"end": 149.59,
"clock": "11:32:24",
"text": "さまざまな必要な財政需要に対応してまいります"
},
{
"file": "seg_012.ts",
"start": 149.59,
"end": 151.59,
"clock": "11:32:29",
"text": "塩入り伊勢彦君"
},
{
"file": "seg_012.ts",
"start": 151.59,
"end": 153.59,
"clock": "11:32:31",
"text": "はいありがとうございました"
},
{
"file": "seg_012.ts",
"start": 153.59,
"end": 156.59,
"clock": "11:32:33",
"text": "つまりですねいくつかの事例はあるということなんですけれども"
},
{
"file": "seg_012.ts",
"start": 156.59,
"end": 161.59,
"clock": "11:32:36",
"text": "実際にはあまり多くない異例のことであるということです"
},
{
"file": "seg_012.ts",
"start": 161.59,
"end": 166.59,
"clock": "11:32:41",
"text": "この件について更に伺ってまいりたいのは"
},
{
"file": "seg_012.ts",
"start": 166.59,
"end": 168.59,
"clock": "11:32:46",
"text": "例は11年度以降はですね"
},
{
"file": "seg_012.ts",
"start": 168.59,
"end": 172.59,
"clock": "11:32:48",
"text": "支援金の部分については救付付税額向上の導入も検討しながら"
},
{
"file": "seg_012.ts",
"start": 172.59,
"end": 175.59,
"clock": "11:32:52",
"text": "高級的に続けていく方向となっているので"
},
{
"file": "seg_012.ts",
"start": 175.59,
"end": 178.59,
"clock": "11:32:55",
"text": "高級財源の確保を歌っているわけです"
},
{
"file": "seg_012.ts",
"start": 178.59,
"end": 180.59,
"clock": "11:32:58",
"text": "日本版同時で無駄なところを削って"
},
{
"file": "seg_012.ts",
"start": 180.59,
"end": 183.59,
"clock": "11:33:00",
"text": "素税特別措置や補助金、基金の見直しなどによって"
},
{
"file": "seg_012.ts",
"start": 183.59,
"end": 186.59,
"clock": "11:33:03",
"text": "財源を燃出するということですけれども"
},
{
"file": "seg_012.ts",
"start": 186.59,
"end": 189.59,
"clock": "11:33:06",
"text": "こうした見直しによって生まれる財源というのは"
},
{
"file": "seg_012.ts",
"start": 189.59,
"end": 192.59,
"clock": "11:33:09",
"text": "基本的に一時的なものが多いと思います"
},
{
"file": "seg_012.ts",
"start": 192.59,
"end": 195.59,
"clock": "11:33:12",
"text": "それらが高級財源になり得ると"
},
{
"file": "seg_012.ts",
"start": 195.59,
"end": 198.59,
"clock": "11:33:15",
"text": "片山大臣はお考えでしょうか"
},
{
"file": "seg_012.ts",
"start": 198.59,
"end": 201.59,
"clock": "11:33:18",
"text": "振動金飛行財務副大臣"
},
{
"file": "seg_012.ts",
"start": 201.59,
"end": 209.17,
"clock": "11:33:21",
"text": "例は11年度以降の支援金制度の実施に当たりましては"
},
{
"file": "seg_012.ts",
"start": 209.17,
"end": 213.17,
"clock": "11:33:29",
"text": "対抗において高級財源を確保する必要があり"
},
{
"file": "seg_012.ts",
"start": 213.17,
"end": 216.17,
"clock": "11:33:33",
"text": "市場の支援を得られるよう特例交差にとらず"
},
{
"file": "seg_012.ts",
"start": 216.17,
"end": 219.17,
"clock": "11:33:36",
"text": "素税特別措置補助金の見直しといった"
},
{
"file": "seg_012.ts",
"start": 219.17,
"end": 222.17,
"clock": "11:33:39",
"text": "再出再入両面の見直しにより"
},
{
"file": "seg_012.ts",
"start": 222.17,
"end": 224.17,
"clock": "11:33:42",
"text": "高級財源を確保することとし"
},
{
"file": "seg_012.ts",
"start": 224.17,
"end": 228.17,
"clock": "11:33:44",
"text": "予算編成改革の具体化の状況を踏まえつつ"
},
{
"file": "seg_012.ts",
"start": 228.17,
"end": 231.17,
"clock": "11:33:48",
"text": "早期に結論を得ることとされておりまして"
},
{
"file": "seg_012.ts",
"start": 231.17,
"end": 234.17,
"clock": "11:33:51",
"text": "この方針に沿って対応してまいります"
},
{
"file": "seg_012.ts",
"start": 234.17,
"end": 237.17,
"clock": "11:33:54",
"text": "その上で高級財源につきましては"
},
{
"file": "seg_012.ts",
"start": 237.17,
"end": 240.17,
"clock": "11:33:57",
"text": "再出に対応する安定的な財源と"
},
{
"file": "seg_012.ts",
"start": 240.17,
"end": 244.17,
"clock": "11:34:00",
"text": "考えられるところ例えばこれまで続いてきた"
},
{
"file": "seg_012.ts",
"start": 244.17,
"end": 247.17,
"clock": "11:34:04",
"text": "素税特別措置や補助金を将来にわたって"
},
{
"file": "seg_012.ts",
"start": 247.17,
"end": 250.17,
"clock": "11:34:07",
"text": "見直した場合それは高級財源になりうと"
},
{
"file": "seg_012.ts",
"start": 250.17,
"end": 252.17,
"clock": "11:34:10",
"text": "考えております"
},
{
"file": "seg_012.ts",
"start": 252.17,
"end": 255.17,
"clock": "11:34:12",
"text": "いずれにしましても財源確保の具体像につきましては"
},
{
"file": "seg_012.ts",
"start": 255.17,
"end": 257.17,
"clock": "11:34:15",
"text": "今後の予算編成プロセスにおいて"
},
{
"file": "seg_012.ts",
"start": 257.17,
"end": 259.17,
"clock": "11:34:17",
"text": "確実に示してまいります"
},
{
"file": "seg_012.ts",
"start": 259.17,
"end": 261.17,
"clock": "11:34:19",
"text": "塩井理財科君"
},
{
"file": "seg_012.ts",
"start": 261.17,
"end": 264.17,
"clock": "11:34:21",
"text": "すいません片山大臣と間違って"
},
{
"file": "seg_012.ts",
"start": 264.17,
"end": 266.17,
"clock": "11:34:24",
"text": "質問してしまいましたけれども"
},
{
"file": "seg_012.ts",
"start": 266.17,
"end": 269.17,
"clock": "11:34:26",
"text": "今ですね伺っても分かるのは"
},
{
"file": "seg_012.ts",
"start": 269.17,
"end": 274.17,
"clock": "11:34:29",
"text": "結局毎年毎年無駄なものが"
},
{
"file": "seg_012.ts",
"start": 274.17,
"end": 277.17,
"clock": "11:34:34",
"text": "あるという状況なのかということが"
},
{
"file": "seg_012.ts",
"start": 277.17,
"end": 281.17,
"clock": "11:34:37",
"text": "そもそもの根本的な懸念なんですよね"
},
{
"file": "seg_012.ts",
"start": 281.17,
"end": 284.17,
"clock": "11:34:41",
"text": "再出の見直しによって浮いた財源を"
},
{
"file": "seg_012.ts",
"start": 284.17,
"end": 288.17,
"clock": "11:34:44",
"text": "継続的に当てていくということなんですけれども"
},
{
"file": "seg_012.ts",
"start": 291.17,
"end": 295.17,
"clock": "11:34:51",
"text": "例えば今回の税制上の有儀措置を"
},
{
"file": "seg_012.ts",
"start": 295.17,
"end": 298.17,
"clock": "11:34:55",
"text": "廃止するということにおいては"
},
{
"file": "seg_012.ts",
"start": 298.17,
"end": 301.17,
"clock": "11:34:58",
"text": "その有儀措置を受けてきた人にとっては"
},
{
"file": "seg_012.ts",
"start": 301.17,
"end": 304.17,
"clock": "11:35:01",
"text": "純然たる増税になるわけです"
},
{
"file": "seg_012.ts",
"start": 304.17,
"end": 307.17,
"clock": "11:35:04",
"text": "だから現税をするために増税をしている"
},
{
"file": "seg_012.ts",
"start": 307.17,
"end": 310.17,
"clock": "11:35:07",
"text": "という状態になってしまうということなんだと思います"
},
{
"file": "seg_012.ts",
"start": 310.17,
"end": 313.17,
"clock": "11:35:10",
"text": "例えば例は区年度税制改正の見直し事項には"
},
{
"file": "seg_012.ts",
"start": 313.17,
"end": 317.17,
"clock": "11:35:13",
"text": "祖父や親から小山声結婚子育て資金を"
},
{
"file": "seg_012.ts",
"start": 317.17,
"end": 320.17,
"clock": "11:35:17",
"text": "一括で増養する際の被火税措置を"
},
{
"file": "seg_012.ts",
"start": 320.17,
"end": 323.17,
"clock": "11:35:20",
"text": "廃止するという案も示されておられますけれども"
},
{
"file": "seg_012.ts",
"start": 323.17,
"end": 326.17,
"clock": "11:35:23",
"text": "その制度を存続させるべきかどうかというのを"
},
{
"file": "seg_012.ts",
"start": 326.17,
"end": 329.17,
"clock": "11:35:26",
"text": "検証して政策効果として検証する必要が"
},
{
"file": "seg_012.ts",
"start": 329.17,
"end": 332.17,
"clock": "11:35:29",
"text": "あると思いますただ何が無駄で"
},
{
"file": "seg_012.ts",
"start": 332.17,
"end": 334.17,
"clock": "11:35:32",
"text": "何が無駄でないかというのを"
},
{
"file": "seg_012.ts",
"start": 334.17,
"end": 336.17,
"clock": "11:35:34",
"text": "その程度判断していくことになりますので"
},
{
"file": "seg_012.ts",
"start": 336.17,
"end": 339.17,
"clock": "11:35:36",
"text": "今は不要と思われていた政策でも"
},
{
"file": "seg_012.ts",
"start": 339.17,
"end": 341.17,
"clock": "11:35:39",
"text": "経済状況や社会情勢の変化によって"
},
{
"file": "seg_012.ts",
"start": 341.17,
"end": 345.17,
"clock": "11:35:41",
"text": "再び必要になってくることもあると思います"
},
{
"file": "seg_012.ts",
"start": 345.17,
"end": 348.17,
"clock": "11:35:45",
"text": "そうした政策を消すと毎年毎年安定した"
},
{
"file": "seg_012.ts",
"start": 348.17,
"end": 351.17,
"clock": "11:35:48",
"text": "財源を作っていくということが"
},
{
"file": "seg_012.ts",
"start": 351.17,
"end": 353.17,
"clock": "11:35:51",
"text": "本当に可能なのかどうかということ"
},
{
"file": "seg_012.ts",
"start": 353.17,
"end": 356.17,
"clock": "11:35:53",
"text": "それから毎年数兆円規模の採出を"
},
{
"file": "seg_012.ts",
"start": 356.17,
"end": 359.17,
"clock": "11:35:56",
"text": "削減できるということであれば"
},
{
"file": "seg_012.ts",
"start": 359.17,
"end": 361.17,
"clock": "11:35:59",
"text": "それまでの予算編成では一体どういう"
},
{
"file": "seg_012.ts",
"start": 361.17,
"end": 363.17,
"clock": "11:36:01",
"text": "査定を行ってきたのかという"
},
{
"file": "seg_012.ts",
"start": 363.17,
"end": 366.17,
"clock": "11:36:03",
"text": "素朴な疑問もあいてくるわけです"
},
{
"file": "seg_012.ts",
"start": 367.17,
"end": 372.17,
"clock": "11:36:07",
"text": "それが十分に予見可能で"
},
{
"file": "seg_012.ts",
"start": 372.17,
"end": 374.17,
"clock": "11:36:12",
"text": "安定したものになるかというのは"
},
{
"file": "seg_012.ts",
"start": 374.17,
"end": 377.17,
"clock": "11:36:14",
"text": "ちょっと考えにくいなとその点を"
},
{
"file": "seg_012.ts",
"start": 377.17,
"end": 379.17,
"clock": "11:36:17",
"text": "さらに深掘りして片山大臣に"
},
{
"file": "seg_012.ts",
"start": 379.17,
"end": 382.17,
"clock": "11:36:19",
"text": "伺っていきたいと思うんですけれども"
},
{
"file": "seg_012.ts",
"start": 382.17,
"end": 385.17,
"clock": "11:36:22",
"text": "今回日本版同時で基金や素税"
},
{
"file": "seg_012.ts",
"start": 385.17,
"end": 387.17,
"clock": "11:36:25",
"text": "特別措置の見直し再出改革を"
},
{
"file": "seg_012.ts",
"start": 387.17,
"end": 389.17,
"clock": "11:36:27",
"text": "行い財源を練出すると"
},
{
"file": "seg_012.ts",
"start": 389.17,
"end": 392.17,
"clock": "11:36:29",
"text": "そうしますと基金の見直しについては"
},
{
"file": "seg_012.ts",
"start": 392.17,
"end": 394.17,
"clock": "11:36:32",
"text": "各省庁が持っている資金を一旦"
},
{
"file": "seg_012.ts",
"start": 394.17,
"end": 396.17,
"clock": "11:36:34",
"text": "個々に変更させて結果的に一般"
},
{
"file": "seg_012.ts",
"start": 396.17,
"end": 399.17,
"clock": "11:36:36",
"text": "財源化するということになると思うんです"
},
{
"file": "seg_012.ts",
"start": 399.17,
"end": 402.17,
"clock": "11:36:39",
"text": "そうしますと各省庁が保有していた財源を"
},
{
"file": "seg_012.ts",
"start": 402.17,
"end": 405.17,
"clock": "11:36:42",
"text": "結果として財務省が予算編成の中で"
},
{
"file": "seg_012.ts",
"start": 405.17,
"end": 408.17,
"clock": "11:36:45",
"text": "管理することになって各省庁が独自に"
},
{
"file": "seg_012.ts",
"start": 408.17,
"end": 410.17,
"clock": "11:36:48",
"text": "進める政策への予算が相対的に"
},
{
"file": "seg_012.ts",
"start": 410.17,
"end": 413.17,
"clock": "11:36:50",
"text": "減ってしまうということになりませんか"
},
{
"file": "seg_012.ts",
"start": 413.17,
"end": 416.17,
"clock": "11:36:53",
"text": "片山国務大臣"
