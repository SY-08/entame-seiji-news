"start": 557.17,
"end": 559.17,
"clock": "11:39:17",
"text": "積極財政の考え方に"
},
{
"file": "seg_012.ts",
"start": 559.17,
"end": 561.17,
"clock": "11:39:19",
"text": "立却しております"
},
