[
{
"file": "seg_007.ts",
"start": 0.0,
"end": 7.22,
"clock": "10:40:00",
"text": "今般の給付事業の給付手続きにつきましては、 現在検討中ではあるのですが、"
},
{
"file": "seg_007.ts",
"start": 7.22,
"end": 11.62,
"clock": "10:40:07",
"text": "これは非常に多くの対象者に対しまして 給付を行う必要もあります。"
},
{
"file": "seg_007.ts",
"start": 11.62,
"end": 15.0,
"clock": "10:40:11",
"text": "不正需求を防止つつオンラインの活用も含めて、"
},
{
"file": "seg_007.ts",
"start": 15.0,
"end": 19.22,
"clock": "10:40:15",
"text": "なるべく事務負担を軽減して、 効率的かつ確実に給付できる仕組み、"
},
{
"file": "seg_007.ts",
"start": 19.22,
"end": 21.22,
"clock": "10:40:19",
"text": "これを構築したいと考えてございます。"
},
{
"file": "seg_007.ts",
"start": 21.22,
"end": 26.58,
"clock": "10:40:21",
"text": "例えば、公勤受取講座の活用なんかも含めまして、"
},
{
"file": "seg_007.ts",
"start": 26.58,
"end": 36.78,
"clock": "10:40:26",
"text": "効率的かつ確実な事務失効について、 現在デジタル庁など関係省庁にもご相談しながら、"
},
{
"file": "seg_007.ts",
"start": 36.78,
"end": 40.98,
"clock": "10:40:36",
"text": "どういったことができるかも含めて検討しているところでございます。"
},
{
"file": "seg_007.ts",
"start": 40.98,
"end": 49.98,
"clock": "10:40:40",
"text": "また、農林業業者の申請等をサポートする仕組みも含めた事業の実施体制を 構築する必要もあると考えてございまして、"
},
{
"file": "seg_007.ts",
"start": 49.98,
"end": 55.48,
"clock": "10:40:49",
"text": "農業を始めとする農林業業者に関わる団体の皆様の協力を 見ながら、"
},
{
"file": "seg_007.ts",
"start": 55.48,
"end": 63.98,
"clock": "10:40:55",
"text": "給付の対象となる農林業業者の皆様に確実に支援をお届けできるように してまいりたいと考えてございます。"
},
{
"file": "seg_007.ts",
"start": 64.98,
"end": 66.48,
"clock": "10:41:04",
"text": "佐々木理也君。"
},
{
"file": "seg_007.ts",
"start": 66.48,
"end": 67.78,
"clock": "10:41:06",
"text": "ありがとうございます。"
},
{
"file": "seg_007.ts",
"start": 67.78,
"end": 73.18,
"clock": "10:41:07",
"text": "せっかく毎ナンバーカードもございますので、 それを有効活用できるように、"
},
{
"file": "seg_007.ts",
"start": 73.18,
"end": 79.58,
"clock": "10:41:13",
"text": "個人情報の観点からも難しいと思いますが、 ぜひ挑戦の方をやっていただきたいと思います。"
},
{
"file": "seg_007.ts",
"start": 79.58,
"end": 87.38,
"clock": "10:41:19",
"text": "次に、先ほど今ございましたが、農協や 漁協の役割についてもお伺いさせていただきたいと思います。"
},
{
"file": "seg_007.ts",
"start": 87.38,
"end": 93.58,
"clock": "10:41:27",
"text": "遠隔な給付にはやはりJAや漁協の協力が 欠かせないと思います。"
},
{
"file": "seg_007.ts",
"start": 93.58,
"end": 96.98,
"clock": "10:41:33",
"text": "現場では深刻な人手不足もあります。"
},
{
"file": "seg_007.ts",
"start": 96.98,
"end": 103.38,
"clock": "10:41:36",
"text": "新生支援や売り明けだからの確認まで 担えば大きな負担になってくると思います。"
},
{
"file": "seg_007.ts",
"start": 103.38,
"end": 110.18,
"clock": "10:41:43",
"text": "JAや漁協にどこまでの役割を求めるか、 また課題な事務負担を防ぐため、"
},
{
"file": "seg_007.ts",
"start": 110.18,
"end": 117.98,
"clock": "10:41:50",
"text": "必要な事務費を基礎の農水関係予算とは別枠で しっかりと確保していただきたいと考えますが、"
},
{
"file": "seg_007.ts",
"start": 117.98,
"end": 120.38,
"clock": "10:41:57",
"text": "農水町のご見解をお伺いいたします。"
},
{
"file": "seg_007.ts",
"start": 120.38,
"end": 122.58,
"clock": "10:42:00",
"text": "小林大紀経営局長。"
},
{
"file": "seg_007.ts",
"start": 123.58,
"end": 125.38,
"clock": "10:42:03",
"text": "お答え申し上げます。"
},
{
"file": "seg_007.ts",
"start": 125.38,
"end": 131.98,
"clock": "10:42:05",
"text": "今般の給付事業の実施体制、これを構築するためで、 農林業業者へのサポートを"
},
{
"file": "seg_007.ts",
"start": 131.98,
"end": 138.58,
"clock": "10:42:11",
"text": "こういった面を含めまして農業を始めとする 農林業業者に関わる団体の皆様の協力は"
},
{
"file": "seg_007.ts",
"start": 138.58,
"end": 140.38,
"clock": "10:42:18",
"text": "不可欠であると考えております。"
},
{
"file": "seg_007.ts",
"start": 140.38,
"end": 146.98,
"clock": "10:42:20",
"text": "このため、給付手続きにつきましては、 新生行う農林業業者の皆様もちろんでございますけれども、"
},
{
"file": "seg_007.ts",
"start": 146.98,
"end": 151.38,
"clock": "10:42:26",
"text": "こういった新生サポートを行う団体の皆様にとっても、"
},
{
"file": "seg_007.ts",
"start": 151.38,
"end": 158.78,
"clock": "10:42:31",
"text": "可能な限り効率的で負担の少ないものとする、 こういった観点から、確定申告書など、"
},
{
"file": "seg_007.ts",
"start": 158.78,
"end": 166.98,
"clock": "10:42:38",
"text": "既存の処理のを最大限活用するといったことなども含めて、 必要な手続きを検討しておるところでございますし、"
},
{
"file": "seg_007.ts",
"start": 166.98,
"end": 173.58,
"clock": "10:42:46",
"text": "また、本事業に係る予算につきましては、 こうした給付をするために必要となる事務経費も含めて、"
},
{
"file": "seg_007.ts",
"start": 173.58,
"end": 175.58,
"clock": "10:42:53",
"text": "しっかり検討してまいりたいと考えております。"
},
{
"file": "seg_007.ts",
"start": 175.58,
"end": 182.78,
"clock": "10:42:55",
"text": "また、農林水産省といたしましては、 こうした事務経費等を含めた給付事業に係る予算の確保に当たりましては、"
},
{
"file": "seg_007.ts",
"start": 182.78,
"end": 187.98,
"clock": "10:43:02",
"text": "今般の飲食料品の消費税率の引き下げが、 臨時的な対応でございまして、"
},
{
"file": "seg_007.ts",
"start": 187.98,
"end": 195.38,
"clock": "10:43:07",
"text": "農林水産政策に向上的に必要となる経費の予算とは、 性質が異なるといったことから、"
},
{
"file": "seg_007.ts",
"start": 195.38,
"end": 198.98,
"clock": "10:43:15",
"text": "既存の予算に影響が出ないように 措置される必要があると考えてございます。"
},
{
"file": "seg_007.ts",
"start": 200.38,
"end": 201.98,
"clock": "10:43:20",
"text": "佐々木議員"
},
{
"file": "seg_007.ts",
"start": 201.98,
"end": 205.98,
"clock": "10:43:21",
"text": "ありがとうございます。安心をいたしました。 業務料に見合ったですね、"
},
{
"file": "seg_007.ts",
"start": 205.98,
"end": 209.58,
"clock": "10:43:25",
"text": "予算の確保をしっかりとしていただきたいと思います。"
},
{
"file": "seg_007.ts",
"start": 209.58,
"end": 215.18,
"clock": "10:43:29",
"text": "最後に、消費税率変更による 事業変動についてお伺いをいたします。"
},
{
"file": "seg_007.ts",
"start": 215.18,
"end": 221.88,
"clock": "10:43:35",
"text": "コメなど保存が効く食品では、 現在前の買い控えや2年後の税率引き上げの"
},
{
"file": "seg_007.ts",
"start": 221.88,
"end": 224.78,
"clock": "10:43:41",
"text": "買いだめが懸念をされと思います。"
},
{
"file": "seg_007.ts",
"start": 224.78,
"end": 231.78,
"clock": "10:43:44",
"text": "こうした事業の方よりは、 価格や生産者の経営にも大きく影響をいたします。"
},
{
"file": "seg_007.ts",
"start": 231.78,
"end": 237.18,
"clock": "10:43:51",
"text": "先日の農林水産委員会でも、 コメの事業予測の制度向上について"
},
{
"file": "seg_007.ts",
"start": 237.18,
"end": 242.58,
"clock": "10:43:57",
"text": "質問をさせていただきました。 農水省は税率変更によって、"
},
{
"file": "seg_007.ts",
"start": 242.58,
"end": 248.98,
"clock": "10:44:02",
"text": "コメの事業変動をどう見込み、 価格の急変や流通の混乱を防ぐための"
},
{
"file": "seg_007.ts",
"start": 248.98,
"end": 255.28,
"clock": "10:44:08",
"text": "支援などを考えていらっしゃるか、 そのことについて対策を講じる予定があるかなど"
},
{
"file": "seg_007.ts",
"start": 255.28,
"end": 257.58,
"clock": "10:44:15",
"text": "教えていただければと思います。"
},
{
"file": "seg_007.ts",
"start": 258.58,
"end": 264.08,
"clock": "10:44:18",
"text": "安藤川広太け農林水産大臣政務官"
},
{
"file": "seg_007.ts",
"start": 265.38,
"end": 268.68,
"clock": "10:44:25",
"text": "佐々木委員の質問にお答えいたします。"
},
{
"file": "seg_007.ts",
"start": 268.68,
"end": 274.68,
"clock": "10:44:28",
"text": "2年間の食料品の消費税減税の開始前、 および終了した後のコメの"
},
{
"file": "seg_007.ts",
"start": 274.68,
"end": 279.48,
"clock": "10:44:34",
"text": "事業や価格の状況につきましては、 今後のコメの生産や消費の動向などにより"
},
{
"file": "seg_007.ts",
"start": 279.48,
"end": 283.48,
"clock": "10:44:39",
"text": "変動をするために、 定量的な分析が難しく予断を持って"
},
{
"file": "seg_007.ts",
"start": 283.48,
"end": 286.28,
"clock": "10:44:43",
"text": "申し上げることができない というふうに考えております。"
},
{
"file": "seg_007.ts",
"start": 286.28,
"end": 290.28,
"clock": "10:44:46",
"text": "農水措置としましては、 米について食料法に基づき、"
},
{
"file": "seg_007.ts",
"start": 290.28,
"end": 295.88,
"clock": "10:44:50",
"text": "毎年6年の受給の見通しを策定しているほか、 民間財庫料、取引価格、"
},
{
"file": "seg_007.ts",
"start": 295.88,
"end": 300.48,
"clock": "10:44:55",
"text": "数量などについても、 毎月調査公表をすることとしておりまして、"
},
{
"file": "seg_007.ts",
"start": 300.48,
"end": 304.08,
"clock": "10:45:00",
"text": "引き続きこれらの情報によって 受給の状況を把握してまわりたい"
},
{
"file": "seg_007.ts",
"start": 304.08,
"end": 305.48,
"clock": "10:45:04",
"text": "というふうに考えております。"
},
{
"file": "seg_007.ts",
"start": 305.48,
"end": 312.48,
"clock": "10:45:05",
"text": "その上で、米の受給の安定を図ることで、 結果として価格の安定化が図らえるように、"
},
{
"file": "seg_007.ts",
"start": 312.48,
"end": 317.48,
"clock": "10:45:12",
"text": "食用、米、加工用、米米用、 輸出用などの多様な米の需要開拓を"
},
{
"file": "seg_007.ts",
"start": 317.48,
"end": 321.12,
"clock": "10:45:17",
"text": "進めた上で、こうした多様な米の 需要に応じた生産を"
},
{
"file": "seg_007.ts",
"start": 321.12,
"end": 324.48,
"clock": "10:45:21",
"text": "徹底することが基本であり、 その環境を整えてまいります。"
},
{
"file": "seg_007.ts",
"start": 324.48,
"end": 330.88,
"clock": "10:45:24",
"text": "一番ご記念されていらっしゃる、 現在、会前の会議会、"
},
{
"file": "seg_007.ts",
"start": 330.88,
"end": 337.08,
"clock": "10:45:30",
"text": "終了後の会談に関しましては、 予見可能が高いために、"
},
{
"file": "seg_007.ts",
"start": 337.08,
"end": 341.48,
"clock": "10:45:37",
"text": "ある程度、棚からものがなくなる ということはないかというふうに思いますが、"
},
{
"file": "seg_007.ts",
"start": 341.48,
"end": 346.48,
"clock": "10:45:41",
"text": "以前しましても、我々としましても、 令和9年度、10年度産の生産状況や"
},
{
"file": "seg_007.ts",
"start": 346.48,
"end": 351.48,
"clock": "10:45:46",
"text": "十九バランス、さまざまなデータなどを 持ち出しながら対応してまいりたい"
},
{
"file": "seg_007.ts",
"start": 351.48,
"end": 353.48,
"clock": "10:45:51",
"text": "というふうに考えております。"
},
{
"file": "seg_007.ts",
"start": 353.48,
"end": 354.48,
"clock": "10:45:53",
"text": "佐々木入れ君。"
},
{
"file": "seg_007.ts",
"start": 354.48,
"end": 357.48,
"clock": "10:45:54",
"text": "はい、以上で質問を終わり立ちます。 ありがとうございました。"
},
{
"file": "seg_007.ts",
"start": 357.48,
"end": 375.46,
"clock": "10:45:57",
"text": "松田真奈子君。"
},
{
"file": "seg_007.ts",
"start": 375.46,
"end": 381.46,
"clock": "10:46:15",
"text": "参政党の松田真奈子でございます。 私どもの参政党は、"
},
{
"file": "seg_007.ts",
"start": 381.46,
"end": 385.46,
"clock": "10:46:21",
"text": "消費税率を一率5%に引き下げて インポイスを廃止すると、"
},
{
"file": "seg_007.ts",
"start": 385.46,
"end": 389.46,
"clock": "10:46:25",
"text": "そういう法案を提出しておりまして、 その立場から今回が消費税に絞って"
},
{
"file": "seg_007.ts",
"start": 389.46,
"end": 392.46,
"clock": "10:46:29",
"text": "質問したいと思います。 通告ではたくさん出していますが、"
},
{
"file": "seg_007.ts",
"start": 392.46,
"end": 395.46,
"clock": "10:46:32",
"text": "時間の範囲で行けるところまで 行きたいと思っています。"
},
{
"file": "seg_007.ts",
"start": 395.46,
"end": 398.46,
"clock": "10:46:35",
"text": "私も、片山大臣と同じく、 活性をおくらしように"
},
{
"file": "seg_007.ts",
"start": 398.46,
"end": 402.46,
"clock": "10:46:38",
"text": "拘束した人間でございますから、 消費税を正当活用の理屈は"
},
{
"file": "seg_007.ts",
"start": 402.46,
"end": 405.46,
"clock": "10:46:42",
"text": "もう知り尽くしているという人間でございますけれども、"
},
{
"file": "seg_007.ts",
"start": 405.46,
"end": 410.46,
"clock": "10:46:45",
"text": "しかし、理屈は理屈として、他方で 多くの国民や納税者から大変不満が"
},
{
"file": "seg_007.ts",
"start": 410.46,
"end": 414.46,
"clock": "10:46:50",
"text": "非常に強い税制でもありまして、 参政党はこうした国民の立場に"
},
{
"file": "seg_007.ts",
"start": 414.46,
"end": 418.46,
"clock": "10:46:54",
"text": "立ちまして、消費税の段階的廃止を 唱えるようになったんですけれども、"
},
{
"file": "seg_007.ts",
"start": 418.46,
"end": 423.46,
"clock": "10:46:58",
"text": "形成裁民という言葉がありますが、 それを言うのであれば、"
},
{
"file": "seg_007.ts",
"start": 423.46,
"end": 430.46,
"clock": "10:47:03",
"text": "こうした民の不満にきちんと答えていく必要が 異性者としてはあるのではなかろうかと思いますので、"
},
{
"file": "seg_007.ts",
"start": 430.46,
"end": 434.46,
"clock": "10:47:10",
"text": "よろしくお願いしたいと思います。 そのなかん点から今回の質問は、"
},
{
"file": "seg_007.ts",
"start": 434.46,
"end": 439.46,
"clock": "10:47:14",
"text": "消費税そのものの問題点どう考えるか、 片山大臣の見解を正しまして、"
},
{
"file": "seg_007.ts",
"start": 439.46,
"end": 446.46,
"clock": "10:47:19",
"text": "今回の政府の法案、一時的な食品消費 厳税ではなく、消費厳税をやるのであれば、"
},
{
"file": "seg_007.ts",
"start": 446.46,
"end": 451.46,
"clock": "10:47:26",
"text": "私たち参政党が法案提出している 一律の高級厳税があるべきだということについて、"
},
{
"file": "seg_007.ts",
"start": 451.46,
"end": 455.46,
"clock": "10:47:31",
"text": "国民の皆さんに考えていただく 素材を提供したいと思っております。"
},
{
"file": "seg_007.ts",
"start": 455.46,
"end": 462.46,
"clock": "10:47:35",
"text": "確かに、所得税とか、そういった 直接税、所得や資産の補足というのが"
},
{
"file": "seg_007.ts",
"start": 462.46,
"end": 467.46,
"clock": "10:47:42",
"text": "非常に困難であると、それに対して どんな金持ちでも物を買うときには"
},
{
"file": "seg_007.ts",
"start": 467.46,
"end": 471.46,
"clock": "10:47:47",
"text": "消費税を負担するという理屈で から言うと、消費税は、"
},
{
"file": "seg_007.ts",
"start": 471.46,
"end": 475.46,
"clock": "10:47:51",
"text": "長税側から見れば非常に便利な税制なんですけれども、"
},
{
"file": "seg_007.ts",
"start": 475.46,
"end": 481.46,
"clock": "10:47:55",
"text": "ただ、所得税については、 県戦調子を受ける給与所得者との間で、"
},
{
"file": "seg_007.ts",
"start": 481.46,
"end": 488.46,
"clock": "10:48:01",
"text": "当合産とか黒読とか言われてきた 状況もありますので、消費税は金融者にとって"
},
{
"file": "seg_007.ts",
"start": 488.46,
"end": 493.46,
"clock": "10:48:08",
"text": "より高批な税制であるという 側面を指摘されるところで、"
},
{
"file": "seg_007.ts",
"start": 493.46,
"end": 499.46,
"clock": "10:48:13",
"text": "私も昔、1989年の消費税導入時に オークラショの候補を担当してまして、"
},
{
"file": "seg_007.ts",
"start": 499.46,
"end": 504.46,
"clock": "10:48:19",
"text": "消費税のPRをして、それは今 全然立場が違うわけですけれども、"
},
{
"file": "seg_007.ts",
"start": 504.46,
"end": 507.46,
"clock": "10:48:24",
"text": "その時もそんな話もしていたことが あります。"
},
{
"file": "seg_007.ts",
"start": 507.46,
"end": 513.46,
"clock": "10:48:27",
"text": "ただ、この消費税制、実際には、 民間の納税者側、特に中小、"
},
{
"file": "seg_007.ts",
"start": 513.46,
"end": 516.46,
"clock": "10:48:33",
"text": "冷蔽企業にとっては過酷な税制でもあると、"
},
{
"file": "seg_007.ts",
"start": 516.46,
"end": 520.46,
"clock": "10:48:36",
"text": "そして金融者にとっても賃上げを 妨げている税制ではないかという"
},
{
"file": "seg_007.ts",
"start": 520.46,
"end": 525.46,
"clock": "10:48:40",
"text": "意気がなされているわけであります。 消費税そのものの最大の問題は、"
},
{
"file": "seg_007.ts",
"start": 525.46,
"end": 530.46,
"clock": "10:48:45",
"text": "制度の建前と負担の実態が異なって くることにあるんじゃないかと、"
},
{
"file": "seg_007.ts",
"start": 530.46,
"end": 535.46,
"clock": "10:48:50",
"text": "消費者が負担し、納税者は事業者である だから関節であるといいますが、"
},
{
"file": "seg_007.ts",
"start": 535.46,
"end": 540.46,
"clock": "10:48:55",
"text": "これは価格転換が完全に行われている 場合に初めて言えることではないでしょうか。"
},
{
"file": "seg_007.ts",
"start": 540.46,
"end": 545.46,
"clock": "10:49:00",
"text": "かでてから、中小企業経営者の方々 これ様子に人権品対する仮生で、"
},
{
"file": "seg_007.ts",
"start": 545.46,
"end": 552.46,
"clock": "10:49:05",
"text": "水利益率で商売をしている私たちにとっては もう負担以外の何もでもないという声を聞いておりましたけれども、"
},
{
"file": "seg_007.ts",
"start": 552.46,
"end": 559.46,
"clock": "10:49:12",
"text": "また、国税当局もこの建前を前提にして、 消費税は、"
},
{
"file": "seg_007.ts",
"start": 559.46,
"end": 562.46,
"clock": "10:49:19",
"text": "事業、消費者からの預かり金のような ものであって、"
},
{
"file": "seg_007.ts",
"start": 562.46,
"end": 568.46,
"clock": "10:49:22",
"text": "これをちゃんと納税しないのは、消費者に対する 詐欺であり犯罪行為だという立場から、"
},
{
"file": "seg_007.ts",
"start": 568.46,
"end": 574.46,
"clock": "10:49:28",
"text": "実は私も国税局で丸沢を預かっていた時に、 こうした事案をやったことがあったんですが、"
},
{
"file": "seg_007.ts",
"start": 574.46,
"end": 583.46,
"clock": "10:49:34",
"text": "ただ、国税局の方もやめられて、OBになって 税理士になりますと、中小冷蔽企業の立場に立っているようなやると、"
},
{
"file": "seg_007.ts",
"start": 583.46,
"end": 590.46,
"clock": "10:49:43",
"text": "やっぱり消費税という疑問の声を本音でおっしゃる方も多いんですね。"
},
{
"file": "seg_007.ts",
"start": 590.46,
"end": 599.46,
"clock": "10:49:50",
"text": "そもそも資本主義、市場経済のもとでは、 消費税も事業者にとってはさまざまなコストの一つでありまして、"
},
{
"file": "seg_007.ts",
"start": 599.46,
"end": 601.46,
"clock": "10:49:59",
"text": "でか"
}
]