[
{
"file": "seg_009.ts",
"start": 0.0,
"end": 4.0,
"clock": "11:00:01",
"text": "例えば逆体でも4種類というふうに"
},
{
"file": "seg_009.ts",
"start": 4.0,
"end": 6.5,
"clock": "11:00:05",
"text": "例えば逆体であれば言われていますけれども"
},
{
"file": "seg_009.ts",
"start": 6.5,
"end": 8.32,
"clock": "11:00:07",
"text": "ネグレクトであったりとか"
},
{
"file": "seg_009.ts",
"start": 8.32,
"end": 11.2,
"clock": "11:00:09",
"text": "心理的な逆体というような場合であれば"
},
{
"file": "seg_009.ts",
"start": 11.2,
"end": 14.4,
"clock": "11:00:12",
"text": "保護をするまでにも継続して"
},
{
"file": "seg_009.ts",
"start": 14.4,
"end": 17.6,
"clock": "11:00:15",
"text": "例えばチェックがなされていたり"
},
{
"file": "seg_009.ts",
"start": 17.6,
"end": 19.24,
"clock": "11:00:18",
"text": "家族への関わりとか"
},
{
"file": "seg_009.ts",
"start": 19.24,
"end": 22.16,
"clock": "11:00:20",
"text": "子どもへの関わりもなされていたりという中で"
},
{
"file": "seg_009.ts",
"start": 22.16,
"end": 26.16,
"clock": "11:00:23",
"text": "事前審査が多いなということなのかどうかとか"
},
{
"file": "seg_009.ts",
"start": 26.16,
"end": 29.0,
"clock": "11:00:27",
"text": "この事前審査がなされている場合について"
},
{
"file": "seg_009.ts",
"start": 29.0,
"end": 31.2,
"clock": "11:00:30",
"text": "実際にはどういう場合が多いのかということを"
},
{
"file": "seg_009.ts",
"start": 31.2,
"end": 32.44,
"clock": "11:00:32",
"text": "教えていただけますでしょうか"
},
{
"file": "seg_009.ts",
"start": 32.44,
"end": 33.96,
"clock": "11:00:33",
"text": "原画審議官"
},
{
"file": "seg_009.ts",
"start": 33.96,
"end": 35.3,
"clock": "11:00:34",
"text": "お答えいたします"
},
{
"file": "seg_009.ts",
"start": 35.3,
"end": 37.4,
"clock": "11:00:36",
"text": "一時保護上の自転審査を行った"
},
{
"file": "seg_009.ts",
"start": 37.4,
"end": 39.7,
"clock": "11:00:38",
"text": "42件に係る各事案の概要は"
},
{
"file": "seg_009.ts",
"start": 39.7,
"end": 43.9,
"clock": "11:00:40",
"text": "把握してございません"
},
{
"file": "seg_009.ts",
"start": 43.9,
"end": 45.22,
"clock": "11:00:44",
"text": "愛藤太誠君"
},
{
"file": "seg_009.ts",
"start": 45.22,
"end": 46.98,
"clock": "11:00:46",
"text": "ありがとうございます"
},
{
"file": "seg_009.ts",
"start": 46.98,
"end": 52.38,
"clock": "11:00:47",
"text": "子ども家庭長として把握をしていないということなんですね"
},
{
"file": "seg_009.ts",
"start": 52.38,
"end": 53.42,
"clock": "11:00:53",
"text": "念のためですけれども"
},
{
"file": "seg_009.ts",
"start": 53.42,
"end": 55.82,
"clock": "11:00:54",
"text": "最高裁も把握はされていないですよね"
},
{
"file": "seg_009.ts",
"start": 55.82,
"end": 57.58,
"clock": "11:00:56",
"text": "やっぱりこの点について"
},
{
"file": "seg_009.ts",
"start": 57.58,
"end": 61.02,
"clock": "11:00:58",
"text": "最高裁判所事務総局サムラ家庭局長"
},
{
"file": "seg_009.ts",
"start": 61.02,
"end": 61.82,
"clock": "11:01:02",
"text": "お答え申し上げます"
},
{
"file": "seg_009.ts",
"start": 61.82,
"end": 64.02,
"clock": "11:01:02",
"text": "最高裁判所としても把握してございません"
},
{
"file": "seg_009.ts",
"start": 64.02,
"end": 65.26,
"clock": "11:01:05",
"text": "愛藤太誠君"
},
{
"file": "seg_009.ts",
"start": 65.26,
"end": 66.66,
"clock": "11:01:06",
"text": "ありがとうございます"
},
{
"file": "seg_009.ts",
"start": 66.66,
"end": 68.46,
"clock": "11:01:07",
"text": "この司法審査ですけれども"
},
{
"file": "seg_009.ts",
"start": 68.46,
"end": 70.98,
"clock": "11:01:09",
"text": "前回確認をさせていただいた中で"
},
{
"file": "seg_009.ts",
"start": 70.98,
"end": 75.9,
"clock": "11:01:11",
"text": "どういう処理体制で審査をしているのかというところで"
},
{
"file": "seg_009.ts",
"start": 75.9,
"end": 80.38,
"clock": "11:01:16",
"text": "前回の子ども家庭長の答弁の中では"
},
{
"file": "seg_009.ts",
"start": 80.38,
"end": 82.1,
"clock": "11:01:21",
"text": "約9割ですね"
},
{
"file": "seg_009.ts",
"start": 82.1,
"end": 89.18,
"clock": "11:01:23",
"text": "全体の約9割が通常の例上処理と同じ体制で"
},
{
"file": "seg_009.ts",
"start": 89.18,
"end": 93.38,
"clock": "11:01:30",
"text": "地方裁判所家庭裁判所等でチェックをしているというふうに"
},
{
"file": "seg_009.ts",
"start": 93.38,
"end": 95.74,
"clock": "11:01:34",
"text": "お聞きをしています"
},
{
"file": "seg_009.ts",
"start": 95.74,
"end": 100.38,
"clock": "11:01:36",
"text": "これが具体的なところでも少し詳細というと"
},
{
"file": "seg_009.ts",
"start": 100.38,
"end": 104.02,
"clock": "11:01:41",
"text": "全て通常の刑事事件における一般例上と同じく"
},
{
"file": "seg_009.ts",
"start": 104.02,
"end": 107.34,
"clock": "11:01:45",
"text": "地方裁判所会裁判所において処理する体制"
},
{
"file": "seg_009.ts",
"start": 107.34,
"end": 110.38,
"clock": "11:01:48",
"text": "これが9割というところだと思いますけれども"
},
{
"file": "seg_009.ts",
"start": 110.38,
"end": 114.54,
"clock": "11:01:51",
"text": "残りの1割が平日日中の民家庭裁判所で処理し"
},
{
"file": "seg_009.ts",
"start": 114.54,
"end": 119.02,
"clock": "11:01:55",
"text": "平日夜間および休日は例上処理と同じ体制"
},
{
"file": "seg_009.ts",
"start": 119.02,
"end": 122.9,
"clock": "11:02:00",
"text": "地方裁判所呼び家庭会員裁判所で処理する長がある"
},
{
"file": "seg_009.ts",
"start": 122.9,
"end": 126.1,
"clock": "11:02:03",
"text": "というふうな分け方になるのかと思いますけれども"
},
{
"file": "seg_009.ts",
"start": 126.1,
"end": 129.54,
"clock": "11:02:07",
"text": "この約9割が通常の例上処理と同じ体制で"
},
{
"file": "seg_009.ts",
"start": 129.54,
"end": 132.06,
"clock": "11:02:10",
"text": "しているということになっています"
},
{
"file": "seg_009.ts",
"start": 132.06,
"end": 137.06,
"clock": "11:02:13",
"text": "実際に裁判所が手法審査をするときに"
},
{
"file": "seg_009.ts",
"start": 137.06,
"end": 140.5,
"clock": "11:02:18",
"text": "どのぐらいの時間をかけて審査をしているのか"
},
{
"file": "seg_009.ts",
"start": 140.5,
"end": 143.06,
"clock": "11:02:21",
"text": "ということについて確認をさせていただければ"
},
{
"file": "seg_009.ts",
"start": 143.06,
"end": 144.38,
"clock": "11:02:24",
"text": "と思います"
},
{
"file": "seg_009.ts",
"start": 144.38,
"end": 147.9,
"clock": "11:02:25",
"text": "この際に一般の例上処理と同じ対応している"
},
{
"file": "seg_009.ts",
"start": 147.9,
"end": 151.02,
"clock": "11:02:28",
"text": "この9割のところと例えばそうではない"
},
{
"file": "seg_009.ts",
"start": 151.02,
"end": 153.74,
"clock": "11:02:32",
"text": "家庭裁判所等で対応しているところでは"
},
{
"file": "seg_009.ts",
"start": 153.74,
"end": 156.86,
"clock": "11:02:34",
"text": "かける時間が違うのかということであるとか"
},
{
"file": "seg_009.ts",
"start": 156.86,
"end": 159.7,
"clock": "11:02:37",
"text": "その審査のやり方ですね"
},
{
"file": "seg_009.ts",
"start": 159.7,
"end": 162.74,
"clock": "11:02:40",
"text": "そこについての御説明をお願いいたします"
},
{
"file": "seg_009.ts",
"start": 162.74,
"end": 164.9,
"clock": "11:02:43",
"text": "沢村加定局長"
},
{
"file": "seg_009.ts",
"start": 164.9,
"end": 166.34,
"clock": "11:02:45",
"text": "御答え申し上げます"
},
{
"file": "seg_009.ts",
"start": 166.34,
"end": 169.5,
"clock": "11:02:47",
"text": "一時保護会指示の司法審査におきましては"
},
{
"file": "seg_009.ts",
"start": 169.5,
"end": 172.98,
"clock": "11:02:50",
"text": "裁判官は自動相談助長からの声握に"
},
{
"file": "seg_009.ts",
"start": 172.98,
"end": 175.7,
"clock": "11:02:53",
"text": "基づきまして法令上定められた"
},
{
"file": "seg_009.ts",
"start": 175.7,
"end": 178.34,
"clock": "11:02:56",
"text": "一時保護の要件に該当するか否か"
},
{
"file": "seg_009.ts",
"start": 178.34,
"end": 181.3,
"clock": "11:02:59",
"text": "明らかに一時保護の必要がないと認められるか"
},
{
"file": "seg_009.ts",
"start": 181.3,
"end": 184.26,
"clock": "11:03:02",
"text": "否かについて審査するものとされています"
},
{
"file": "seg_009.ts",
"start": 184.26,
"end": 187.62,
"clock": "11:03:05",
"text": "そしてこの審査は対審の手続きではなく"
},
{
"file": "seg_009.ts",
"start": 187.62,
"end": 189.94,
"clock": "11:03:08",
"text": "また人質属性が求められることから"
},
{
"file": "seg_009.ts",
"start": 189.94,
"end": 192.9,
"clock": "11:03:10",
"text": "自動相談助長等から提供される資料に"
},
{
"file": "seg_009.ts",
"start": 192.9,
"end": 195.62,
"clock": "11:03:13",
"text": "基づく署面審査が想定されていると"
},
{
"file": "seg_009.ts",
"start": 195.62,
"end": 197.26,
"clock": "11:03:16",
"text": "承知しております"
},
{
"file": "seg_009.ts",
"start": 197.26,
"end": 200.22,
"clock": "11:03:18",
"text": "一時保護会指示の司法審査に対応する"
},
{
"file": "seg_009.ts",
"start": 200.22,
"end": 201.7,
"clock": "11:03:21",
"text": "時間につきましては"
},
{
"file": "seg_009.ts",
"start": 201.7,
"end": 203.98,
"clock": "11:03:22",
"text": "事案の内容等により異なるものと"
},
{
"file": "seg_009.ts",
"start": 203.98,
"end": 206.86,
"clock": "11:03:24",
"text": "考えられるため一概にお答えすることは"
},
{
"file": "seg_009.ts",
"start": 206.86,
"end": 210.3,
"clock": "11:03:27",
"text": "困難ですが署面審査が想定されていることから"
},
{
"file": "seg_009.ts",
"start": 210.3,
"end": 213.42,
"clock": "11:03:31",
"text": "しますと基本的には通常の刑事の"
},
{
"file": "seg_009.ts",
"start": 213.42,
"end": 216.82,
"clock": "11:03:34",
"text": "従事を処理と同じ体制で処理している場合か"
},
{
"file": "seg_009.ts",
"start": 216.82,
"end": 219.54,
"clock": "11:03:37",
"text": "それ以外の場合であるかを問わず"
},
{
"file": "seg_009.ts",
"start": 219.54,
"end": 223.26,
"clock": "11:03:40",
"text": "多くの場合は請求を受理した当日中には"
},
{
"file": "seg_009.ts",
"start": 223.26,
"end": 226.06,
"clock": "11:03:44",
"text": "判断がされているものと承知しております"
},
{
"file": "seg_009.ts",
"start": 226.06,
"end": 227.78,
"clock": "11:03:47",
"text": "伊藤高い君"
},
{
"file": "seg_009.ts",
"start": 227.78,
"end": 230.02,
"clock": "11:03:48",
"text": "請求を受理した当日中というのは"
},
{
"file": "seg_009.ts",
"start": 230.02,
"end": 231.82,
"clock": "11:03:51",
"text": "そうだと思うんですけれども"
},
{
"file": "seg_009.ts",
"start": 231.82,
"end": 234.82,
"clock": "11:03:52",
"text": "それを朝受理をして夕方までかけて"
},
{
"file": "seg_009.ts",
"start": 234.82,
"end": 238.14,
"clock": "11:03:55",
"text": "一見をずっと処理を見て審査をするということでは"
},
{
"file": "seg_009.ts",
"start": 238.14,
"end": 239.94,
"clock": "11:03:59",
"text": "ないと思います現実には"
},
{
"file": "seg_009.ts",
"start": 239.94,
"end": 242.62,
"clock": "11:04:00",
"text": "何十件も裁判化処理されているでしょうから"
},
{
"file": "seg_009.ts",
"start": 242.62,
"end": 246.98,
"clock": "11:04:03",
"text": "実際に裁判官が署面を見て判断をする"
},
{
"file": "seg_009.ts",
"start": 246.98,
"end": 248.82,
"clock": "11:04:07",
"text": "というところまでの時間どのぐらいか"
},
{
"file": "seg_009.ts",
"start": 248.82,
"end": 250.26,
"clock": "11:04:09",
"text": "という点についてはいかがですか"
},
{
"file": "seg_009.ts",
"start": 250.26,
"end": 252.58,
"clock": "11:04:11",
"text": "佐藤村勝負局長"
},
{
"file": "seg_009.ts",
"start": 252.58,
"end": 254.34,
"clock": "11:04:13",
"text": "それぞれの個別の事案における"
},
{
"file": "seg_009.ts",
"start": 254.34,
"end": 255.34,
"clock": "11:04:15",
"text": "判断になりますので"
},
{
"file": "seg_009.ts",
"start": 255.34,
"end": 256.66,
"clock": "11:04:16",
"text": "司法裁判所としては"
},
{
"file": "seg_009.ts",
"start": 256.66,
"end": 258.78,
"clock": "11:04:17",
"text": "そこまでは把握してございません"
},
{
"file": "seg_009.ts",
"start": 258.78,
"end": 260.7,
"clock": "11:04:19",
"text": "伊藤高い君"
},
{
"file": "seg_009.ts",
"start": 260.7,
"end": 262.38,
"clock": "11:04:21",
"text": "次の質問に聞きます"
},
{
"file": "seg_009.ts",
"start": 262.38,
"end": 264.7,
"clock": "11:04:23",
"text": "裁判所が"
},
{
"file": "seg_009.ts",
"start": 264.7,
"end": 266.9,
"clock": "11:04:25",
"text": "判断の材料にする見るものは"
},
{
"file": "seg_009.ts",
"start": 266.9,
"end": 269.06,
"clock": "11:04:27",
"text": "先ほども御説明いただきましたけれども"
},
{
"file": "seg_009.ts",
"start": 269.06,
"end": 271.38,
"clock": "11:04:30",
"text": "自動相談所の方で作成をして"
},
{
"file": "seg_009.ts",
"start": 271.38,
"end": 275.42,
"clock": "11:04:32",
"text": "提出をされた署面資料ということになっております"
},
{
"file": "seg_009.ts",
"start": 275.42,
"end": 279.46,
"clock": "11:04:36",
"text": "前回も少し指摘をさせていただきましたけれども"
},
{
"file": "seg_009.ts",
"start": 279.46,
"end": 282.58,
"clock": "11:04:40",
"text": "例えば国連子どもの権利委員会からの"
},
{
"file": "seg_009.ts",
"start": 282.58,
"end": 284.66,
"clock": "11:04:43",
"text": "総括所権におきましては"
},
{
"file": "seg_009.ts",
"start": 284.66,
"end": 286.82,
"clock": "11:04:45",
"text": "子ども家族から分離する会中の"
},
{
"file": "seg_009.ts",
"start": 286.82,
"end": 288.3,
"clock": "11:04:47",
"text": "決定に際しては"
},
{
"file": "seg_009.ts",
"start": 288.3,
"end": 290.1,
"clock": "11:04:49",
"text": "子ども及び親の意見を"
},
{
"file": "seg_009.ts",
"start": 290.1,
"end": 292.02,
"clock": "11:04:51",
"text": "徴取した後に行われることを"
},
{
"file": "seg_009.ts",
"start": 292.02,
"end": 293.54,
"clock": "11:04:53",
"text": "確保することというふうに"
},
{
"file": "seg_009.ts",
"start": 293.54,
"end": 295.62,
"clock": "11:04:54",
"text": "指摘をされております"
},
{
"file": "seg_009.ts",
"start": 295.62,
"end": 298.86,
"clock": "11:04:56",
"text": "裁判所が見るその書類ですけれども"
},
{
"file": "seg_009.ts",
"start": 298.86,
"end": 301.02,
"clock": "11:04:59",
"text": "子どもまた親の意見が"
},
{
"file": "seg_009.ts",
"start": 301.02,
"end": 303.42,
"clock": "11:05:02",
"text": "どのように書かれているのか"
},
{
"file": "seg_009.ts",
"start": 303.42,
"end": 304.7,
"clock": "11:05:04",
"text": "示されているのかということを"
},
{
"file": "seg_009.ts",
"start": 304.7,
"end": 307.26,
"clock": "11:05:05",
"text": "確認をさせていただきたいと思います"
},
{
"file": "seg_009.ts",
"start": 307.26,
"end": 308.98,
"clock": "11:05:08",
"text": "例えば自動相談所が"
},
{
"file": "seg_009.ts",
"start": 308.98,
"end": 310.82,
