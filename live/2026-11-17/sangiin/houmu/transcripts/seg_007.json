[
{
"file": "seg_007.ts",
"start": 0.0,
"end": 8.68,
"clock": "10:40:01",
"text": "いうふうにこの運転してきた日本人のガイドの方ですね 多くが口を揃えっていうのでこれどういうことなんだろうとちょっと違和感があったんですけれども"
},
{
"file": "seg_007.ts",
"start": 8.68,
"end": 17.48,
"clock": "10:40:09",
"text": "恐らくですね旅行法上の届出が必要かどうかっていうところを うまく招かれるためにすごく言ってるんじゃないかと思うんですけれども"
},
{
"file": "seg_007.ts",
"start": 17.48,
"end": 31.44,
"clock": "10:40:18",
"text": "ご所有者が自らサイトで乗客を募集してそして自ら運転するといった場合はこれ 旅行業に当たらないという会社ができるんでしょうか"
},
{
"file": "seg_007.ts",
"start": 31.44,
"end": 43.25,
"clock": "10:40:32",
"text": "北斗交通省大臣官房加田審議官 答え申し上げます ご指摘のですねあの車両の所有者が"
},
{
"file": "seg_007.ts",
"start": 43.25,
"end": 50.25,
"clock": "10:40:44",
"text": "自らウェブサイトで乗客を募集し自ら運転する場合には運送サービスの手配に 当たらないためですね"
},
{
"file": "seg_007.ts",
"start": 50.25,
"end": 57.85,
"clock": "10:40:51",
"text": "旅行業の登録は不要となります 加田審議官 ちょっと後ほどまとめてお尋ねしていきたいと思うんですけど"
},
{
"file": "seg_007.ts",
"start": 57.85,
"end": 65.61,
"clock": "10:40:58",
"text": "いろいろとうまく隙間を塗って運営していて 旅行業法上の届出でもいらないような停災にしていたり"
},
{
"file": "seg_007.ts",
"start": 65.61,
"end": 73.49,
"clock": "10:41:06",
"text": "うまく白宅を回避できるような取扱いにしているのではないかというところを ちょっとまずしてきさせていただきたいと思います"
},
{
"file": "seg_007.ts",
"start": 73.49,
"end": 82.73,
"clock": "10:41:14",
"text": "続きましてあの連宝の方の問題なんですけれども 確かにですねあのワナンバーの車もありましたがそうじゃない車を"
},
{
"file": "seg_007.ts",
"start": 82.73,
"end": 92.93,
"clock": "10:41:23",
"text": "あの自ら運転してきているというパターンもあの見かけましたと でも大前提としてあの先ほどご説明いただいたのなの事前にもう1個飛ばしますけれども"
},
{
"file": "seg_007.ts",
"start": 92.93,
"end": 102.13,
"clock": "10:41:33",
"text": "あの連宝事業者が観光者客に対してこの走行ルートで言ってくださいと指定したり 場合によっては先動車がついていたり"
},
{
"file": "seg_007.ts",
"start": 102.13,
"end": 111.77,
"clock": "10:41:43",
"text": "でこの運転の体験をパッケージとしてやっていると いう場合はこれ通常の連宝会議をと異なる規制というのは適用できるんでしょうか"
},
{
"file": "seg_007.ts",
"start": 111.77,
"end": 120.69,
"clock": "10:41:52",
"text": "大通信議官 お答え申し上げます許可を受けた連宝事業者は同論予想上の規制を受けることになりますが"
},
{
"file": "seg_007.ts",
"start": 120.69,
"end": 128.21,
"clock": "10:42:01",
"text": "先生御指摘の場合にあっても同論予想法上その取扱いが変わるものではないと考えております 和田川君"
},
{
"file": "seg_007.ts",
"start": 128.21,
"end": 136.81,
"clock": "10:42:09",
"text": "ちょっとこうただ車をカスを一脱している連宝だと思うんですけれども今はそこに対する規制はないという誤解とだったかと思います"
},
{
"file": "seg_007.ts",
"start": 136.81,
"end": 147.45,
"clock": "10:42:17",
"text": "続きましてちょっと1つ飛ばさせていただきますこの連宝にそもそもですねあの不安基準適用されないであろう改造者が使われているケースが"
},
{
"file": "seg_007.ts",
"start": 147.45,
"end": 161.69,
"clock": "10:42:28",
"text": "あのまま参見されるんですがまあそれについてはあの使用者に対してですね 規制がかかってくれてとか事前のご説明いただいてますのでまあそもそも連宝のワナーバーでやってた場合改造者だったらダメなんじゃないのかなと"
},
{
"file": "seg_007.ts",
"start": 161.69,
"end": 172.05,
"clock": "10:42:42",
"text": "いうところをまず指摘させていただきたいと思いますもう1つ ドリフトの体験ができますよといったような形で危険な運転をできるということをによわせてサイトで"
},
{
"file": "seg_007.ts",
"start": 172.05,
"end": 181.25,
"clock": "10:42:53",
"text": "客を募っていると必要なものもあるんですけれども連宝業者が危険運転を売り物にした宣伝を行ったりとか利用者のスピード違反とか"
},
{
"file": "seg_007.ts",
"start": 181.25,
"end": 189.75,
"clock": "10:43:02",
"text": "ですね違反行為を繰り返し認識しつつ 目認して営業したりしている場合というのは行政処分と可能なんでしょうか"
},
{
"file": "seg_007.ts",
"start": 189.75,
"end": 200.69,
"clock": "10:43:10",
"text": "大勢審判 お答え申し上げます委員ご指摘のような不適切な営業行為を連宝事業者が行っていることが確認された場合については"
},
{
"file": "seg_007.ts",
"start": 200.69,
"end": 208.89,
"clock": "10:43:21",
"text": "関係省庁とも連携しつつ個別具体の事案に応じ適切に対応してまいります お前は久保くん"
},
{
"file": "seg_007.ts",
"start": 210.09,
"end": 219.19,
"clock": "10:43:31",
"text": "時間がないのですがもう1ついきます そもそもですねこの JDMツアーを募集している会社が海外にあったと言った場合にですね"
},
{
"file": "seg_007.ts",
"start": 219.19,
"end": 237.0,
"clock": "10:43:40",
"text": "今ルールご説明いただいたような日本国内の放棄というのは適用できるんでしょうか 朴田清官"
},
{
"file": "seg_007.ts",
"start": 237.0,
"end": 248.0,
"clock": "10:43:58",
"text": "国内申し上げます 日本に拠点のないという前提です日本に拠点のない海外の法人に対しましては一般的に法律の適用範囲が"
},
{
"file": "seg_007.ts",
"start": 248.0,
"end": 258.0,
"clock": "10:44:09",
"text": "その国の主権の及ぶ範囲に限られており実行的な手段を持って適用するのは困難でありまして適用対象外と旅行基本適用対象外となっております"
},
{
"file": "seg_007.ts",
"start": 258.0,
"end": 264.2,
"clock": "10:44:19",
"text": "小谷裁判君 ありがとうございますもう1つ関交庁にも同じ質問を振ってたんですけれども"
},
{
"file": "seg_007.ts",
"start": 264.2,
"end": 271.2,
"clock": "10:44:25",
"text": "このプラットフォーム側にですねなかなか違法な営業に似合わせるような記載があった場合に"
},
{
"file": "seg_007.ts",
"start": 271.2,
"end": 278.2,
"clock": "10:44:32",
"text": "経済停止ですとか予約受付停止を求められるんでしょうかというところ事前にご質問しておりましたが"
},
{
"file": "seg_007.ts",
"start": 278.2,
"end": 284.2,
"clock": "10:44:39",
"text": "これも難しいということだったと思います ここまで旅行合法上の連多官も白田君もですね"
},
{
"file": "seg_007.ts",
"start": 284.2,
"end": 292.2,
"clock": "10:44:45",
"text": "取り締まり一部できるんだけれども海外の授業者だとますます難しいということが明らかになったかなと思うんですが"
},
{
"file": "seg_007.ts",
"start": 292.2,
"end": 300.2,
"clock": "10:44:53",
"text": "あとは言え見た目が改造者であればそれは整備不良ということで一発でいけると思いますのでそこでお尋ねしたいんですけれども"
},
{
"file": "seg_007.ts",
"start": 300.2,
"end": 306.2,
"clock": "10:45:01",
"text": "この海ホタルのパーキングエリア等々においてですねその改造車両があったりですとか"
},
{
"file": "seg_007.ts",
"start": 306.2,
"end": 311.2,
"clock": "10:45:07",
"text": "相応とかからぶかししているとか車道上にハミ出てきて耐留していて危ないですとか"
},
{
"file": "seg_007.ts",
"start": 311.2,
"end": 318.2,
"clock": "10:45:12",
"text": "そういったところについてですね発生状況を把握したり取り締まったりしているという実績はあるんでしょうか"
},
{
"file": "seg_007.ts",
"start": 318.2,
"end": 321.2,
"clock": "10:45:19",
"text": "法株審議官"
},
{
"file": "seg_007.ts",
"start": 321.2,
"end": 323.2,
"clock": "10:45:22",
"text": "お答えいたします"
},
{
"file": "seg_007.ts",
"start": 323.2,
"end": 328.2,
"clock": "10:45:24",
"text": "御指摘のエリア内におきまして多数の利用者が不正改造車両等で集まり"
},
{
"file": "seg_007.ts",
"start": 328.2,
"end": 334.2,
"clock": "10:45:29",
"text": "相応などの免疫学行為を行っていることにつきましては承知をしております"
},
{
"file": "seg_007.ts",
"start": 334.2,
"end": 340.2,
"clock": "10:45:35",
"text": "こうした現状踏まえましてですね千葉県警察におきましては100頭版通報等があった場合には"
},
{
"file": "seg_007.ts",
"start": 340.2,
"end": 346.2,
"clock": "10:45:41",
"text": "現場に臨場するなどして必要な交通指導を取り締まり等を行っているところでございます"
},
{
"file": "seg_007.ts",
"start": 346.2,
"end": 351.2,
"clock": "10:45:47",
"text": "例えば本年7月18日には海ホタルパーキングエリアにおきまして"
},
{
"file": "seg_007.ts",
"start": 351.2,
"end": 357.2,
"clock": "10:45:52",
"text": "関東運輸局千葉運輸所秩局等と合同で特別該当検査を実施をし"
},
{
"file": "seg_007.ts",
"start": 357.2,
"end": 362.2,
"clock": "10:45:58",
"text": "相応防止装置の整備不良等で重発件を検討しているところでございます"
},
{
"file": "seg_007.ts",
"start": 362.2,
"end": 366.58,
"clock": "10:46:03",
"text": "ごめんなさいかくん"
},
{
"file": "seg_007.ts",
"start": 366.58,
"end": 371.58,
"clock": "10:46:07",
"text": "ぜひですねこの改造車を転検してまぁ重発件適発していただけた時に"
},
{
"file": "seg_007.ts",
"start": 371.58,
"end": 374.58,
"clock": "10:46:12",
"text": "同時にこの白宅行為だっているかですとか"
},
{
"file": "seg_007.ts",
"start": 374.58,
"end": 377.58,
"clock": "10:46:15",
"text": "木屋かレンタカーであるかですとか"
},
{
"file": "seg_007.ts",
"start": 377.58,
"end": 382.58,
"clock": "10:46:18",
"text": "もしくはそれを意図なんでるものが外国のものだった場合に財流資格が適合しているかですとか"
},
{
"file": "seg_007.ts",
"start": 382.58,
"end": 389.58,
"clock": "10:46:23",
"text": "ちょっとぜひ関係省庁と連携してですねこういった転検行為を行っていただきたいということを"
},
{
"file": "seg_007.ts",
"start": 389.58,
"end": 392.58,
"clock": "10:46:30",
"text": "ご要望させていただきたいと思います"
},
{
"file": "seg_007.ts",
"start": 392.58,
"end": 395.58,
"clock": "10:46:33",
"text": "今警察臨場してくださっているということで"
},
{
"file": "seg_007.ts",
"start": 395.58,
"end": 399.58,
"clock": "10:46:36",
"text": "その迷惑声を追い出すためにですね海ホタルそのものを閉鎖して"
},
{
"file": "seg_007.ts",
"start": 399.58,
"end": 404.58,
"clock": "10:46:40",
"text": "次の車が入ってこないようにするといったような取り組みをしてくださっていることは"
},
{
"file": "seg_007.ts",
"start": 404.58,
"end": 409.58,
"clock": "10:46:45",
"text": "承知しているんですがこの直近のですね例えば10月11月で"
},
{
"file": "seg_007.ts",
"start": 409.58,
"end": 415.58,
"clock": "10:46:50",
"text": "そういった形で海ホタルのパーキングエリアを閉鎖した検数というのは何形に上るんでしょうか"
},
{
"file": "seg_007.ts",
"start": 415.58,
"end": 419.92,
"clock": "10:46:56",
"text": "国土交通省道路局鈴木事長"
},
{
"file": "seg_007.ts",
"start": 419.92,
"end": 420.92,
"clock": "10:47:00",
"text": "大体申し上げます"
},
{
"file": "seg_007.ts",
"start": 420.92,
"end": 425.92,
"clock": "10:47:01",
"text": "東日本高速道路株式会社は一般の利用者の安全を確保するなどのため"
},
{
"file": "seg_007.ts",
"start": 425.92,
"end": 430.92,
"clock": "10:47:06",
"text": "警察と協議し東京アクアラインの海ホタルパーキングエリアの閉鎖を行っております"
},
{
"file": "seg_007.ts",
"start": 430.92,
"end": 432.92,
"clock": "10:47:11",
"text": "迷惑声による閉鎖回数は"
},
{
"file": "seg_007.ts",
"start": 432.92,
"end": 436.92,
"clock": "10:47:13",
"text": "今年の10月1日から31日までは12回"
},
{
"file": "seg_007.ts",
"start": 436.92,
"end": 440.92,
"clock": "10:47:17",
"text": "11月1日から15日までは5回なっております"
},
{
"file": "seg_007.ts",
"start": 440.92,
"end": 442.92,
"clock": "10:47:21",
"text": "小林裁和君"
},
{
"file": "seg_007.ts",
"start": 442.92,
"end": 446.92,
"clock": "10:47:23",
"text": "10月11月だけで足して17回すでに閉鎖されているということも"
},
{
"file": "seg_007.ts",
"start": 446.92,
"end": 448.92,
"clock": "10:47:27",
"text": "本当に毎週末なんですよね"
},
{
"file": "seg_007.ts",
"start": 448.92,
"end": 450.92,
"clock": "10:47:29",
"text": "やっぱりトイレいけない困りますので"
},
{
"file": "seg_007.ts",
"start": 450.92,
"end": 455.92,
"clock": "10:47:31",
"text": "ぜひですねこのやっぱり閉め出して追い出すということも必要なんですけれども"
},
{
"file": "seg_007.ts",
"start": 455.92,
"end": 460.92,
"clock": "10:47:36",
"text": "やっぱり抜本的な対応が必要だということを申し上げさせていただきたいと思います"
},
{
"file": "seg_007.ts",
"start": 460.92,
"end": 462.92,
"clock": "10:47:41",
"text": "また一問ともします"
},
{
"file": "seg_007.ts",
"start": 462.92,
"end": 466.92,
"clock": "10:47:43",
"text": "外国人観光客からしますとツアーで募集されていて"
},
{
"file": "seg_007.ts",
"start": 466.92,
"end": 470.92,
"clock": "10:47:47",
"text": "それがグレーゾーンかどうかというとは思わないと思うんですね"
},
{
"file": "seg_007.ts",
"start": 470.92,
"end": 476.92,
"clock": "10:47:51",
"text": "なのでツアーに参加するものに対する交通マナーの啓発等が必要だと思います"
},
{
"file": "seg_007.ts",
"start": 476.92,
"end": 477.92,
"clock": "10:47:57",
"text": "まず1点目"
},
{
"file": "seg_007.ts",
"start": 477.92,
"end": 480.92,
"clock": "10:47:58",
"text": "自分で運転するパターンについて"
},
{
"file": "seg_007.ts",
"start": 480.92,
"end": 485.92,
"clock": "10:48:01",
"text": "外面切り替えの原画家が昨年行われましたけれども"
},
{
"file": "seg_007.ts",
"start": 485.92,
"end": 492.92,
"clock": "10:48:06",
"text": "外面切り替え前に免許を取得した外国人の運転者について"
},
{
"file": "seg_007.ts",
"start": 492.92,
"end": 496.92,
"clock": "10:48:13",
"text": "交通事故違反の実態を前後で把握しているかというところと"
},
{
"file": "seg_007.ts",
"start": 496.92,
"end": 501.92,
"clock": "10:48:17",
"text": "切り替え厳しくなる前に取った人に追加でマナー講習ですとか"
},
{
"file": "seg_007.ts",
"start": 501.92,
"end": 505.92,
"clock": "10:48:22",
"text": "知識を得ていただくような機会というのがあるんでしょうか"
},
{
"file": "seg_007.ts",
"start": 509.07,
"end": 513.21,
"clock": "10:48:30",
"text": "ほうかべ審議官"
},
{
"file": "seg_007.ts",
"start": 513.21,
"end": 514.21,
"clock": "10:48:34",
"text": "お答えいたします"
},
{
"file": "seg_007.ts",
"start": 514.21,
"end": 518.21,
"clock": "10:48:35",
"text": "いわゆる外面切り替え手続の原画家前に"
},
{
"file": "seg_007.ts",
"start": 518.21,
"end": 523.21,
"clock": "10:48:39",
"text": "運転免許を取得した外国人運転者の交通事故や違反につきましては"
},
{
"file": "seg_007.ts",
"start": 523.21,
"end": 526.21,
"clock": "10:48:44",
"text": "某ら的には把握をしてございません"
},
{
"file": "seg_007.ts",
"start": 526.21,
"end": 532.21,
"clock": "10:48:47",
"text": "なおですね運転免許の交診時の交収におきましては"
},
{
"file": "seg_007.ts",
"start": 532.21,
"end": 535.21,
"clock": "10:48:53",
"text": "二重言語の交収動画の活用のほか"
},
{
"file": "seg_007.ts",
"start": 535.21,
"end": 537.21,
"clock": "10:48:56",
"text": "各都道府県の実情に応じて"
},
{
"file": "seg_007.ts",
"start": 537.21,
"end": 540.21,
"clock": "10:48:58",
"text": "日本の交通ルールを十分に理解していただくよう"
},
{
"file": "seg_007.ts",
"start": 540.21,
"end": 546.21,
"clock": "10:49:01",
"text": "外国人運転者を対象とした個別の会場での交診時交収を行うなど"
},
{
"file": "seg_007.ts",
"start": 546.21,
"end": 551.21,
"clock": "10:49:07",
"text": "外国人運転者に対しての効果的な交通な全教育を推進しているところでございます"
},
{
"file": "seg_007.ts",
"start": 551.21,
"end": 553.21,
"clock": "10:49:12",
"text": "ほうかべ審議官"
},
{
"file": "seg_007.ts",
"start": 553.21,
"end": 556.21,
"clock": "10:49:14",
"text": "次の質問ちょっと飛ばして自分で説明しますけれども"
},
{
"file": "seg_007.ts",
"start": 556.21,
"end": 558.21,
"clock": "10:49:17",
"text": "国際運転免許称ですとか"
},
{
"file": "seg_007.ts",
"start": 558.21,
"end": 561.21,
"clock": "10:49:19",
"text": "あと一定の外国免許プラス本役分で"
},
{
"file": "seg_007.ts",
"start": 561.21,
"end": 564.21,
"clock": "10:49:22",
"text": "運転できる短期滞在者の方もいらっしゃって"
},
{
"file": "seg_007.ts",
"start": 564.21,
"end": 569.21,
"clock": "10:49:25",
"text": "この方々に対してはなお一層日本の交通ルールを免許取得時に"
},
{
"file": "seg_007.ts",
"start": 569.21,
"end": 571.21,
"clock": "10:49:30",
"text": "勉強するという機会もないですので"
},
{
"file": "seg_007.ts",
"start": 571.21,
"end": 574.21,
"clock": "10:49:32",
"text": "啓発の強化が必要だと思っています"
},
{
"file": "seg_007.ts",
"start": 574.21,
"end": 578.21,
"clock": "10:49:35",
"text": "そこで入国前とか入国する時に"
},
{
"file": "seg_007.ts",
"start": 578.21,
"end": 580.21,
"clock": "10:49:39",
"text": "日本の交通ルールとか"
},
{
"file": "seg_007.ts",
"start": 580.21,
"end": 583.21,
"clock": "10:49:41",
"text": "今回のパーキングエリアでの迷惑行為はダメなんですよと"
},
{
"file": "seg_007.ts",
"start": 583.21,
"end": 588.21,
"clock": "10:49:44",
"text": "周知するような仕組みを強化する必要もあると思うんですけれども"
},
{
"file": "seg_007.ts",
"start": 588.21,
"end": 592.21,
"clock": "10:49:49",
"text": "去年私ホーム委員会でも財流資格の考慮と"
},
{
"file": "seg_007.ts",
"start": 592.21,
"end": 595.21,
"clock": "10:49:53",
"text": "一部こういったマナ講習を受講することも"
},
{
"file": "seg_007.ts",
"start": 595.21,
"end": 599.21,
"clock": "10:49:56",
"text": "要件とすることもあり得るのではないかと提案しましたが"
},
{
"file": "seg_007.ts",
"start": 599.21,
"end": 601.21,
"clock": "10:50:00",
"text": "その後の検討の進捗は"
}
]