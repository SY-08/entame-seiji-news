[
{
"file": "seg_003.ts",
"start": 48.82,
"end": 55.26,
"clock": "10:00:49",
"text": "ただいまから、法務委員会を開会いたします。"
},
{
"file": "seg_003.ts",
"start": 55.26,
"end": 57.86,
"clock": "10:00:56",
"text": "議事に先立ち、一言申し上げます。"
},
{
"file": "seg_003.ts",
"start": 57.86,
"end": 60.86,
"clock": "10:00:58",
"text": "本委員、元議長の重責業に並ばれ、"
},
{
"file": "seg_003.ts",
"start": 60.86,
"end": 62.86,
"clock": "10:01:01",
"text": "本委員会委員であられました、"
},
{
"file": "seg_003.ts",
"start": 62.86,
"end": 64.62,
"clock": "10:01:03",
"text": "山崎正彦君は、"
},
{
"file": "seg_003.ts",
"start": 64.62,
"end": 67.22,
"clock": "10:01:05",
"text": "去る13日、請求されました。"
},
{
"file": "seg_003.ts",
"start": 67.22,
"end": 70.62,
"clock": "10:01:08",
"text": "誠に、相当、通責に絶えません。"
},
{
"file": "seg_003.ts",
"start": 70.62,
"end": 73.02,
"clock": "10:01:11",
"text": "ここに、土進で相当のよう表示、"
},
{
"file": "seg_003.ts",
"start": 73.02,
"end": 75.82,
"clock": "10:01:14",
"text": "皆さんと共に木頭を捧げたいと思います。"
},
{
"file": "seg_003.ts",
"start": 75.82,
"end": 78.22,
"clock": "10:01:16",
"text": "どうぞ、御記立願います。"
},
{
"file": "seg_003.ts",
"start": 79.42,
"end": 80.62,
"clock": "10:01:20",
"text": "木頭。"
},
{
"file": "seg_003.ts",
"start": 80.62,
"end": 105.3,
"clock": "10:01:21",
"text": "木頭あります。"
},
{
"file": "seg_003.ts",
"start": 105.3,
"end": 113.03,
"clock": "10:01:46",
"text": "御座説、願います。"
},
{
"file": "seg_003.ts",
"start": 113.03,
"end": 116.03,
"clock": "10:01:54",
"text": "委員の移動について、御報告いたします。"
},
{
"file": "seg_003.ts",
"start": 116.03,
"end": 119.03,
"clock": "10:01:57",
"text": "昨日までに、山内金子君が委員を自任され、"
},
{
"file": "seg_003.ts",
"start": 119.03,
"end": 122.03,
"clock": "10:02:00",
"text": "その補決として、内越、さくら君が選任されました。"
},
{
"file": "seg_003.ts",
"start": 122.03,
"end": 126.03,
"clock": "10:02:03",
"text": "また、本日、若い圧子君が委員を自任されました。"
},
{
"file": "seg_003.ts",
"start": 126.03,
"end": 129.03,
"clock": "10:02:07",
"text": "なお、山崎君の政挙に伴い、"
},
{
"file": "seg_003.ts",
"start": 129.03,
"end": 132.03,
"clock": "10:02:10",
"text": "一名決委となっております。"
},
{
"file": "seg_003.ts",
"start": 132.03,
"end": 135.03,
"clock": "10:02:13",
"text": "政府参考人の出席要求に関する件について"
},
{
"file": "seg_003.ts",
"start": 135.03,
"end": 137.03,
"clock": "10:02:16",
"text": "お分かりいたします。"
},
{
"file": "seg_003.ts",
"start": 137.03,
"end": 139.03,
"clock": "10:02:18",
"text": "司法行政等に関する調査のため、"
},
{
"file": "seg_003.ts",
"start": 139.03,
"end": 141.03,
"clock": "10:02:20",
"text": "本日の委員会に、自治会協議の通り、"
},
{
"file": "seg_003.ts",
"start": 141.03,
"end": 145.03,
"clock": "10:02:22",
"text": "内閣官房、法人等の自質的支配者情報関係、"
},
{
"file": "seg_003.ts",
"start": 145.03,
"end": 150.03,
"clock": "10:02:26",
"text": "制度準備室事長、江口野武明君、他17名を"
},
{
"file": "seg_003.ts",
"start": 150.03,
"end": 152.03,
"clock": "10:02:31",
"text": "政府参考人として出席を求め、"
},
{
"file": "seg_003.ts",
"start": 152.03,
"end": 155.03,
"clock": "10:02:33",
"text": "その説明を聴取することに御意義ございませんか。"
},
{
"file": "seg_003.ts",
"start": 155.03,
"end": 158.03,
"clock": "10:02:36",
"text": "御意義ないと認め、作用決定いたします。"
},
{
"file": "seg_003.ts",
"start": 158.03,
"end": 161.03,
"clock": "10:02:39",
"text": "法務及び、司法行政等に関する調査を"
},
{
"file": "seg_003.ts",
"start": 161.03,
"end": 163.03,
"clock": "10:02:42",
"text": "議題とし、質疑を行います。"
},
{
"file": "seg_003.ts",
"start": 163.03,
"end": 166.03,
"clock": "10:02:44",
"text": "質疑のある方は、順次、御発言願います。"
},
{
"file": "seg_003.ts",
"start": 166.03,
"end": 168.03,
"clock": "10:02:47",
"text": "内閣市桜君"
},
{
"file": "seg_003.ts",
"start": 168.03,
"end": 172.03,
"clock": "10:02:49",
"text": "一見認識無所属の内閣市桜です。"
},
{
"file": "seg_003.ts",
"start": 172.03,
"end": 176.03,
"clock": "10:02:53",
"text": "日本の難民認定制度は、兼ねてより国内外から"
},
{
"file": "seg_003.ts",
"start": 176.03,
"end": 180.03,
"clock": "10:02:57",
"text": "繰り返し強く批判されてきました。"
},
{
"file": "seg_003.ts",
"start": 180.03,
"end": 183.03,
"clock": "10:03:01",
"text": "国連の人種差別鉄板委員会などから"
},
{
"file": "seg_003.ts",
"start": 183.03,
"end": 186.03,
"clock": "10:03:04",
"text": "難民認定率が非常に低いこと、"
},
{
"file": "seg_003.ts",
"start": 186.03,
"end": 189.03,
"clock": "10:03:07",
"text": "国際基準に沿った難民認定の基盤となる"
},
{
"file": "seg_003.ts",
"start": 189.03,
"end": 192.03,
"clock": "10:03:10",
"text": "包括的な法律がないことなどが"
},
{
"file": "seg_003.ts",
"start": 192.03,
"end": 195.03,
"clock": "10:03:13",
"text": "問題視されてきました。"
},
{
"file": "seg_003.ts",
"start": 195.03,
"end": 198.03,
"clock": "10:03:16",
"text": "続き保障や国際基準に沿った"
},
{
"file": "seg_003.ts",
"start": 198.03,
"end": 201.03,
"clock": "10:03:19",
"text": "難民認定基準の策定といった"
},
{
"file": "seg_003.ts",
"start": 201.03,
"end": 204.03,
"clock": "10:03:22",
"text": "適正手付のもとで難民を認定する"
},
{
"file": "seg_003.ts",
"start": 204.03,
"end": 207.03,
"clock": "10:03:25",
"text": "そうした土台がそもそもありません。"
},
{
"file": "seg_003.ts",
"start": 207.03,
"end": 211.03,
"clock": "10:03:28",
"text": "難民認定に関する専門性もなく"
},
{
"file": "seg_003.ts",
"start": 211.03,
"end": 214.03,
"clock": "10:03:32",
"text": "独立した審査機関もないという"
},
{
"file": "seg_003.ts",
"start": 214.03,
"end": 215.03,
"clock": "10:03:35",
"text": "事態になっております。"
},
{
"file": "seg_003.ts",
"start": 215.03,
"end": 217.03,
"clock": "10:03:36",
"text": "私たち立憲民主党は"
},
{
"file": "seg_003.ts",
"start": 217.03,
"end": 220.03,
"clock": "10:03:38",
"text": "難民保護法案などを提出してまいりました。"
},
{
"file": "seg_003.ts",
"start": 220.03,
"end": 224.03,
"clock": "10:03:41",
"text": "そのような法案を参考にして"
},
{
"file": "seg_003.ts",
"start": 224.03,
"end": 227.03,
"clock": "10:03:45",
"text": "専門的で厚生な第三者機関を設けて"
},
{
"file": "seg_003.ts",
"start": 227.03,
"end": 230.03,
"clock": "10:03:48",
"text": "難民認定の視察を委ねるべきです。"
},
{
"file": "seg_003.ts",
"start": 230.03,
"end": 233.03,
"clock": "10:03:51",
"text": "ところが、入管庁には"
},
{
"file": "seg_003.ts",
"start": 233.03,
"end": 237.03,
"clock": "10:03:54",
"text": "こうした国際スタンダードに近づこうとする努力"
},
{
"file": "seg_003.ts",
"start": 237.03,
"end": 239.03,
"clock": "10:03:58",
"text": "未人も見られません。"
},
{
"file": "seg_003.ts",
"start": 239.03,
"end": 241.03,
"clock": "10:04:00",
"text": "それどころか、昨年5月"
},
{
"file": "seg_003.ts",
"start": 241.03,
"end": 243.03,
"clock": "10:04:02",
"text": "国民の安全・安心のための"
},
{
"file": "seg_003.ts",
"start": 243.03,
"end": 246.03,
"clock": "10:04:04",
"text": "不法滞在者ゼロプランを掲げてから"
},
{
"file": "seg_003.ts",
"start": 246.03,
"end": 248.03,
"clock": "10:04:07",
"text": "難民条約非遵国としての"
},
{
"file": "seg_003.ts",
"start": 248.03,
"end": 250.03,
"clock": "10:04:09",
"text": "セクミンに背を向けるような運用"
},
{
"file": "seg_003.ts",
"start": 250.03,
"end": 253.03,
"clock": "10:04:11",
"text": "サラーに強めています。"
},
{
"file": "seg_003.ts",
"start": 253.03,
"end": 255.03,
"clock": "10:04:14",
"text": "取り分け、入管庁が"
},
{
"file": "seg_003.ts",
"start": 255.03,
"end": 257.03,
"clock": "10:04:16",
"text": "難民条約上の白外に"
},
{
"file": "seg_003.ts",
"start": 257.03,
"end": 259.03,
"clock": "10:04:18",
"text": "明らかに該当しない事情を"
},
{
"file": "seg_003.ts",
"start": 259.03,
"end": 262.03,
"clock": "10:04:20",
"text": "主張している案件をB案件と指定し"
},
{
"file": "seg_003.ts",
"start": 262.03,
"end": 264.03,
"clock": "10:04:23",
"text": "在留資格を認めないとし、"
},
{
"file": "seg_003.ts",
"start": 264.03,
"end": 267.03,
"clock": "10:04:25",
"text": "しかも、以後、八津羽屋に"
},
{
"file": "seg_003.ts",
"start": 267.03,
"end": 269.03,
"clock": "10:04:28",
"text": "合計7回もこの通知を"
},
{
"file": "seg_003.ts",
"start": 269.03,
"end": 271.03,
"clock": "10:04:30",
"text": "改定している。"
},
{
"file": "seg_003.ts",
"start": 271.03,
"end": 273.03,
"clock": "10:04:32",
"text": "その上、B案件に振り分けられる"
},
{
"file": "seg_003.ts",
"start": 273.03,
"end": 276.03,
"clock": "10:04:34",
"text": "基準が明らかにされていません。"
},
{
"file": "seg_003.ts",
"start": 276.03,
"end": 278.03,
"clock": "10:04:37",
"text": "大問題です。"
},
{
"file": "seg_003.ts",
"start": 278.03,
"end": 281.03,
"clock": "10:04:39",
"text": "入管庁は、2015年9月に"
},
{
"file": "seg_003.ts",
"start": 281.03,
"end": 283.03,
"clock": "10:04:42",
"text": "案件振り分けを導入した際、"
},
{
"file": "seg_003.ts",
"start": 283.03,
"end": 285.03,
"clock": "10:04:44",
"text": "その適正性を事故的に"
},
{
"file": "seg_003.ts",
"start": 285.03,
"end": 287.03,
"clock": "10:04:46",
"text": "チェックするため、外部"
},
{
"file": "seg_003.ts",
"start": 287.03,
"end": 289.03,
"clock": "10:04:48",
"text": "専門家による有識者会議、"
},
{
"file": "seg_003.ts",
"start": 289.03,
"end": 291.03,
"clock": "10:04:50",
"text": "いわゆる検証会議を"
},
{
"file": "seg_003.ts",
"start": 291.03,
"end": 293.03,
"clock": "10:04:52",
"text": "設けました。"
},
{
"file": "seg_003.ts",
"start": 293.03,
"end": 296.03,
"clock": "10:04:54",
"text": "今回のB案件の累計化についても"
},
{
"file": "seg_003.ts",
"start": 296.03,
"end": 298.03,
"clock": "10:04:57",
"text": "せめて有識者会議に"
},
{
"file": "seg_003.ts",
"start": 298.03,
"end": 300.03,
"clock": "10:04:59",
"text": "図り、その結果を"
},
{
"file": "seg_003.ts",
"start": 300.03,
"end": 302.03,
"clock": "10:05:01",
"text": "公表すべきではないでしょうか。"
},
{
"file": "seg_003.ts",
"start": 312.6,
"end": 314.6,
"clock": "10:05:13",
"text": "当初、含め、これまで2回"
},
{
"file": "seg_003.ts",
"start": 314.6,
"end": 316.6,
"clock": "10:05:15",
"text": "外部の有識者によって"
},
{
"file": "seg_003.ts",
"start": 316.6,
"end": 318.6,
"clock": "10:05:17",
"text": "難民認定制度のご要覧用的な"
},
{
"file": "seg_003.ts",
"start": 318.6,
"end": 320.6,
"clock": "10:05:19",
"text": "申請に対して対応するための"
},
{
"file": "seg_003.ts",
"start": 320.6,
"end": 322.6,
"clock": "10:05:21",
"text": "運用状況の適正性を検証して"
},
{
"file": "seg_003.ts",
"start": 322.6,
"end": 324.6,
"clock": "10:05:23",
"text": "いただきたいと思います。"
},
{
"file": "seg_003.ts",
"start": 324.6,
"end": 326.6,
"clock": "10:05:25",
"text": "その結果、振り分けの適正性につきましては"
},
{
"file": "seg_003.ts",
"start": 326.6,
"end": 328.6,
"clock": "10:05:27",
"text": "いずれも明らかに不適当と"
},
{
"file": "seg_003.ts",
"start": 328.6,
"end": 330.6,
"clock": "10:05:29",
"text": "断定できる案件は見当たらなかったと"
},
{
"file": "seg_003.ts",
"start": 330.6,
"end": 332.6,
"clock": "10:05:31",
"text": "評価をいただいております。"
},
{
"file": "seg_003.ts",
"start": 332.6,
"end": 334.6,
"clock": "10:05:33",
"text": "その上で、ご尋ねのゼロプランで"
},
{
"file": "seg_003.ts",
"start": 334.6,
"end": 336.6,
"clock": "10:05:35",
"text": "ございますが、報告対策者ゼロプランに"
},
{
"file": "seg_003.ts",
"start": 336.6,
"end": 338.6,
"clock": "10:05:37",
"text": "基づく運用は、あくまで"
},
{
"file": "seg_003.ts",
"start": 338.6,
"end": 340.6,
"clock": "10:05:39",
"text": "基礎の振り分けを前提に"
},
{
"file": "seg_003.ts",
"start": 340.6,
"end": 342.6,
"clock": "10:05:41",
"text": "まして、これまでの基準でも"
},
{
"file": "seg_003.ts",
"start": 342.6,
"end": 344.6,
"clock": "10:05:43",
"text": "B案件として振り分けることが可能"
},
{
"file": "seg_003.ts",
"start": 344.6,
"end": 346.6,
"clock": "10:05:45",
"text": "であったものについて、最新の"
},
{
"file": "seg_003.ts",
"start": 346.6,
"end": 348.6,
"clock": "10:05:47",
"text": "出身国情報を踏まえて、申し立ての内容を"
},
{
"file": "seg_003.ts",
"start": 348.6,
"end": 350.6,
"clock": "10:05:49",
"text": "累計化、つまり具体化、明確化"
},
{
"file": "seg_003.ts",
"start": 350.6,
"end": 352.6,
"clock": "10:05:51",
"text": "するものでございまして、"
},
{
"file": "seg_003.ts",
"start": 352.6,
"end": 354.6,
"clock": "10:05:53",
"text": "基礎の振り分けを変更する"
},
{
"file": "seg_003.ts",
"start": 354.6,
"end": 356.6,
"clock": "10:05:55",
"text": "ものではございません。"
},
{
"file": "seg_003.ts",
"start": 356.6,
"end": 358.6,
"clock": "10:05:57",
"text": "さらに、当庁といましては"
},
{
"file": "seg_003.ts",
"start": 358.6,
"end": 360.6,
"clock": "10:05:59",
"text": "制度と運用の両面から"
},
{
"file": "seg_003.ts",
"start": 360.6,
"end": 362.6,
"clock": "10:06:01",
"text": "難民等の認定手続きの"
},
{
"file": "seg_003.ts",
"start": 362.6,
"end": 364.6,
"clock": "10:06:03",
"text": "適正性を確保しているところで"
},
{
"file": "seg_003.ts",
"start": 364.6,
"end": 366.6,
"clock": "10:06:05",
"text": "ございます。制度面においては"
},
{
"file": "seg_003.ts",
"start": 366.6,
"end": 368.6,
"clock": "10:06:07",
"text": "不認定処分に対するホーム大臣への"
},
{
"file": "seg_003.ts",
"start": 368.6,
"end": 370.6,
"clock": "10:06:09",
"text": "難民差請求では、外部の有識者である"
},
{
"file": "seg_003.ts",
"start": 370.6,
"end": 372.6,
"clock": "10:06:11",
"text": "難民審査予認が、3人1組で"
},
{
"file": "seg_003.ts",
"start": 372.6,
"end": 374.6,
"clock": "10:06:13",
"text": "審議を行い、その意見を必ず聞いた"
},
{
"file": "seg_003.ts",
"start": 374.6,
"end": 376.6,
"clock": "10:06:15",
"text": "上で判断しているところでございます。"
},
{
"file": "seg_003.ts",
"start": 376.6,
"end": 378.6,
"clock": "10:06:17",
"text": "また、難民また保管的"
},
{
"file": "seg_003.ts",
"start": 378.6,
"end": 380.6,
"clock": "10:06:19",
"text": "保護対象者には当たらないとの"
},
{
"file": "seg_003.ts",
"start": 380.6,
"end": 382.6,
"clock": "10:06:21",
"text": "判断に符吹くあれば、裁判所に"
},
{
"file": "seg_003.ts",
"start": 382.6,
"end": 384.6,
"clock": "10:06:23",
"text": "訴えを定期し、司法判断を受けることも"
},
{
"file": "seg_003.ts",
"start": 384.6,
"end": 386.6,
"clock": "10:06:25",
"text": "可能でございます。加えて、"
},
{
"file": "seg_003.ts",
"start": 386.6,
"end": 388.6,
"clock": "10:06:27",
"text": "運用面におきましては、難民調査官の"
},
{
"file": "seg_003.ts",
"start": 388.6,
"end": 390.6,
"clock": "10:06:29",
"text": "能力向上、出身国情報の"
},
{
"file": "seg_003.ts",
"start": 390.6,
"end": 392.6,
"clock": "10:06:31",
"text": "充実との運用の一層の"
},
{
"file": "seg_003.ts",
"start": 392.6,
"end": 394.6,
"clock": "10:06:33",
"text": "適正化に取り組んでいるところでございます。"
},
{
"file": "seg_003.ts",
"start": 394.6,
"end": 396.6,
"clock": "10:06:35",
"text": "こうしたころかことから"
},
{
"file": "seg_003.ts",
"start": 396.6,
"end": 398.6,
"clock": "10:06:37",
"text": "引き続き"
},
{
"file": "seg_003.ts",
"start": 398.6,
"end": 400.6,
"clock": "10:06:39",
"text": "審議、保護を必要とする"
},
{
"file": "seg_003.ts",
"start": 400.6,
"end": 402.6,
"clock": "10:06:41",
"text": "外国人の迅速かつ、確実な"
},
{
"file": "seg_003.ts",
"start": 402.6,
"end": 404.6,
"clock": "10:06:43",
"text": "保護に取り組んでまいりたい"
},
{
"file": "seg_003.ts",
"start": 404.6,
"end": 406.6,
"clock": "10:06:45",
"text": "このように考えております。"
},
{
"file": "seg_003.ts",
"start": 406.6,
"end": 408.6,
"clock": "10:06:47",
"text": "内越桜君"
},
{
"file": "seg_003.ts",
"start": 408.6,
"end": 410.6,
"clock": "10:06:49",
"text": "運用を改善したと認めながら"
},
{
"file": "seg_003.ts",
"start": 410.6,
"end": 412.6,
"clock": "10:06:51",
"text": "つまり、変えたわけですよね。"
},
{
"file": "seg_003.ts",
"start": 412.6,
"end": 414.6,
"clock": "10:06:53",
"text": "それについて、全く"
},
{
"file": "seg_003.ts",
"start": 414.6,
"end": 416.6,
"clock": "10:06:55",
"text": "第三者の名は入れていない"
},
{
"file": "seg_003.ts",
"start": 416.6,
"end": 418.6,
"clock": "10:06:57",
"text": "今、ルル私が聞いたこと以外"
},
{
"file": "seg_003.ts",
"start": 418.6,
"end": 420.6,
"clock": "10:06:59",
"text": "も答えられましたけれども"
},
{
"file": "seg_003.ts",
"start": 420.6,
"end": 422.6,
"clock": "10:07:01",
"text": "3、4人が別に"
},
{
"file": "seg_003.ts",
"start": 422.6,
"end": 424.6,
"clock": "10:07:03",
"text": "独立しているんじゃない?"
},
{
"file": "seg_003.ts",
"start": 424.6,
"end": 426.6,
"clock": "10:07:05",
"text": "その状態は、一般者性がないということも"
},
{
"file": "seg_003.ts",
"start": 426.6,
"end": 428.6,
"clock": "10:07:07",
"text": "ルルこの委員会でも問題に"
},
{
"file": "seg_003.ts",
"start": 428.6,
"end": 430.6,
"clock": "10:07:09",
"text": "されてきたわけです。そしてまた"
},
{
"file": "seg_003.ts",
"start": 430.6,
"end": 432.6,
"clock": "10:07:11",
"text": "一区されていると"
},
{
"file": "seg_003.ts",
"start": 432.6,
"end": 434.6,
"clock": "10:07:13",
"text": "外部の目にさらされていない"
},
{
"file": "seg_003.ts",
"start": 434.6,
"end": 436.6,
"clock": "10:07:15",
"text": "ということ自体が"
},
{
"file": "seg_003.ts",
"start": 436.6,
"end": 438.6,
"clock": "10:07:17",
"text": "適正性を確保しているということは"
},
{
"file": "seg_003.ts",
"start": 438.6,
"end": 440.6,
"clock": "10:07:19",
"text": "とてい言えないと思います。"
},
{
"file": "seg_003.ts",
"start": 440.6,
"end": 442.6,
"clock": "10:07:21",
"text": "一般な市長対応を"
},
{
"file": "seg_003.ts",
"start": 442.6,
"end": 444.6,
"clock": "10:07:23",
"text": "そもそもやめていただきたい"
},
{
"file": "seg_003.ts",
"start": 444.6,
"end": 446.6,
"clock": "10:07:25",
"text": "そういうのであれば"
},
{
"file": "seg_003.ts",
"start": 446.6,
"end": 448.6,
"clock": "10:07:27",
"text": "第三者期間に"
},
{
"file": "seg_003.ts",
"start": 448.6,
"end": 450.6,
"clock": "10:07:29",
"text": "図ると、議論していただく"
},
{
"file": "seg_003.ts",
"start": 450.6,
"end": 452.6,
"clock": "10:07:31",
"text": "その結果も公表するということが"
},
{
"file": "seg_003.ts",
"start": 452.6,
"end": 454.6,
"clock": "10:07:33",
"text": "必要であると申し上げているにも"
},
{
"file": "seg_003.ts",
"start": 454.6,
"end": 456.6,
"clock": "10:07:35",
"text": "かかわらず、そうした答弁は"
},
{
"file": "seg_003.ts",
"start": 456.6,
"end": 458.6,
"clock": "10:07:37",
"text": "誠に以下でございます。"
},
{
"file": "seg_003.ts",
"start": 458.6,
"end": 460.6,
"clock": "10:07:39",
"text": "そして、昨年5月1日"
},
{
"file": "seg_003.ts",
"start": 460.6,
"end": 462.6,
"clock": "10:07:41",
"text": "先ほども申し上げましたけれども"
},
{
"file": "seg_003.ts",
"start": 462.6,
"end": 464.6,
"clock": "10:07:43",
"text": "難民等認定申請において"
},
{
"file": "seg_003.ts",
"start": 464.6,
"end": 466.6,
"clock": "10:07:45",
"text": "B案件に振り分けるのが"
},
{
"file": "seg_003.ts",
"start": 466.6,
"end": 468.6,
"clock": "10:07:47",
"text": "適当な案件の指定についてという"
},
{
"file": "seg_003.ts",
"start": 468.6,
"end": 470.6,
"clock": "10:07:49",
"text": "通知を、質問に"
},
{
"file": "seg_003.ts",
"start": 470.6,
"end": 472.6,
"clock": "10:07:51",
"text": "管理部長が地方入管局や"
},
{
"file": "seg_003.ts",
"start": 472.6,
"end": 474.6,
"clock": "10:07:53",
"text": "市局に出通しました。"
},
{
"file": "seg_003.ts",
"start": 474.6,
"end": 476.6,
"clock": "10:07:55",
"text": "そして、この1年2ヶ月の"
},
{
"file": "seg_003.ts",
"start": 476.6,
"end": 478.6,
"clock": "10:07:57",
"text": "間に、7回も"
},
{
"file": "seg_003.ts",
"start": 478.6,
"end": 480.6,
"clock": "10:07:59",
"text": "小刻みに改定していますね。"
},
{
"file": "seg_003.ts",
"start": 480.6,
"end": 482.6,
"clock": "10:08:01",
"text": "事前に改定を求めましたけれども"
},
{
"file": "seg_003.ts",
"start": 482.6,
"end": 484.6,
"clock": "10:08:03",
"text": "はい、ということで"
},
{
"file": "seg_003.ts",
"start": 484.6,
"end": 486.6,
"clock": "10:08:05",
"text": "素直に改定してきたと思ったら"
},
{
"file": "seg_003.ts",
"start": 486.6,
"end": 488.6,
"clock": "10:08:07",
"text": "通知だけで"
},
{
"file": "seg_003.ts",
"start": 488.6,
"end": 490.6,
"clock": "10:08:09",
"text": "管理の通知につけて"
},
{
"file": "seg_003.ts",
"start": 490.6,
"end": 492.6,
"clock": "10:08:11",
"text": "あるはずの別資、"
},
{
"file": "seg_003.ts",
"start": 492.6,
"end": 494.6,
"clock": "10:08:13",
"text": "重要な別資は改定していただいてないんですよね"
},
{
"file": "seg_003.ts",
"start": 494.6,
"end": 496.6,
"clock": "10:08:15",
"text": "クロヌリなわけですよ。"
},
{
"file": "seg_003.ts",
"start": 496.6,
"end": 498.6,
"clock": "10:08:17",
"text": "そこのクロヌリのところに"
},
{
"file": "seg_003.ts",
"start": 498.6,
"end": 500.6,
"clock": "10:08:19",
"text": "住民塗りのところに"
},
{
"file": "seg_003.ts",
"start": 500.6,
"end": 502.6,
"clock": "10:08:21",
"text": "具体的な基準があるにもかかわらですね"
},
{
"file": "seg_003.ts",
"start": 502.6,
"end": 504.6,
"clock": "10:08:23",
"text": "それは"
},
{
"file": "seg_003.ts",
"start": 504.6,
"end": 506.6,
"clock": "10:08:25",
"text": "明らかにしていただいていないと"
},
{
"file": "seg_003.ts",
"start": 506.6,
"end": 508.6,
"clock": "10:08:27",
"text": "それを全て明らかにしていただきたいと思います。"
},
{
"file": "seg_003.ts",
"start": 508.6,
"end": 510.6,
"clock": "10:08:29",
"text": "いかがでしょうか。"
},
{
"file": "seg_003.ts",
"start": 510.6,
"end": 512.6,
"clock": "10:08:31",
"text": "内藤事長"
},
{
"file": "seg_003.ts",
"start": 512.6,
"end": 514.6,
"clock": "10:08:33",
"text": "お答え申し上げます。"
},
{
"file": "seg_003.ts",
"start": 514.6,
"end": 516.6,
"clock": "10:08:35",
"text": "交信の詳細や拡大会場の"
},
{
"file": "seg_003.ts",
"start": 516.6,
"end": 518.6,
"clock": "10:08:37",
"text": "以下につきましては、これを"
},
{
"file": "seg_003.ts",
"start": 518.6,
"end": 520.6,
"clock": "10:08:39",
"text": "公表することとなれば"
},
{
"file": "seg_003.ts",
"start": 520.6,
"end": 522.6,
"clock": "10:08:41",
"text": "当該累計を踏まえた距離の主張"
},
{
"file": "seg_003.ts",
"start": 522.6,
"end": 524.6,
"clock": "10:08:43",
"text": "等を内容とする"
},
{
"file": "seg_003.ts",
"start": 524.6,
"end": 526.6,
"clock": "10:08:45",
"text": "御容覧用的な申請が"
},
{
"file": "seg_003.ts",
"start": 526.6,
"end": 528.6,
"clock": "10:08:47",
"text": "行われることが想定されるため"
},
{
"file": "seg_003.ts",
"start": 528.6,
"end": 530.6,
"clock": "10:08:49",
"text": "対外的に明らかにすることは"
},
{
"file": "seg_003.ts",
"start": 530.6,
"end": 532.6,
"clock": "10:08:51",
"text": "適当ではないと考えており"
},
{
"file": "seg_003.ts",
"start": 532.6,
"end": 534.6,
"clock": "10:08:53",
"text": "お答えを差し控えたいと考えておりますが"
},
{
"file": "seg_003.ts",
"start": 534.6,
"end": 536.6,
"clock": "10:08:55",
"text": "ゼロプランにおける"
},
{
"file": "seg_003.ts",
"start": 536.6,
"end": 538.6,
"clock": "10:08:57",
"text": "先ほどお答えしたとおり"
},
{
"file": "seg_003.ts",
"start": 538.6,
"end": 540.6,
"clock": "10:08:59",
"text": "最新の出身国情報等を踏まえて"
},
{
"file": "seg_003.ts",
"start": 540.6,
"end": 542.6,
"clock": "10:09:01",
"text": "普段に見直すこととしております。"
},
{
"file": "seg_003.ts",
"start": 542.6,
"end": 544.6,
"clock": "10:09:03",
"text": "したがって"
},
{
"file": "seg_003.ts",
"start": 544.6,
"end": 546.6,
"clock": "10:09:05",
"text": "そのような取り組みの結果として"
},
{
"file": "seg_003.ts",
"start": 546.6,
"end": 548.6,
"clock": "10:09:07",
"text": "通知を"
},
{
"file": "seg_003.ts",
"start": 548.6,
"end": 550.6,
"clock": "10:09:09",
"text": "交信しているものとございます。"
},
{
"file": "seg_003.ts",
"start": 550.6,
"end": 552.6,
"clock": "10:09:11",
"text": "内藤御下倉君"
},
{
"file": "seg_003.ts",
"start": 552.6,
"end": 554.6,
"clock": "10:09:13",
"text": "つまりブラックボックスのままなわけですよ"
},
{
"file": "seg_003.ts",
"start": 554.6,
"end": 556.6,
"clock": "10:09:15",
"text": "判断基準を"
},
{
"file": "seg_003.ts",
"start": 556.6,
"end": 558.6,
"clock": "10:09:17",
"text": "解示しないかたくないね"
},
{
"file": "seg_003.ts",
"start": 558.6,
"end": 560.6,
"clock": "10:09:19",
"text": "第三者の検証もできない状態にしている"
},
{
"file": "seg_003.ts",
"start": 560.6,
"end": 562.6,
"clock": "10:09:21",
"text": "それでも大丈夫ですよ"
},
{
"file": "seg_003.ts",
"start": 562.6,
"end": 564.6,
"clock": "10:09:23",
"text": "適正手続きですよなんていうことは"
},
{
"file": "seg_003.ts",
"start": 564.6,
"end": 566.6,
"clock": "10:09:25",
"text": "言えるんですか"
},
{
"file": "seg_003.ts",
"start": 566.6,
"end": 568.6,
"clock": "10:09:27",
"text": "大臣"
},
{
"file": "seg_003.ts",
"start": 568.6,
"end": 570.6,
"clock": "10:09:29",
"text": "難民認定には迅速さが必要ですけれども"
},
{
"file": "seg_003.ts",
"start": 570.6,
"end": 572.6,
"clock": "10:09:31",
"text": "迅速に不認定にされては困るんですよ"
},
{
"file": "seg_003.ts",
"start": 572.6,
"end": 574.6,
"clock": "10:09:33",
"text": "不透明な行政で"
},
{
"file": "seg_003.ts",
"start": 574.6,
"end": 576.6,
"clock": "10:09:35",
"text": "迅速に不認定の"
},
{
"file": "seg_003.ts",
"start": 576.6,
"end": 578.6,
"clock": "10:09:37",
"text": "検数を稼ぐ"
},
{
"file": "seg_003.ts",
"start": 578.6,
"end": 580.6,
"clock": "10:09:39",
"text": "ゼロプランというものとに"
},
{
"file": "seg_003.ts",
"start": 580.6,
"end": 582.6,
"clock": "10:09:41",
"text": "そうしたことでは"
},
{
"file": "seg_003.ts",
"start": 582.6,
"end": 584.6,
"clock": "10:09:43",
"text": "難民条約非人国としての"
},
{
"file": "seg_003.ts",
"start": 584.6,
"end": 586.6,
"clock": "10:09:45",
"text": "積組み"
},
{
"file": "seg_003.ts",
"start": 586.6,
"end": 588.6,
"clock": "10:09:47",
"text": "これ果たせないのではないでしょうか"
},
{
"file": "seg_003.ts",
"start": 588.6,
"end": 590.6,
"clock": "10:09:49",
"text": "山下法務大臣"
},
{
"file": "seg_003.ts",
"start": 590.6,
"end": 592.6,
"clock": "10:09:51",
"text": "我が国は難民の受入れを"
},
{
"file": "seg_003.ts",
"start": 592.6,
"end": 594.6,
"clock": "10:09:53",
"text": "といて果たすべき重要な責任を"
},
{
"file": "seg_003.ts",
"start": 594.6,
"end": 596.6,
"clock": "10:09:55",
"text": "認識しており"
},
{
"file": "seg_003.ts",
"start": 596.6,
"end": 598.6,
"clock": "10:09:57",
"text": "昭和56年に難民条約について"
}
]