[
{
"file": "seg_006.ts",
"start": 0.0,
"end": 4.6,
"clock": "10:30:01",
"text": "常年のようなDVEが理由とした在留所申請に関する許可件数等については"
},
{
"file": "seg_006.ts",
"start": 4.6,
"end": 7.22,
"clock": "10:30:05",
"text": "東京を取っていないためのお答えは困難でございます。"
},
{
"file": "seg_006.ts",
"start": 7.22,
"end": 10.86,
"clock": "10:30:08",
"text": "最もそのような申請があった場合の在留の拒否については"
},
{
"file": "seg_006.ts",
"start": 10.86,
"end": 13.16,
"clock": "10:30:11",
"text": "基本方針や措置容量に乗っておって"
},
{
"file": "seg_006.ts",
"start": 13.16,
"end": 16.1,
"clock": "10:30:14",
"text": "個別の事案ごとに処判の事情を総合的に勘案して"
},
{
"file": "seg_006.ts",
"start": 16.1,
"end": 18.52,
"clock": "10:30:17",
"text": "適切に判断することとしておりますし"
},
{
"file": "seg_006.ts",
"start": 18.52,
"end": 21.26,
"clock": "10:30:19",
"text": "今後とも判断してまいりたい、このように考えております。"
},
{
"file": "seg_006.ts",
"start": 21.26,
"end": 22.64,
"clock": "10:30:22",
"text": "宇宙市長桜君"
},
{
"file": "seg_006.ts",
"start": 22.64,
"end": 25.6,
"clock": "10:30:23",
"text": "適切になっていないという指摘は"
},
{
"file": "seg_006.ts",
"start": 25.6,
"end": 27.0,
"clock": "10:30:26",
"text": "たくさんあるわけですよね。"
},
{
"file": "seg_006.ts",
"start": 27.0,
"end": 31.6,
"clock": "10:30:28",
"text": "支援団体の人たちからDVEによって逃れて"
},
{
"file": "seg_006.ts",
"start": 31.6,
"end": 32.94,
"clock": "10:30:32",
"text": "募資家庭になって"
},
{
"file": "seg_006.ts",
"start": 32.94,
"end": 35.28,
"clock": "10:30:33",
"text": "不利で定住者等の在留資格で"
},
{
"file": "seg_006.ts",
"start": 35.28,
"end": 38.78,
"clock": "10:30:36",
"text": "長年日本に暮らしてきた外国人女性についても"
},
{
"file": "seg_006.ts",
"start": 38.78,
"end": 40.5,
"clock": "10:30:39",
"text": "生活保護を受けていたり"
},
{
"file": "seg_006.ts",
"start": 40.5,
"end": 42.36,
"clock": "10:30:41",
"text": "収入が低いことを理由にして"
},
{
"file": "seg_006.ts",
"start": 42.36,
"end": 44.08,
"clock": "10:30:43",
"text": "在留機関を短縮されたり"
},
{
"file": "seg_006.ts",
"start": 44.08,
"end": 47.0,
"clock": "10:30:45",
"text": "更新を認められなかったりする事例がたくさん"
},
{
"file": "seg_006.ts",
"start": 47.0,
"end": 48.08,
"clock": "10:30:48",
"text": "最近あると。"
},
{
"file": "seg_006.ts",
"start": 48.08,
"end": 50.9,
"clock": "10:30:49",
"text": "どうも昨年末頃から従来より厳しい"
},
{
"file": "seg_006.ts",
"start": 50.9,
"end": 52.48,
"clock": "10:30:51",
"text": "審査になっているんじゃないかと"
},
{
"file": "seg_006.ts",
"start": 52.48,
"end": 53.88,
"clock": "10:30:53",
"text": "いうふうに言われています。"
},
{
"file": "seg_006.ts",
"start": 53.88,
"end": 56.8,
"clock": "10:30:54",
"text": "内部で指示したり運用を並行したりしているので"
},
{
"file": "seg_006.ts",
"start": 56.8,
"end": 57.56,
"clock": "10:30:57",
"text": "どうしようか。"
},
{
"file": "seg_006.ts",
"start": 57.56,
"end": 59.56,
"clock": "10:30:58",
"text": "こんなことはとんでもないと思うんですけれども"
},
{
"file": "seg_006.ts",
"start": 59.56,
"end": 63.45,
"clock": "10:31:00",
"text": "あのことは弁をお願いします。"
},
{
"file": "seg_006.ts",
"start": 63.45,
"end": 67.21,
"clock": "10:31:04",
"text": "内藤事長"
},
{
"file": "seg_006.ts",
"start": 67.21,
"end": 70.21,
"clock": "10:31:08",
"text": "具体的な審査の詳細は差し控えさせていただきますが"
},
{
"file": "seg_006.ts",
"start": 70.21,
"end": 71.73,
"clock": "10:31:11",
"text": "一般論として申し上げれば"
},
{
"file": "seg_006.ts",
"start": 71.73,
"end": 73.45,
"clock": "10:31:12",
"text": "在留の拠品に関する判断は"
},
{
"file": "seg_006.ts",
"start": 73.45,
"end": 76.45,
"clock": "10:31:14",
"text": "個々の事案ごとに新生人の行おうとする活動"
},
{
"file": "seg_006.ts",
"start": 76.45,
"end": 78.57,
"clock": "10:31:17",
"text": "在留の状況、在留の必要性等を"
},
{
"file": "seg_006.ts",
"start": 78.57,
"end": 80.33,
"clock": "10:31:19",
"text": "総合的に勘案して行っており"
},
{
"file": "seg_006.ts",
"start": 80.33,
"end": 81.53,
"clock": "10:31:21",
"text": "この考え方自体は"
},
{
"file": "seg_006.ts",
"start": 81.53,
"end": 83.29,
"clock": "10:31:22",
"text": "従前から同様でございます。"
},
{
"file": "seg_006.ts",
"start": 83.29,
"end": 85.29,
"clock": "10:31:24",
"text": "なおこの判断に当たりましては"
},
{
"file": "seg_006.ts",
"start": 85.29,
"end": 87.29,
"clock": "10:31:26",
"text": "新生人の生活状況として"
},
{
"file": "seg_006.ts",
"start": 87.29,
"end": 89.89,
"clock": "10:31:28",
"text": "日常生活のおりで公共の負担となっておらず"
},
{
"file": "seg_006.ts",
"start": 89.89,
"end": 92.61,
"clock": "10:31:30",
"text": "かつその有する資産、または理能等から見て"
},
{
"file": "seg_006.ts",
"start": 92.61,
"end": 95.01,
"clock": "10:31:33",
"text": "将来において安定した生活が見込まれることが"
},
{
"file": "seg_006.ts",
"start": 95.01,
"end": 97.29,
"clock": "10:31:36",
"text": "求められておりところでございます。"
},
{
"file": "seg_006.ts",
"start": 97.29,
"end": 100.33,
"clock": "10:31:38",
"text": "他方、仮に公共の負担となっている場合であっても"
},
{
"file": "seg_006.ts",
"start": 100.33,
"end": 102.81,
"clock": "10:31:41",
"text": "在留を認めるべき人道上の理由が"
},
{
"file": "seg_006.ts",
"start": 102.81,
"end": 105.61,
"clock": "10:31:43",
"text": "認まれる場合にはその理由を"
},
{
"file": "seg_006.ts",
"start": 105.61,
"end": 108.81,
"clock": "10:31:46",
"text": "十分に勘案して判断しているところでございます。"
},
{
"file": "seg_006.ts",
"start": 108.81,
"end": 110.65,
"clock": "10:31:49",
"text": "いずれにしましたも"
},
{
"file": "seg_006.ts",
"start": 110.65,
"end": 113.17,
"clock": "10:31:51",
"text": "お尋ねのような在留所申請につきましては"
},
{
"file": "seg_006.ts",
"start": 113.17,
"end": 114.49,
"clock": "10:31:54",
"text": "個々の事案を踏まえ"
},
{
"file": "seg_006.ts",
"start": 114.49,
"end": 116.41,
"clock": "10:31:55",
"text": "引き続き適切に対応してまいりたい"
},
{
"file": "seg_006.ts",
"start": 116.41,
"end": 118.41,
"clock": "10:31:57",
"text": "このように考えております。"
},
{
"file": "seg_006.ts",
"start": 118.41,
"end": 119.93,
"clock": "10:31:59",
"text": "宇宙寺さくらくん"
},
{
"file": "seg_006.ts",
"start": 119.93,
"end": 121.41,
"clock": "10:32:00",
"text": "全然適切になっていないと"
},
{
"file": "seg_006.ts",
"start": 121.41,
"end": 122.89,
"clock": "10:32:02",
"text": "厳しくなってしまっているということは"
},
{
"file": "seg_006.ts",
"start": 122.89,
"end": 124.13,
"clock": "10:32:03",
"text": "言われているわけです。"
},
{
"file": "seg_006.ts",
"start": 124.13,
"end": 126.73,
"clock": "10:32:05",
"text": "難民の方々や子ども、生活根急者など"
},
{
"file": "seg_006.ts",
"start": 126.73,
"end": 129.21,
"clock": "10:32:07",
"text": "生活の基盤を緩和す問題として"
},
{
"file": "seg_006.ts",
"start": 129.21,
"end": 132.25,
"clock": "10:32:10",
"text": "在留手数量の引き上げがございます。"
},
{
"file": "seg_006.ts",
"start": 132.25,
"end": 134.05,
"clock": "10:32:13",
"text": "さっきの国会で私たちの開派は"
},
{
"file": "seg_006.ts",
"start": 134.05,
"end": 136.01,
"clock": "10:32:15",
"text": "こんな入管法改正とんでもないと"
},
{
"file": "seg_006.ts",
"start": 136.01,
"end": 137.61,
"clock": "10:32:17",
"text": "反対したわけですけれども"
},
{
"file": "seg_006.ts",
"start": 137.61,
"end": 139.49,
"clock": "10:32:18",
"text": "それにしても与党も"
},
{
"file": "seg_006.ts",
"start": 139.49,
"end": 142.13,
"clock": "10:32:20",
"text": "賛成していただいた二階決議については"
},
{
"file": "seg_006.ts",
"start": 142.13,
"end": 143.49,
"clock": "10:32:23",
"text": "現面対象者について"
},
{
"file": "seg_006.ts",
"start": 143.49,
"end": 145.93,
"clock": "10:32:24",
"text": "難民条約や子どもの権利条約など"
},
{
"file": "seg_006.ts",
"start": 145.93,
"end": 148.05,
"clock": "10:32:26",
"text": "国際人権条約に考みて"
},
{
"file": "seg_006.ts",
"start": 148.05,
"end": 150.37,
"clock": "10:32:29",
"text": "個別地上に応じて現面するよう"
},
{
"file": "seg_006.ts",
"start": 150.37,
"end": 151.65,
"clock": "10:32:31",
"text": "求めたわけです。"
},
{
"file": "seg_006.ts",
"start": 151.65,
"end": 154.45,
"clock": "10:32:32",
"text": "ところが公表された現面の取扱いでは"
},
{
"file": "seg_006.ts",
"start": 154.45,
"end": 158.61,
"clock": "10:32:35",
"text": "なんと外交交用のぞいて原則としては"
},
{
"file": "seg_006.ts",
"start": 158.61,
"end": 161.37,
"clock": "10:32:39",
"text": "原額の対象がすごく限定的になっている"
},
{
"file": "seg_006.ts",
"start": 161.37,
"end": 163.77,
"clock": "10:32:42",
"text": "これは二階決議を"
},
{
"file": "seg_006.ts",
"start": 163.77,
"end": 166.09,
"clock": "10:32:44",
"text": "全く無視する取扱いなんではないかと"
},
{
"file": "seg_006.ts",
"start": 166.09,
"end": 168.29,
"clock": "10:32:47",
"text": "これ速刻見直すべきではないかと"
},
{
"file": "seg_006.ts",
"start": 168.29,
"end": 169.05,
"clock": "10:32:49",
"text": "いうことを"
},
{
"file": "seg_006.ts",
"start": 169.05,
"end": 171.45,
"clock": "10:32:50",
"text": "答弁求めたかったんですが"
},
{
"file": "seg_006.ts",
"start": 171.45,
"end": 173.09,
"clock": "10:32:52",
"text": "これについては今後も"
},
{
"file": "seg_006.ts",
"start": 173.09,
"end": 174.61,
"clock": "10:32:54",
"text": "質問を重ねていくことを"
},
{
"file": "seg_006.ts",
"start": 174.61,
"end": 175.93,
"clock": "10:32:55",
"text": "申し上げまして質問を"
},
{
"file": "seg_006.ts",
"start": 175.93,
"end": 205.32,
"clock": "10:32:56",
"text": "終わらせていただきます"
},
{
"file": "seg_006.ts",
"start": 205.32,
"end": 206.92,
"clock": "10:33:26",
"text": "小林裁加君"
},
{
"file": "seg_006.ts",
"start": 206.92,
"end": 212.13,
"clock": "10:33:27",
"text": "国民民主党新力不快の小林裁加です"
},
{
"file": "seg_006.ts",
"start": 212.13,
"end": 214.93,
"clock": "10:33:33",
"text": "今日はJDM化といわれます"
},
{
"file": "seg_006.ts",
"start": 214.93,
"end": 216.93,
"clock": "10:33:35",
"text": "日本の改造スポーツカーが"
},
{
"file": "seg_006.ts",
"start": 216.93,
"end": 218.89,
"clock": "10:33:37",
"text": "最近海外から非常に人気で"
},
{
"file": "seg_006.ts",
"start": 218.89,
"end": 220.73,
"clock": "10:33:39",
"text": "観光の対象になっていると"
},
{
"file": "seg_006.ts",
"start": 220.73,
"end": 221.57,
"clock": "10:33:41",
"text": "この件について"
},
{
"file": "seg_006.ts",
"start": 221.57,
"end": 223.85,
"clock": "10:33:42",
"text": "取り上げさせていただきたいと思います"
},
{
"file": "seg_006.ts",
"start": 223.85,
"end": 226.33,
"clock": "10:33:44",
"text": "私あまり車は詳しくないんですけれども"
},
{
"file": "seg_006.ts",
"start": 226.33,
"end": 228.25,
"clock": "10:33:47",
"text": "日本のアニメや映画が"
},
{
"file": "seg_006.ts",
"start": 228.25,
"end": 229.69,
"clock": "10:33:49",
"text": "海外で人気で"
},
{
"file": "seg_006.ts",
"start": 229.69,
"end": 231.41,
"clock": "10:33:50",
"text": "それをきっかけに日本に来て"
},
{
"file": "seg_006.ts",
"start": 231.41,
"end": 233.01,
"clock": "10:33:52",
"text": "ドライブをするという"
},
{
"file": "seg_006.ts",
"start": 233.01,
"end": 235.89,
"clock": "10:33:54",
"text": "体験ツアーが成形だということなんですね"
},
{
"file": "seg_006.ts",
"start": 235.89,
"end": 238.37,
"clock": "10:33:56",
"text": "店舗の記事もつけておりますけれども"
},
{
"file": "seg_006.ts",
"start": 238.37,
"end": 241.89,
"clock": "10:33:59",
"text": "ただ楽しんでいただくというだけならいいんですが"
},
{
"file": "seg_006.ts",
"start": 241.89,
"end": 244.53,
"clock": "10:34:02",
"text": "今東京湾のアクアラインの"
},
{
"file": "seg_006.ts",
"start": 244.53,
"end": 247.01,
"clock": "10:34:05",
"text": "海ホタルパーキングエリアというところが"
},
{
"file": "seg_006.ts",
"start": 247.01,
"end": 247.89,
"clock": "10:34:08",
"text": "ございまして"
},
{
"file": "seg_006.ts",
"start": 247.89,
"end": 249.01,
"clock": "10:34:08",
"text": "そこで夜間"
},
{
"file": "seg_006.ts",
"start": 249.01,
"end": 251.69,
"clock": "10:34:10",
"text": "改造スポーツカー島が集結しまして"
},
{
"file": "seg_006.ts",
"start": 251.69,
"end": 252.97,
"clock": "10:34:12",
"text": "総温ですとか"
},
{
"file": "seg_006.ts",
"start": 252.97,
"end": 254.53,
"clock": "10:34:13",
"text": "車道上でタムロして"
},
{
"file": "seg_006.ts",
"start": 254.53,
"end": 257.25,
"clock": "10:34:15",
"text": "このJDM化といわれる車を撮影したり"
},
{
"file": "seg_006.ts",
"start": 257.25,
"end": 258.57,
"clock": "10:34:18",
"text": "駐車スペースを長時間"
},
{
"file": "seg_006.ts",
"start": 258.57,
"end": 260.21,
"clock": "10:34:19",
"text": "潜入しているということが"
},
{
"file": "seg_006.ts",
"start": 260.21,
"end": 261.65,
"clock": "10:34:21",
"text": "問題になっております"
},
{
"file": "seg_006.ts",
"start": 261.65,
"end": 264.29,
"clock": "10:34:22",
"text": "私もあの先週の週末実際自分で"
},
{
"file": "seg_006.ts",
"start": 264.29,
"end": 266.41,
"clock": "10:34:25",
"text": "夜間見に行ってきたんですけれども"
},
{
"file": "seg_006.ts",
"start": 266.41,
"end": 268.73,
"clock": "10:34:27",
"text": "音がすごく大きくて"
},
{
"file": "seg_006.ts",
"start": 268.73,
"end": 271.29,
"clock": "10:34:29",
"text": "その家族ずれとうですと怖いですし"
},
{
"file": "seg_006.ts",
"start": 271.29,
"end": 272.13,
"clock": "10:34:32",
"text": "またですね"
},
{
"file": "seg_006.ts",
"start": 272.13,
"end": 273.29,
"clock": "10:34:33",
"text": "このパーキングエリア内で"
},
{
"file": "seg_006.ts",
"start": 273.29,
"end": 274.93,
"clock": "10:34:34",
"text": "退留させないために"
},
{
"file": "seg_006.ts",
"start": 274.93,
"end": 275.81,
"clock": "10:34:35",
"text": "貧海に"
},
{
"file": "seg_006.ts",
"start": 275.81,
"end": 277.41,
"clock": "10:34:36",
"text": "貧海閉鎖させて"
},
{
"file": "seg_006.ts",
"start": 277.41,
"end": 278.25,
"clock": "10:34:38",
"text": "追い出すと"
},
{
"file": "seg_006.ts",
"start": 278.25,
"end": 280.37,
"clock": "10:34:39",
"text": "言ったようなこともしてくださっているんですけれども"
},
{
"file": "seg_006.ts",
"start": 280.37,
"end": 282.45,
"clock": "10:34:41",
"text": "そうすると一般の利用の人が"
},
{
"file": "seg_006.ts",
"start": 282.45,
"end": 284.05,
"clock": "10:34:43",
