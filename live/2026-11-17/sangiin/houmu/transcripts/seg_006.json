"file": "seg_006.ts",
"start": 402.4,
"end": 403.48,
"clock": "10:36:43",
"text": "とか行政処分というような"
},
{
"file": "seg_006.ts",
"start": 403.48,
"end": 405.4,
"clock": "10:36:44",
"text": "実績があるんでしょうか"
},
{
"file": "seg_006.ts",
"start": 405.4,
"end": 410.07,
"clock": "10:36:46",
"text": "お答え申し上げます"
},
{
"file": "seg_006.ts",
"start": 410.07,
"end": 411.63,
"clock": "10:36:51",
"text": "国土交通省では"
