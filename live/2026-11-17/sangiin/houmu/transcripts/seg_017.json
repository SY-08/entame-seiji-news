[
{
"file": "seg_017.ts",
"start": 0.0,
"end": 6.16,
"clock": "12:20:01",
"text": "金関係がないことが判明した場合には その子は日本国籍を取得していない"
},
{
"file": "seg_017.ts",
"start": 6.16,
"end": 9.92,
"clock": "12:20:07",
"text": "ということになりますので 個性についても市区町村長が"
},
{
"file": "seg_017.ts",
"start": 9.92,
"end": 14.56,
"clock": "12:20:10",
"text": "植権で必要な訂正を行うこととなります 委員の問題意識も踏まえつつ"
},
{
"file": "seg_017.ts",
"start": 14.56,
"end": 17.84,
"clock": "12:20:15",
"text": "現行制度を適切に分用してまいりたいと 考えております"
},
{
"file": "seg_017.ts",
"start": 17.84,
"end": 19.28,
"clock": "12:20:18",
"text": "北村原子君"
},
{
"file": "seg_017.ts",
"start": 19.28,
"end": 25.6,
"clock": "12:20:20",
"text": "今おっしゃったこれをほぼ否定する 理由の中で市町村の窓口でその"
},
{
"file": "seg_017.ts",
"start": 25.6,
"end": 29.04,
"clock": "12:20:26",
"text": "理由の関点が適切になされたものか どうか判断することができない"
},
{
"file": "seg_017.ts",
"start": 29.04,
"end": 33.04,
"clock": "12:20:30",
"text": "これは理由になりません そもそもそういう処理を"
},
{
"file": "seg_017.ts",
"start": 33.04,
"end": 36.64,
"clock": "12:20:34",
"text": "提示させることでハードルを 一つ高くなるわけですから"
},
{
"file": "seg_017.ts",
"start": 36.64,
"end": 41.28,
"clock": "12:20:37",
"text": "加えてそれが偽造された理由の 関点処理であるなどということが"
},
{
"file": "seg_017.ts",
"start": 41.28,
"end": 44.4,
"clock": "12:20:42",
"text": "分かればそれまた処罰の対象等 になるわけで"
},
{
"file": "seg_017.ts",
"start": 44.4,
"end": 48.48,
"clock": "12:20:45",
"text": "今おっしゃった一つは理由にならない と考えております"
},
{
"file": "seg_017.ts",
"start": 48.48,
"end": 52.08,
"clock": "12:20:49",
"text": "法務省としては特段偽送認知の 問題に危機感を持っていないように"
},
{
"file": "seg_017.ts",
"start": 52.08,
"end": 58.64,
"clock": "12:20:53",
"text": "見受けられますが制度の悪用があった ことは事実です"
},
{
"file": "seg_017.ts",
"start": 58.64,
"end": 64.72,
"clock": "12:20:59",
"text": "これ大臣も検察官御出身ですから 当然分かりだと思いますけれども"
},
{
"file": "seg_017.ts",
"start": 64.72,
"end": 69.52,
"clock": "12:21:05",
"text": "犯罪行為には必ず大きな案数が あります"
},
{
"file": "seg_017.ts",
"start": 69.52,
"end": 73.92,
"clock": "12:21:10",
"text": "発覚したものの背後に実際には その十倍"
},
{
"file": "seg_017.ts",
"start": 73.92,
"end": 78.04,
"clock": "12:21:14",
"text": "ごめんなさいその数十倍あるいは 数百倍の案数があることこれは"
},
{
"file": "seg_017.ts",
"start": 78.04,
"end": 81.76,
"clock": "12:21:19",
"text": "常識であります 例えば殺人事件につきましても"
},
{
"file": "seg_017.ts",
"start": 81.76,
"end": 90.68,
"clock": "12:21:22",
"text": "私は長年弁護士として例えば保健 金目的の殺人事件など民事事件でも"
},
{
"file": "seg_017.ts",
"start": 90.68,
"end": 95.04,
"clock": "12:21:31",
"text": "家族を使いましたがいずれも 刑事としては立刑されていません"
},
{
"file": "seg_017.ts",
"start": 95.04,
"end": 100.36,
"clock": "12:21:36",
"text": "これは刑事と民主の立証のハードル が全然違うことが理由なんですけれども"
},
{
"file": "seg_017.ts",
"start": 100.36,
"end": 104.76,
"clock": "12:21:41",
"text": "それにしても我々が認知できない そもそも認知できなかった"
},
{
"file": "seg_017.ts",
"start": 104.76,
"end": 109.2,
"clock": "12:21:45",
"text": "民事事件としても認知できなかった 殺人事件が多数あるものというふうに"
},
{
"file": "seg_017.ts",
"start": 109.2,
"end": 115.04,
"clock": "12:21:50",
"text": "我々は推測しております ですからこの議層認知の問題が一件"
},
{
"file": "seg_017.ts",
"start": 115.04,
"end": 119.32,
"clock": "12:21:56",
"text": "しかまだ発覚していない私の知る 代わり一件なわけですけど日本では"
},
{
"file": "seg_017.ts",
"start": 119.32,
"end": 124.32,
"clock": "12:22:00",
"text": "だから問題がないということには 絶対ならないというふうに考えております"
},
{
"file": "seg_017.ts",
"start": 124.32,
"end": 129.64,
"clock": "12:22:05",
"text": "そこで議層認知の件数を調査 することは困難ではありますけれども"
},
{
"file": "seg_017.ts",
"start": 129.64,
"end": 136.96,
"clock": "12:22:10",
"text": "せめて外国人女性が生んだお子さんを 日本人男性が認知した件数"
},
{
"file": "seg_017.ts",
"start": 136.96,
"end": 139.92,
"clock": "12:22:17",
"text": "これについては調査した方が 四年ではないかと考えますが"
},
{
"file": "seg_017.ts",
"start": 139.92,
"end": 144.19,
"clock": "12:22:20",
"text": "いかがでしょうか 安定民主局長"
},
{
"file": "seg_017.ts",
"start": 144.19,
"end": 148.67,
"clock": "12:22:25",
"text": "お答え申し上げます 御指摘のように外国人女性が生んだ"
},
{
"file": "seg_017.ts",
"start": 148.67,
"end": 154.79,
"clock": "12:22:29",
"text": "子を日本人男性が認知し日本国籍 を取得するためには国籍法第3条"
},
{
"file": "seg_017.ts",
"start": 154.79,
"end": 160.35,
"clock": "12:22:35",
"text": "第1個の国籍取得届が必要となります がこの国籍取得届の受付件数"
},
{
"file": "seg_017.ts",
"start": 160.35,
"end": 165.67,
"clock": "12:22:41",
"text": "については令和7年は498件と なっております"
},
{
"file": "seg_017.ts",
"start": 165.67,
"end": 170.71,
"clock": "12:22:46",
"text": "委員御指摘のとおり議層認知により 不正に日本国籍を取得させることは"
},
{
"file": "seg_017.ts",
"start": 170.71,
"end": 173.35,
"clock": "12:22:51",
"text": "あってはならないものと認識を しております"
},
{
"file": "seg_017.ts",
"start": 173.35,
"end": 176.39,
"clock": "12:22:54",
"text": "委員の問題式も踏まえつつ 原稿制度を適切に運用してまいり"
},
{
"file": "seg_017.ts",
"start": 176.39,
"end": 179.75,
"clock": "12:22:57",
"text": "たいと考えています 北村原子君"
},
{
"file": "seg_017.ts",
"start": 179.75,
"end": 184.19,
"clock": "12:23:00",
"text": "ありがとうございます 最後に入管行政についてお聞き"
},
{
"file": "seg_017.ts",
"start": 184.19,
"end": 190.19,
"clock": "12:23:05",
"text": "します これまで本委員会でも 再参御指摘してきたところですが"
},
{
"file": "seg_017.ts",
"start": 190.19,
"end": 194.55,
"clock": "12:23:11",
"text": "この臨時国会から法務大臣 変わられたので改めて山下大臣"
},
{
"file": "seg_017.ts",
"start": 194.55,
"end": 199.19,
"clock": "12:23:15",
"text": "にお聞きします 犯罪行為を行ったが処分保留"
},
{
"file": "seg_017.ts",
"start": 199.19,
"end": 204.51,
"clock": "12:23:20",
"text": "で釈放された外国人 福祉屋馬金券になった外国人"
},
{
"file": "seg_017.ts",
"start": 204.51,
"end": 208.95,
"clock": "12:23:25",
"text": "について この方々については対協共生"
},
{
"file": "seg_017.ts",
"start": 208.95,
"end": 214.39,
"clock": "12:23:29",
"text": "できないわけですが原稿法は 個別の事情を判案し当該外国人"
},
{
"file": "seg_017.ts",
"start": 214.39,
"end": 217.87,
"clock": "12:23:35",
"text": "が在留し続けると日本社会の 治安を悪化させる"
},
{
"file": "seg_017.ts",
"start": 217.87,
"end": 224.71,
"clock": "12:23:38",
"text": "すなわち国民の生命身体財産を 外する外善性が高い場合"
},
{
"file": "seg_017.ts",
"start": 224.71,
"end": 229.55,
"clock": "12:23:45",
"text": "そういった場合には対協共生入供拒 入国拒否などができるように"
},
{
"file": "seg_017.ts",
"start": 229.55,
"end": 234.07,
"clock": "12:23:50",
"text": "入管法を改正すべきと考えます 具体的には例えば捜査機関が"
},
{
"file": "seg_017.ts",
"start": 234.07,
"end": 238.63,
"clock": "12:23:55",
"text": "保有する外国人品社に関する 捜査記録これを入管当局に"
},
{
"file": "seg_017.ts",
"start": 238.63,
"end": 241.97,
"clock": "12:23:59",
"text": "共有した上で 上級リスクがそういった"
},
{
"file": "seg_017.ts",
"start": 241.97,
"end": 245.31,
"clock": "12:24:02",
"text": "リスクが高いか 田舎を判断して適切な"
},
{
"file": "seg_017.ts",
"start": 245.31,
"end": 248.63,
"clock": "12:24:06",
"text": "職務を行えるようにするということで ございます"
},
{
"file": "seg_017.ts",
"start": 248.63,
"end": 252.11,
"clock": "12:24:09",
"text": "疑わしきや罰せずというのは 刑事訴訟法手続に送る原則で"
},
{
"file": "seg_017.ts",
"start": 252.11,
"end": 256.99,
"clock": "12:24:13",
"text": "あり入管行政においては疑わしき は入国させない疑わしきは退去"
},
{
"file": "seg_017.ts",
"start": 256.99,
"end": 261.59,
"clock": "12:24:17",
"text": "させるということが政策判断と して必要だと考えますがこれら"
},
{
"file": "seg_017.ts",
"start": 261.59,
"end": 265.35,
"clock": "12:24:22",
"text": "にとについての大臣のできれば 個人的な処刑も含めて"
},
{
"file": "seg_017.ts",
"start": 265.35,
"end": 270.19,
"clock": "12:24:26",
"text": "見解をお聞かせください 山下大臣 健康法におきましても"
},
{
"file": "seg_017.ts",
"start": 270.19,
"end": 273.35,
"clock": "12:24:31",
"text": "退去共生自由や上立共非自由 に該当したい外国人について"
},
{
"file": "seg_017.ts",
"start": 273.35,
"end": 278.43,
"clock": "12:24:34",
"text": "も適切に在留資格に該当する活動 を行うことができるかなとさま"
},
{
"file": "seg_017.ts",
"start": 278.43,
"end": 282.95,
"clock": "12:24:39",
"text": "さまな個別の事事を考慮して 上立地にさや在留審査等を行って"
},
{
"file": "seg_017.ts",
"start": 282.95,
"end": 287.95,
"clock": "12:24:43",
"text": "その拒否を判断しているところ でありますが本年1月政府において"
},
{
"file": "seg_017.ts",
"start": 287.95,
"end": 291.55,
"clock": "12:24:48",
"text": "取りまとめた外国人の受入れ H2R共生のための"
},
{
"file": "seg_017.ts",
"start": 291.55,
"end": 295.51,
"clock": "12:24:52",
"text": "総合的対応策において 退去共生自由の拡大について"
},
{
"file": "seg_017.ts",
"start": 295.51,
"end": 298.51,
"clock": "12:24:56",
"text": "海外事例を参考にしながら 検討するとの施策が"
},
{
"file": "seg_017.ts",
"start": 298.51,
"end": 302.15,
"clock": "12:24:59",
"text": "掲げられていることから現在 集中国在留管理庁において"
},
{
"file": "seg_017.ts",
"start": 302.15,
"end": 306.31,
"clock": "12:25:03",
"text": "退去共生自由の拡大について 検討を進めているところでございます"
},
{
"file": "seg_017.ts",
"start": 306.31,
"end": 310.83,
"clock": "12:25:07",
"text": "退去共生や上立共非は重大な結果 を伴うものでありますので"
},
{
"file": "seg_017.ts",
"start": 310.83,
"end": 315.51,
"clock": "12:25:11",
"text": "これらの自由は明確かつ適切に 適定する必要があり拡大するかどうか"
},
{
"file": "seg_017.ts",
"start": 315.51,
"end": 318.79,
"clock": "12:25:16",
"text": "拡大するとしてどのような自由 とするかについては"
},
{
"file": "seg_017.ts",
"start": 318.79,
"end": 323.27,
"clock": "12:25:19",
"text": "退去共生や上立共非の施策 拡大することによる影響"
},
{
"file": "seg_017.ts",
"start": 323.27,
"end": 326.71,
"clock": "12:25:24",
"text": "他の自由とのバランス 形式手続きとの関係など"
},
{
"file": "seg_017.ts",
"start": 326.71,
"end": 331.31,
"clock": "12:25:27",
"text": "さまざまな観点も含めた 検討が必要と考えているところでございます"
},
{
"file": "seg_017.ts",
"start": 331.31,
"end": 335.99,
"clock": "12:25:32",
"text": "田村晴君 体系共生などが重大な結果を伴う"
},
{
"file": "seg_017.ts",
"start": 335.99,
"end": 340.27,
"clock": "12:25:36",
"text": "それはそのとおりです 他方で例えば 制犯罪おかし"
},
{
"file": "seg_017.ts",
"start": 340.27,
"end": 343.31,
"clock": "12:25:41",
"text": "時段が成立したことにより引き そうになった外国人"
},
{
"file": "seg_017.ts",
"start": 343.31,
"end": 347.63,
"clock": "12:25:44",
"text": "その方を脳に放つということ つまり日本国から退去させない"
},
{
"file": "seg_017.ts",
"start": 347.63,
"end": 351.67,
"clock": "12:25:48",
"text": "ということは日本の社会に 重大な結果を伴う"
},
{
"file": "seg_017.ts",
"start": 351.67,
"end": 357.27,
"clock": "12:25:52",
"text": "日本の女性あるいは全量な外国人 女性にとっても重大な危険を"
},
{
"file": "seg_017.ts",
"start": 357.27,
"end": 359.75,
"clock": "12:25:58",
"text": "伴うということを十分ご理解いただき たいと思います"
},
{
"file": "seg_017.ts",
"start": 359.75,
"end": 367.05,
"clock": "12:26:00",
"text": "時間ですので終わります 本日の調査はこの程度に"
},
{
"file": "seg_017.ts",
"start": 367.05,
"end": 371.81,
"clock": "12:26:08",
"text": "とどめます 諸法及び国際会場物品運送法"
},
{
"file": "seg_017.ts",
"start": 371.81,
"end": 376.17,
"clock": "12:26:12",
"text": "の一部を改正する法律案を 議題といたします"
},
{
"file": "seg_017.ts",
"start": 376.17,
"end": 380.97,
"clock": "12:26:17",
"text": "政府から出資説明を聴取いたします 山下法務大臣"
},
{
"file": "seg_017.ts",
"start": 380.97,
"end": 386.97,
"clock": "12:26:21",
"text": "諸法及び国際会場物品運送法 の一部を改正する法律案について"
},
{
"file": "seg_017.ts",
"start": 386.97,
"end": 390.21,
"clock": "12:26:27",
"text": "その趣旨を御説明いたします この法律案は"
},
{
"file": "seg_017.ts",
"start": 390.21,
"end": 395.77,
"clock": "12:26:31",
"text": "近年の情報通信技術の新店に伴う 電子消取引の拡大に対応する観点"
},
{
"file": "seg_017.ts",
"start": 395.77,
"end": 398.73,
"clock": "12:26:36",
"text": "から 船仁消件クラニ消件及び"
},
{
"file": "seg_017.ts",
"start": 398.73,
"end": 404.33,
"clock": "12:26:39",
"text": "複合運送消件に変わる電磁鉄記録 である電子船仁消件記録電子"
},
{
"file": "seg_017.ts",
"start": 404.33,
"end": 410.21,
"clock": "12:26:45",
"text": "クラニ消件記録及び電子複合運送 消件記録に関する制度の創設等"
},
{
"file": "seg_017.ts",
"start": 410.21,
"end": 415.05,
"clock": "12:26:51",
"text": "の措置を講ずるため諸法及び 国際会場物品運送法の一部を"
},
{
"file": "seg_017.ts",
"start": 415.05,
"end": 419.41,
"clock": "12:26:56",
"text": "改正しようとするものであります その要点は次の通りであります"
},
{
"file": "seg_017.ts",
"start": 419.41,
"end": 423.93,
"clock": "12:27:00",
"text": "第一に 諸法の一部を改正し電子船仁消件記録の"
},
{
"file": "seg_017.ts",
"start": 423.93,
"end": 429.53,
"clock": "12:27:04",
"text": "意義を定めるとともにその作成及び 管理のために用いられる情報処理システムの"
},
{
"file": "seg_017.ts",
"start": 429.53,
"end": 434.65,
"clock": "12:27:10",
"text": "要件を定めた上で船仁消件の 書事に変わる電子船仁消件記録の"
},
{
"file": "seg_017.ts",
"start": 434.65,
"end": 441.21,
"clock": "12:27:15",
"text": "支配の意義や船仁消件の交付に 変わる電子船仁消件記録の提供の"
},
{
"file": "seg_017.ts",
"start": 441.21,
"end": 445.69,
"clock": "12:27:22",
"text": "意義を定めることとしております また運送認討が船仁消件の"
},
{
"file": "seg_017.ts",
"start": 445.69,
"end": 451.97,
"clock": "12:27:26",
"text": "交付に変えて二億人認討の省略を得て 電子船仁消件記録の提供をすることが"
},
{
"file": "seg_017.ts",
"start": 451.97,
"end": 457.69,
