[
{
"file": "seg_008.ts",
"start": 0.0,
"end": 2.0,
"clock": "10:50:01",
"text": "あといかがでしょうか"
},
{
"file": "seg_008.ts",
"start": 2.0,
"end": 4.0,
"clock": "10:50:03",
"text": "質疑局在留官に一応内藤事長"
},
{
"file": "seg_008.ts",
"start": 4.0,
"end": 6.0,
"clock": "10:50:05",
"text": "お答え申し上げます"
},
{
"file": "seg_008.ts",
"start": 6.0,
"end": 8.0,
"clock": "10:50:07",
"text": "いいのだぜ"
},
{
"file": "seg_008.ts",
"start": 8.0,
"end": 10.0,
"clock": "10:50:09",
"text": "今我々の方で検討しております"
},
{
"file": "seg_008.ts",
"start": 10.0,
"end": 12.0,
"clock": "10:50:11",
"text": "日本語生活学習プログラムは"
},
{
"file": "seg_008.ts",
"start": 12.0,
"end": 14.0,
"clock": "10:50:13",
"text": "課章でございますが"
},
{
"file": "seg_008.ts",
"start": 14.0,
"end": 16.0,
"clock": "10:50:15",
"text": "というものに関連すると思うんですけれども"
},
{
"file": "seg_008.ts",
"start": 16.0,
"end": 18.0,
"clock": "10:50:17",
"text": "その方は生物間中心としては"
},
{
"file": "seg_008.ts",
"start": 18.0,
"end": 20.0,
"clock": "10:50:19",
"text": "法局書作りまして"
},
{
"file": "seg_008.ts",
"start": 20.0,
"end": 22.0,
"clock": "10:50:21",
"text": "それが今内閣官房の方で"
},
{
"file": "seg_008.ts",
"start": 22.0,
"end": 24.0,
"clock": "10:50:23",
"text": "検討の部隊が移りまして"
},
{
"file": "seg_008.ts",
"start": 24.0,
"end": 26.0,
"clock": "10:50:25",
"text": "有識者で会議が行われている"
},
{
"file": "seg_008.ts",
"start": 26.0,
"end": 28.0,
"clock": "10:50:27",
"text": "というところでございます"
},
{
"file": "seg_008.ts",
"start": 28.0,
"end": 30.0,
"clock": "10:50:29",
"text": "また質疑局の際の取り組みということについて"
},
{
"file": "seg_008.ts",
"start": 30.0,
"end": 32.0,
"clock": "10:50:31",
"text": "関連して申し上げますと"
},
{
"file": "seg_008.ts",
"start": 32.0,
"end": 34.0,
"clock": "10:50:33",
"text": "日本の交通ルールやメアクコインの"
},
{
"file": "seg_008.ts",
"start": 34.0,
"end": 36.0,
"clock": "10:50:35",
"text": "禁止に関する候補について"
},
{
"file": "seg_008.ts",
"start": 36.0,
"end": 38.0,
"clock": "10:50:37",
"text": "関係省庁から要望があれば"
},
{
"file": "seg_008.ts",
"start": 38.0,
"end": 40.0,
"clock": "10:50:39",
"text": "条例審査上においてどのような対応が"
},
{
"file": "seg_008.ts",
"start": 40.0,
"end": 42.0,
"clock": "10:50:41",
"text": "可能か検討してまいりたいと"
},
{
"file": "seg_008.ts",
"start": 42.0,
"end": 44.0,
"clock": "10:50:43",
"text": "このように考えております"
},
{
"file": "seg_008.ts",
"start": 44.0,
"end": 46.0,
"clock": "10:50:45",
"text": "小川大川君"
},
{
"file": "seg_008.ts",
"start": 46.0,
"end": 48.0,
"clock": "10:50:47",
"text": "プログラムの充実は今検討いただいていると"
},
{
"file": "seg_008.ts",
"start": 48.0,
"end": 50.0,
"clock": "10:50:49",
"text": "当時に入国の時に"
},
{
"file": "seg_008.ts",
"start": 50.0,
"end": 52.0,
"clock": "10:50:51",
"text": "プラスで啓発するというところは"
},
{
"file": "seg_008.ts",
"start": 52.0,
"end": 54.0,
"clock": "10:50:53",
"text": "関係省庁の要望があれば"
},
{
"file": "seg_008.ts",
"start": 54.0,
"end": 56.0,
"clock": "10:50:55",
"text": "お答えをいただけるということでしたので"
},
{
"file": "seg_008.ts",
"start": 56.0,
"end": 58.0,
"clock": "10:50:57",
"text": "またも連携していただいて"
},
{
"file": "seg_008.ts",
"start": 58.0,
"end": 60.0,
"clock": "10:50:59",
"text": "交通マナ"
},
{
"file": "seg_008.ts",
"start": 60.0,
"end": 62.0,
"clock": "10:51:01",
"text": "パーキングエリアのマナ"
},
{
"file": "seg_008.ts",
"start": 62.0,
"end": 64.0,
"clock": "10:51:03",
"text": "こういったところの周知も"
},
{
"file": "seg_008.ts",
"start": 64.0,
"end": 66.0,
"clock": "10:51:05",
"text": "ご検討いただきたいと思います"
},
{
"file": "seg_008.ts",
"start": 66.0,
"end": 68.0,
"clock": "10:51:07",
"text": "続きまして"
},
{
"file": "seg_008.ts",
"start": 68.0,
"end": 70.0,
"clock": "10:51:09",
"text": "これも一問すいません"
},
{
"file": "seg_008.ts",
"start": 70.0,
"end": 72.0,
"clock": "10:51:11",
"text": "飛ばさせていただきますけれども"
},
{
"file": "seg_008.ts",
"start": 72.0,
"end": 74.0,
"clock": "10:51:13",
"text": "合わせてやっぱりツアーの予約時に"
},
{
"file": "seg_008.ts",
"start": 74.0,
"end": 76.0,
"clock": "10:51:15",
"text": "こういった交通マナの"
},
{
"file": "seg_008.ts",
"start": 76.0,
"end": 78.0,
"clock": "10:51:17",
"text": "動画を受講いただくことを"
},
{
"file": "seg_008.ts",
"start": 78.0,
"end": 80.0,
"clock": "10:51:19",
"text": "要検とするとか"
},
{
"file": "seg_008.ts",
"start": 80.0,
"end": 82.0,
"clock": "10:51:21",
"text": "なかなか難しいと思いますけれども"
},
{
"file": "seg_008.ts",
"start": 82.0,
"end": 84.0,
"clock": "10:51:23",
"text": "義務付きは無理にしても"
},
{
"file": "seg_008.ts",
"start": 84.0,
"end": 86.0,
"clock": "10:51:25",
"text": "ユルデスとかレンタカー借りるときに"
},
{
"file": "seg_008.ts",
"start": 86.0,
"end": 88.0,
"clock": "10:51:27",
"text": "そういったところも将来的には"
},
{
"file": "seg_008.ts",
"start": 88.0,
"end": 90.0,
"clock": "10:51:29",
"text": "検討する必要があるのではないか"
},
{
"file": "seg_008.ts",
"start": 90.0,
"end": 92.0,
"clock": "10:51:31",
"text": "ということをして"
},
{
"file": "seg_008.ts",
"start": 92.0,
"end": 94.0,
"clock": "10:51:33",
"text": "来させていただきます"
},
{
"file": "seg_008.ts",
"start": 94.0,
"end": 96.0,
"clock": "10:51:35",
"text": "続きまして"
},
{
"file": "seg_008.ts",
"start": 96.0,
"end": 98.0,
"clock": "10:51:37",
"text": "海ホタルに限らず"
},
{
"file": "seg_008.ts",
"start": 98.0,
"end": 100.0,
"clock": "10:51:39",
"text": "いわゆる空港などでの"
},
{
"file": "seg_008.ts",
"start": 100.0,
"end": 102.0,
"clock": "10:51:41",
"text": "白宅行為については"
},
{
"file": "seg_008.ts",
"start": 102.0,
"end": 104.0,
"clock": "10:51:43",
"text": "この授業を行っているものが"
},
{
"file": "seg_008.ts",
"start": 104.0,
"end": 106.0,
"clock": "10:51:45",
"text": "在留外国人のケースもあったと"
},
{
"file": "seg_008.ts",
"start": 106.0,
"end": 108.0,
"clock": "10:51:47",
"text": "お承知しています"
},
{
"file": "seg_008.ts",
"start": 108.0,
"end": 110.0,
"clock": "10:51:49",
"text": "JDMツアーに関しては"
},
{
"file": "seg_008.ts",
"start": 110.0,
"end": 112.0,
"clock": "10:51:51",
"text": "私そこまでまだ取材立ってないんですけれども"
},
{
"file": "seg_008.ts",
"start": 112.0,
"end": 114.0,
"clock": "10:51:53",
"text": "あると見られます"
},
{
"file": "seg_008.ts",
"start": 114.0,
"end": 116.0,
"clock": "10:51:55",
"text": "まずこの件に関して"
},
{
"file": "seg_008.ts",
"start": 116.0,
"end": 118.0,
"clock": "10:51:57",
"text": "どのような在留資格であれば"
},
{
"file": "seg_008.ts",
"start": 118.0,
"end": 120.0,
"clock": "10:51:59",
"text": "日本国内で有償運転や観光ツアー授業"
},
{
"file": "seg_008.ts",
"start": 120.0,
"end": 122.0,
"clock": "10:52:01",
"text": "レンタカー貸し出したりするといった授業を"
},
{
"file": "seg_008.ts",
"start": 122.0,
"end": 124.0,
"clock": "10:52:03",
"text": "行うことができるのかというところを"
},
{
"file": "seg_008.ts",
"start": 124.0,
"end": 126.0,
"clock": "10:52:05",
"text": "尋ねしていいでしょうか"
},
{
"file": "seg_008.ts",
"start": 126.0,
"end": 128.0,
"clock": "10:52:07",
"text": "内藤事長"
},
{
"file": "seg_008.ts",
"start": 128.0,
"end": 130.0,
"clock": "10:52:09",
"text": "お答え申し上げます"
},
{
"file": "seg_008.ts",
"start": 130.0,
"end": 132.0,
"clock": "10:52:11",
"text": "外国人が若く人がで行うことができる活動は"
},
{
"file": "seg_008.ts",
"start": 132.0,
"end": 134.0,
"clock": "10:52:13",
"text": "出身国管理及び難民認定法に基づき"
},
{
"file": "seg_008.ts",
"start": 134.0,
"end": 136.0,
"clock": "10:52:15",
"text": "在留資格ごとに定められている"
},
{
"file": "seg_008.ts",
"start": 136.0,
"end": 138.0,
"clock": "10:52:17",
"text": "ところでございます"
},
{
"file": "seg_008.ts",
"start": 138.0,
"end": 140.0,
"clock": "10:52:19",
"text": "在留資格は個別の申請におけます"
},
{
"file": "seg_008.ts",
"start": 140.0,
"end": 142.0,
"clock": "10:52:21",
"text": "具体的活動内容を踏まえて決定するものであり"
},
{
"file": "seg_008.ts",
"start": 142.0,
"end": 144.0,
"clock": "10:52:23",
"text": "一概にお答えすることが困難な"
},
{
"file": "seg_008.ts",
"start": 144.0,
"end": 146.0,
"clock": "10:52:25",
"text": "部分もございますが"
},
{
"file": "seg_008.ts",
"start": 146.0,
"end": 148.0,
"clock": "10:52:27",
"text": "例として申し上げると"
},
{
"file": "seg_008.ts",
"start": 148.0,
"end": 150.0,
"clock": "10:52:29",
"text": "まず英勇者日本人の配偶者等の"
},
{
"file": "seg_008.ts",
"start": 150.0,
"end": 152.0,
"clock": "10:52:31",
"text": "身分または地位に基づきに"
},
{
"file": "seg_008.ts",
"start": 152.0,
"end": 154.0,
"clock": "10:52:33",
"text": "認められる在留資格であれば"
},
{
"file": "seg_008.ts",
"start": 154.0,
"end": 156.0,
"clock": "10:52:35",
"text": "収労活動に制限がないため"
},
{
"file": "seg_008.ts",
"start": 156.0,
"end": 158.0,
"clock": "10:52:37",
"text": "日本人と同様にさまざまな活動に"
},
{
"file": "seg_008.ts",
"start": 158.0,
"end": 160.0,
"clock": "10:52:39",
"text": "従事することが可能となります"
},
{
"file": "seg_008.ts",
"start": 160.0,
"end": 162.0,
"clock": "10:52:41",
"text": "またいわゆる収労資格について"
},
{
"file": "seg_008.ts",
"start": 162.0,
"end": 164.0,
"clock": "10:52:43",
"text": "お答え申し上げますと"
},
{
"file": "seg_008.ts",
"start": 164.0,
"end": 166.0,
"clock": "10:52:45",
"text": "事業経営または管理する場合には"
},
{
"file": "seg_008.ts",
"start": 166.0,
"end": 168.0,
"clock": "10:52:47",
"text": "一般的には経営管理の在留資格が"
},
{
"file": "seg_008.ts",
"start": 168.0,
"end": 170.0,
"clock": "10:52:49",
"text": "該当するということになります"
},
{
"file": "seg_008.ts",
"start": 170.0,
"end": 172.0,
"clock": "10:52:51",
"text": "なおいずれの在留資格だとも関係法令等に"
},
{
"file": "seg_008.ts",
"start": 172.0,
"end": 174.0,
"clock": "10:52:53",
"text": "基づく要件を満たす必要がございます"
},
{
"file": "seg_008.ts",
"start": 174.0,
"end": 176.0,
"clock": "10:52:55",
"text": "おはようございます"
},
{
"file": "seg_008.ts",
"start": 176.0,
"end": 178.0,
"clock": "10:52:57",
"text": "こうした在留資格に適合した"
},
{
"file": "seg_008.ts",
"start": 178.0,
"end": 180.0,
"clock": "10:52:59",
"text": "働き方なのかというところ事業なのか"
},
{
"file": "seg_008.ts",
"start": 180.0,
"end": 182.0,
"clock": "10:53:01",
"text": "という確認も必要だと思います"
},
{
"file": "seg_008.ts",
"start": 182.0,
"end": 184.0,
"clock": "10:53:03",
"text": "仮に在留外国人が"
},
{
"file": "seg_008.ts",
"start": 184.0,
"end": 186.0,
"clock": "10:53:05",
"text": "こういった無供給営営業ですとか"
},
{
"file": "seg_008.ts",
"start": 186.0,
"end": 188.0,
"clock": "10:53:07",
"text": "移送改造者の使用など"
},
{
"file": "seg_008.ts",
"start": 188.0,
"end": 190.0,
"clock": "10:53:09",
"text": "行っていた場合に"
},
{
"file": "seg_008.ts",
"start": 190.0,
"end": 192.0,
"clock": "10:53:11",
"text": "在留資格を更新する際"
},
{
"file": "seg_008.ts",
"start": 192.0,
"end": 194.0,
"clock": "10:53:13",
"text": "また変更の審査等に"
},
{
"file": "seg_008.ts",
"start": 194.0,
"end": 196.0,
"clock": "10:53:15",
"text": "一気地で反映する必要があると思うんですけれども"
},
{
"file": "seg_008.ts",
"start": 196.0,
"end": 198.0,
"clock": "10:53:17",
"text": "この"
},
{
"file": "seg_008.ts",
"start": 198.0,
"end": 200.0,
"clock": "10:53:19",
"text": "経営不自法的な"
},
{
"file": "seg_008.ts",
"start": 200.0,
"end": 202.0,
"clock": "10:53:21",
"text": "場速等に引きかかった場合は"
},
{
"file": "seg_008.ts",
"start": 202.0,
"end": 204.0,
"clock": "10:53:23",
"text": "そういう情報連携すでにされている"
},
{
"file": "seg_008.ts",
"start": 204.0,
"end": 206.0,
"clock": "10:53:25",
"text": "ということを承知しているんですが"
},
{
"file": "seg_008.ts",
"start": 206.0,
"end": 208.0,
"clock": "10:53:27",
"text": "今度の行政処分の情報についても"
},
{
"file": "seg_008.ts",
"start": 208.0,
"end": 210.0,
"clock": "10:53:29",
"text": "適切に在留資格に反映できるように"
},
{
"file": "seg_008.ts",
"start": 210.0,
"end": 212.0,
"clock": "10:53:31",
"text": "入管庁と国交省の"
},
{
"file": "seg_008.ts",
"start": 212.0,
"end": 214.0,
"clock": "10:53:33",
"text": "連携も進めるべきではないかと思うんですが"
},
{
"file": "seg_008.ts",
"start": 214.0,
"end": 216.0,
"clock": "10:53:35",
"text": "まず入管庁いかがでしょうか"
},
{
"file": "seg_008.ts",
"start": 216.0,
"end": 218.0,
"clock": "10:53:37",
"text": "おはようございます"
},
{
"file": "seg_008.ts",
"start": 218.0,
"end": 220.0,
"clock": "10:53:39",
"text": "在留機関の更新等は"
},
{
"file": "seg_008.ts",
"start": 220.0,
"end": 222.0,
"clock": "10:53:41",
"text": "入管法により"
},
{
"file": "seg_008.ts",
"start": 222.0,
"end": 224.0,
"clock": "10:53:43",
"text": "法務大臣が適当と認識ともいろいろ場合に"
},
{
"file": "seg_008.ts",
"start": 224.0,
"end": 226.0,
"clock": "10:53:45",
"text": "足りる相当の理由があるときに"
},
{
"file": "seg_008.ts",
"start": 226.0,
"end": 228.0,
"clock": "10:53:47",
"text": "限り強化することとされております"
},
{
"file": "seg_008.ts",
"start": 228.0,
"end": 230.0,
"clock": "10:53:49",
"text": "この"
},
{
"file": "seg_008.ts",
"start": 230.0,
"end": 232.0,
"clock": "10:53:51",
"text": "更新の際の考慮要素としましては"
},
{
"file": "seg_008.ts",
"start": 232.0,
"end": 234.0,
"clock": "10:53:53",
"text": "遭遇が不良でないことについても"
},
{
"file": "seg_008.ts",
"start": 234.0,
"end": 236.0,
"clock": "10:53:55",
"text": "考慮されることになっております"
},
{
"file": "seg_008.ts",
"start": 236.0,
"end": 238.0,
"clock": "10:53:57",
"text": "その上であくまで一般論として"
},
{
"file": "seg_008.ts",
"start": 238.0,
"end": 240.0,
"clock": "10:53:59",
"text": "申し上げれば例えば本法に在留する"
},
{
"file": "seg_008.ts",
"start": 240.0,
"end": 242.0,
"clock": "10:54:01",
