[
{
"file": "seg_016.ts",
"start": 0.0,
"end": 6.62,
"clock": "12:10:01",
"text": "山下ろうとして建物に放下し保健金 を請求したという極めて危険であり"
},
{
"file": "seg_016.ts",
"start": 6.62,
"end": 13.72,
"clock": "12:10:07",
"text": "悪質な犯罪をおかしたとされて 逮捕された中国国籍の男女について"
},
{
"file": "seg_016.ts",
"start": 13.72,
"end": 22.21,
"clock": "12:10:14",
"text": "これ何も説明がなかったという ものでございます"
},
{
"file": "seg_016.ts",
"start": 22.21,
"end": 28.29,
"clock": "12:10:23",
"text": "この処判の事情によりですとか 証拠関係に照らし副訴訟とした"
},
{
"file": "seg_016.ts",
"start": 28.29,
"end": 33.73,
"clock": "12:10:29",
"text": "というこの説明は最高権の資診の 趣旨に相物とお考えでしょうか"
},
{
"file": "seg_016.ts",
"start": 33.73,
"end": 35.33,
"clock": "12:10:34",
"text": "大臣お答えください"
},
{
"file": "seg_016.ts",
"start": 35.33,
"end": 37.57,
"clock": "12:10:36",
"text": "失礼しました"
},
{
"file": "seg_016.ts",
"start": 37.57,
"end": 39.21,
"clock": "12:10:38",
"text": "法務省佐藤警事局長"
},
{
"file": "seg_016.ts",
"start": 39.21,
"end": 40.61,
"clock": "12:10:40",
"text": "お答えいたします"
},
{
"file": "seg_016.ts",
"start": 40.61,
"end": 43.89,
"clock": "12:10:41",
"text": "個別事件における広報のあり方 につきましては検察当局において"
},
{
"file": "seg_016.ts",
"start": 43.89,
"end": 47.65,
"clock": "12:10:44",
"text": "判断すべきことがらでありまして お尋ねの具体的事件を前提とした"
},
{
"file": "seg_016.ts",
"start": 47.65,
"end": 51.41,
"clock": "12:10:48",
"text": "検察当局による副訴訟文広報 の適位について法務当局として"
},
{
"file": "seg_016.ts",
"start": 51.41,
"end": 54.13,
"clock": "12:10:52",
"text": "お答えすることは差し控える ところでありますが"
},
{
"file": "seg_016.ts",
"start": 54.13,
"end": 57.29,
"clock": "12:10:55",
"text": "検察の活動国民に正しく理解して いただくことは"
},
{
"file": "seg_016.ts",
"start": 57.29,
"end": 59.73,
"clock": "12:10:58",
"text": "もとより重要である認識している ところであります"
},
{
"file": "seg_016.ts",
"start": 59.73,
"end": 62.21,
"clock": "12:11:00",
"text": "そして一般論として申し上げます と御指摘のように"
},
{
"file": "seg_016.ts",
"start": 62.21,
"end": 66.49,
"clock": "12:11:03",
"text": "所犯の事情により副訴とした 証拠関係に照らし副訴としたという"
},
{
"file": "seg_016.ts",
"start": 66.49,
"end": 70.49,
"clock": "12:11:07",
"text": "説明だけでは副訴理を何も説明 していないに等しいと思われる"
},
{
"file": "seg_016.ts",
"start": 70.49,
"end": 74.41,
"clock": "12:11:11",
"text": "との御指摘はそのとおりである というふうに考えるところであります"
},
{
"file": "seg_016.ts",
"start": 74.41,
"end": 78.69,
"clock": "12:11:15",
"text": "最も例えば制犯罪をはじめと してそもそも検察当局によって"
},
{
"file": "seg_016.ts",
"start": 78.69,
"end": 81.81,
"clock": "12:11:19",
"text": "副訴理を明らかにすることが困難 であるために御指摘のような"
},
{
"file": "seg_016.ts",
"start": 81.81,
"end": 86.13,
"clock": "12:11:22",
"text": "説明とどまらざるを得ない事案 もある上に検察当局において"
},
{
"file": "seg_016.ts",
"start": 86.13,
"end": 92.61,
"clock": "12:11:27",
"text": "説明した副訴理由やこれを一定の 説明それに以外の一定の説明である"
},
{
"file": "seg_016.ts",
"start": 92.61,
"end": 96.53,
"clock": "12:11:33",
"text": "とか明らかにすることができない 理由の説明であるとかこれがその"
},
{
"file": "seg_016.ts",
"start": 96.53,
"end": 99.85,
"clock": "12:11:37",
"text": "まま報道機関によって報道されて いるかというとそうでないことも"
},
{
"file": "seg_016.ts",
"start": 99.85,
"end": 103.49,
"clock": "12:11:40",
"text": "ただあるのではないかというふう に思われるところでございます"
},
{
"file": "seg_016.ts",
"start": 103.49,
"end": 107.57,
"clock": "12:11:44",
"text": "その上で検察当局におきまして は記者の国籍の別を問わずに"
},
{
"file": "seg_016.ts",
"start": 107.57,
"end": 111.13,
"clock": "12:11:48",
"text": "個別の事案ごとに経験 47条の趣旨を踏まえまして"
},
{
"file": "seg_016.ts",
"start": 111.13,
"end": 115.09,
"clock": "12:11:52",
"text": "委員御指摘のような要素を考慮 した上で最適資分の等の"
},
{
"file": "seg_016.ts",
"start": 115.09,
"end": 118.61,
"clock": "12:11:56",
"text": "公表の価品やその程度判断して 復帰処処分をした事件の"
},
{
"file": "seg_016.ts",
"start": 118.61,
"end": 121.89,
"clock": "12:11:59",
"text": "対外的な事件候補に努めている ものと承知しております"
},
{
"file": "seg_016.ts",
"start": 121.89,
"end": 126.21,
"clock": "12:12:02",
"text": "検察当局におきましては検察の 活動を国民に正しく理解していただく"
},
{
"file": "seg_016.ts",
"start": 126.21,
"end": 130.21,
"clock": "12:12:07",
"text": "よう御指摘の資診の趣旨も踏まえ つつ引き続き適切な候補に"
},
{
"file": "seg_016.ts",
"start": 130.21,
"end": 133.77,
"clock": "12:12:11",
"text": "努めていくことは関用である と考えるところでございます"
},
{
"file": "seg_016.ts",
"start": 133.77,
"end": 136.41,
"clock": "12:12:14",
"text": "田村浩子君"
},
{
"file": "seg_016.ts",
"start": 136.41,
"end": 144.33,
"clock": "12:12:17",
"text": "検察情報上昇部あるいは法務省 とそれから現場の検察との"
},
{
"file": "seg_016.ts",
"start": 144.33,
"end": 147.73,
"clock": "12:12:25",
"text": "どうも意識の帰りがあるようになる おまえたりはなりません"
},
{
"file": "seg_016.ts",
"start": 147.73,
"end": 151.73,
"clock": "12:12:28",
"text": "現場としては余計な説明をして 仕事を増やしたくないとか"
},
{
"file": "seg_016.ts",
"start": 151.73,
"end": 155.45,
"clock": "12:12:32",
"text": "あるいは余計な突っ込みをされたく ないなどの意識があるんじゃない"
},
{
"file": "seg_016.ts",
"start": 155.45,
"end": 158.69,
"clock": "12:12:36",
"text": "かなというふうに思えてはならない ということであります"
},
{
"file": "seg_016.ts",
"start": 158.69,
"end": 165.81,
"clock": "12:12:39",
"text": "そこで特に外国人犯罪との関係で 検察への信頼これは大変重要"
},
{
"file": "seg_016.ts",
"start": 165.81,
"end": 170.93,
"clock": "12:12:46",
"text": "だと思っておりますので可能な 限り具体的な説明をされるように"
},
{
"file": "seg_016.ts",
"start": 170.93,
"end": 175.69,
"clock": "12:12:51",
"text": "最高検察庁から改めて手動など 行うべきではないかと考えていますが"
},
{
"file": "seg_016.ts",
"start": 175.69,
"end": 178.33,
"clock": "12:12:56",
"text": "これについて大臣の諸権をお伺い します"
},
{
"file": "seg_016.ts",
"start": 178.33,
"end": 180.77,
"clock": "12:12:59",
"text": "山下法務大臣"
},
{
"file": "seg_016.ts",
"start": 180.77,
"end": 184.45,
"clock": "12:13:01",
"text": "私としても検察の活動を国民の 皆様に正しく理解していただく"
},
{
"file": "seg_016.ts",
"start": 184.45,
"end": 190.85,
"clock": "12:13:05",
"text": "ことは重要であると考えております ただ先ほど局長からも説明ありました"
},
{
"file": "seg_016.ts",
"start": 190.85,
"end": 194.13,
"clock": "12:13:11",
"text": "とおり個別事件における 公法のあり方については"
},
{
"file": "seg_016.ts",
"start": 194.13,
"end": 198.05,
"clock": "12:13:15",
"text": "まずもって検察投票において 判断すべきことからでありまして"
},
{
"file": "seg_016.ts",
"start": 198.05,
"end": 201.57,
"clock": "12:13:19",
"text": "お答えすることについては差し 控えますけれども"
},
{
"file": "seg_016.ts",
"start": 201.57,
"end": 205.57,
"clock": "12:13:22",
"text": "検察投票後においては検察活動 に対する国民の一層の理解を得る"
},
{
"file": "seg_016.ts",
"start": 205.57,
"end": 210.49,
"clock": "12:13:26",
"text": "ことができるよう最高検察庁が 公表した資金の手術を踏まえ"
},
{
"file": "seg_016.ts",
"start": 210.49,
"end": 215.45,
"clock": "12:13:31",
"text": "引き続き個別事件に即して適切 に副訴訟分候補を行っていくこと"
},
{
"file": "seg_016.ts",
"start": 215.45,
"end": 221.81,
"clock": "12:13:36",
"text": "は関与であると考えております でも私としてもこれは個別事件"
},
{
"file": "seg_016.ts",
"start": 221.81,
"end": 226.73,
"clock": "12:13:42",
"text": "における対応のあり方でもある ためつまびらかには申し上げ"
},
{
"file": "seg_016.ts",
"start": 226.73,
"end": 235.21,
"clock": "12:13:47",
"text": "られませんが一方で昨年の12月3日 に副訴訟分候補の具体的運用について"
},
{
"file": "seg_016.ts",
"start": 235.21,
"end": 241.29,
"clock": "12:13:56",
"text": "ということで公表している部分がございます のでこれについて今後これに基づいた"
},
{
"file": "seg_016.ts",
"start": 241.29,
"end": 244.85,
"clock": "12:14:02",
"text": "検察創業の今後の対応について 引き続き重視してまいりたいと考えて"
},
{
"file": "seg_016.ts",
"start": 244.85,
"end": 249.05,
"clock": "12:14:05",
"text": "おります 北村原子君ありがとうございます"
},
{
"file": "seg_016.ts",
"start": 249.05,
"end": 254.09,
"clock": "12:14:10",
"text": "次に決演関係がないことを知り ながら協議の認知の届でがなされる"
},
{
"file": "seg_016.ts",
"start": 254.09,
"end": 258.21,
"clock": "12:14:15",
"text": "問題いわゆる議想認知の問題について 質問します"
},
{
"file": "seg_016.ts",
"start": 258.21,
"end": 266.41,
"clock": "12:14:19",
"text": "決演関係のない認知は法律上無効です が現行の個跡実務上2人や体重の"
},
{
"file": "seg_016.ts",
"start": 266.41,
"end": 271.37,
"clock": "12:14:27",
"text": "認知の場合に決演関係の確認は 行っていないという理解でよろしい"
},
{
"file": "seg_016.ts",
"start": 271.37,
"end": 276.72,
"clock": "12:14:32",
"text": "ですか 法務省松井民地局長"
},
{
"file": "seg_016.ts",
"start": 276.72,
"end": 280.84,
"clock": "12:14:37",
"text": "お答え申し上げます 一般に個跡の届で等の受費を決定"
},
{
"file": "seg_016.ts",
"start": 280.84,
"end": 287.0,
"clock": "12:14:41",
"text": "するにあたっての市区町村町の市区 町村の審査は多数の届で事件を確立"
},
{
"file": "seg_016.ts",
"start": 287.0,
"end": 292.4,
"clock": "12:14:48",
"text": "的かつ迅速に処理するとの要請 により基本的には民法及び個跡法"
},
{
"file": "seg_016.ts",
"start": 292.4,
"end": 296.84,
"clock": "12:14:53",
"text": "等に帰定する要件を首している かどうかを届省及び個跡法に基づ"
},
{
"file": "seg_016.ts",
"start": 296.84,
"end": 302.16,
"clock": "12:14:57",
"text": "き調査するいわゆる形式的審査 を行っているところです"
},
{
"file": "seg_016.ts",
"start": 302.16,
"end": 305.96,
"clock": "12:15:03",
"text": "着出ない子について個跡法の定める ところにより父としての認知の"
},
{
"file": "seg_016.ts",
"start": 305.96,
"end": 309.56,
"clock": "12:15:06",
"text": "届でがされたときもそのような 審査を行っているところです"
},
{
"file": "seg_016.ts",
"start": 309.56,
"end": 316.16,
"clock": "12:15:10",
"text": "山野浩労君 先日台では中国人男女の間の子に対して"
},
{
"file": "seg_016.ts",
"start": 316.16,
"end": 322.12,
"clock": "12:15:17",
"text": "大国籍を取得させるために大臣男 生に認知させた件が発覚し約1,500"
},
{
"file": "seg_016.ts",
"start": 322.12,
"end": 327.04,
"clock": "12:15:23",
"text": "人の子について偽装認知が疑われ 大きなニュースとなりました"
},
{
"file": "seg_016.ts",
"start": 327.04,
"end": 330.52,
"clock": "12:15:28",
"text": "資料4です また日本国内においても昨年"
},
{
"file": "seg_016.ts",
"start": 330.52,
"end": 336.08,
"clock": "12:15:31",
"text": "10月ベトナム人男女の間の子に 日本国籍を取得させる目的で"
},
{
"file": "seg_016.ts",
"start": 336.08,
"end": 341.68,
"clock": "12:15:37",
"text": "日本人男性が拒否の認知をして 茨城県県に逮捕されるという"
},
{
"file": "seg_016.ts",
"start": 341.68,
"end": 346.28,
"clock": "12:15:42",
"text": "授業がありました資料5です いずれのケースにおいても国籍"
},
{
"file": "seg_016.ts",
"start": 346.28,
"end": 350.44,
"clock": "12:15:47",
"text": "の不正取得のために認知制度が 悪用されたものであります"
},
{
"file": "seg_016.ts",
"start": 350.44,
"end": 353.56,
"clock": "12:15:51",
"text": "この点に関連してまず法務省に 確認します"
},
{
"file": "seg_016.ts",
"start": 353.56,
"end": 357.56,
"clock": "12:15:54",
"text": "偽装認知により日本国籍を有した が実際には外国人同種の"
},
{
"file": "seg_016.ts",
"start": 357.56,
"end": 361.92,
"clock": "12:15:58",
"text": "風亡がある生まれた子について 後に偽装認知が明らかになった"
},
{
"file": "seg_016.ts",
"start": 361.92,
"end": 365.76,
"clock": "12:16:02",
"text": "場合その後の国籍はどうなります でしょうか"
},
{
"file": "seg_016.ts",
"start": 365.76,
"end": 369.76,
"clock": "12:16:06",
"text": "法務省まてみじ局長 お答え申し上げます"
},
{
"file": "seg_016.ts",
"start": 369.76,
"end": 374.2,
"clock": "12:16:10",
"text": "国籍法上子が認知により日本国籍 を取得するためには"
},
{
"file": "seg_016.ts",
"start": 374.2,
"end": 378.96,
"clock": "12:16:15",
"text": "決演上の父がその認知をしたことを 要するものと介されております"
},
{
"file": "seg_016.ts",
"start": 378.96,
"end": 384.16,
"clock": "12:16:19",
"text": "そのため御指摘の事案で事故的に 父として認知をしたものと認知"
},
{
"file": "seg_016.ts",
"start": 384.16,
"end": 389.04,
"clock": "12:16:25",
"text": "をされた子との間に決演上の不死 関係がないことが判明した場合"
},
{
"file": "seg_016.ts",
"start": 389.04,
"end": 393.84,
"clock": "12:16:30",
"text": "には認知による国籍取得の効果 が生じておらず認知された子"
},
{
"file": "seg_016.ts",
"start": 393.84,
"end": 398.72,
"clock": "12:16:34",
"text": "は日本国民でないということになります 山村原君"
},
{
"file": "seg_016.ts",
"start": 398.72,
"end": 403.26,
"clock": "12:16:39",
"text": "続いて入管庁にお聞きします 先ほど申し上げたケースにおいて"
},
{
"file": "seg_016.ts",
"start": 403.26,
"end": 409.32,
"clock": "12:16:44",
"text": "当該子を理由にその親の在留が 認められていたすなわちこの存在"
},
{
"file": "seg_016.ts",
"start": 409.32,
"end": 414.0,
"clock": "12:16:50",
"text": "が在留許可の判断に大きな影響を 与えていた場合その親の在留"
},
{
"file": "seg_016.ts",
"start": 414.0,
"end": 417.84,
"clock": "12:16:55",
"text": "資格はどうなりますか 内藤事長"
},
{
"file": "seg_016.ts",
"start": 417.84,
"end": 420.92,
"clock": "12:16:58",
"text": "お答え申し上げます 因後指摘のいわゆる遺働認知事案"
},
{
"file": "seg_016.ts",
"start": 420.92,
"end": 425.52,
"clock": "12:17:01",
"text": "など偽りその他不正の手段により 上陸許可等を受けた場合などにおり"
},
{
"file": "seg_016.ts",
"start": 425.52,
"end": 430.68,
"clock": "12:17:06",
"text": "ては在留資格取消自由に該当する ため在留資格取消し手続きをとって"
},
{
"file": "seg_016.ts",
"start": 430.68,
"end": 434.56,
"clock": "12:17:11",
"text": "いくということになります 山村原君"
},
{
"file": "seg_016.ts",
"start": 434.56,
"end": 438.92,
"clock": "12:17:15",
"text": "その決論時では当然のことと考え ますが令和4年の民法党改正の"
},
{
"file": "seg_016.ts",
"start": 438.92,
"end": 445.04,
"clock": "12:17:19",
"text": "際に国籍法第3条参考の規定 すなわち日本人により認知された"
},
{
"file": "seg_016.ts",
"start": 445.04,
"end": 450.28,
"clock": "12:17:26",
"text": "ものは日本国籍を取得するという 規定との関連で認知について"
},
{
"file": "seg_016.ts",
"start": 450.28,
"end": 454.96,
"clock": "12:17:31",
"text": "反対の事実があるときすなわち 認知が向こうのあった場合にはこれ"
},
{
"file": "seg_016.ts",
"start": 454.96,
"end": 461.08,
"clock": "12:17:35",
"text": "を適用しないすなわち今おっしゃった ようなことになるそういったその"
},
{
"file": "seg_016.ts",
"start": 461.08,
"end": 466.96,
"clock": "12:17:42",
"text": "偽造認知対策として親切された規定 がありますこの当時日弁連などの"
},
{
"file": "seg_016.ts",
"start": 466.96,
"end": 471.8,
"clock": "12:17:47",
"text": "この規定の親切に反対していました がその反対それ自体は誤りだと"
},
{
"file": "seg_016.ts",
"start": 471.8,
"end": 474.96,
"clock": "12:17:52",
"text": "理解していますのでそのもね 踏言しておきます"
},
{
"file": "seg_016.ts",
"start": 474.96,
"end": 478.4,
"clock": "12:17:55",
"text": "さて偽造認知の問題を考える 上で非常に難しいのは実態の"
},
{
"file": "seg_016.ts",
"start": 478.4,
"end": 482.6,
"clock": "12:17:59",
"text": "把握は極めて困難であるということ です先ほど紹介した台の事例や"
},
{
"file": "seg_016.ts",
"start": 482.6,
"end": 487.1,
"clock": "12:18:03",
"text": "日本国内のベトナム人の事例で なぜ偽造認知が発覚したのか"
},
{
"file": "seg_016.ts",
"start": 487.1,
"end": 491.88,
"clock": "12:18:08",
"text": "さだかではありませんが現行 の運用では認知の届けの際に"
},
{
"file": "seg_016.ts",
"start": 491.88,
"end": 497.04,
"clock": "12:18:12",
"text": "dna関係などは求められていません ので偽造認知がくわだてられた"
},
{
"file": "seg_016.ts",
"start": 497.04,
"end": 501.28,
"clock": "12:18:18",
"text": "場合にそれを察知することは通常 できません現行の認知制度は"
},
{
"file": "seg_016.ts",
"start": 501.28,
"end": 505.4,
"clock": "12:18:22",
"text": "こうした偽造認知がなされる ことは想定したいないものと"
},
{
"file": "seg_016.ts",
"start": 505.4,
"end": 509.12,
"clock": "12:18:26",
"text": "考えられるところ何らかの対策 は必要ではないかというふうに"
},
{
"file": "seg_016.ts",
"start": 509.12,
"end": 514.16,
"clock": "12:18:30",
"text": "考えますそこでそれらを防止 するためには例えばですけど"
},
{
"file": "seg_016.ts",
"start": 514.16,
"end": 519.56,
"clock": "12:18:35",
"text": "外国人女性がうんだこう日本人 男性が認知するケースこういわ"
},
{
"file": "seg_016.ts",
"start": 519.56,
"end": 523.12,
"clock": "12:18:40",
"text": "についてはdna関係を義務付ける など認知制度の見直しが必要"
},
{
"file": "seg_016.ts",
"start": 523.12,
"end": 525.52,
"clock": "12:18:44",
"text": "ではないかと考えますがいかが でしょうか"
},
{
"file": "seg_016.ts",
"start": 525.52,
"end": 528.84,
"clock": "12:18:46",
"text": "大臣にお聞きをお聞きしました 保務大臣"
},
{
"file": "seg_016.ts",
"start": 528.84,
"end": 536.4,
"clock": "12:18:49",
"text": "御指摘のような見直しについて はこれは要するに宿町村の窓口"
},
{
"file": "seg_016.ts",
"start": 536.4,
"end": 541.28,
"clock": "12:18:57",
"text": "にdna型関係の結果を提出させる ことを想定しているのではないか"
},
{
"file": "seg_016.ts",
"start": 541.28,
"end": 545.88,
"clock": "12:19:02",
"text": "と思われるのですがそうやって 宿町村の窓口が受け取ったとしても"
},
{
"file": "seg_016.ts",
"start": 545.88,
"end": 550.04,
"clock": "12:19:06",
"text": "その関係が適切に実施された ものであるかということをその"
},
{
"file": "seg_016.ts",
"start": 550.04,
"end": 553.92,
"clock": "12:19:11",
"text": "宿町村において的確に判断 することというのは困難ではない"
},
{
"file": "seg_016.ts",
"start": 553.92,
"end": 558.8,
"clock": "12:19:14",
"text": "かということまた外国人女性 の子を日本人男性が認知する"
},
{
"file": "seg_016.ts",
"start": 558.8,
"end": 563.8,
"clock": "12:19:19",
"text": "ケースのみに義務付けることという のが相当なのかということも踏ま"
},
{
"file": "seg_016.ts",
"start": 563.8,
"end": 566.68,
"clock": "12:19:24",
"text": "えて慎重な検討を要するものと 考えております"
},
{
"file": "seg_016.ts",
"start": 566.68,
"end": 572.52,
"clock": "12:19:27",
"text": "ただ委員御指摘のとおり偽造認知 により不正に日本国籍が取得させ"
},
{
"file": "seg_016.ts",
"start": 572.52,
"end": 575.92,
"clock": "12:19:33",
"text": "ることはあってはならないもの と認識しております"
},
{
"file": "seg_016.ts",
"start": 575.92,
"end": 581.44,
"clock": "12:19:36",
"text": "現行制度上外国人女性が出産した 子を日本人男性が認知したとして"
},
{
"file": "seg_016.ts",
"start": 581.44,
"end": 585.44,
"clock": "12:19:42",
"text": "その頃についての国籍支度の 届け手があった場合不保の接触"
},
{
"file": "seg_016.ts",
"start": 585.44,
"end": 593.16,
"clock": "12:19:46",
"text": "可能性と申請しておりまして不保 の父とこの血縁関係が認められない"
},
{
"file": "seg_016.ts",
"start": 593.16,
"end": 597.16,
"clock": "12:19:54",
"text": "時はこの日本国籍の支度を認める ことはございません"
},
{
"file": "seg_016.ts",
"start": 597.16,
"end": 598.44,
"clock": "12:19:58",
"text": "また事後的に"
}
]