[
{
"file": "seg_015.ts",
"start": 0.0,
"end": 7.48,
"clock": "12:00:01",
"text": "あるように在留機関の定めのある 外国人顧客については在留機関"
},
{
"file": "seg_015.ts",
"start": 7.48,
"end": 13.36,
"clock": "12:00:08",
"text": "万料号基本的には我が国を出国 しているものと推定されるという"
},
{
"file": "seg_015.ts",
"start": 13.36,
"end": 19.82,
"clock": "12:00:14",
"text": "認識に立って行われているんです だけど御商売されているとか"
},
{
"file": "seg_015.ts",
"start": 19.82,
"end": 26.32,
"clock": "12:00:20",
"text": "あるいは定住者だとか中長期の 在留が想定されている例在留資格"
},
{
"file": "seg_015.ts",
"start": 26.32,
"end": 33.54,
"clock": "12:00:27",
"text": "というのは当然あると思うん ですよどうしてこの24年の6月の"
},
{
"file": "seg_015.ts",
"start": 33.54,
"end": 39.0,
"clock": "12:00:34",
"text": "犯罪対策閣僚会議決定これに基づいて の12月のこの事務連絡というのは"
},
{
"file": "seg_015.ts",
"start": 39.0,
"end": 46.41,
"clock": "12:00:40",
"text": "こんな認識に立っているんですか 平田市長長官官房遠藤審議官"
},
{
"file": "seg_015.ts",
"start": 46.41,
"end": 50.77,
"clock": "12:00:47",
"text": "お答えいたします御指摘の事務 連絡におきましては徳島議長に"
},
{
"file": "seg_015.ts",
"start": 50.77,
"end": 56.21,
"clock": "12:00:51",
"text": "おいて帰国する在留外国人から 不正に常とされた予着金交差"
},
{
"file": "seg_015.ts",
"start": 56.21,
"end": 60.73,
"clock": "12:00:57",
"text": "を握用した手口が認められることを 踏まえまして在留機関の定め合う"
},
{
"file": "seg_015.ts",
"start": 60.73,
"end": 66.13,
"clock": "12:01:01",
"text": "外国人についてはすでに在留機関 更新行っている場合や在留機関"
},
{
"file": "seg_015.ts",
"start": 66.13,
"end": 71.37,
"clock": "12:01:07",
"text": "更新許可申請中である場合などとい った特段の事情がない限り在留"
},
{
"file": "seg_015.ts",
"start": 71.37,
"end": 74.85,
"clock": "12:01:12",
"text": "機関万料日の翌日以降にその 予着金交差から現金出金や多く"
},
{
"file": "seg_015.ts",
"start": 74.85,
"end": 77.89,
"clock": "12:01:15",
"text": "交差への振り込みが行われる 場合は他人になりつましている"
},
{
"file": "seg_015.ts",
"start": 77.89,
"end": 82.29,
"clock": "12:01:18",
"text": "疑いがある場合に該当し得る とものとしているところでございます"
},
{
"file": "seg_015.ts",
"start": 82.29,
"end": 88.73,
"clock": "12:01:23",
"text": "他方で定住者等の在留資格を有する 方が適正に在留機関の更新を行った"
},
{
"file": "seg_015.ts",
"start": 88.73,
"end": 94.13,
"clock": "12:01:29",
"text": "場合などはこの特段の事情が 認められましてなりつましている"
},
{
"file": "seg_015.ts",
"start": 94.13,
"end": 98.17,
"clock": "12:01:35",
"text": "疑いがある場合に該当せず金融機関 において速やかに取引に落ちて"
},
{
"file": "seg_015.ts",
"start": 98.17,
"end": 101.93,
"clock": "12:01:39",
"text": "いただくことになるほか特段の 事情が確認されるまでの間に"
},
{
"file": "seg_015.ts",
"start": 101.93,
"end": 105.73,
"clock": "12:01:42",
"text": "取引の制限措置が取られていた 場合はこれも特段の事情が確認"
},
{
"file": "seg_015.ts",
"start": 105.73,
"end": 109.93,
"clock": "12:01:46",
"text": "されれば速やかに解除される ものと承知しております"
},
{
"file": "seg_015.ts",
"start": 109.93,
"end": 118.89,
"clock": "12:01:50",
"text": "まず凍結ということについての 根拠が私ははっきりしてないん"
},
{
"file": "seg_015.ts",
"start": 118.89,
"end": 124.97,
"clock": "12:01:59",
"text": "じゃないのか決めつけなんじゃない だろうかと思うんですけど"
},
{
"file": "seg_015.ts",
"start": 124.97,
"end": 130.93,
"clock": "12:02:05",
"text": "この今を講談におっしゃったように この事務連絡自身が在留機関"
},
{
"file": "seg_015.ts",
"start": 130.93,
"end": 135.93,
"clock": "12:02:11",
"text": "万量後も適方に在留していること があり得るということを前提に"
},
{
"file": "seg_015.ts",
"start": 135.93,
"end": 141.01,
"clock": "12:02:16",
"text": "していて更新申請がされています とだから在留カードの裏にそういう"
},
{
"file": "seg_015.ts",
"start": 141.01,
"end": 146.37,
"clock": "12:02:22",
"text": "申請中という記載があります ということが確認されたら"
},
{
"file": "seg_015.ts",
"start": 146.37,
"end": 151.01,
"clock": "12:02:27",
"text": "なりつましにはなりませんから だから解除してくださいという"
},
{
"file": "seg_015.ts",
"start": 151.01,
"end": 159.93,
"clock": "12:02:32",
"text": "前提になっているわけですよね その次の資料に金融庁の"
},
{
"file": "seg_015.ts",
"start": 159.93,
"end": 166.93,
"clock": "12:02:40",
"text": "外国人顧客対応にかかる留意事故 というガイドライン的なものを"
},
{
"file": "seg_015.ts",
"start": 166.93,
"end": 172.93,
"clock": "12:02:47",
"text": "お配りしていますがその14ページの ところにあるように"
},
{
"file": "seg_015.ts",
"start": 172.93,
"end": 179.69,
"clock": "12:02:53",
"text": "外国人顧客の視点に立った対応 具体的には在留機関万量前に"
},
{
"file": "seg_015.ts",
"start": 179.69,
"end": 185.17,
"clock": "12:03:00",
"text": "顧客に対して在留機関更新手続 の在留機関が近づいていますよ"
},
{
"file": "seg_015.ts",
"start": 185.17,
"end": 189.17,
"clock": "12:03:06",
"text": "とだから手続きをされている ということであればご連絡ください"
},
{
"file": "seg_015.ts",
"start": 189.17,
"end": 195.13,
"clock": "12:03:10",
"text": "ねというような案内をしましょう ねという趣旨があるんですね"
},
{
"file": "seg_015.ts",
"start": 195.13,
"end": 201.17,
"clock": "12:03:16",
"text": "こういう観点からしたら先ほど らへ紹介している更新手続中です"
},
{
"file": "seg_015.ts",
"start": 201.17,
"end": 206.41,
"clock": "12:03:22",
"text": "と知らせに行ったのにいやもう 統計をしたんだからだめです"
},
{
"file": "seg_015.ts",
"start": 206.41,
"end": 210.41,
"clock": "12:03:27",
"text": "なんていうような対応こんなのは 改めなきゃいけないんじゃないか"
},
{
"file": "seg_015.ts",
"start": 210.41,
"end": 214.17,
"clock": "12:03:31",
"text": "と思いますが金融庁いかがですか 金融庁橋本晋館"
},
{
"file": "seg_015.ts",
"start": 214.17,
"end": 220.17,
"clock": "12:03:35",
"text": "お答えいたします 金融庁といたしましては御指摘の"
},
{
"file": "seg_015.ts",
"start": 220.17,
"end": 226.01,
"clock": "12:03:41",
"text": "警察庁からの事務連絡も踏まえ まして令和7年1月に在留機関に"
},
{
"file": "seg_015.ts",
"start": 226.01,
"end": 231.09,
"clock": "12:03:47",
"text": "基づいた要求金講座の適切な 管理を行うとともに顧客から"
},
{
"file": "seg_015.ts",
"start": 231.09,
"end": 235.81,
"clock": "12:03:52",
"text": "在留機関の更新等の事実を確認 した場合には速やかに通常"
},
{
"file": "seg_015.ts",
"start": 235.81,
"end": 240.91,
"clock": "12:03:56",
"text": "通りの取引を可能とするだけで なく在留機関万量前に更新"
},
{
"file": "seg_015.ts",
"start": 240.91,
"end": 245.11,
"clock": "12:04:01",
"text": "手続の運動を確認するなど顧客 の指定に立った適切な対応を"
},
{
"file": "seg_015.ts",
"start": 245.11,
"end": 250.91,
"clock": "12:04:06",
"text": "要請してきております また本年7月先ほどご書きいただきました"
},
{
"file": "seg_015.ts",
"start": 250.91,
"end": 255.23,
"clock": "12:04:11",
"text": "とおり金融庁が発出しております 外国人顧客対応にかかる留意事故"
},
{
"file": "seg_015.ts",
"start": 255.23,
"end": 260.47,
"clock": "12:04:16",
"text": "を書いていたしまして講座解説時の 顧客説明として在留機関の"
},
{
"file": "seg_015.ts",
"start": 260.47,
"end": 264.35,
"clock": "12:04:21",
"text": "更新等の際に金融機関において 必要とされる手続を追加する"
},
{
"file": "seg_015.ts",
"start": 264.35,
"end": 270.11,
"clock": "12:04:25",
"text": "ほか在留機関万量前に更新手続 の運動を確認するなど外国人"
},
{
"file": "seg_015.ts",
"start": 270.11,
"end": 274.75,
"clock": "12:04:31",
"text": "顧客の指定に立った対応を行っている かといった在留機関の管理に関"
},
{
"file": "seg_015.ts",
"start": 274.75,
"end": 280.95,
"clock": "12:04:35",
"text": "する留意事故を追加の上各金融関 に周知してきているところでございます"
},
{
"file": "seg_015.ts",
"start": 280.95,
"end": 285.15,
"clock": "12:04:41",
"text": "金融庁としてはマネロンダリン ごよびテロシ勤強対策を前提と"
},
{
"file": "seg_015.ts",
"start": 285.15,
"end": 290.63,
"clock": "12:04:46",
"text": "しつつ引き続き各金融機関が外国人 顧客の指定に立った適切な対応"
},
{
"file": "seg_015.ts",
"start": 290.63,
"end": 293.87,
"clock": "12:04:51",
"text": "を行っていくようフォローして まわりたいと考えております"
},
{
"file": "seg_015.ts",
"start": 293.87,
"end": 297.51,
"clock": "12:04:54",
"text": "委員長 委員長 しっかりフォローしていただいて"
},
{
"file": "seg_015.ts",
"start": 297.51,
"end": 304.87,
"clock": "12:04:58",
"text": "まじめにやっているのに在留資格 が入管の言わば都合でですよ審査"
},
{
"file": "seg_015.ts",
"start": 304.87,
"end": 310.67,
"clock": "12:05:05",
"text": "が長びいて交差が止められるという 事態が始まってしまっているという"
},
{
"file": "seg_015.ts",
"start": 310.67,
"end": 316.95,
"clock": "12:05:11",
"text": "ねこういう事態は絶対なくして もらなきゃいけないと強く求め"
},
{
"file": "seg_015.ts",
"start": 316.95,
"end": 323.23,
"clock": "12:05:17",
"text": "たいと思います経営管理のビザ で言いますと許可基準が一方的"
},
{
"file": "seg_015.ts",
"start": 323.23,
"end": 329.95,
"clock": "12:05:24",
"text": "に厳しくされてそれが計画期間中 にもかかわらず一律にたくさんの"
},
{
"file": "seg_015.ts",
"start": 329.95,
"end": 334.83,
"clock": "12:05:30",
"text": "所類を求めて審査が長期化するという 中で交差が統決されるというのは"
},
{
"file": "seg_015.ts",
"start": 334.83,
"end": 340.11,
"clock": "12:05:35",
"text": "とんでもないと思うんですね大臣 最後にこういう中でもし高速効果"
},
{
"file": "seg_015.ts",
"start": 340.11,
"end": 346.39,
"clock": "12:05:41",
"text": "が引き寄とされなかったとだから 形式的に見ると対応みたいになって"
},
{
"file": "seg_015.ts",
"start": 346.39,
"end": 351.03,
"clock": "12:05:47",
"text": "るわけですけどこれから先の審査 例えば英銃資格への申請だとか"
},
{
"file": "seg_015.ts",
"start": 351.03,
"end": 355.79,
"clock": "12:05:52",
"text": "ですねこんな時に不利に扱われたら それは絶対ならないと思いますが"
},
{
"file": "seg_015.ts",
"start": 355.79,
"end": 358.87,
"clock": "12:05:56",
"text": "いかがですか 吉田大臣"
},
{
"file": "seg_015.ts",
"start": 358.87,
"end": 364.03,
"clock": "12:05:59",
"text": "いくつかの質問が中身がございます のでまず一つは経営管理につき"
},
{
"file": "seg_015.ts",
"start": 364.03,
"end": 371.71,
"clock": "12:06:05",
"text": "まして余価基準改正前から経営管理 在留中の方については施工後3年"
},
{
"file": "seg_015.ts",
"start": 371.71,
"end": 375.03,
"clock": "12:06:12",
"text": "が経過するまでは改正後の許可 基準を満たさないことをのみ"
},
{
"file": "seg_015.ts",
"start": 375.03,
"end": 378.59,
"clock": "12:06:16",
"text": "をもって在留期間更新許可申請 を含かとはしていないこれは"
},
{
"file": "seg_015.ts",
"start": 378.59,
"end": 384.43,
"clock": "12:06:19",
"text": "大前提でありますその上で在留資格 経営管理の適正化を図った結果高速"
},
{
"file": "seg_015.ts",
"start": 384.43,
"end": 389.15,
"clock": "12:06:25",
"text": "効果の支払い義務の離効状況の 確認のため申請者に提出を求める"
},
{
"file": "seg_015.ts",
"start": 389.15,
"end": 395.31,
"clock": "12:06:30",
"text": "書類が増加しているということで ございますがこれが審査機関の"
},
{
"file": "seg_015.ts",
"start": 395.31,
"end": 400.83,
"clock": "12:06:36",
"text": "長期間を呼んで統決されている かどうかについては先ほど"
},
{
"file": "seg_015.ts",
"start": 400.83,
"end": 404.71,
"clock": "12:06:41",
"text": "事情が申し上げたように現状 は把握できていないわけでございます"
},
{
"file": "seg_015.ts",
"start": 404.71,
"end": 413.03,
"clock": "12:06:45",
"text": "けれども仮に審査が長びいた結果 この在留機関を超えてしまった場合"
},
{
"file": "seg_015.ts",
"start": 413.03,
"end": 418.39,
"clock": "12:06:54",
"text": "でも特例機関が認められるということ がございますそしてその特例機関"
},
{
"file": "seg_015.ts",
"start": 418.39,
"end": 423.79,
"clock": "12:06:59",
"text": "につきましては先ほど警察庁 からも説明がありましたとおり"
},
{
"file": "seg_015.ts",
"start": 423.79,
"end": 431.43,
"clock": "12:07:04",
"text": "通達においても特段の事情に 当たるということで7ページ8ページ"
},
{
"file": "seg_015.ts",
"start": 431.43,
"end": 437.79,
"clock": "12:07:12",
"text": "にかけて他の特段の疑わしい事情 がない限り素早かに当該とに引き"
},
{
"file": "seg_015.ts",
"start": 437.79,
"end": 441.71,
"clock": "12:07:18",
"text": "に応じていたことを想定している ということが期待しておりますです"
},
{
"file": "seg_015.ts",
"start": 441.71,
"end": 447.95,
"clock": "12:07:22",
"text": "からぜひ警察庁あるいは金融庁 において金融機関に対してこの"
},
{
"file": "seg_015.ts",
"start": 447.95,
"end": 451.51,
"clock": "12:07:28",
"text": "もねをぜひ周知徹底していただき たいというふうに考えておる"
},
{
"file": "seg_015.ts",
"start": 451.51,
"end": 456.03,
"clock": "12:07:32",
"text": "ところでございます 入管庁としてあるいは法務省"
},
{
"file": "seg_015.ts",
"start": 456.03,
"end": 463.43,
"clock": "12:07:37",
"text": "としては迅速に特例機関に入る 前にこういった在留許可を出すということ"
},
{
"file": "seg_015.ts",
"start": 463.43,
"end": 468.47,
"clock": "12:07:44",
"text": "に全力を上げるということととも に経過してもなお特例機関がある"
},
{
"file": "seg_015.ts",
"start": 468.47,
"end": 474.31,
"clock": "12:07:49",
"text": "のだということを本人にもまた 金融機関など関係機関にも周知"
},
{
"file": "seg_015.ts",
"start": 474.31,
"end": 476.87,
"clock": "12:07:55",
"text": "する工夫をしていきたいと考えて おります"
},
{
"file": "seg_015.ts",
"start": 476.87,
"end": 478.47,
"clock": "12:07:57",
"text": "議事長 申し上げておりますのでお待ち"
},
{
"file": "seg_015.ts",
"start": 478.47,
"end": 480.59,
"clock": "12:07:59",
"text": "申し上げてください 引き続き丁寧な審査に染めて"
},
{
"file": "seg_015.ts",
"start": 480.59,
"end": 484.83,
"clock": "12:08:01",
"text": "まいりたいと考えております 二層副長 誰かが丁寧にご答弁"
},
{
"file": "seg_015.ts",
"start": 484.83,
"end": 491.63,
"clock": "12:08:05",
"text": "しようとされる姿勢が見受けられる ほどひどい話なんですよですから"
},
{
"file": "seg_015.ts",
"start": 491.63,
"end": 496.79,
"clock": "12:08:12",
"text": "ちゃんとやってくれということと それから入管の審査の窓口はずらっと"
},
{
"file": "seg_015.ts",
"start": 496.79,
"end": 502.75,
"clock": "12:08:17",
"text": "並んで台重大でその入管庁の職員 さんたちも抜本的に増やさない"
},
{
"file": "seg_015.ts",
"start": 502.75,
"end": 518.61,
"clock": "12:08:23",
"text": "と対応できませんよ強く求めて 質問を終わります"
},
{
"file": "seg_015.ts",
"start": 518.61,
"end": 524.69,
"clock": "12:08:39",
"text": "北村晴君 日本主党の北村晴です よろしくお願いします"
},
{
"file": "seg_015.ts",
"start": 524.69,
"end": 530.81,
"clock": "12:08:45",
"text": "はじめに前回質問した外国人品社 の不規則の報道がある度に検察"
},
{
"file": "seg_015.ts",
"start": 530.81,
"end": 535.65,
"clock": "12:08:51",
"text": "不審が広がっていることから外国 人品社については特にできる"
