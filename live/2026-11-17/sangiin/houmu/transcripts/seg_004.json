[
{
"file": "seg_004.ts",
"start": 0.0,
"end": 5.28,
"clock": "10:10:01",
"text": "上57年には南民議典書に加入するとともに 南民手続きにかかる必要の体制を"
},
{
"file": "seg_004.ts",
"start": 5.28,
"end": 9.32,
"clock": "10:10:06",
"text": "とのえてまいりました まずワークにおいては申請者ごとに"
},
{
"file": "seg_004.ts",
"start": 9.32,
"end": 12.9,
"clock": "10:10:10",
"text": "その申請内容を審査した上で 南民条約の定義に基づき"
},
{
"file": "seg_004.ts",
"start": 12.9,
"end": 18.12,
"clock": "10:10:13",
"text": "南民と認定すべきものを適切に認定しようり また令和5年12月からは"
},
{
"file": "seg_004.ts",
"start": 18.12,
"end": 23.32,
"clock": "10:10:19",
"text": "保管的保護対象者の認定制度を開始 保護すべきものの一層確実な方に"
},
{
"file": "seg_004.ts",
"start": 23.32,
"end": 27.16,
"clock": "10:10:24",
"text": "取り組んでいるところであります さらに南民及び保管的保護"
},
{
"file": "seg_004.ts",
"start": 27.16,
"end": 32.2,
"clock": "10:10:28",
"text": "対象者と認定しない場合であっても 人道上本法での材料を認めるべき"
},
{
"file": "seg_004.ts",
"start": 32.2,
"end": 36.5,
"clock": "10:10:33",
"text": "ものについては材料を適切に認めて 保護しているものであります"
},
{
"file": "seg_004.ts",
"start": 36.5,
"end": 40.12,
"clock": "10:10:37",
"text": "このようにワークにとしては新に 保護するべきものを迅速かつ確実に"
},
{
"file": "seg_004.ts",
"start": 40.12,
"end": 45.28,
"clock": "10:10:41",
"text": "保護しつつ御用卵用的な申請に対し 鉄角に対応することにより"
},
{
"file": "seg_004.ts",
"start": 45.28,
"end": 49.32,
"clock": "10:10:46",
"text": "南民条約非準確としての正規も 果たしていると考えております"
},
{
"file": "seg_004.ts",
"start": 49.32,
"end": 52.8,
"clock": "10:10:50",
"text": "なお美安県の累計化の内容につきましては"
},
{
"file": "seg_004.ts",
"start": 52.8,
"end": 59.8,
"clock": "10:10:53",
"text": "これについてはまずそもそも 振り上げ状況に関する第三者の"
},
{
"file": "seg_004.ts",
"start": 59.8,
"end": 64.64,
"clock": "10:11:00",
"text": "検証ということで振り分けを導入した 当初を含めこれまでに二回外部"
},
{
"file": "seg_004.ts",
"start": 64.64,
"end": 70.4,
"clock": "10:11:05",
"text": "有識者によって運用状況の適正を 検証していただいたところ明らかに"
},
{
"file": "seg_004.ts",
"start": 70.4,
"end": 74.2,
"clock": "10:11:11",
"text": "不適切不適当と断定できる 関係が見当たらなかったということで"
},
{
"file": "seg_004.ts",
"start": 74.2,
"end": 80.2,
"clock": "10:11:15",
"text": "ありそういった御評価を前提として ゼロプラーに基づく運用を"
},
{
"file": "seg_004.ts",
"start": 80.28,
"end": 83.96,
"clock": "10:11:21",
"text": "既存の振り上げを前提に運用 改善したということで運用させて"
},
{
"file": "seg_004.ts",
"start": 83.96,
"end": 87.72,
"clock": "10:11:24",
"text": "いただいているものであります 御都盟ということは当たらない"
},
{
"file": "seg_004.ts",
"start": 87.72,
"end": 91.84,
"clock": "10:11:28",
"text": "というふうに考えております 石川宗君"
},
{
"file": "seg_004.ts",
"start": 91.84,
"end": 98.0,
"clock": "10:11:32",
"text": "第三者の目に検証したのは11年前 なわけにゼロプランのもので"
},
{
"file": "seg_004.ts",
"start": 98.0,
"end": 102.9,
"clock": "10:11:39",
"text": "不妊定行政というべきですけれども 明らかに変わっているそれについて"
},
{
"file": "seg_004.ts",
"start": 102.9,
"end": 107.28,
"clock": "10:11:43",
"text": "は検証していない当初検討 しましたといってこれだいぶ"
},
{
"file": "seg_004.ts",
"start": 107.28,
"end": 111.84,
"clock": "10:11:48",
"text": "前のことなんですよねそれは明らかに 難民条約非準国としては積極も"
},
{
"file": "seg_004.ts",
"start": 111.84,
"end": 118.14,
"clock": "10:11:52",
"text": "よりもゼロプランの方が有意に立っている かのようにそれに接続に従っている"
},
{
"file": "seg_004.ts",
"start": 118.14,
"end": 125.8,
"clock": "10:11:59",
"text": "としか思えませんそして5番に行きます けれども難民として瀬巻もんで"
},
{
"file": "seg_004.ts",
"start": 125.8,
"end": 130.96,
"clock": "10:12:06",
"text": "難民として認定されてもまだ困難 が続くわけですね資料をご覧"
},
{
"file": "seg_004.ts",
"start": 130.96,
"end": 136.64,
"clock": "10:12:11",
"text": "ください10月30日付の朝新聞なんです けれどもアフガニスタンで約"
},
{
"file": "seg_004.ts",
"start": 136.64,
"end": 142.36,
"clock": "10:12:17",
"text": "20年間日本大使館の警備などを担当 してきた野心アミリさんについて"
},
{
"file": "seg_004.ts",
"start": 142.36,
"end": 148.0,
"clock": "10:12:23",
"text": "これは報知したものです外国の機関 で働くアフガニスタン人はテロ"
},
{
"file": "seg_004.ts",
"start": 148.0,
"end": 154.04,
"clock": "10:12:29",
"text": "の表的にされる危険があったと実際 にロケット団が日本大使館の敷地"
},
{
"file": "seg_004.ts",
"start": 154.04,
"end": 158.68,
"clock": "10:12:35",
"text": "に着断したこともあったとそれでも アミリさんたちは命がけで日本"
},
{
"file": "seg_004.ts",
"start": 158.68,
"end": 164.28,
"clock": "10:12:39",
"text": "大使館を守ってくださいました 2021年8月タリバンが主党株料"
},
{
"file": "seg_004.ts",
"start": 164.28,
"end": 171.32,
"clock": "10:12:45",
"text": "制圧10月にようやくアミリさんと ご家族は日本に避難することができました"
},
{
"file": "seg_004.ts",
"start": 171.32,
"end": 178.32,
"clock": "10:12:52",
"text": "ところが来日して真っ先に外務省 から言われたのはアフガニスタン"
},
{
"file": "seg_004.ts",
"start": 178.32,
"end": 185.84,
"clock": "10:12:59",
"text": "にいつ帰るのかという言葉だと言います もう信じられないです日本で外国人"
},
{
"file": "seg_004.ts",
"start": 185.84,
"end": 191.0,
"clock": "10:13:06",
"text": "が暮らしていくことがいかに 難しいか繰り返し解かれたと"
},
{
"file": "seg_004.ts",
"start": 191.0,
"end": 194.76,
"clock": "10:13:12",
"text": "もうこの記事の中にありますこれ とんでもないんじゃないでしょうか"
},
{
"file": "seg_004.ts",
"start": 194.76,
"end": 200.88,
"clock": "10:13:15",
"text": "命がけで日本大使館を守ってくれた 方に対する対応としてアマリにも"
},
{
"file": "seg_004.ts",
"start": 200.88,
"end": 206.92,
"clock": "10:13:21",
"text": "非人道的ではないでしょうか外務省 はこのような扱いについて当然"
},
{
"file": "seg_004.ts",
"start": 206.92,
"end": 212.84,
"clock": "10:13:27",
"text": "だと受け止めるんでしょうか 外務省に置かれては日本大使館"
},
{
"file": "seg_004.ts",
"start": 212.84,
"end": 219.8,
"clock": "10:13:33",
"text": "長年貢献したため迫害される 恐れがあり日本に命からから"
},
{
"file": "seg_004.ts",
"start": 219.8,
"end": 225.0,
"clock": "10:13:40",
"text": "避難してきた現地職員やその家族 に対しても難民として保護され"
},
{
"file": "seg_004.ts",
"start": 225.0,
"end": 229.7,
"clock": "10:13:46",
"text": "生活が安定するよう支援にしっかり 結びつけるそういうことしたこと"
},
{
"file": "seg_004.ts",
"start": 229.7,
"end": 238.68,
"clock": "10:13:50",
"text": "ではなく迫害の恐れがある国へ帰れ とそう促す対応をなさるのでしょう"
},
{
"file": "seg_004.ts",
"start": 238.68,
"end": 243.56,
"clock": "10:13:59",
"text": "かそれとも二度とこんなことが あったならですね二度とそんな"
},
{
"file": "seg_004.ts",
"start": 243.56,
"end": 250.44,
"clock": "10:14:04",
"text": "お促しをしないようにと再発防止 策を決定するのでしょうかことべ"
},
{
"file": "seg_004.ts",
"start": 250.44,
"end": 255.8,
"clock": "10:14:11",
"text": "をお願いします 外務省大臣官房辻さん時間"
},
{
"file": "seg_004.ts",
"start": 255.8,
"end": 260.0,
"clock": "10:14:16",
"text": "お答え申し上げます二〇二十一年八月 のアフガニスタンにおける情勢"
},
{
"file": "seg_004.ts",
"start": 260.0,
"end": 264.0,
"clock": "10:14:21",
"text": "厚下以降政府といたしましては 在アフガニスタン日本国大使館"
},
{
"file": "seg_004.ts",
"start": 264.0,
"end": 269.44,
"clock": "10:14:25",
"text": "の各現地職員の移行を確認の上 希望者についてはその家族を"
},
{
"file": "seg_004.ts",
"start": 269.44,
"end": 276.04,
"clock": "10:14:30",
"text": "含め日本への退避を手拝し日本 における生活支援等も実施してまいりました"
},
{
"file": "seg_004.ts",
"start": 276.04,
"end": 280.44,
"clock": "10:14:37",
"text": "その後現地の在アフガニスタン 日本国大使館再開に向けた準備を"
},
{
"file": "seg_004.ts",
"start": 280.44,
"end": 285.32,
"clock": "10:14:41",
"text": "行う中で各現地職員に対しまして はアフガニスタンへの帰国希望"
},
{
"file": "seg_004.ts",
"start": 285.32,
"end": 291.04,
"clock": "10:14:46",
"text": "の確認などを行いましたその際 政府としてはあくまであくまでも"
},
{
"file": "seg_004.ts",
"start": 291.04,
"end": 295.44,
"clock": "10:14:52",
"text": "本人の意志を尊重しつつできる だけ丁寧な対応を心がけて"
},
{
"file": "seg_004.ts",
"start": 295.44,
"end": 303.6,
"clock": "10:14:56",
"text": "きたところでございます 石川君 それでもいつ帰るのかという言葉"
},
{
"file": "seg_004.ts",
"start": 303.6,
"end": 309.04,
"clock": "10:15:04",
"text": "が発せられたと受け止められている わけですよそしてまた日本で外国人"
},
{
"file": "seg_004.ts",
"start": 309.04,
"end": 312.92,
"clock": "10:15:10",
"text": "が暮らしていくことがいかに難しい かと繰り返しとかれたと受け止め"
},
{
"file": "seg_004.ts",
"start": 312.92,
"end": 317.36,
"clock": "10:15:13",
"text": "られているわけですよそれに ついてあってはならないと外務省"
},
{
"file": "seg_004.ts",
"start": 317.36,
"end": 320.2,
"clock": "10:15:18",
"text": "は思っているかどうかもう一度 確認します"
},
{
"file": "seg_004.ts",
"start": 320.2,
"end": 327.28,
"clock": "10:15:21",
"text": "質疑者さん時間 お答え申し上げます 先ほどご説明しましたとおり本人"
},
{
"file": "seg_004.ts",
"start": 327.28,
"end": 334.44,
"clock": "10:15:28",
"text": "アフガニスタンの現地職員の帰国 希望の確認におきましては外務省"
},
{
"file": "seg_004.ts",
"start": 334.44,
"end": 339.92,
"clock": "10:15:35",
"text": "として本人の意志を尊重しつつできる だけ丁寧な対応を心がけてきた"
},
{
"file": "seg_004.ts",
"start": 339.92,
"end": 344.8,
"clock": "10:15:40",
"text": "ところでございます この帰国意志の 確認に当たりましては帰国した"
},
{
"file": "seg_004.ts",
"start": 344.8,
"end": 349.32,
"clock": "10:15:45",
"text": "場合と帰国しなかった場合のそれ づれにつきまして想定シュール"
},
{
"file": "seg_004.ts",
"start": 349.32,
"end": 354.24,
"clock": "10:15:50",
"text": "一般的な手続きや状況等について 説明をいたしたところでございます"
},
{
"file": "seg_004.ts",
"start": 354.24,
"end": 359.2,
"clock": "10:15:55",
"text": "その上で各現地職員はあくまでも 本人の意志に基づき帰国するかどうか"
},
{
"file": "seg_004.ts",
"start": 359.2,
"end": 364.04,
"clock": "10:16:00",
"text": "を決定したものでございます 宇宙市長村君"
},
{
"file": "seg_004.ts",
"start": 364.04,
"end": 366.08,
"clock": "10:16:05",
"text": "ちょっと待ってください そうすると想定シュール状況"
},
{
"file": "seg_004.ts",
"start": 366.08,
"end": 373.48,
"clock": "10:16:07",
"text": "ということで外国人の人は命から から日本を守ったためにこれから"
},
{
"file": "seg_004.ts",
"start": 373.48,
"end": 376.6,
"clock": "10:16:14",
"text": "迫害をされるかもしれない そういう人に対しても想定される"
},
{
"file": "seg_004.ts",
"start": 376.6,
"end": 380.08,
"clock": "10:16:17",
"text": "こととして日本では暮らしにくく なるかもしれないよとかそういう"
},
{
"file": "seg_004.ts",
"start": 380.08,
"end": 383.92,
"clock": "10:16:21",
"text": "説明もしたこともあるよりということ ですかそれでよしとするんですか"
},
{
"file": "seg_004.ts",
"start": 383.92,
"end": 387.52,
"clock": "10:16:24",
"text": "外務省は スリーさん時間"
},
{
"file": "seg_004.ts",
"start": 387.52,
"end": 391.76,
"clock": "10:16:28",
"text": "お答え申し上げます これも帰国の規模の確認に"
},
{
"file": "seg_004.ts",
"start": 391.76,
"end": 398.08,
"clock": "10:16:32",
"text": "再しましてはできるだけ丁寧な 対応を心がけましたまさにこれ"
},
{
"file": "seg_004.ts",
"start": 398.08,
"end": 404.16,
"clock": "10:16:39",
"text": "在福岡ニスタ日本国大使館で働いて いた現職員ということでできる"
},
{
"file": "seg_004.ts",
"start": 404.16,
"end": 409.88,
"clock": "10:16:45",
"text": "限りの人道的配慮を行いまして 誠実に対応したところでございます"
},
{
"file": "seg_004.ts",
"start": 409.88,
"end": 412.88,
"clock": "10:16:50",
"text": "宇宙市長村君 誠実さがないと思うんですよね"
},
{
"file": "seg_004.ts",
"start": 412.88,
"end": 419.04,
"clock": "10:16:53",
"text": "誠実さというものは本当に日本 大使館に貢献したために迫害"
},
{
"file": "seg_004.ts",
"start": 419.04,
"end": 423.48,
"clock": "10:17:00",
"text": "を受ける恐れがあるということだったら 日本としてしっかり保護しますと"
},
{
"file": "seg_004.ts",
"start": 423.48,
"end": 426.8,
"clock": "10:17:04",
"text": "それを大丈夫です安心してください というのが誠実さだと思います"
},
{
"file": "seg_004.ts",
"start": 426.8,
"end": 428.72,
"clock": "10:17:07",
"text": "よ 想定されることって何なん"
},
{
"file": "seg_004.ts",
"start": 428.72,
"end": 432.52,
"clock": "10:17:09",
"text": "ですか日本では外国人が暮らし にくいということですかそれは"
},
{
"file": "seg_004.ts",
"start": 432.52,
"end": 436.2,
"clock": "10:17:13",
"text": "ちょっと驚きの答弁だと思います ね 正義がかけていると思います"
},
{
"file": "seg_004.ts",
"start": 436.2,
"end": 442.56,
"clock": "10:17:17",
"text": "そして記事によれば多国の大使館 で働いていた阿福岡ニスタ人日本"
},
{
"file": "seg_004.ts",
"start": 442.56,
"end": 447.28,
"clock": "10:17:23",
"text": "じゃなくて多国の大使館で働いて いた方たちは避難先の国籍を"
},
{
"file": "seg_004.ts",
"start": 447.28,
"end": 452.16,
"clock": "10:17:28",
"text": "取得しているんですよ そしてその一方で難民としては"
},
{
"file": "seg_004.ts",
"start": 452.16,
"end": 456.48,
"clock": "10:17:33",
"text": "認定されたものの国籍を取得して いらっしゃるないアミリサンと"
},
{
"file": "seg_004.ts",
"start": 456.48,
"end": 461.44,
"clock": "10:17:37",
"text": "そのご家族日本で安定した生活 を気づけずにいらっしゃる"
},
{
"file": "seg_004.ts",
"start": 461.44,
"end": 469.52,
"clock": "10:17:42",
"text": "難民条約34条は定約国に対して 難民の機関をできる限り容易にし"
},
{
"file": "seg_004.ts",
"start": 469.52,
"end": 474.72,
"clock": "10:17:50",
"text": "その手続きを迅速化するためあら ゆる努力を払うよう求めています"
},
{
"file": "seg_004.ts",
"start": 474.72,
"end": 478.48,
"clock": "10:17:55",
"text": "他の国はこの責任を果たしているん じゃないですかそれなのに日本"
},
{
"file": "seg_004.ts",
"start": 478.48,
"end": 482.92,
"clock": "10:17:59",
"text": "は果たしてないんじゃないでしょうか それだけではなく今年4月法務省"
},
{
"file": "seg_004.ts",
"start": 482.92,
"end": 488.64,
"clock": "10:18:03",
"text": "は機科審査における居住機関 について法律改正するはしない"
},
{
"file": "seg_004.ts",
"start": 488.64,
"end": 494.96,
"clock": "10:18:09",
"text": "で原則10年以上とする運用にして しまいました国籍法御条では重症"
},
{
"file": "seg_004.ts",
"start": 494.96,
"end": 501.2,
"clock": "10:18:15",
"text": "要件は原則として5年以上とも定め られたままなのに運用変更した"
},
{
"file": "seg_004.ts",
"start": 501.2,
"end": 506.64,
"clock": "10:18:22",
"text": "とこれはどのような検討をして 決定したのでしょうか有識発車会議"
},
{
"file": "seg_004.ts",
"start": 506.64,
"end": 512.12,
"clock": "10:18:27",
"text": "などを開いて意見を聞いたのでしょう か憲法学者や国籍法の研究者に"
},
{
"file": "seg_004.ts",
"start": 512.12,
"end": 515.7,
"clock": "10:18:33",
"text": "も当然聞くべきだと思います がいかがでしょうか"
},
{
"file": "seg_004.ts",
"start": 515.7,
"end": 520.73,
"clock": "10:18:36",
"text": "法務省松井民事局長 お答え申し上げます"
},
{
"file": "seg_004.ts",
"start": 520.73,
"end": 527.05,
"clock": "10:18:41",
"text": "今回の見直しは令和8年1月23日 に取りまとめられた外国人の受入れ"
},
{
"file": "seg_004.ts",
"start": 527.05,
"end": 532.37,
"clock": "10:18:48",
"text": "知事はある共生のための総合的対応 策に基づき英重許可の審査との"
},
{
"file": "seg_004.ts",
"start": 532.37,
"end": 536.17,
"clock": "10:18:53",
"text": "整合性の観点から企画許可審査 にかかる見直しを行ったもので"
},
{
"file": "seg_004.ts",
"start": 536.17,
"end": 539.77,
"clock": "10:18:57",
"text": "ございます 国籍法第5条第1項確保に"
},
{
"file": "seg_004.ts",
"start": 539.77,
"end": 543.37,
"clock": "10:19:00",
"text": "企画の条件が規定されております がこれを満たすものについて"
},
{
"file": "seg_004.ts",
"start": 543.37,
"end": 547.49,
"clock": "10:19:04",
"text": "企画を許可するかどうかは法務大臣 の裁量であると返されておりまして"
},
{
"file": "seg_004.ts",
"start": 547.49,
"end": 550.61,
"clock": "10:19:08",
"text": "条件を満たしているからといって 企画を必ず認めなければならない"
},
{
"file": "seg_004.ts",
"start": 550.61,
"end": 555.37,
"clock": "10:19:11",
"text": "というものではございません 今回の見直しは申請者が国籍法"
},
{
"file": "seg_004.ts",
"start": 555.37,
"end": 559.33,
"clock": "10:19:16",
"text": "の定める5年以上の重所条件を満た していることを前提とした上で"
},
{
"file": "seg_004.ts",
"start": 559.33,
"end": 565.37,
"clock": "10:19:20",
"text": "法務大臣の裁量の範囲内で英重許可 との整合性の観点から日本社会"
},
{
"file": "seg_004.ts",
"start": 565.37,
"end": 569.49,
"clock": "10:19:26",
"text": "に誘わしていることの要件の審査 において原則として10年以上"
},
{
"file": "seg_004.ts",
"start": 569.49,
"end": 573.77,
"clock": "10:19:30",
"text": "の在留市日本社会に誘わしている ことを必要としたものでございます"
},
{
"file": "seg_004.ts",
"start": 573.77,
"end": 578.09,
"clock": "10:19:34",
"text": "このように今回の見直しは法務大臣 の裁量権の公主についての運用を"
},
{
"file": "seg_004.ts",
"start": 578.09,
"end": 582.41,
"clock": "10:19:39",
"text": "見直すものに過ぎないため法律の改正 や有識者の意見調子等を減ること"
},
{
"file": "seg_004.ts",
"start": 582.41,
"end": 588.49,
"clock": "10:19:43",
"text": "なく見直ししたものでございます 英重許可についても批判が集まって"
},
{
"file": "seg_004.ts",
"start": 588.49,
"end": 592.33,
"clock": "10:19:49",
"text": "いるわけですよそれが英重許可 に横並びにするというどういうこと"
},
{
"file": "seg_004.ts",
"start": 592.33,
"end": 599.21,
"clock": "10:19:53",
"text": "ですかそれも専門家の意見も聞かない 法律改正も変わりそれで国籍"
}
]