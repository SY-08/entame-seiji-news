[
{
"file": "seg_005.ts",
"start": 0.0,
"end": 5.36,
"clock": "10:20:01",
"text": "するとこれで放置国家と名乗れる のでしょうか難民として認定された"
},
{
"file": "seg_005.ts",
"start": 5.36,
"end": 11.84,
"clock": "10:20:06",
"text": "方などは例外で従来通り5年という ほうどもありましたが大臣の記者"
},
{
"file": "seg_005.ts",
"start": 11.84,
"end": 16.52,
"clock": "10:20:12",
"text": "会見とかあるいは入管庁の救援 団営にはそのような記載がちょっと"
},
{
"file": "seg_005.ts",
"start": 16.52,
"end": 21.44,
"clock": "10:20:17",
"text": "よくわかりませんでした難民として 認定された方については従来通り"
},
{
"file": "seg_005.ts",
"start": 21.44,
"end": 27.36,
"clock": "10:20:22",
"text": "5年以上とする扱いなのでしょうか アンビリさんの娘さん記事にある"
},
{
"file": "seg_005.ts",
"start": 27.36,
"end": 32.12,
"clock": "10:20:28",
"text": "とりアフガニスタンドでは資格 に言っていましたけれども今は"
},
{
"file": "seg_005.ts",
"start": 32.12,
"end": 38.4,
"clock": "10:20:33",
"text": "ファストフードであるわいと息子さん も大変困難な生活をしてらっしゃる"
},
{
"file": "seg_005.ts",
"start": 38.4,
"end": 43.96,
"clock": "10:20:39",
"text": "支援のあり方についてはまた ベット質問したいと思います日本"
},
{
"file": "seg_005.ts",
"start": 43.96,
"end": 49.32,
"clock": "10:20:44",
"text": "国籍がないことで就職や住居の 覚悟など生活のさまざまな場面"
},
{
"file": "seg_005.ts",
"start": 49.32,
"end": 54.92,
"clock": "10:20:50",
"text": "で困難に直面していらっしゃる 繰り返し申し上げますけど多"
},
{
"file": "seg_005.ts",
"start": 54.92,
"end": 60.88,
"clock": "10:20:55",
"text": "国の大使館に外埋めていらっしゃる 方はもう多国で国籍を取得していらっしゃ"
},
{
"file": "seg_005.ts",
"start": 60.88,
"end": 67.56,
"clock": "10:21:01",
"text": "るんですね日本のために命がけで 働いてくれた方々とその家族"
},
{
"file": "seg_005.ts",
"start": 67.56,
"end": 74.16,
"clock": "10:21:08",
"text": "ですら放入りだし不安なままで 自己責任と放置するんでしょうか"
},
{
"file": "seg_005.ts",
"start": 74.16,
"end": 79.2,
"clock": "10:21:15",
"text": "さっきこの記事で紹介されている この不安難民世帯を調べた"
},
{
"file": "seg_005.ts",
"start": 79.2,
"end": 84.44,
"clock": "10:21:20",
"text": "千葉大の小川稲子教授は帰国する ことができない若者にとって"
},
{
"file": "seg_005.ts",
"start": 84.44,
"end": 89.32,
"clock": "10:21:25",
"text": "日本国籍を申請するのに必要な 10年という期間はあまり長く絶望"
},
{
"file": "seg_005.ts",
"start": 89.32,
"end": 94.96,
"clock": "10:21:30",
"text": "しかねないと指摘しています そうですよね20歳の若い人が30歳"
},
{
"file": "seg_005.ts",
"start": 94.96,
"end": 99.92,
"clock": "10:21:35",
"text": "までまた言われたらもう本当に 仕事もできないし何もどうしよう"
},
{
"file": "seg_005.ts",
"start": 99.92,
"end": 103.76,
"clock": "10:21:40",
"text": "ということで絶望ですよね そんな扱いは絶対しない"
},
{
"file": "seg_005.ts",
"start": 103.76,
"end": 109.12,
"clock": "10:21:44",
"text": "難民の方は安心してください ということを扱うすべきですし"
},
{
"file": "seg_005.ts",
"start": 109.12,
"end": 112.88,
"clock": "10:21:50",
"text": "Q&Aとかリーフとかですね わかりやすく周知していただき"
},
{
"file": "seg_005.ts",
"start": 112.88,
"end": 115.72,
"clock": "10:21:53",
"text": "たいんですけれどもいかがでしょう か"
},
{
"file": "seg_005.ts",
"start": 115.72,
"end": 121.27,
"clock": "10:21:56",
"text": "松井民事局長 一般論として難民として認定"
},
{
"file": "seg_005.ts",
"start": 121.27,
"end": 124.23,
"clock": "10:22:02",
"text": "された方についての機関の審査 成り方についてお答え申し上げ"
},
{
"file": "seg_005.ts",
"start": 124.23,
"end": 127.67,
"clock": "10:22:05",
"text": "ます 先ほど申し上げた機関の審査に"
},
{
"file": "seg_005.ts",
"start": 127.67,
"end": 131.63,
"clock": "10:22:08",
"text": "関する見直しは英獣許可の審査 との整合性の観点から行う"
},
{
"file": "seg_005.ts",
"start": 131.63,
"end": 134.79,
"clock": "10:22:12",
"text": "ものでございます 英獣許可の審査においても"
},
{
"file": "seg_005.ts",
"start": 134.79,
"end": 138.83,
"clock": "10:22:15",
"text": "難民の認定を受けた方などについて は例外として在留機関が10年"
},
{
"file": "seg_005.ts",
"start": 138.83,
"end": 142.03,
"clock": "10:22:19",
"text": "に満たなくても許可がされる 場合があるとしお知りをしております"
},
{
"file": "seg_005.ts",
"start": 142.03,
"end": 146.63,
"clock": "10:22:23",
"text": "これを踏まえ機関におきましても 難民の認定を受けたものなどについて"
},
{
"file": "seg_005.ts",
"start": 146.63,
"end": 151.67,
"clock": "10:22:27",
"text": "は個別の事案に応じて例外的に10年 以上の在留をしていなくても機関"
},
{
"file": "seg_005.ts",
"start": 151.67,
"end": 155.43,
"clock": "10:22:32",
"text": "が許可されることがあると考え られます 委員の御指摘を踏まえ"
},
{
"file": "seg_005.ts",
"start": 155.43,
"end": 158.59,
"clock": "10:22:36",
"text": "御指摘の場合についての取扱い の周知のあり方について検討"
},
{
"file": "seg_005.ts",
"start": 158.59,
"end": 163.87,
"clock": "10:22:39",
"text": "してまいりたいと考えております 内閣総理君"
},
{
"file": "seg_005.ts",
"start": 163.87,
"end": 167.75,
"clock": "10:22:44",
"text": "ぜひ周知していただきたいんです が例外としてありうるという"
},
{
"file": "seg_005.ts",
"start": 167.75,
"end": 172.51,
"clock": "10:22:48",
"text": "言い方ではやはりこのような 状態に置かれている若い方たち"
},
{
"file": "seg_005.ts",
"start": 172.51,
"end": 179.59,
"clock": "10:22:53",
"text": "を含めて非常に絶望されると思います のでこれはしっかりと保護する"
},
{
"file": "seg_005.ts",
"start": 179.59,
"end": 185.07,
"clock": "10:23:00",
"text": "とそして安定的な生活を支えるという 観点から国籍取得について確実"
},
{
"file": "seg_005.ts",
"start": 185.07,
"end": 190.51,
"clock": "10:23:06",
"text": "にしていただきたいと思います そして 機関許可の理由の不解事について"
},
{
"file": "seg_005.ts",
"start": 190.51,
"end": 195.59,
"clock": "10:23:11",
"text": "も伺います長年日本で暮らし 日本語を学び生活基盤を築いて"
},
{
"file": "seg_005.ts",
"start": 195.59,
"end": 200.63,
"clock": "10:23:16",
"text": "機関を申請したとしても不許可 となった場合なんとその理由は"
},
{
"file": "seg_005.ts",
"start": 200.63,
"end": 205.43,
"clock": "10:23:21",
"text": "本人に明らかにされません 何人の場合でもですねそうなんです"
},
{
"file": "seg_005.ts",
"start": 205.43,
"end": 210.19,
"clock": "10:23:26",
"text": "何が足りなかったのかと何どこ を改善すればよいのかとそれすら"
},
{
"file": "seg_005.ts",
"start": 210.19,
"end": 217.19,
"clock": "10:23:31",
"text": "わからない状態なんですね これで政府は例えばg7について"
},
{
"file": "seg_005.ts",
"start": 217.19,
"end": 222.19,
"clock": "10:23:38",
"text": "繰り返し自由民主主義人権法の 支配という基本的価値を共有する"
},
{
"file": "seg_005.ts",
"start": 222.19,
"end": 227.27,
"clock": "10:23:43",
"text": "国にだとこの日本もそうだと ことを高らかに言うわけなんですね"
},
{
"file": "seg_005.ts",
"start": 227.27,
"end": 232.99,
"clock": "10:23:48",
"text": "でも他のg7諸国では機関不許可 の理由を示す仕組みが法律上"
},
{
"file": "seg_005.ts",
"start": 232.99,
"end": 238.99,
"clock": "10:23:53",
"text": "整備されているわけですよね 日本でも過去には確か不許可理由"
},
{
"file": "seg_005.ts",
"start": 238.99,
"end": 242.91,
"clock": "10:23:59",
"text": "を示していた例があるんじゃないか と中歴史の時はそういった例"
},
{
"file": "seg_005.ts",
"start": 242.91,
"end": 245.71,
"clock": "10:24:03",
"text": "はないと言われたんですけど でもそういう示した例がある"
},
{
"file": "seg_005.ts",
"start": 245.71,
"end": 251.63,
"clock": "10:24:06",
"text": "というふうに支援者の方々から 聞いています不許可の理由が明らか"
},
{
"file": "seg_005.ts",
"start": 251.63,
"end": 256.71,
"clock": "10:24:12",
"text": "にされなければ行政判断が適切だった のかどうか検証することすら困"
},
{
"file": "seg_005.ts",
"start": 256.71,
"end": 264.51,
"clock": "10:24:17",
"text": "なんです大臣本人に対してせめて 機関を不許可にした理由を明らか"
},
{
"file": "seg_005.ts",
"start": 264.51,
"end": 268.51,
"clock": "10:24:25",
"text": "にすると交渉した制度にすべき ではないでしょうか"
},
{
"file": "seg_005.ts",
"start": 268.51,
"end": 273.11,
"clock": "10:24:29",
"text": "きました大臣 国家の厚生員の範囲を定める機関"
},
{
"file": "seg_005.ts",
"start": 273.11,
"end": 277.83,
"clock": "10:24:34",
"text": "につきましては先ほど民主局局 長が答弁させていただいたとおり"
},
{
"file": "seg_005.ts",
"start": 277.83,
"end": 282.27,
"clock": "10:24:38",
"text": "国際協助法務大臣の裁量を持って 許可不可可の決定をするものでござい"
},
{
"file": "seg_005.ts",
"start": 282.27,
"end": 287.55,
"clock": "10:24:43",
"text": "ましてこれはこうした機関を不許可 とする処分につきましては一般的"
},
{
"file": "seg_005.ts",
"start": 287.55,
"end": 293.51,
"clock": "10:24:48",
"text": "な例えば理由解示の規定があります 行政手続法が適用されず申請者"
},
{
"file": "seg_005.ts",
"start": 293.51,
"end": 298.51,
"clock": "10:24:54",
"text": "に対してその理由を示す必要は 行政手続法上はないということで"
},
{
"file": "seg_005.ts",
"start": 298.51,
"end": 301.87,
"clock": "10:24:59",
"text": "あります その上でこの許可不許可の判断"
},
{
"file": "seg_005.ts",
"start": 301.87,
"end": 307.35,
"clock": "10:25:02",
"text": "についてどのような判断かという とこれは裁判例があるのですが"
},
{
"file": "seg_005.ts",
"start": 307.35,
"end": 311.71,
"clock": "10:25:08",
"text": "機科が国家の厚生員としての 包括的な法律関係を設定する行為"
},
{
"file": "seg_005.ts",
"start": 311.71,
"end": 316.27,
"clock": "10:25:12",
"text": "であり国籍を付与するか否かという 判断は国家の試験者の範囲を確定"
},
{
"file": "seg_005.ts",
"start": 316.27,
"end": 320.75,
"clock": "10:25:17",
"text": "するという我が国の政治の基盤に 関わるものであるから機科を許可"
},
{
"file": "seg_005.ts",
"start": 320.75,
"end": 325.95,
"clock": "10:25:21",
"text": "するか否かにつき政治的社会的な 諸事上を考慮して自由にこれを"
},
{
"file": "seg_005.ts",
"start": 325.95,
"end": 330.19,
"clock": "10:25:26",
"text": "決することができる広犯な 裁量を有しているというのが"
},
{
"file": "seg_005.ts",
"start": 330.19,
"end": 335.43,
"clock": "10:25:31",
"text": "法務大臣の裁量権の範囲ということで 裁判例が示しておるところでございます"
},
{
"file": "seg_005.ts",
"start": 335.43,
"end": 340.47,
"clock": "10:25:36",
"text": "したがってこうした広犯な諸要素を 考慮しなければならないことから"
},
{
"file": "seg_005.ts",
"start": 340.47,
"end": 345.31,
"clock": "10:25:41",
"text": "性質上不許可理由についてつまびらか にすることは困難であります"
},
{
"file": "seg_005.ts",
"start": 345.31,
"end": 350.27,
"clock": "10:25:46",
"text": "さらに不告解理由を明らかにいたします と例えば調査方法や調査事項"
},
{
"file": "seg_005.ts",
"start": 350.27,
"end": 355.07,
"clock": "10:25:51",
"text": "が明らかになりまして機科の判断 に必要な調査の適正な推行に"
},
{
"file": "seg_005.ts",
"start": 355.07,
"end": 358.03,
"clock": "10:25:56",
"text": "首相を及ぼすおそれも考えられる ところであります"
},
{
"file": "seg_005.ts",
"start": 358.03,
"end": 362.03,
"clock": "10:25:59",
"text": "そのため御指摘のような制度を設ける ことについては慎重な件"
},
{
"file": "seg_005.ts",
"start": 362.03,
"end": 365.15,
"clock": "10:26:03",
"text": "を同様すると考えております 宮城さんから"
},
{
"file": "seg_005.ts",
"start": 365.15,
"end": 369.03,
"clock": "10:26:06",
"text": "君 何故理由の明らかにすることが"
},
{
"file": "seg_005.ts",
"start": 369.03,
"end": 373.87,
"clock": "10:26:10",
"text": "適正な調査を妨げるのかむしろ 反対だと思います適正さを担保する"
},
{
"file": "seg_005.ts",
"start": 373.87,
"end": 378.75,
"clock": "10:26:14",
"text": "上でせめて理由を明らかにする ことが必要ですし今日は時間がない"
},
{
"file": "seg_005.ts",
"start": 378.75,
"end": 383.87,
"clock": "10:26:19",
"text": "ので他の質問に移りますけれども ただ今緩和せにできないような"
},
{
"file": "seg_005.ts",
"start": 383.87,
"end": 388.31,
"clock": "10:26:24",
"text": "ことをしたって政治的な社会的事情 で裁量があるとかおっしゃいました"
},
{
"file": "seg_005.ts",
"start": 388.31,
"end": 396.31,
"clock": "10:26:29",
"text": "けれどもどういう意味なんでしょう ねそしたらもうないと信じたいんです"
},
{
"file": "seg_005.ts",
"start": 396.31,
"end": 401.31,
"clock": "10:26:37",
"text": "けれども例えばですよ各国の話 として配外主義的な傾向が強まって"
},
{
"file": "seg_005.ts",
"start": 401.31,
"end": 406.87,
"clock": "10:26:42",
"text": "るとかそういうような政治的な 傾向を配慮にしたら機科とか制限"
},
{
"file": "seg_005.ts",
"start": 406.87,
"end": 410.39,
"clock": "10:26:47",
"text": "的にしようかなというようなこと を強めてそれも裁量のうちって"
},
{
"file": "seg_005.ts",
"start": 410.39,
"end": 414.91,
"clock": "10:26:51",
"text": "ことになるのかどうかちょっと こんな 辺は引き続き追求したい"
},
{
"file": "seg_005.ts",
"start": 414.91,
"end": 420.63,
"clock": "10:26:55",
"text": "と思いますが次の9番に移ります けれども私は弁護士としてdv被害"
},
{
"file": "seg_005.ts",
"start": 420.63,
"end": 425.19,
"clock": "10:27:01",
"text": "を受けてきたが外国人女性たちの 大理人を務めてきたわけですけれども"
},
{
"file": "seg_005.ts",
"start": 425.19,
"end": 429.99,
"clock": "10:27:06",
"text": "外国人女性の場合避難した理理 君を失れば在留資格を失うん"
},
{
"file": "seg_005.ts",
"start": 429.99,
"end": 433.63,
"clock": "10:27:10",
"text": "じゃないかと子どもと離れ離れ になるんじゃないかということ"
},
{
"file": "seg_005.ts",
"start": 433.63,
"end": 441.99,
"clock": "10:27:14",
"text": "を恐れてそしてなかなかdvから 逃れようとしないとか本当に大変な"
},
{
"file": "seg_005.ts",
"start": 441.99,
"end": 447.19,
"clock": "10:27:22",
"text": "ようよろしいでしょうか入管庁は dv事案にかかる措置要領を定めて"
},
{
"file": "seg_005.ts",
"start": 447.19,
"end": 452.19,
"clock": "10:27:28",
"text": "季節に対応するとしていますしかし dvから逃れて別拠し在留期限"
},
{
"file": "seg_005.ts",
"start": 452.19,
"end": 457.63,
"clock": "10:27:33",
"text": "を迎えた場合に確実に在留機関 の更新が認められるのか離婚した"
},
{
"file": "seg_005.ts",
"start": 457.63,
"end": 462.07,
"clock": "10:27:38",
"text": "場合に定住者党への在留資格変更 が認められるのかこれ措置要領"
},
{
"file": "seg_005.ts",
"start": 462.07,
"end": 467.55,
"clock": "10:27:43",
"text": "では必ずしも明らかではありません ですから外国人女性たちは dv"
},
{
"file": "seg_005.ts",
"start": 467.55,
"end": 472.11,
"clock": "10:27:48",
"text": "という予が悪してそこに居続ける ということになり兼ねない状態"
},
{
"file": "seg_005.ts",
"start": 472.11,
"end": 478.71,
"clock": "10:27:53",
"text": "なんですねですからこういう状況 を十分考慮して在留機関の更新"
},
{
"file": "seg_005.ts",
"start": 478.71,
"end": 484.07,
"clock": "10:27:59",
