[
{
"file": "seg_011.ts",
"start": 0.0,
"end": 5.04,
"clock": "11:20:01",
"text": "ここに関しては先ほど説明あったようにも、ほとんどが自護審査です。"
},
{
"file": "seg_011.ts",
"start": 5.04,
"end": 7.52,
"clock": "11:20:06",
"text": "一時報がなされた上での自護審査です。"
},
{
"file": "seg_011.ts",
"start": 7.52,
"end": 13.28,
"clock": "11:20:08",
"text": "もちろん自護審査でも迅速にしないといけないというところはありますけれども、"
},
{
"file": "seg_011.ts",
"start": 13.28,
"end": 17.8,
"clock": "11:20:14",
"text": "密構性の部分であったりであるとか、やはり違いというのがあると思う。"
},
{
"file": "seg_011.ts",
"start": 17.8,
"end": 25.2,
"clock": "11:20:18",
"text": "その中で、通常の台保上などの冷蔵処理と同じようにしなければならないというところは、"
},
{
"file": "seg_011.ts",
"start": 25.2,
"end": 30.56,
"clock": "11:20:26",
"text": "もう少し現実に即して考えるべきではないかと思うんですけれども、最高最下がでしょうか。"
},
{
"file": "seg_011.ts",
"start": 30.56,
"end": 32.56,
"clock": "11:20:31",
"text": "さむなかぜき局長。"
},
{
"file": "seg_011.ts",
"start": 32.56,
"end": 33.92,
"clock": "11:20:33",
"text": "ご対問申し上げます。"
},
{
"file": "seg_011.ts",
"start": 33.92,
"end": 37.92,
"clock": "11:20:34",
"text": "一時保護開始時の審査制度の導入の趣旨は、"
},
{
"file": "seg_011.ts",
"start": 37.92,
"end": 43.36,
"clock": "11:20:38",
"text": "司法機関である裁判所が、一時保護の開始の判断について審査することで、"
},
{
"file": "seg_011.ts",
"start": 43.36,
"end": 49.04,
"clock": "11:20:44",
"text": "より一層の適正性や次続の透明性を確保する点にあることからしますと、"
},
{
"file": "seg_011.ts",
"start": 49.04,
"end": 51.84,
"clock": "11:20:50",
"text": "御指摘の自己請求の場合におきましても、"
},
{
"file": "seg_011.ts",
"start": 51.84,
"end": 57.04,
"clock": "11:20:52",
"text": "司法の判断がないまま、一時保護、長期間継続させることは相当ではなく、"
},
{
"file": "seg_011.ts",
"start": 57.04,
"end": 61.6,
"clock": "11:20:58",
"text": "迅速に司法審査を行うことが求められているものと認識しております。"
},
{
"file": "seg_011.ts",
"start": 61.6,
"end": 69.12,
"clock": "11:21:02",
"text": "裁判所拡張におきましては、ただいま申し上げたような適正性や迅速性等の確保の要請に応える観点から、"
},
{
"file": "seg_011.ts",
"start": 69.12,
"end": 73.28,
"clock": "11:21:10",
"text": "他の事件の処理状況や体制面も含めた事情も踏まえて、"
},
{
"file": "seg_011.ts",
"start": 73.28,
"end": 76.4,
"clock": "11:21:14",
"text": "最適な処理体制について検討した結果、"
},
{
"file": "seg_011.ts",
"start": 76.4,
"end": 84.72,
"clock": "11:21:17",
"text": "多くの長において、通常の例状処理と同じ体制で処理することが相当であると判断したものと認識しております。"
},
{
"file": "seg_011.ts",
"start": 84.72,
"end": 86.32,
"clock": "11:21:25",
"text": "井戸高い君。"
},
{
"file": "seg_011.ts",
"start": 86.32,
"end": 93.04,
"clock": "11:21:27",
"text": "迅速な処理と合わせて、本当に保護すべき事案なのかどうかというところをきっちり審査をしていただくというのが、"
},
{
"file": "seg_011.ts",
"start": 93.04,
"end": 95.92,
"clock": "11:21:34",
"text": "裁判所に求められている役割だと思います。"
},
{
"file": "seg_011.ts",
"start": 95.92,
"end": 106.08,
"clock": "11:21:36",
"text": "これまで、審査が入る前に、時層の判断の中で不当に保護をしているというような状況が現実にあったということを踏まえての、"
},
{
"file": "seg_011.ts",
"start": 106.08,
"end": 111.92,
"clock": "11:21:47",
"text": "今回の新しい仕組みですから、その点も踏まえて、今後の制度を考えていただけたいと思います。"
},
{
"file": "seg_011.ts",
"start": 111.92,
"end": 135.49,
"clock": "11:21:52",
"text": "以上で終わります。"
},
{
"file": "seg_011.ts",
"start": 135.49,
"end": 137.09,
"clock": "11:22:16",
"text": "加田幸君。"
},
{
"file": "seg_011.ts",
"start": 137.09,
"end": 139.01,
"clock": "11:22:18",
"text": "はい、ありがとうございます。"
},
{
"file": "seg_011.ts",
"start": 139.01,
"end": 142.05,
"clock": "11:22:20",
"text": "日本一心の会、加田幸子でございます。"
},
{
"file": "seg_011.ts",
"start": 142.05,
"end": 145.89,
"clock": "11:22:23",
"text": "10分の時間ですので、コンパクトに質問させていただきます。"
},
{
"file": "seg_011.ts",
"start": 145.89,
"end": 157.65,
"clock": "11:22:26",
"text": "まず、私自身一貫して、日本の子どもの幸せづくり、その背景となっている家族の幸せづくりを法的に改善提案をしてまいりました。"
},
{
"file": "seg_011.ts",
"start": 157.65,
"end": 163.49,
"clock": "11:22:38",
"text": "その背景には、男女関係のあり方があります。"
},
{
"file": "seg_011.ts",
"start": 163.49,
"end": 173.09,
"clock": "11:22:44",
"text": "これ、プライバシーが尊重されるべき領域で、そもそも法律へ縛れるのか、規制官をすべきなのか、すべきではないのかと、"
},
{
"file": "seg_011.ts",
"start": 173.09,
"end": 176.29,
"clock": "11:22:54",
"text": "大変、多様な意見のある領域です。"
},
{
"file": "seg_011.ts",
"start": 176.29,
"end": 193.25,
"clock": "11:22:57",
"text": "そういう中で、男女関係の課題、課外者が減らないと被害は減らない、被害者を守るためには、課外者の構成プログラムなり、課外者を減らすことが必要だろうと一貫して訴えてまいりました。"
},
{
"file": "seg_011.ts",
"start": 193.25,
"end": 201.25,
"clock": "11:23:14",
"text": "そういう中で、ストーカー被害、大変悲しい事件がつい最近もたくさんございます。"
},
{
"file": "seg_011.ts",
"start": 201.25,
"end": 214.45,
"clock": "11:23:22",
"text": "元々が2000年だったでしょうか、お怪我しで女学生が大変なストーカー殺人被害を受け、その後、マスコムの皆さんもある意味で関心を持たれて、"
},
{
"file": "seg_011.ts",
"start": 214.45,
"end": 218.85,
"clock": "11:23:35",
"text": "20の意味で殺人されたという問題がありました。"
},
{
"file": "seg_011.ts",
"start": 218.85,
"end": 231.17,
"clock": "11:23:39",
"text": "そこの中で、ストーカー被害法が施行されましたけれども、その後、4回の改正を経て、次の段階を今検討しているということです。"
},
{
"file": "seg_011.ts",
"start": 231.33,
"end": 244.09,
"clock": "11:23:52",
"text": "まず質問ですけれども、7月には犯罪対策、閣僚会議で緊急対策がまとめられ、10月には有識者検討会の初会合が開かれておりますが、"
},
{
"file": "seg_011.ts",
"start": 244.09,
"end": 255.49,
"clock": "11:24:05",
"text": "ここで被害の未然防止、早期対応につなげるために、ストーカー課外者へのGPS装着が議論が始まっております。"
},
{
"file": "seg_011.ts",
"start": 255.49,
"end": 263.33,
"clock": "11:24:16",
"text": "このGPS装着の条件運用方法など得られた情報を基に、検察がどう対応と言うのでしょうか。"
},
{
"file": "seg_011.ts",
"start": 263.33,
"end": 271.41,
"clock": "11:24:24",
"text": "参考資料として、参考位置、どういう仕組みかというのを分かりやすく絵にしたものがありますので、"
},
{
"file": "seg_011.ts",
"start": 271.41,
"end": 277.65,
"clock": "11:24:32",
"text": "これ皆さん見ていただいて一緒にお考えいただけたらと思います。質問以上お願いします。"
},
{
"file": "seg_011.ts",
"start": 277.65,
"end": 280.69,
"clock": "11:24:38",
"text": "以上、警察庁長官官法、ハットレ審議官。"
},
{
"file": "seg_011.ts",
"start": 281.65,
"end": 287.89,
"clock": "11:24:42",
"text": "お答えいたします。本年7月の犯罪対策閣僚会議で決定されました。"
},
{
"file": "seg_011.ts",
"start": 287.89,
"end": 294.29,
"clock": "11:24:48",
"text": "さぎ及びストーカー被害拡大防止のための緊急対策におきましては、"
},
{
"file": "seg_011.ts",
"start": 294.29,
"end": 301.65,
"clock": "11:24:55",
"text": "一定の課外者へのGPS機器等の装着により、課外者が被害者等に接近した場合に、"
},
{
"file": "seg_011.ts",
"start": 301.65,
"end": 311.09,
"clock": "11:25:02",
"text": "被害者等に通知される仕組み等の被害者保護措置の導入に関し、早急に検討を進めることとされたところでございます。"
},
{
"file": "seg_011.ts",
"start": 311.09,
"end": 320.61,
"clock": "11:25:12",
"text": "これを踏まえ、本年10月から警察庁において、ストーカー行為等の規制等のあり方に関する有識者検討会を開催し、"
},
{
"file": "seg_011.ts",
"start": 320.61,
"end": 325.57,
"clock": "11:25:21",
"text": "法学等の専門家等による検討を行っていただいているところでございます。"
},
{
"file": "seg_011.ts",
"start": 325.57,
"end": 329.97,
"clock": "11:25:26",
"text": "新たな被害者保護措置に関する今後の検討の内容につきまして、"
},
{
"file": "seg_011.ts",
"start": 329.97,
"end": 334.45,
"clock": "11:25:30",
"text": "現時点で予断を持ってお答えすることはさしっかりさせていただきますが、"
},
{
"file": "seg_011.ts",
"start": 334.45,
"end": 342.29,
"clock": "11:25:35",
"text": "検討会における議論も踏まえつつ、被害者の保護措置に指するような制度設計を検討してまいりたいと考えております。"
},
{
"file": "seg_011.ts",
"start": 342.29,
"end": 344.21,
"clock": "11:25:43",
"text": "加田有局君"
},
{
"file": "seg_011.ts",
"start": 344.21,
"end": 353.09,
"clock": "11:25:45",
"text": "ありがとうございます。被害はそれこそ日々広がっておりますのでできるだけ速やかな対応をお願いいたします。"
},
{
"file": "seg_011.ts",
"start": 353.25,
"end": 359.81,
"clock": "11:25:54",
"text": "そういう中で海外ではかなり先行事例があると伺っております。"
},
{
"file": "seg_011.ts",
"start": 359.81,
"end": 367.49,
"clock": "11:26:00",
"text": "資料2人、海外の事例を出させていただいておりますけれども、韓国・スペイン・ドイツです。"
},
{
"file": "seg_011.ts",
"start": 367.49,
"end": 378.61,
"clock": "11:26:08",
"text": "韓国やスペインは主にこのGPS装着をストーキング犯罪、あるいはジェンダーボーリュックになっているんですけれども、"
},
{
"file": "seg_011.ts",
"start": 378.61,
"end": 388.13,
"clock": "11:26:19",
"text": "ドイツなどでは犯罪類型の限定なしというような広がりもあるようです。この海外の事例について紹介いただけますか。"
},
{
"file": "seg_011.ts",
"start": 388.13,
"end": 392.35,
"clock": "11:26:29",
"text": "以上、アットリシン館"
},
{
"file": "seg_011.ts",
"start": 392.35,
"end": 398.27,
"clock": "11:26:33",
"text": "お答えいたします。諸外国の制度について、某ら的に把握しているわけではございませんけれども、"
},
{
"file": "seg_011.ts",
"start": 398.27,
"end": 405.15,
"clock": "11:26:39",
"text": "一定のストーカー課外者へのGPS基島の装着により課外者が被害者等に接近した場合に、"
},
{
"file": "seg_011.ts",
"start": 405.15,
"end": 411.23,
"clock": "11:26:46",
"text": "被害者等に通知される仕組みが導入されている例が複数あるものと承知しておりまして、"
},
{
"file": "seg_011.ts",
"start": 411.23,
"end": 417.71,
"clock": "11:26:52",
"text": "まず韓国でございますが、課外者にそのものの位置を即位する端末を装着させる、"
},
{
"file": "seg_011.ts",
"start": 417.71,
"end": 422.43,
"clock": "11:26:58",
"text": "被害者にそのものの位置を即位する端末を携帯してもらう。"
},
{
"file": "seg_011.ts",
"start": 422.43,
"end": 429.31,
"clock": "11:27:03",
"text": "課外者が、被害者または被害者の住居を等から1キロメートル以下に接近した場合において、"
},
{
"file": "seg_011.ts",
"start": 429.31,
"end": 433.95,
"clock": "11:27:10",
"text": "警察に接近した事実や課外者の位置情報を通知する。"
},
{
"file": "seg_011.ts",
"start": 433.95,
"end": 438.91,
"clock": "11:27:14",
"text": "被害者に対しても、課外者が被害者または被害者の住居等に接近した、"
},
{
"file": "seg_011.ts",
"start": 438.91,
"end": 444.11,
"clock": "11:27:19",
"text": "または接近のそれがある場合において同様の通知を行う制度があります。"
},
{
"file": "seg_011.ts",
"start": 444.11,
"end": 450.27,
"clock": "11:27:25",
"text": "またスペインにおきましては、課外者にそのものの位置を即位する端末を装着させるなどする、"
},
{
"file": "seg_011.ts",
"start": 450.27,
"end": 454.11,
"clock": "11:27:31",
"text": "被害者にそのものの位置を即位する端末を携帯してもらう、"
},
{
"file": "seg_011.ts",
"start": 454.11,
"end": 457.87,
"clock": "11:27:35",
"text": "課外者が被害者または被害者の住居等から、"
},
{
"file": "seg_011.ts",
"start": 457.87,
"end": 462.59,
"clock": "11:27:38",
"text": "裁判官が個別の事案ごとに定める距離以下に接近した場合において、"
},
{
"file": "seg_011.ts",
"start": 462.59,
"end": 468.19,
"clock": "11:27:43",
"text": "警察や被害者に接近した事実を通知するなどする制度があります。"
},
{
"file": "seg_011.ts",
"start": 468.19,
"end": 471.79,
"clock": "11:27:49",
"text": "さらに、ドイツのヘッド戦衆におきましても同様に、"
},
{
"file": "seg_011.ts",
"start": 471.79,
"end": 475.79,
"clock": "11:27:52",
"text": "課外者にそのものの位置を即位する端末を装着させる、"
},
{
"file": "seg_011.ts",
"start": 475.79,
"end": 479.79,
"clock": "11:27:56",
"text": "被害者にそのものの位置を即位する端末を携帯してもらう、"
},
{
"file": "seg_011.ts",
"start": 479.79,
"end": 483.39,
"clock": "11:28:00",
"text": "課外者が、被害者または被害者の住居等から、"
},
{
"file": "seg_011.ts",
"start": 483.39,
"end": 487.31,
"clock": "11:28:04",
"text": "個別の事案ごとに定められた距離以下に接近した場合において、"
},
{
"file": "seg_011.ts",
"start": 487.31,
"end": 491.87,
"clock": "11:28:08",
"text": "警察や被害者に接近した事実を通知するなどする制度がございます。"
},
{
"file": "seg_011.ts",
"start": 491.87,
"end": 497.07,
"clock": "11:28:12",
"text": "このような障害国の制度や、先ほど申し上げた検討会における議論も踏まえつつ、"
},
{
"file": "seg_011.ts",
"start": 497.07,
"end": 501.55,
"clock": "11:28:18",
"text": "新たな被害者保護措置の導入について検討を進めてまいりたいと考えています。"
},
{
"file": "seg_011.ts",
"start": 501.55,
"end": 503.79,
"clock": "11:28:22",
"text": "かな、いい子群。"
},
{
"file": "seg_011.ts",
"start": 503.79,
"end": 505.87,
"clock": "11:28:24",
"text": "ありがとうございます。"
},
{
"file": "seg_011.ts",
"start": 505.87,
"end": 512.35,
"clock": "11:28:26",
"text": "こういう犯罪にしろ、かなりそれぞれの文化的、社会的背景が違いますので、"
},
{
"file": "seg_011.ts",
"start": 512.43,
"end": 517.63,
"clock": "11:28:33",
"text": "一概にどこの制度がどうと評価はできないと思うんですけれども、"
},
{
"file": "seg_011.ts",
"start": 517.63,
"end": 526.27,
"clock": "11:28:38",
"text": "その延長の中で3点目ですけれども、DVを理由とした子どもの連れ去り事案、"
},
{
"file": "seg_011.ts",
"start": 526.27,
"end": 530.19,
"clock": "11:28:47",
"text": "これ、精査が必要だと思っております。"
},
{
"file": "seg_011.ts",
"start": 530.19,
"end": 536.27,
"clock": "11:28:51",
"text": "特に婚姻中のDVですね、この事実を十分に確認する必要があります。"
},
{
"file": "seg_011.ts",
"start": 536.27,
"end": 541.23,
"clock": "11:28:57",
"text": "先ほど、うちこしさんがDVの被害者の例を出しておられましたけれども、"
},
{
"file": "seg_011.ts",
"start": 541.23,
"end": 548.67,
"clock": "11:29:02",
"text": "被害を少なくするためにも、課外の実態を制作する必要があると考えております。"
},
{
"file": "seg_011.ts",
"start": 548.67,
"end": 556.51,
"clock": "11:29:09",
"text": "で、今はDVを利用として母親が子どもを促して、シェルターなどに身を隠す方法、"
},
{
"file": "seg_011.ts",
