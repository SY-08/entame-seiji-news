[
{
"file": "seg_012.ts",
"start": 0.0,
"end": 7.0,
"clock": "11:30:01",
"text": "するのではない 課外者を確保する このことによって被害を少なくする"
},
{
"file": "seg_012.ts",
"start": 7.0,
"end": 12.16,
"clock": "11:30:08",
"text": "あるいは被害をなくすというような 逆のベクトルが働いているんです"
},
{
"file": "seg_012.ts",
"start": 12.16,
"end": 19.14,
"clock": "11:30:13",
"text": "けど この辺りどうでしょうか 婚姻中のdvの事実が十分に確認"
},
{
"file": "seg_012.ts",
"start": 19.14,
"end": 23.12,
"clock": "11:30:20",
"text": "された事例については 被害者が逃げるのではなく"
},
{
"file": "seg_012.ts",
"start": 23.12,
"end": 30.12,
"clock": "11:30:24",
"text": "課外者側を保護を確立する捕索を 取るのが一つの方向と思いますけれども"
},
{
"file": "seg_012.ts",
"start": 30.12,
"end": 35.68,
"clock": "11:30:31",
"text": "例えば具体的にはシェルターの設置や 課外者のですね"
},
{
"file": "seg_012.ts",
"start": 35.68,
"end": 40.88,
"clock": "11:30:36",
"text": "あるいはgps装着 そのストーカー被害とのつながりで"
},
{
"file": "seg_012.ts",
"start": 40.88,
"end": 46.44,
"clock": "11:30:41",
"text": "政府として課外者構成するための 対策何か立てておられるでしょうか"
},
{
"file": "seg_012.ts",
"start": 46.44,
"end": 50.72,
"clock": "11:30:47",
"text": "お願いします 内閣大臣官も南新機関"
},
{
"file": "seg_012.ts",
"start": 50.72,
"end": 55.04,
"clock": "11:30:51",
"text": "お答え申し上げます 被害者が安心して生活できる環境を"
},
{
"file": "seg_012.ts",
"start": 55.04,
"end": 60.08,
"clock": "11:30:56",
"text": "整えるためには dvの課外者が自身の課外責任を自覚し"
},
{
"file": "seg_012.ts",
"start": 60.08,
"end": 64.56,
"clock": "11:31:01",
"text": "行動変容を起こすことがお促す 課外者プログラムの実施が"
},
{
"file": "seg_012.ts",
"start": 64.56,
"end": 68.96,
"clock": "11:31:05",
"text": "被害者支援の一環として大変重要 であると考えております"
},
{
"file": "seg_012.ts",
"start": 68.96,
"end": 74.2,
"clock": "11:31:09",
"text": "このため内閣府におきましては 令和5年に地方公共団体が"
},
{
"file": "seg_012.ts",
"start": 74.2,
"end": 78.44,
"clock": "11:31:15",
"text": "課外者プログラムを実施する上で の留意事項を取りまとめて"
},
{
"file": "seg_012.ts",
"start": 78.44,
"end": 84.16,
"clock": "11:31:19",
"text": "都道府県等にお示しするとともに 令和6年度からは都道府県等の取組を"
},
{
"file": "seg_012.ts",
"start": 84.16,
"end": 87.56,
"clock": "11:31:25",
"text": "交付金で支援をしているところで ございます"
},
{
"file": "seg_012.ts",
"start": 87.56,
"end": 91.64,
"clock": "11:31:28",
"text": "多くの地域で課外者プログラム を行っていただくためには"
},
{
"file": "seg_012.ts",
"start": 91.64,
"end": 97.68,
"clock": "11:31:32",
"text": "都道府県等に自信意義をご理解いただき 実施団体等との連携協力を"
},
{
"file": "seg_012.ts",
"start": 97.68,
"end": 100.68,
"clock": "11:31:38",
"text": "深めていただくことが重要である と考えております"
},
{
"file": "seg_012.ts",
"start": 100.68,
"end": 105.08,
"clock": "11:31:41",
"text": "そのため他の自治体での取組事例 を参考としていただくことや"
},
{
"file": "seg_012.ts",
"start": 105.08,
"end": 109.24,
"clock": "11:31:46",
"text": "自治体に対する財政的な支援も 必要であると認識しております"
},
{
"file": "seg_012.ts",
"start": 109.24,
"end": 114.48,
"clock": "11:31:50",
"text": "引き続き自治体向けの研修やウェブサイト における自治体の取組事例等の"
},
{
"file": "seg_012.ts",
"start": 114.48,
"end": 119.16,
"clock": "11:31:55",
"text": "一元的な提供発信交付金の活用特診等 を通じて"
},
{
"file": "seg_012.ts",
"start": 119.16,
"end": 124.24,
"clock": "11:32:00",
"text": "課外者プログラムの全国的な普及 に取り組んでもありたいと考えております"
},
{
"file": "seg_012.ts",
"start": 124.24,
"end": 125.76,
"clock": "11:32:05",
"text": "花井君"
},
{
"file": "seg_012.ts",
"start": 125.76,
"end": 129.6,
"clock": "11:32:06",
"text": "はい 課外者プログラムまた今日も 時間がないので"
},
{
"file": "seg_012.ts",
"start": 129.6,
"end": 134.76,
"clock": "11:32:10",
"text": "より深く現場の実態を勉強 させていただきますけれども"
},
{
"file": "seg_012.ts",
"start": 134.76,
"end": 141.08,
"clock": "11:32:15",
"text": "具体的にはジャシャルターとかあるいは 物理的な手段というのは今考えてない"
},
{
"file": "seg_012.ts",
"start": 141.08,
"end": 149.66,
"clock": "11:32:22",
"text": "ということでよろしいですか 時間ありませんので最後一言お願いします"
},
{
"file": "seg_012.ts",
"start": 149.66,
"end": 154.58,
"clock": "11:32:30",
"text": "南神義官時間が前に出ていません で端的に答弁願います"
},
{
"file": "seg_012.ts",
"start": 154.58,
"end": 159.26,
"clock": "11:32:35",
"text": "課外者用シェルターの設置や GPS装着 といった個別の措置につきましては"
},
{
"file": "seg_012.ts",
"start": 159.26,
"end": 164.02,
"clock": "11:32:40",
"text": "その対象となる課外者の範囲 実施大勢や実施方法実効性等を"
},
{
"file": "seg_012.ts",
"start": 164.02,
"end": 166.82,
"clock": "11:32:45",
"text": "慎重に検討する必要がある と考えております"
},
{
"file": "seg_012.ts",
"start": 167.42,
"end": 198.82,
"clock": "11:32:48",
"text": "ありがとうございました これで終わります"
},
{
"file": "seg_012.ts",
"start": 198.82,
"end": 202.75,
"clock": "11:33:19",
"text": "安田知事君"
},
{
"file": "seg_012.ts",
"start": 202.75,
"end": 204.87,
"clock": "11:33:23",
"text": "三政党の安田知事です"
},
{
"file": "seg_012.ts",
"start": 204.87,
"end": 209.07,
"clock": "11:33:25",
"text": "今日は文部科学省からもおくし出 てますので順番を変えてまず2番から"
},
{
"file": "seg_012.ts",
"start": 209.07,
"end": 211.19,
"clock": "11:33:30",
"text": "お尋ねしたいと思います"
},
{
"file": "seg_012.ts",
"start": 211.19,
"end": 218.51,
"clock": "11:33:32",
"text": "先日私はある効率の高校の野間 定時制を視察しました"
},
{
"file": "seg_012.ts",
"start": 218.51,
"end": 223.11,
"clock": "11:33:39",
"text": "そこでは外国人生徒の比率が 7割を超えておりました"
},
{
"file": "seg_012.ts",
"start": 223.11,
"end": 226.99,
"clock": "11:33:44",
"text": "例は4年までは非常に少なかった のですけど例は5年度から急に増え"
},
{
"file": "seg_012.ts",
"start": 226.99,
"end": 230.79,
"clock": "11:33:47",
"text": "始めたということです"
},
{
"file": "seg_012.ts",
"start": 230.79,
"end": 238.83,
"clock": "11:33:51",
"text": "外国席向けの生徒の特別課程という のでは1年時では週3時間週3個"
},
{
"file": "seg_012.ts",
"start": 238.83,
"end": 244.95,
"clock": "11:33:59",
"text": "までは日本語という科目を単位認定 をしていてまた他の科目でも処方"
},
{
"file": "seg_012.ts",
"start": 244.95,
"end": 249.31,
"clock": "11:34:05",
"text": "的な日本語を教えながら授業を 進めていますだから外国人の生徒と"
},
{
"file": "seg_012.ts",
"start": 249.31,
"end": 254.55,
"clock": "11:34:10",
"text": "日本語日本人の生徒と分けて 授業をしている例が多かった"
},
{
"file": "seg_012.ts",
"start": 254.55,
"end": 256.31,
"clock": "11:34:15",
"text": "ほとんどそうでした"
},
{
"file": "seg_012.ts",
"start": 256.31,
"end": 262.47,
"clock": "11:34:17",
"text": "そして日本語を含めて外国人 の日本語が支援が必要な生徒にも"
},
{
"file": "seg_012.ts",
"start": 262.47,
"end": 268.59,
"clock": "11:34:23",
"text": "今節丁寧な指導を日本人の教員 がしているのでその辺が評判"
},
{
"file": "seg_012.ts",
"start": 268.59,
"end": 273.59,
"clock": "11:34:29",
"text": "がいいのかまた授業料無償であり 口込みで広がって本国から子ども"
},
{
"file": "seg_012.ts",
"start": 273.59,
"end": 277.03,
"clock": "11:34:34",
"text": "呼び寄せてそして受けさせている とそういった例もあると聞いて"
},
{
"file": "seg_012.ts",
"start": 277.03,
"end": 278.03,
"clock": "11:34:38",
"text": "います"
},
{
"file": "seg_012.ts",
"start": 278.03,
"end": 282.95,
"clock": "11:34:39",
"text": "他方で日本語の理解も含めた授業 を行うにあったってどういうふう"
},
{
"file": "seg_012.ts",
"start": 282.95,
"end": 286.91,
"clock": "11:34:43",
"text": "に教えるかというのを持ち返 って考える教員の負担もかなり"
},
{
"file": "seg_012.ts",
"start": 286.91,
"end": 291.35,
"clock": "11:34:47",
"text": "大きいと聞いています さらに定員割れをずっとしている"
},
{
"file": "seg_012.ts",
"start": 291.35,
"end": 296.59,
"clock": "11:34:52",
"text": "ので定員に飽きがあるんですよね だから試験の結果がそこまで"
},
{
"file": "seg_012.ts",
"start": 296.59,
"end": 302.43,
"clock": "11:34:57",
"text": "よくなくても入学できてしまう とそこですると日本語の能力"
},
{
"file": "seg_012.ts",
"start": 302.43,
"end": 306.27,
"clock": "11:35:03",
"text": "はそれほどではなくても面談 が一応できれば受け入れている"
},
{
"file": "seg_012.ts",
"start": 306.27,
"end": 311.83,
"clock": "11:35:07",
"text": "ということのようなんですけど果たして こういう効率の効果において日本語"
},
{
"file": "seg_012.ts",
"start": 311.83,
"end": 317.35,
"clock": "11:35:12",
"text": "能力試験例えばjlptとかこういう 受験や一定の級を合格している"
},
{
"file": "seg_012.ts",
"start": 317.35,
"end": 323.59,
"clock": "11:35:18",
"text": "ということを出願条件できない のかこういう問題意識があります"
},
{
"file": "seg_012.ts",
"start": 323.59,
"end": 327.35,
"clock": "11:35:24",
"text": "そこでご質問なんですけど効率 高校は現行法上でどこまで日本語"
},
{
"file": "seg_012.ts",
"start": 327.35,
"end": 331.63,
"clock": "11:35:28",
"text": "能力を選抜条件できるんでしょう か例えば都道府県の教育委員会"
},
{
"file": "seg_012.ts",
"start": 331.63,
"end": 336.51,
"clock": "11:35:32",
"text": "が要項を改める場合にjlptの一定級 を合格を必進するとかあるいは"
},
{
"file": "seg_012.ts",
"start": 336.51,
"end": 340.75,
"clock": "11:35:37",
"text": "または資格を持たない人には 校内で同等の試験を行って結果"
},
{
"file": "seg_012.ts",
"start": 340.75,
"end": 343.83,
"clock": "11:35:41",
"text": "を合気に持ち入れることは現行法 上可能なんでしょうか不可能な場合"
},
{
"file": "seg_012.ts",
"start": 343.83,
"end": 350.58,
"clock": "11:35:44",
"text": "は根拠条文と利用を示してください 門務科学省大臣官房時代議学習"
},
{
"file": "seg_012.ts",
"start": 350.58,
"end": 356.26,
"clock": "11:35:51",
"text": "基盤審議官 お答え申し上げます 効率高校の入手でございます"
},
{
"file": "seg_012.ts",
"start": 356.26,
"end": 359.82,
"clock": "11:35:57",
"text": "がその実施方法については 町市内である各教育委員会"
},
{
"file": "seg_012.ts",
"start": 359.82,
"end": 363.04,
"clock": "11:36:00",
"text": "等が都道府県教育委員会等が 適切に判断し決定するものでは"
},
{
"file": "seg_012.ts",
"start": 363.04,
"end": 366.46,
"clock": "11:36:04",
"text": "ございますがその上では一般論 として申し上げますと今先生"
},
{
"file": "seg_012.ts",
"start": 366.46,
"end": 371.46,
"clock": "11:36:07",
"text": "御指摘の外部検定試験である日本語 能力試験この一定の級の合格を"
},
{
"file": "seg_012.ts",
"start": 371.46,
"end": 377.18,
"clock": "11:36:12",
"text": "一律に入手の必須の受験資格 とすることにつきましては外部"
},
{
"file": "seg_012.ts",
"start": 377.18,
"end": 382.46,
"clock": "11:36:18",
"text": "の資格であることもなども考え ますとその資格をとっていない"
},
{
"file": "seg_012.ts",
"start": 382.46,
"end": 386.02,
"clock": "11:36:23",
"text": "中学生などの受験機会を一律 にちょっと届くことにもつながり"
},
{
"file": "seg_012.ts",
"start": 386.02,
"end": 388.82,
"clock": "11:36:27",
"text": "兼ねずに機会菌等や平等性 の関係ののについてもまず"
},
{
"file": "seg_012.ts",
"start": 388.82,
"end": 392.38,
"clock": "11:36:29",
"text": "が慎重な検討が必要だと考え られるところでございますが他"
},
{
"file": "seg_012.ts",
"start": 392.38,
"end": 398.38,
"clock": "11:36:33",
"text": "方ですね甲内で日本語に係る試験 を実施し日本語能力を選抜の資料"
},
{
"file": "seg_012.ts",
"start": 398.38,
"end": 403.02,
"clock": "11:36:39",
"text": "の一つとして合肥に用いりこと自体 は当該高校が定める入学者の"
},
{
"file": "seg_012.ts",
"start": 403.02,
"end": 406.58,
"clock": "11:36:44",
"text": "受入れに関する方針などこうした ものに載っておりまして当該"
},
{
"file": "seg_012.ts",
"start": 406.58,
"end": 410.5,
"clock": "11:36:47",
"text": "高校での教育を受けるにあた っての能力適正などを学校として"
},
{
"file": "seg_012.ts",
"start": 410.5,
"end": 414.54,
"clock": "11:36:51",
"text": "判断するということで上級によって は方法の一つとして必ずしも"
},
{
"file": "seg_012.ts",
"start": 414.54,
"end": 417.82,
"clock": "11:36:55",
"text": "認められないということではない と認められることもあると"
},
{
"file": "seg_012.ts",
"start": 417.82,
"end": 421.18,
"clock": "11:36:58",
"text": "考えられるところでございます いずれにいたしました具体的な"
},
{
"file": "seg_012.ts",
"start": 421.18,
"end": 425.66,
"clock": "11:37:02",
"text": "選抜方法につきましては実施者である 都道府県教育委員会などが関係法令"
},
{
"file": "seg_012.ts",
"start": 425.66,
"end": 429.14,
"clock": "11:37:06",
"text": "ですとか教育の機会菌等の観点 こうしたものを踏まえて適切に"
},
{
"file": "seg_012.ts",
"start": 429.14,
"end": 433.18,
"clock": "11:37:10",
"text": "判断されるべきものと考えておる ところでございましてその上で"
},
{
"file": "seg_012.ts",
"start": 433.18,
"end": 437.06,
"clock": "11:37:14",
"text": "生徒や保護者の皆さんなどにも 適切に説明して決定することが"
},
{
"file": "seg_012.ts",
"start": 437.06,
"end": 439.22,
"clock": "11:37:18",
"text": "求められるものと考えている ところでございます"
},
{
"file": "seg_012.ts",
"start": 439.22,
"end": 443.58,
"clock": "11:37:20",
"text": "安田知事君私もこれは現場で いろいろ聞きますとやはり"
},
{
"file": "seg_012.ts",
"start": 443.58,
"end": 447.46,
"clock": "11:37:24",
"text": "課題も先生も本当に頑張って らっしゃるんですけど課題も"
},
{
"file": "seg_012.ts",
"start": 447.46,
"end": 451.74,
"clock": "11:37:28",
"text": "多くてやはり一つ見つけていた のはまず現行の壁ということで"
},
{
"file": "seg_012.ts",
"start": 451.74,
"end": 457.86,
"clock": "11:37:32",
"text": "生徒に日本語の収得の幅があり すぎて私も見たら日本語の科目"
},
{
"file": "seg_012.ts",
"start": 457.86,
"end": 462.02,
"clock": "11:37:38",
"text": "では小学校3年生ぐらいで教える ような感じを教えたり温度交差"
},
{
"file": "seg_012.ts",
"start": 462.02,
"end": 466.18,
"clock": "11:37:43",
"text": "してたりということがあって また毎週5分間ぐらいは他の授業"
},
{
"file": "seg_012.ts",
"start": 466.18,
"end": 469.3,
"clock": "11:37:47",
"text": "のあと時にもやはり同じよう 日本語の指導を入れているという"
},
{
"file": "seg_012.ts",
"start": 469.3,
"end": 473.5,
"clock": "11:37:50",
"text": "ようなことですとまた二つ目の 課題が新路指導でして"
},
{
"file": "seg_012.ts",
"start": 473.5,
"end": 476.94,
"clock": "11:37:54",
"text": "高校を卒業した後ビザがどうなる のかということについて専門の"
},
{
"file": "seg_012.ts",
"start": 476.94,
"end": 480.3,
"clock": "11:37:57",
"text": "人がいないのでやはりこの 事務的な負担が大きいということ"
},
{
"file": "seg_012.ts",
"start": 480.3,
"end": 483.42,
"clock": "11:38:01",
"text": "を言っていてそういう人を配置して 欲しいという予防もありました"
},
{
"file": "seg_012.ts",
"start": 483.42,
"end": 487.1,
"clock": "11:38:04",
"text": "またさらに三つ目として先発 段階で今言った日本能力の"
},
{
"file": "seg_012.ts",
"start": 487.1,
"end": 493.06,
"clock": "11:38:08",
"text": "先発の空ができないかと言った こともありましたということです"
},
{
"file": "seg_012.ts",
"start": 493.06,
"end": 499.38,
"clock": "11:38:14",
"text": "それと今回令和5年の4月から 高校では日本語指導特別の"
},
{
"file": "seg_012.ts",
"start": 499.38,
"end": 502.86,
"clock": "11:38:20",
"text": "業務課程として実施できるように 生徒改正始まりました"
},
{
"file": "seg_012.ts",
"start": 502.86,
"end": 509.58,
"clock": "11:38:23",
"text": "夜間中学では他方で今日本は 生徒の6割長が外国人になっていて"
},
{
"file": "seg_012.ts",
"start": 509.58,
"end": 512.66,
"clock": "11:38:30",
"text": "夜間中学のポスターも外国人の 受入れを連想させるようなもの"
},
{
"file": "seg_012.ts",
"start": 512.66,
"end": 517.9,
"clock": "11:38:33",
"text": "になっております平成26年からは もうすでに夜間中学では特別の"
},
{
"file": "seg_012.ts",
"start": 517.9,
"end": 521.7,
"clock": "11:38:38",
"text": "教育課程を編成する可能になって いて令和5年には東京ことに"
},
{
"file": "seg_012.ts",
"start": 521.7,
"end": 525.78,
"clock": "11:38:42",
"text": "夜間中学一校設置するという 方針を決められたようです"
},
{
"file": "seg_012.ts",
"start": 525.78,
"end": 529.98,
"clock": "11:38:46",
"text": "ただ国や自治体のお金で無償で 日本語指導まで効率の中学校"
},
{
"file": "seg_012.ts",
"start": 529.98,
"end": 534.66,
"clock": "11:38:50",
"text": "とか効率の高校とかすごくやって いけば外国人が増えていくというのは"
},
{
"file": "seg_012.ts",
"start": 534.66,
"end": 540.34,
"clock": "11:38:55",
"text": "当たり前ではないかとまず大切なのは わが国がどういう方針で外国人"
},
{
"file": "seg_012.ts",
"start": 540.34,
"end": 543.26,
"clock": "11:39:01",
"text": "を受け入れるのかということを 決めることではないかと思います"
},
{
"file": "seg_012.ts",
"start": 543.26,
"end": 548.38,
"clock": "11:39:04",
"text": "特に日本語能力がそれほどない 方の受入れをどうするのかということ"
},
{
"file": "seg_012.ts",
"start": 548.38,
"end": 552.22,
"clock": "11:39:09",
"text": "はこれは入国段階できちっと 決めておかなければないんでは"
},
{
"file": "seg_012.ts",
"start": 552.22,
"end": 556.58,
"clock": "11:39:13",
"text": "いけないではないかと思います また後避負担のあり方や現場"
},
{
"file": "seg_012.ts",
"start": 556.58,
"end": 561.58,
"clock": "11:39:17",
"text": "の教員の負担、生徒への授業の 幸せとか外国人秘密の問題を受け"
},
{
"file": "seg_012.ts",
"start": 561.58,
"end": 568.14,
"clock": "11:39:22",
"text": "まして明確な方針をこれは法務省も 入管庁もさらに門下省も縦で"
},
{
"file": "seg_012.ts",
"start": 568.14,
"end": 570.54,
"clock": "11:39:29",
"text": "置かなければならないんではない かと思います"
},
{
"file": "seg_012.ts",
"start": 570.54,
"end": 576.86,
"clock": "11:39:31",
"text": "今令和8年6月末家族滞在者数という の資料の一番最後5枚目ありますけれども"
},
{
"file": "seg_012.ts",
"start": 576.86,
"end": 584.82,
"clock": "11:39:37",
"text": "37466人で全体の8.7%を閉めています またこれから特定技能2号という"
},
{
"file": "seg_012.ts",
"start": 584.82,
"end": 588.26,
"clock": "11:39:45",
"text": "のが今非役的に伸びてまして18000人 だいまで来ているんですね"
},
{
"file": "seg_012.ts",
"start": 588.26,
"end": 592.66,
"clock": "11:39:49",
"text": "もともとも本当にゼロに近かった のがすごい勢いで数間数的に伸びて"
},
{
"file": "seg_012.ts",
"start": 592.66,
"end": 598.5,
"clock": "11:39:53",
"text": "まして特定技能2号になると家族滞在 が家族を呼べせることができ"
},
{
"file": "seg_012.ts",
"start": 598.5,
"end": 600.42,
"clock": "11:39:59",
"text": "ないんですね 本国から奥さんや子どもを"
},
{
"file": "seg_012.ts",
"start": 600.42,
"end": 601.06,
"clock": "11:40:01",
"text": "呼び"
}
]