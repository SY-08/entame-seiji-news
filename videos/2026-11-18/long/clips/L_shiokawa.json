[
{
"start": 0.02,
"end": 6.78,
"text": "次に塩川哲也君"
},
{
"start": 6.78,
"end": 9.92,
"text": "日本共産党代表して意見表明を行います"
},
{
"start": 9.92,
"end": 15.4,
"text": "自民党日本維新の会国民主党参統が提出した提出削減法案は"
},
{
"start": 15.4,
"end": 21.1,
"text": "現行制度の最大の問題である民意を歪める小選局制を正義にしたまま"
},
{
"start": 21.1,
"end": 27.08,
"text": "民意の反映としてきた比例代表の提出を31番削減して規模を縮小し"
},
{
"start": 27.08,
"end": 30.94,
"text": "小数生徒の犠牲不獲得は幅む仕組みまで導入して"
},
{
"start": 30.94,
"end": 34.44,
"text": "比例代表の機能を交代させるものです"
},
{
"start": 34.44,
"end": 37.64,
"text": "一層小選局中心の選挙制度に作り替え"
},
{
"start": 37.64,
"end": 42.04,
"text": "民主主義破壊の大改悪を行うものと言わざるません"
},
{
"start": 42.04,
"end": 45.34,
"text": "国会議員は主権者国民の代表です"
},
{
"start": 45.34,
"end": 49.44,
"text": "民意を正確に反映した国会団が徹底した議論を通じて"
},
{
"start": 49.44,
"end": 53.54,
"text": "国の審議を決めるのが国民主権の議会制民主主義です"
},
{
"start": 53.54,
"end": 57.84,
"text": "県政史上最大規模となる議員提出31削減は"
},
{
"start": 57.84,
"end": 61.44,
"text": "多様な民意の議制権の反映を一層困難にし"
},
{
"start": 61.44,
"end": 65.24,
"text": "小数意見や小数生徒を排除することになります"
},
{
"start": 65.24,
"end": 68.74,
"text": "国民の声は真っすぐ議会に届きにくくなり"
},
{
"start": 68.74,
"end": 73.04,
"text": "国会の政府監視機能が弱まることは明らかです"
},
{
"start": 73.04,
"end": 75.84,
"text": "そもそも日本の議員数は国際的に見ても"
},
{
"start": 75.84,
"end": 77.84,
"text": "歴史的に見ても最小です"
},
{
"start": 77.84,
"end": 81.64,
"text": "現在でも少ない議員をさらに減らすことは認められません"
},
{
"start": 81.64,
"end": 83.64,
"text": "議員提出は増やすべきです"
},
{
"start": 83.64,
"end": 87.14,
"text": "直近の提出策券が行われた2016年"
},
{
"start": 87.14,
"end": 90.14,
"text": "削減する積極的な理由や理論的根拠は"
},
{
"start": 90.14,
"end": 93.54,
"text": "見出し方ないとの有識者の当進や"
},
{
"start": 93.54,
"end": 96.34,
"text": "各党の提案者がこれ以上の削減はできない"
},
{
"start": 96.34,
"end": 98.34,
"text": "という認識を示していました"
},
{
"start": 98.34,
"end": 101.94,
"text": "提数削減に合理的根拠は存在しないということが"
},
{
"start": 101.94,
"end": 104.94,
"text": "提数削減問題の国会議論の到達点です"
},
{
"start": 104.94,
"end": 107.84,
"text": "これを議論の前提とすべきです"
},
{
"start": 107.84,
"end": 110.34,
"text": "ヒレ提数の31削減によって"
},
{
"start": 110.34,
"end": 112.74,
"text": "一層小選局制中心となり"
},
{
"start": 112.74,
"end": 115.74,
"text": "比較大一党の議席戦有率が高まります"
},
{
"start": 115.74,
"end": 118.04,
"text": "小数生徒に配慮したといっても"
},
{
"start": 118.04,
"end": 120.04,
"text": "ヒレ提数削減を前提に"
},
{
"start": 120.04,
"end": 121.84,
"text": "どんな仕組みを導入しても"
},
{
"start": 121.84,
"end": 124.04,
"text": "ヒレ代表の機能は切り刻まれ"
},
{
"start": 124.04,
"end": 126.74,
"text": "多様な身には切り捨てられます"
},
{
"start": 126.74,
"end": 131.14,
"text": "ヒレ議席配分方法の修正散落式への変更"
},
{
"start": 131.14,
"end": 134.04,
"text": "重複立候補者の当選基準の引き上げ"
},
{
"start": 134.04,
"end": 136.24,
"text": "中国四国ブロックの統合"
},
{
"start": 136.24,
"end": 140.14,
"text": "ヒレで名簿搭載者補助となった際の決意など"
},
{
"start": 140.14,
"end": 142.34,
"text": "身員を反映した議会を作ることに"
},
{
"start": 142.34,
"end": 144.34,
"text": "ことごと区反するものです"
},
{
"start": 144.54,
"end": 147.04,
"text": "現行の選挙制度の最大の問題は"
},
{
"start": 147.04,
"end": 149.04,
"text": "小選局制にあります"
},
{
"start": 149.04,
"end": 152.04,
"text": "議席に反映しない指標を大量に生み出し"
},
{
"start": 152.04,
"end": 155.54,
"text": "投票した半数の民意を切り捨て"
},
{
"start": 155.54,
"end": 157.24,
"text": "特許率と議席戦有率に"
},
{
"start": 157.24,
"end": 158.84,
"text": "一律しい帰りを作り出し"
},
{
"start": 158.84,
"end": 160.64,
"text": "民意を歪めています"
},
{
"start": 160.64,
"end": 163.94,
"text": "比較大一党が虚構の多数議席を得ることで"
},
{
"start": 163.94,
"end": 165.34,
"text": "多数のおごりを生み"
},
{
"start": 165.34,
"end": 167.14,
"text": "共権政治を往行させ"
},
{
"start": 167.14,
"end": 169.14,
"text": "国民の政治不信を作り出すことに"
},
{
"start": 169.14,
"end": 170.44,
"text": "つながっています"
},
{
"start": 170.44,
"end": 172.84,
"text": "今多くの国民が求めているのは"
},
{
"start": 172.84,
"end": 174.44,
"text": "自民党裏金問題など"
},
{
"start": 174.44,
"end": 177.04,
"text": "勤権不敗政治の混雑です"
},
{
"start": 177.04,
"end": 178.64,
"text": "共同通信の世論調査でも"
},
{
"start": 178.64,
"end": 179.94,
"text": "低数削減より"
},
{
"start": 179.94,
"end": 182.64,
"text": "政治資金の規制強化を優先すべきだとの"
},
{
"start": 182.64,
"end": 185.64,
"text": "回答が67.1%です"
},
{
"start": 185.64,
"end": 188.84,
"text": "ところが今回の低数削減の作動は"
},
{
"start": 188.84,
"end": 190.44,
"text": "維新が連立いるのため"
},
{
"start": 190.44,
"end": 193.64,
"text": "自民の嫌がる裏金問題とその原始となった"
},
{
"start": 193.64,
"end": 196.34,
"text": "企業団体研究の禁止を棚上げし"
},
{
"start": 196.34,
"end": 198.34,
"text": "論点のすり替えごまかしのため"
},
{
"start": 198.34,
"end": 200.24,
"text": "持ち出してきたものです"
},
{
"start": 200.24,
"end": 202.44,
"text": "その上維新や高一総理は"
},
{
"start": 202.44,
"end": 204.34,
"text": "低数削減の後日として"
},
{
"start": 204.34,
"end": 206.84,
"text": "身を切る改革を懸殿してきました"
},
{
"start": 206.84,
"end": 209.54,
"text": "国民の代表だる国会議員の議席は"
},
{
"start": 209.54,
"end": 211.84,
"text": "金額で図るものではありません"
},
{
"start": 211.84,
"end": 213.34,
"text": "身を切る改革は"
},
{
"start": 213.34,
"end": 215.74,
"text": "政権の側が国民に負担と"
},
{
"start": 215.74,
"end": 218.14,
"text": "痛みを押し付けるときの常統区であり"
},
{
"start": 218.14,
"end": 219.24,
"text": "印象捜査"
},
{
"start": 219.24,
"end": 221.24,
"text": "目値ましでしかありません"
},
{
"start": 221.24,
"end": 222.34,
"text": "重大のことは"
},
{
"start": 222.34,
"end": 224.94,
"text": "自民維新政権が低数削減を"
},
{
"start": 224.94,
"end": 227.34,
"text": "改革の先端品と位置づけ"
},
{
"start": 227.34,
"end": 230.04,
"text": "選挙制度を与党の独裁を実現する"
},
{
"start": 231.04,
"end": 234.44,
"text": "その先に社会保障不担当と大軍閣"
},
{
"start": 234.44,
"end": 237.14,
"text": "会見などの共権政治を加速しようと"
},
{
"start": 237.14,
"end": 238.34,
"text": "していることです"
},
{
"start": 238.34,
"end": 240.64,
"text": "このような身身破壊の防御を"
},
{
"start": 240.64,
"end": 243.14,
"text": "断じて認めることはできません"
},
{
"start": 243.14,
"end": 245.44,
"text": "国民的な議論を行うことなく"
},
{
"start": 245.44,
"end": 247.64,
"text": "一部の政党が断応した見直しを"
},
{
"start": 247.64,
"end": 250.74,
"text": "多数の力で国会と国民に押し付けることは"
},
{
"start": 250.74,
"end": 252.04,
"text": "許されません"
},
{
"start": 252.04,
"end": 253.84,
"text": "虚構の多数を作り出す"
},
{
"start": 253.84,
"end": 256.14,
"text": "小選局制を排除し"
},
{
"start": 256.14,
"end": 258.54,
"text": "民意を反映する比例代表中心の"
},
{
"start": 258.54,
"end": 260.64,
"text": "選挙制度への抜本改革こそ"
},
{
"start": 260.64,
"end": 270.69,
"text": "必要だと申し述べ意見表明を終わります"
},
{
"start": 270.69,
"end": 273.09,
"text": "これにて発言は終わりました"
},
{
"start": 273.09,
"end": 274.99,
"text": "次回は来たる20日金曜日"
},
{
"start": 274.99,
"end": 276.79,
"text": "午前9時20分理事会"
},
{
"start": 276.79,
"end": 280.09,
"text": "午前9時30分委員会を開会することとし"
},
{
"start": 280.09,
"end": 282.59,
"text": "本日はこれにて参加いたします"
}
]