[
{
"start": 0.0,
"end": 3.36,
"text": "発言の申し出がありますので、順次、これを許します。"
},
{
"start": 3.36,
"end": 11.82,
"text": "派世川順次君"
},
{
"start": 11.82,
"end": 14.3,
"text": "十日総の派世川順次でございます。"
},
{
"start": 14.3,
"end": 17.58,
"text": "まず、衆議院の選挙制度につきましては、"
},
{
"start": 17.58,
"end": 22.54,
"text": "令和4年の公職選挙法改正の際の不対決議に基づき、"
},
{
"start": 22.54,
"end": 26.7,
"text": "議長のおとに設置された衆議院選挙制度に関する協議会において、"
},
{
"start": 26.7,
"end": 32.3,
"text": "議論が行われ、本年10月にその結論が議長に報告されました。"
},
{
"start": 32.3,
"end": 35.14,
"text": "約4年間にわたりまして、議論を積み重ね、"
},
{
"start": 35.14,
"end": 39.46,
"text": "取りまとめに向けてご人旅行いただいた全ての関係者の皆さんに、"
},
{
"start": 39.46,
"end": 41.7,
"text": "心から経緯を申し上げます。"
},
{
"start": 41.7,
"end": 46.02,
"text": "第一に、協議会報告の柱の一つであります。"
},
{
"start": 46.02,
"end": 49.54,
"text": "理想の選挙制度に向けた罰本改革につきましては、"
},
{
"start": 49.54,
"end": 53.22,
"text": "議長のおとに衆議院選挙制度調査会を設置し、"
},
{
"start": 53.22,
"end": 54.98,
"text": "時期遺送選挙までに、"
},
{
"start": 54.98,
"end": 58.74,
"text": "新たな制度のもとで選挙を実施することを目指し、"
},
{
"start": 58.74,
"end": 62.98,
"text": "1年以内を目とに当心を取りまとめることとされました。"
},
{
"start": 62.98,
"end": 66.5,
"text": "我が党は罰本改革の検討にあたっては、"
},
{
"start": 66.5,
"end": 72.74,
"text": "我が国のあるべき政治や当地の携帯を踏まえて議論をすべきであると考えます。"
},
{
"start": 72.74,
"end": 79.06,
"text": "すなわち、主犯使命や予算の議決などで優越する衆議院の選挙は、"
},
{
"start": 79.06,
"end": 81.62,
"text": "政権選択選挙であり、"
},
{
"start": 81.62,
"end": 87.3,
"text": "政治責任の明確化と安定した政権運営を実現するため、"
},
{
"start": 87.38,
"end": 89.46,
"text": "衆議院の選挙制度は、"
},
{
"start": 89.46,
"end": 93.06,
"text": "民意の集約を重視すべきであります。"
},
{
"start": 93.06,
"end": 96.5,
"text": "今まさに、激変する内外の所上制に、"
},
{
"start": 96.5,
"end": 100.82,
"text": "迅速に対処し、決める政治を実現するためには、"
},
{
"start": 100.82,
"end": 106.42,
"text": "民意の集約を軸とした選挙制度を追求すべきと考えます。"
},
{
"start": 106.42,
"end": 110.1,
"text": "また、いわゆる一票の格差、絶対に伴い、"
},
{
"start": 110.1,
"end": 113.06,
"text": "地方の選挙区が減少しておりますが、"
},
{
"start": 113.06,
"end": 116.1,
"text": "我が国は、歴史的、社会的にみて、"
},
{
"start": 116.1,
"end": 120.34,
"text": "それぞれ特色ある地域があって国土が形成されており、"
},
{
"start": 120.34,
"end": 122.74,
"text": "抜本改革の検討にあたっては、"
},
{
"start": 122.74,
"end": 125.94,
"text": "人口を基本としつつも行政区域や"
},
{
"start": 125.94,
"end": 129.54,
"text": "地域的な一体制度を総合的に勘案した"
},
{
"start": 129.54,
"end": 132.82,
"text": "選挙区割の制度を導入することについて、"
},
{
"start": 132.82,
"end": 134.74,
"text": "憲法改正の必要性も含め、"
},
{
"start": 134.74,
"end": 137.06,
"text": "検討を行うべきと考えます。"
},
{
"start": 137.06,
"end": 140.98,
"text": "第二に、協議会報告のもう一つの柱であります。"
},
{
"start": 141.14,
"end": 143.62,
"text": "原稿制度の見直しにつきましては、"
},
{
"start": 143.62,
"end": 146.26,
"text": "今般の協議会報告を受け、"
},
{
"start": 146.26,
"end": 149.06,
"text": "生徒館協議を重ねた結果、"
},
{
"start": 149.06,
"end": 151.94,
"text": "自由民主党、日本維新の会、"
},
{
"start": 151.94,
"end": 154.98,
"text": "国民民主党の3党の合意に基づき、"
},
{
"start": 154.98,
"end": 156.58,
"text": "共同提案にて、"
},
{
"start": 156.58,
"end": 159.38,
"text": "公職選挙法の一部を改正する党の"
},
{
"start": 159.38,
"end": 161.7,
"text": "法律さんを提出いたしました。"
},
{
"start": 161.7,
"end": 164.18,
"text": "まず、議員提出につきましては、"
},
{
"start": 164.18,
"end": 166.78,
"text": "我が党は衆議院総選挙の蹴る"
},
{
"start": 166.78,
"end": 168.34,
"text": "政権公約において、"
},
{
"start": 168.34,
"end": 172.74,
"text": "1割を目標とする定数削減を掲げました。"
},
{
"start": 172.74,
"end": 175.38,
"text": "今般、協議会報告を受け、"
},
{
"start": 175.38,
"end": 177.42,
"text": "定数のあり方についても、"
},
{
"start": 177.42,
"end": 179.94,
"text": "生徒館協議を重ねた結果、"
},
{
"start": 179.94,
"end": 181.78,
"text": "3党合意に基づき、"
},
{
"start": 181.78,
"end": 184.46,
"text": "国民の人口動態に応じた"
},
{
"start": 184.46,
"end": 188.1,
"text": "31人の削減を提案しております。"
},
{
"start": 188.1,
"end": 189.78,
"text": "原稿制度の下で、"
},
{
"start": 189.78,
"end": 193.38,
"text": "地方議員の定数削減努力なども踏まえ、"
},
{
"start": 193.38,
"end": 195.5,
"text": "国民との約束である"
},
{
"start": 195.5,
"end": 199.38,
"text": "定数削減を実現すべきと考えます。"
},
{
"start": 199.38,
"end": 200.38,
"text": "その上で、"
},
{
"start": 200.38,
"end": 204.54,
"text": "地方の声を国政に反映する必要性を考えれば、"
},
{
"start": 204.54,
"end": 208.18,
"text": "地方の小選挙区の数をこれ以上減らすことは"
},
{
"start": 208.18,
"end": 209.74,
"text": "困難であることから、"
},
{
"start": 209.74,
"end": 213.5,
"text": "定数削減は比例代表において行うものとし、"
},
{
"start": 213.5,
"end": 216.5,
"text": "合わせて比例代表制において、"
},
{
"start": 216.5,
"end": 219.82,
"text": "多様な民意を反映させることができる"
},
{
"start": 219.82,
"end": 221.78,
"text": "議席配分方式として、"
},
{
"start": 221.78,
"end": 225.14,
"text": "修正3ラグ式を導入するとともに、"
},
{
"start": 225.14,
"end": 227.66,
"text": "人口が最初の四国ブロックを"
},
{
"start": 227.66,
"end": 230.14,
"text": "中国ブロックと統合することにより、"
},
{
"start": 230.14,
"end": 233.42,
"text": "民意の集約と反映のバランスを"
},
{
"start": 233.42,
"end": 235.34,
"text": "明ることとしております。"
},
{
"start": 235.34,
"end": 237.62,
"text": "さらに比例代表制において、"
},
{
"start": 237.62,
"end": 241.38,
"text": "政党官の連携を円滑化する観点から、"
},
{
"start": 241.38,
"end": 245.1,
"text": "いわゆる統一名簿方式を導入することとし、"
},
{
"start": 245.1,
"end": 247.7,
"text": "来年にも提出されることとなる、"
},
{
"start": 247.7,
"end": 251.18,
"text": "令和7年国政調査の結果に基づく、"
},
{
"start": 251.18,
"end": 255.66,
"text": "衆議院省選局のクワリ海底法の施行の日と同日に、"
},
{
"start": 255.66,
"end": 258.7,
"text": "定数削減や比例代表制の見直し層と"
},
{
"start": 258.7,
"end": 260.58,
"text": "一体として施行できるよう、"
},
{
"start": 260.58,
"end": 264.74,
"text": "必要な構成上の措置を講じるものとしております。"
},
{
"start": 264.74,
"end": 267.34,
"text": "次に、比例代表制については、"
},
{
"start": 267.34,
"end": 271.66,
"text": "兼ねてから低い得票率での復活当選や、"
},
{
"start": 271.66,
"end": 274.82,
"text": "比例名簿搭載者の不足が主張した場合に、"
},
{
"start": 274.82,
"end": 278.54,
"text": "他の政党に議席が移る仕組みに対して、"
},
{
"start": 278.54,
"end": 283.42,
"text": "有権者の投票意思と帰りしているのではないかと指摘されてきました。"
},
{
"start": 283.42,
"end": 290.5,
"text": "このため、庁福立候補者の比例復活当選の基準については、"
},
{
"start": 290.5,
"end": 298.1,
"text": "強拓勤募集点である有効投票速数の十分の一から、"
},
{
"start": 298.1,
"end": 303.02,
"text": "省選局での投票に最低限必要な特標数である"
},
{
"start": 303.02,
"end": 305.5,
"text": "六分の一に引き上げることにより、"
},
{
"start": 305.5,
"end": 312.46,
"text": "有権者の候補者への一票という投票意思をより反映させることとしております。"
},
{
"start": 312.46,
"end": 315.06,
"text": "また、比例名簿搭載者については、"
},
{
"start": 315.06,
"end": 319.38,
"text": "各政党において、候補者を用立しやすくするため、"
},
{
"start": 319.38,
"end": 323.82,
"text": "比例代表における強拓勤募集基準を着下げることとし、"
},
{
"start": 323.82,
"end": 327.62,
"text": "なお、比例名簿搭載者が不足した場合には、"
},
{
"start": 327.62,
"end": 332.3,
"text": "有権者の政党への一票という投票意思を尊重し、"
},
{
"start": 332.3,
"end": 336.18,
"text": "不足分を決意扱いとすることとしております。"
},
{
"start": 336.18,
"end": 339.9,
"text": "さらに、比例代表選出議員が理当し、"
},
{
"start": 339.9,
"end": 342.62,
"text": "他の政党に所属した場合における、"
},
{
"start": 342.62,
"end": 345.94,
"text": "政党交付金の賛定の在り方など、"
},
{
"start": 345.94,
"end": 350.06,
"text": "公的女性である政党交付金の在り方に対しても、"
},
{
"start": 350.06,
"end": 352.66,
"text": "さまざまな指摘があることから、"
},
{
"start": 352.66,
"end": 357.66,
"text": "速やかに検討を行い、必要な措置を講じることとしております。"
},
{
"start": 357.66,
"end": 363.02,
"text": "以上、理想の選挙制度に向けた抜本改革の実現には、"
},
{
"start": 363.02,
"end": 366.1,
"text": "総合の時間を要することを踏まえ、"
},
{
"start": 366.1,
"end": 370.42,
"text": "抜本改革の結論を得るまでの官において、"
},
{
"start": 370.42,
"end": 374.82,
"text": "原稿制度についても、普段の見直しを行うことは、"
},
{
"start": 374.82,
"end": 378.3,
"text": "我々立法府のセクウムであると考えます。"
},
{
"start": 378.3,
"end": 381.54,
"text": "我が党として、自民、維新、国民民主の"
},
{
"start": 381.54,
"end": 385.02,
"text": "参討合意に基づく、原稿制度の見直し法案について、"
},
{
"start": 385.02,
"end": 389.3,
"text": "幅広い合意が得られるよう、審議に望んでまいることを申し上げ、"
},
{
"start": 389.3,
"end": 391.7,
"text": "意見表明といたします。ありがとうございました。"
}
]